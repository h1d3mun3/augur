#!/usr/bin/env bash
# llm-docker install script
# Usage: bash install

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="$HOME/.llm-docker"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

info()    { echo -e "${CYAN}[install]${RESET} $*"; }
success() { echo -e "${GREEN}[install]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[install]${RESET} $*"; }
error()   { echo -e "${RED}[install]${RESET} $*" >&2; }

# Validate source files exist
for f in llm-docker Dockerfile; do
    if [[ ! -f "$SCRIPT_DIR/$f" ]]; then
        error "$f not found in $SCRIPT_DIR"
        exit 1
    fi
done

# Copy files
info "Installing to $INSTALL_DIR..."
mkdir -p "$INSTALL_DIR"
cp "$SCRIPT_DIR/llm-docker" "$INSTALL_DIR/llm-docker"
cp "$SCRIPT_DIR/Dockerfile" "$INSTALL_DIR/Dockerfile"
chmod +x "$INSTALL_DIR/llm-docker"
success "Files copied."

# Add to PATH
SHELL_CONFIG=""
[[ -f "$HOME/.zshrc" ]]  && SHELL_CONFIG="$HOME/.zshrc"
[[ -z "$SHELL_CONFIG" ]] && [[ -f "$HOME/.bashrc" ]] && SHELL_CONFIG="$HOME/.bashrc"

if [[ -z "$SHELL_CONFIG" ]]; then
    warn "Neither ~/.zshrc nor ~/.bashrc found. Add $INSTALL_DIR to PATH manually."
elif grep -q 'export PATH=.*\.llm-docker' "$SHELL_CONFIG" 2>/dev/null; then
    warn "PATH already configured in $SHELL_CONFIG"
else
    printf '\n# llm-docker\nexport PATH="$HOME/.llm-docker:$PATH"\n' >> "$SHELL_CONFIG"
    success "Added PATH entry to $SHELL_CONFIG"
fi

echo ""
success "Installation complete!"
echo ""
echo -e "  ${BOLD}Next steps:${RESET}"
echo -e "    1. ${CYAN}source ${SHELL_CONFIG:-~/.zshrc}${RESET}"
echo -e "    2. ${CYAN}llm-docker build${RESET}"
echo -e "    3. ${CYAN}llm-docker up${RESET} (in any project directory)"
echo ""
