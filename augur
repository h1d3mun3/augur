# ── Entry point ───────────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift || true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --macos) MACOS_MODE=true; shift ;;
        --gui)   MACOS_GUI=true; shift ;;
        --egress)    AUGUR_EGRESS=1; shift ;;
        --no-egress) AUGUR_EGRESS=0; shift ;;
        --swift)
            SWIFT_VERSION="${2:?'--swift requires a version (e.g. --swift 6.0)'}"
            shift 2
            ;;
        *) break ;;
    esac
done

SWIFT_IMAGE_TAG="${SWIFT_VERSION:-latest}"
IMAGE_NAME="augur:swift-${SWIFT_IMAGE_TAG}"
CONTAINER_NAME="$(make_container_name)"
WORKSPACE_MOUNT="$(make_workspace_mount)"
# Per-project virtiofs share name for macOS VM mode. The automount exposes it at
# "/Volumes/My Shared Files/<name>", which is the path Claude actually records as cwd (it resolves
# the ~/workspace-<slug> symlink), so a per-project name keeps each project's history under a distinct slug.
MACOS_SHARE="workspace-$(workspace_slug)"

if $MACOS_MODE; then
    case "$COMMAND" in
        build)          cmd_build_macos "$@" ;;
        up)             cmd_up_macos ;;
        claude)         cmd_claude_macos ;;
        shell)          cmd_shell_macos ;;
        down)           cmd_down_macos ;;
        destroy)        cmd_destroy_macos ;;
        status)         cmd_status_macos ;;
        init-conf)      cmd_init_conf ;;
        list)           cmd_list_macos ;;
        update)         cmd_update_macos ;;
        version)        cmd_version_macos ;;
        help|--help|-h) cmd_help ;;
        *) error "Unknown command: '$COMMAND'"; cmd_help; exit 1 ;;
    esac
else
    case "$COMMAND" in
        up)             cmd_up ;;
        claude)         cmd_claude ;;
        shell)          cmd_shell ;;
        down)           cmd_down ;;
        status)         cmd_status ;;
        init-conf)      cmd_init_conf ;;
        update)         cmd_update ;;
        version)        cmd_version ;;
        build)          cmd_build ;;
        help|--help|-h) cmd_help ;;
        *)
            error "Unknown command: '$COMMAND'"
            cmd_help
            exit 1
            ;;
    esac
fi
