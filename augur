#!/usr/bin/env bash
# augur - Run Claude Code and Codex CLI in an isolated Docker container
# Usage:
#   augur up       - Start the container for the current directory
#   augur claude   - Launch Claude Code
#   augur codex    - Launch Codex
#   augur gemini   - Launch Gemini CLI
#   augur shell    - Open a bash shell in the container
#   augur down     - Stop and remove the container
#   augur status   - Show container status

set -euo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(pwd)"
SWIFT_VERSION="${SWIFT_VERSION:-6.0}"

# ANSI colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Helpers ───────────────────────────────────────────────────────────────────

info()    { echo -e "${CYAN}[augur]${RESET} $*"; }
success() { echo -e "${GREEN}[augur]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[augur]${RESET} $*"; }
error()   { echo -e "${RED}[augur]${RESET} $*" >&2; }

# Derive a safe container name from the directory path
make_container_name() {
    local dir_name
    dir_name="$(basename "$WORKSPACE_DIR")"
    dir_name="$(echo "$dir_name" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-' | sed 's/^-//;s/-$//')"
    echo "augur-${dir_name}-swift-${SWIFT_VERSION//./-}"
}

container_running() {
    docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER_NAME"
}

container_exists() {
    docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER_NAME"
}

require_docker() {
    if ! command -v docker &>/dev/null; then
        error "Docker is not installed or not in PATH."
        exit 1
    fi
    if ! docker info &>/dev/null; then
        error "Docker daemon is not running."
        exit 1
    fi
}

ensure_image() {
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        info "Docker image '${IMAGE_NAME}' not found. Building..."
        cmd_build
    fi
}

warn_if_image_stale() {
    local created created_epoch now_epoch age_days
    created=$(docker image inspect --format '{{.Created}}' "$IMAGE_NAME" 2>/dev/null) || return 0
    if created_epoch=$(date -d "$created" +%s 2>/dev/null); then
        :
    else
        created_epoch=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${created:0:19}" +%s 2>/dev/null) || return 0
    fi
    now_epoch=$(date +%s)
    age_days=$(( (now_epoch - created_epoch) / 86400 ))
    if (( age_days >= 14 )); then
        warn "Image was built ${age_days} days ago. Run ${BOLD}augur update${RESET} to get the latest versions."
    fi
}

ensure_running() {
    if ! container_running; then
        if container_exists; then
            info "Container exists but is stopped. Starting it..."
            docker start "$CONTAINER_NAME" &>/dev/null
        else
            warn "No container found for this directory."
            warn "Run ${BOLD}augur up${RESET} first."
            exit 1
        fi
    fi
}

# Resolve an API key: env var > file > empty
resolve_api_key() {
    local env_val="$1" file_path="$2"
    if [[ -n "$env_val" ]]; then
        echo "$env_val"
    elif [[ -f "$file_path" ]]; then
        cat "$file_path"
    fi
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_build() {
    require_docker
    info "Building Docker image '${IMAGE_NAME}' (Swift ${SWIFT_VERSION})..."
    docker build --build-arg SWIFT_VERSION="${SWIFT_VERSION}" -t "$IMAGE_NAME" "$SCRIPT_DIR"
    success "Image '${IMAGE_NAME}' built successfully."
}

cmd_up() {
    require_docker
    ensure_image
    warn_if_image_stale

    if container_running; then
        warn "Container '${CONTAINER_NAME}' is already running."
        return 0
    fi

    if container_exists; then
        info "Removing stale container '${CONTAINER_NAME}'..."
        docker rm -f "$CONTAINER_NAME" &>/dev/null
    fi

    info "Starting container '${CONTAINER_NAME}'..."
    info "Mounting: ${BOLD}${WORKSPACE_DIR}${RESET} → /workspace"

    local docker_args=(
        run -dit
        --name "$CONTAINER_NAME"
        -v "${WORKSPACE_DIR}:/workspace"
        -w /workspace
    )

    # API keys
    local anthropic_key openai_key gemini_key
    anthropic_key="$(resolve_api_key "${ANTHROPIC_API_KEY:-}" "$HOME/.anthropic_api_key")"
    openai_key="$(resolve_api_key "${OPENAI_API_KEY:-}" "$HOME/.openai_api_key")"
    gemini_key="$(resolve_api_key "${GEMINI_API_KEY:-}" "$HOME/.gemini_api_key")"
    [[ -n "$anthropic_key" ]] && docker_args+=(-e "ANTHROPIC_API_KEY=${anthropic_key}")
    [[ -n "$openai_key" ]]    && docker_args+=(-e "OPENAI_API_KEY=${openai_key}")
    [[ -n "$gemini_key" ]]    && docker_args+=(-e "GEMINI_API_KEY=${gemini_key}")

    # Auth & settings directories
    mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.gemini"
    docker_args+=(-v "${HOME}/.claude:/home/dev/.claude")
    docker_args+=(-v "${HOME}/.codex:/home/dev/.codex")
    docker_args+=(-v "${HOME}/.gemini:/home/dev/.gemini")

    # Claude Code stores config (oauthAccount, onboarding state) in ~/.claude.json
    # (separate from ~/.claude/ directory). Persist it so re-login isn't required.
    touch "$HOME/.claude.json"
    docker_args+=(-v "${HOME}/.claude.json:/home/dev/.claude.json")

    # Git config
    [[ -f "$HOME/.gitconfig" ]] && docker_args+=(-v "${HOME}/.gitconfig:/home/dev/.gitconfig:ro")

    # GitHub CLI config (gh pr create, gh auth, etc.)
    mkdir -p "$HOME/.config/gh"
    docker_args+=(-v "${HOME}/.config/gh:/home/dev/.config/gh")
    # On macOS, gh stores OAuth tokens in Keychain (not in hosts.yml), so the
    # mounted config alone is not enough. Pass the token explicitly via GH_TOKEN.
    local gh_token
    gh_token="$(gh auth token 2>/dev/null || true)"
    [[ -n "$gh_token" ]] && docker_args+=(-e "GH_TOKEN=${gh_token}")

    docker_args+=("$IMAGE_NAME" bash)

    docker "${docker_args[@]}" &>/dev/null
    success "Container '${CONTAINER_NAME}' is up."
    echo ""
    echo -e "  ${BOLD}augur claude${RESET}  → Launch Claude Code"
    echo -e "  ${BOLD}augur codex${RESET}   → Launch Codex"
    echo -e "  ${BOLD}augur gemini${RESET}  → Launch Gemini CLI"
    echo -e "  ${BOLD}augur shell${RESET}   → Open bash shell"
    echo -e "  ${BOLD}augur down${RESET}    → Stop and remove"
}

cmd_claude() {
    require_docker
    ensure_running
    info "Launching Claude Code in '${CONTAINER_NAME}'..."
    docker exec -it -e DISABLE_AUTOUPDATER=1 "$CONTAINER_NAME" claude
}

cmd_codex() {
    require_docker
    ensure_running
    info "Launching Codex in '${CONTAINER_NAME}'..."
    docker exec -it "$CONTAINER_NAME" codex
}

cmd_gemini() {
    require_docker
    ensure_running
    info "Launching Gemini CLI in '${CONTAINER_NAME}'..."
    docker exec -it "$CONTAINER_NAME" gemini
}


cmd_shell() {
    require_docker
    ensure_running
    info "Opening bash shell in '${CONTAINER_NAME}'..."
    docker exec -it "$CONTAINER_NAME" bash
}

cmd_down() {
    require_docker

    if ! container_exists; then
        warn "No container found for this directory (${CONTAINER_NAME})."
        return 0
    fi

    info "Stopping and removing container '${CONTAINER_NAME}'..."
    docker rm -f "$CONTAINER_NAME" &>/dev/null
    success "Container '${CONTAINER_NAME}' has been stopped and removed."
}

cmd_status() {
    require_docker
    echo -e "${BOLD}Container:${RESET}  ${CONTAINER_NAME}"
    echo -e "${BOLD}Directory:${RESET}  ${WORKSPACE_DIR}"
    echo -e "${BOLD}Image:${RESET}      ${IMAGE_NAME}"

    if container_running; then
        echo -e "${BOLD}Status:${RESET}     ${GREEN}running${RESET}"
    elif container_exists; then
        echo -e "${BOLD}Status:${RESET}     ${YELLOW}stopped${RESET}"
    else
        echo -e "${BOLD}Status:${RESET}     ${RED}not created${RESET}"
    fi
    echo ""

    if [[ -n "${ANTHROPIC_API_KEY:-}" ]] || [[ -f "$HOME/.anthropic_api_key" ]]; then
        echo -e "  ${GREEN}✓${RESET} Claude (API key)"
    elif [[ -f "$HOME/.claude.json" ]] && grep -q '"oauthAccount"' "$HOME/.claude.json" 2>/dev/null; then
        echo -e "  ${GREEN}✓${RESET} Claude (account auth)"
    else
        echo -e "  ${RED}✗${RESET} Claude (not authenticated)"
    fi
    if [[ -n "${OPENAI_API_KEY:-}" ]] || [[ -f "$HOME/.openai_api_key" ]]; then
        echo -e "  ${GREEN}✓${RESET} Codex (API key)"
    elif [[ -f "$HOME/.codex/auth.json" ]]; then
        echo -e "  ${GREEN}✓${RESET} Codex (account auth)"
    else
        echo -e "  ${RED}✗${RESET} Codex (not authenticated)"
    fi
    if [[ -n "${GEMINI_API_KEY:-}" ]] || [[ -f "$HOME/.gemini_api_key" ]]; then
        echo -e "  ${GREEN}✓${RESET} Gemini (API key)"
    elif [[ -f "$HOME/.gemini/oauth_creds.json" ]]; then
        echo -e "  ${GREEN}✓${RESET} Gemini (account auth)"
    else
        echo -e "  ${RED}✗${RESET} Gemini (not authenticated)"
    fi
    if [[ -f "$HOME/.config/gh/hosts.yml" ]]; then
        echo -e "  ${GREEN}✓${RESET} GitHub CLI (gh) (authenticated)"
    else
        echo -e "  ${RED}✗${RESET} GitHub CLI (gh) (run: gh auth login)"
    fi
}

cmd_update() {
    require_docker
    info "Updating Docker image '${IMAGE_NAME}' (Swift ${SWIFT_VERSION}) to latest versions..."
    docker build --no-cache --build-arg SWIFT_VERSION="${SWIFT_VERSION}" -t "$IMAGE_NAME" "$SCRIPT_DIR"
    success "Image '${IMAGE_NAME}' updated successfully."
    warn "Existing containers use the old image. Run ${BOLD}augur down && augur up${RESET} to apply."
}

cmd_version() {
    require_docker
    echo ""
    echo -e "  ${BOLD}augur${RESET}  ${CYAN}1.1.0${RESET}"
    echo -e "  ${BOLD}Swift${RESET}       ${CYAN}${SWIFT_VERSION}${RESET}  (image: ${IMAGE_NAME})"
    echo ""
    ensure_image
    echo -e "  ${BOLD}Container tool versions:${RESET}"
    docker run --rm "$IMAGE_NAME" swift --version 2>/dev/null || echo "    swift:  (unable to fetch)"
    docker run --rm "$IMAGE_NAME" claude --version 2>/dev/null || echo "    claude: (unable to fetch)"
    docker run --rm "$IMAGE_NAME" codex --version 2>/dev/null || echo "    codex:  (unable to fetch)"
    docker run --rm "$IMAGE_NAME" gh --version 2>/dev/null | head -1 || echo "    gh:     (unable to fetch)"
    echo ""
}

cmd_help() {
    echo ""
    echo -e "  ${BOLD}augur${RESET} — Run Claude Code, Codex, and Gemini CLI in an isolated Docker container"
    echo ""
    echo -e "  ${BOLD}USAGE${RESET}"
    echo -e "    augur ${CYAN}up${RESET}       [--swift VERSION]  Start the container"
    echo -e "    augur ${CYAN}claude${RESET}                     Launch Claude Code"
    echo -e "    augur ${CYAN}codex${RESET}                      Launch Codex"
    echo -e "    augur ${CYAN}gemini${RESET}                     Launch Gemini CLI"
    echo -e "    augur ${CYAN}shell${RESET}                      Open a bash shell"
    echo -e "    augur ${CYAN}down${RESET}                       Stop and remove the container"
    echo -e "    augur ${CYAN}status${RESET}                     Check status and auth info"
    echo -e "    augur ${CYAN}update${RESET}  [--swift VERSION]  Rebuild image with latest versions"
    echo -e "    augur ${CYAN}build${RESET}   [--swift VERSION]  Build the Docker image"
    echo -e "    augur ${CYAN}version${RESET} [--swift VERSION]  Show version information"
    echo -e "    augur ${CYAN}help${RESET}                       Show this help"
    echo ""
    echo -e "  ${BOLD}OPTIONS${RESET}"
    echo -e "    --swift VERSION    Swift version (default: ${CYAN}6.0${RESET})"
    echo ""
    echo -e "  ${BOLD}ENVIRONMENT${RESET}"
    echo -e "    ANTHROPIC_API_KEY   Anthropic API key (or ~/.anthropic_api_key)"
    echo -e "    OPENAI_API_KEY      OpenAI API key (or ~/.openai_api_key)"
    echo -e "    SWIFT_VERSION       Default Swift version (default: 6.0)"
    echo ""
    echo -e "  ${BOLD}NOTES${RESET}"
    echo -e "    • Current directory is mounted at /workspace"
    echo -e "    • ~/.claude, ~/.codex, ~/.gemini, ~/.config/gh are shared with the host"
    echo -e "    • ~/.gitconfig is mounted read-only"
    echo -e "    • Auth is shared across all projects via persistent ~/.claude.json"
    echo -e "    • Run ${BOLD}gh auth login${RESET} on the host once to enable gh inside the container"
    echo ""
}

# ── Entry point ───────────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift || true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --swift)
            SWIFT_VERSION="${2:?'--swift requires a version (e.g. --swift 6.0)'}"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

IMAGE_NAME="augur:swift-${SWIFT_VERSION}"
CONTAINER_NAME="$(make_container_name)"

case "$COMMAND" in
    up)             cmd_up ;;
    claude)         cmd_claude ;;
    codex)          cmd_codex ;;
    gemini)         cmd_gemini ;;
    shell)          cmd_shell ;;
    down)           cmd_down ;;
    status)         cmd_status ;;
    update)         cmd_update ;;
    version)        cmd_version ;;
    build)          cmd_build ;;
    help|--help|-h) cmd_help ;;
    *)
        error "Unknown command: '$COMMAND'"
        cmd_help
        exit 1
        ;;
esac
