#!/usr/bin/env bash
# augur - Run AI coding agents in an isolated environment
#   Container mode (default): lightweight Linux container, run via Apple Container
#     (`container`, macOS 26+).
#   macOS VM mode (--macos): macOS VM with full Xcode support

set -euo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────

# SCRIPT_DIR is the real install directory: symlinks to this script (a link in /usr/local/bin, say)
# are followed by hand, since `readlink -f` is not portable to macOS. The result never depends on
# the current directory.
_augur_src="${BASH_SOURCE[0]}"
_augur_hops=0
while [[ -L "$_augur_src" ]]; do
    _augur_link_dir="$(cd "$(dirname "$_augur_src")" && pwd)" || exit 1
    _augur_src="$(readlink "$_augur_src")"
    [[ "$_augur_src" == /* ]] || _augur_src="$_augur_link_dir/$_augur_src"
    if (( ++_augur_hops > 40 )); then
        echo "augur: too many levels of symbolic links resolving $0" >&2
        return 1 2>/dev/null || exit 1
    fi
done
if ! SCRIPT_DIR="$(cd "$(dirname "$_augur_src")" 2>/dev/null && pwd)"; then
    echo "augur: cannot locate the install directory of $0 (dangling symlink?)" >&2
    return 1 2>/dev/null || exit 1
fi
unset _augur_src _augur_hops _augur_link_dir

# The agent definition (the agent_* data functions) is sourced from beside this script, by an
# absolute path under SCRIPT_DIR — never from the workspace or the current directory. It is
# host-trusted code like this script, so a missing, unreadable or incomplete file is a hard stop
# rather than a fallback; every entry path (help, version, completion helpers, tests that source
# augur) goes through here. `return` covers being sourced, `exit` being executed.
# Today the definition is this one file; a second agent needs a selection point right here, which
# is deliberately not built until a second agent exists.
AGENT_DEFINITION_FILE="$SCRIPT_DIR/agents/claude.sh"  # AUGUR_AGENT_SEAM | the one agent definition file
if [[ ! -f "$AGENT_DEFINITION_FILE" || ! -r "$AGENT_DEFINITION_FILE" ]]; then
    echo "augur: agent definition not found or unreadable: $AGENT_DEFINITION_FILE" >&2
    echo "augur: the install is incomplete or out of date; re-run \`bash install\`." >&2
    return 1 2>/dev/null || exit 1
fi
# shellcheck source=agents/claude.sh
source "$AGENT_DEFINITION_FILE"

# Every accessor the rest of this script calls. A truncated, stale or hand-edited definition would
# otherwise leave some undefined, and many call sites swallow "command not found" (no fixed env, no
# credentials injected, an empty managed policy, an empty signing Team ID), so the load fails
# closed here instead. A test keeps this list equal to the accessors augur actually calls.
AGENT_REQUIRED_ACCESSORS=(
    agent_auth_specs
    agent_cli_name
    agent_config_file_relpath
    agent_config_seed_json
    agent_display_name
    agent_fixed_env
    agent_installer_args
    agent_installer_url
    agent_launch_argv
    agent_login_argv
    agent_macos_cli_relpath
    agent_macos_managed_settings_path
    agent_macos_signing_team
    agent_managed_settings_json
    agent_profile_copy_files
    agent_profile_guest_dir
    agent_profile_guest_mount
    agent_profile_host_subdir
    agent_profile_link_dirs
    agent_state_agents_host_subdir
    agent_state_carryover_host_subdir
    agent_state_guest_agents_dir
    agent_state_guest_history_file
    agent_state_guest_leaf
    agent_state_guest_projects_dir
    agent_state_host_subdir
    agent_token_hint
    agent_version_cmd
)
# The only accessors allowed to print nothing; every other one is a constant the core depends on
# (the signing Team ID and the installer URL gate what runs in a guest).
AGENT_EMPTY_OK_ACCESSORS=(agent_fixed_env agent_installer_args agent_profile_copy_files agent_profile_link_dirs)
for _augur_acc in "${AGENT_REQUIRED_ACCESSORS[@]}"; do
    if ! declare -F "$_augur_acc" >/dev/null; then
        echo "augur: incomplete agent definition: $_augur_acc is not defined in $AGENT_DEFINITION_FILE" >&2
        echo "augur: the install is out of date or damaged; re-run \`bash install\`." >&2
        return 1 2>/dev/null || exit 1
    fi
    case " ${AGENT_EMPTY_OK_ACCESSORS[*]} " in *" $_augur_acc "*) continue ;; esac
    if [[ -z "$("$_augur_acc" x 2>/dev/null)" ]]; then
        echo "augur: incomplete agent definition: $_augur_acc returns nothing in $AGENT_DEFINITION_FILE" >&2
        echo "augur: the install is out of date or damaged; re-run \`bash install\`." >&2
        return 1 2>/dev/null || exit 1
    fi
done
unset _augur_acc

WORKSPACE_DIR="$(pwd)"
SWIFT_VERSION="${SWIFT_VERSION:-}"
MACOS_MODE=false
MACOS_GUI=false
# Set only by `augur destroy <name>` (see adopt_target_name): the slug/hash parsed out of the
# named container/VM, which workspace_slug/workspace_path_hash then return instead of deriving
# them from the current directory.
TARGET_SLUG=""
TARGET_HASH=""

# ANSI colors
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

# macOS VM mode: VM names and SSH key
MACOS_BASE_VM="augur-macos-base"
MACOS_BUILD_VM="augur-macos-build"
# `augur update --macos`'s staging copy of the base VM; never the build VM, which may be a running
# build or one kept with AUGUR_KEEP_BUILD_VM=1.
MACOS_UPDATE_VM="augur-macos-update"
# Host-wide locks (see host_lock_acquire). The base-writer lock is held for the whole of
# `build --macos` and `update --macos`, which both replace the base VM and share the fixed
# provisioning ports, and of `install-cert --macos`, which writes into it; and by setup-token --macos
# while it clones the base VM, so a clone is never taken of a base VM that is being replaced.
MACOS_BASE_WRITER_LOCK="macos-base-writer"
MACOS_SETUP_TOKEN_LOCK="setup-token-macos"
MACOS_SSH_USER="admin"
MACOS_SSH_KEY="$HOME/.augur/vm_key"
# The line push_macos_guest_env appends to a project VM's ~/.zshenv so every zsh sources ~/.augur-env.
MACOS_AUGUR_ENV_SOURCE_LINE='[[ -f ~/.augur-env ]] && source ~/.augur-env'
# The password the operator gives the admin account in the manual Setup Assistant build flow
# (macos_first_boot_manual). Deliberately fixed: see macos_admin_password().
MACOS_MANUAL_SETUP_PASSWORD="admin"
# MACOS_MANUAL_SETUP_PASSWORD ("admin") in /etc/kcpassword's encoding, as hex for `xxd -r -p`:
# the password's bytes XOR'd with the cycling key 7d 89 52 23 d2 bc dd ea a3 b9 1f, then an
# encoded NUL terminator, then filler up to 12 bytes (loginwindow stops reading at the NUL).
# These are known-good bytes, not derived at runtime: change the password and these together.
# macos_first_boot_manual refuses to run if the password is no longer "admin".
MACOS_MANUAL_SETUP_KCPASSWORD="1ced3f4abcbcba2ccaca4e82"

# macOS VM backend binary (augur-vm, built from ./augur-vm). Override with AUGUR_VM_BIN.
AUGUR_VM_BIN="${AUGUR_VM_BIN:-}"

# ── Egress allowlist (augur-proxy) ────────────────────────────────────────────
# When enabled, all guest egress is funneled through a host-side, host-user
# transparent proxy that only permits the domains in the merged allowlist
# (managed baseline augur.conf.default + global ~/.augur/augur.conf + project
# ./.augur/allowlist.conf). Everything else is blocked. No host sudo is ever required. See
# augur-proxy/. This is a security-critical datapath: it must always fail closed.
AUGUR_DIR="$HOME/.augur"
# Three-layer egress allowlist, all merged (union-only: a layer can widen but never
# narrow the ones below it):
#   1. baseline (augur.conf.default) — augur-managed; refreshed on every install so
#      shipped domain updates (e.g. new Anthropic endpoints) reach existing users.
#   2. global   (augur.conf)         — the user's own global domains; never clobbered.
#   3. project  (./.augur/allowlist.conf) — per-project domains.
AUGUR_BASELINE_CONF="$AUGUR_DIR/augur.conf.default"
AUGUR_GLOBAL_CONF="${AUGUR_GLOBAL_CONF:-$AUGUR_DIR/augur.conf}"
# Project-local settings dir — git-tracked, so it travels with the project across
# machines (unlike env vars, which are per-host). Guest-writable (it's inside the
# mounted workspace).
AUGUR_PROJECT_DIR="$WORKSPACE_DIR/.augur"
AUGUR_PROJECT_CONF="${AUGUR_PROJECT_CONF:-$AUGUR_PROJECT_DIR/allowlist.conf}"
# Resource knobs (e.g. MEMORY=4g, MACOS_CPU=4, MACOS_MEMORY_MB=8192). No TOFU gate like the
# allowlist: a guest inflating its own resource limits isn't a containment breach, just a
# self-serve request the operator sees applied on the next `augur up`/`augur up --macos` —
# not worth the approval-prompt UX cost.
AUGUR_PROJECT_RESOURCES_CONF="${AUGUR_PROJECT_RESOURCES_CONF:-$AUGUR_PROJECT_DIR/resources.conf}"
AUGUR_PROXY_DIR="$AUGUR_DIR/proxy"
# Per-project derivation: a stable hash of the project dir yields an offset used for both the
# proxy ports AND the internal subnet, so two egress-enabled projects can run at once without
# colliding. Override any value below with its matching env var.
# (Collisions are ~1/900 between distinct projects.)
# Hashed over the FULL workspace path, not its basename: with the basename, ~/work/app and
# ~/archive/app would get the SAME ports and subnet — a GUARANTEED collision, not a 1/900 one —
# so the second project's `up` would silently share the first's proxy and network. The offset's
# stated purpose is anti-collision, and the full path serves it strictly better: the same ~1/900
# for unrelated projects, minus the certain collision for same-basename pairs. See
# workspace_path_hash for the general rule (host-namespace identifiers carry the path hash).
_augur_port_offset=$(( $(printf '%s' "$WORKSPACE_DIR" | tr '[:upper:]' '[:lower:]' | cksum | cut -d' ' -f1) % 900 ))
# Carve a per-project /28 out of 172.31.0.0/16: third octet = offset/16, fourth octet =
# (offset%16)*16 (a /28 boundary). The network is --internal, so it has no route to the
# host or the internet regardless of the subnet.
_augur_subnet_third=$(( _augur_port_offset / 16 ))
_augur_subnet_fourth=$(( (_augur_port_offset % 16) * 16 ))
AUGUR_INTERNAL_SUBNET="${AUGUR_INTERNAL_SUBNET:-172.31.${_augur_subnet_third}.${_augur_subnet_fourth}/28}"
# Ports the proxy listens on (host side). HTTP CONNECT for container mode; SOCKS5 for
# the macOS file-handle datapath (gvproxy forwards guest TCP here by name).
AUGUR_PROXY_HTTP_PORT="${AUGUR_PROXY_HTTP_PORT:-$((13000 + _augur_port_offset))}"
AUGUR_PROXY_SOCKS_PORT="${AUGUR_PROXY_SOCKS_PORT:-$((14000 + _augur_port_offset))}"
# In egress mode the guest has no host-routable IP (gvproxy user-space network);
# SSH reaches it via gvproxy's host-side forward 127.0.0.1:<this port> → guest:22.
# Only start_gvproxy uses it: it belongs to the current directory's project, so anything that
# connects to a VM reads the port back from that VM's running gvproxy instead (macos_ssh_port).
AUGUR_SSH_FWD_PORT="${AUGUR_SSH_FWD_PORT:-$((20000 + _augur_port_offset))}"
# Egress filtering is on by default. The managed baseline (augur.conf.default) is always
# active; add global domains to ~/.augur/augur.conf or per-project ones to
# ./.augur/allowlist.conf. --no-egress / AUGUR_EGRESS=0 forces filtering off for a run.
AUGUR_EGRESS="${AUGUR_EGRESS:-auto}"
AUGUR_PROXY_BIN="${AUGUR_PROXY_BIN:-}"
# AUGUR_CONTAINER_MEMORY / AUGUR_MACOS_VM_CPU / AUGUR_MACOS_VM_MEMORY_MB are deliberately left
# UNSET here (no ":-default") — resolve_container_memory / resolve_macos_vm_cpu /
# resolve_macos_vm_memory_mb (below) need to distinguish "the operator exported it" from "fall
# through to the project file / built-in default", which a top-level default would collapse.

# ── Base-image custom provisioning (host-global, not per-project — there is exactly one
# macOS base VM and one container image per Swift tag per host, built before any project
# exists) ────────────────────────────────────────────────────────────────────
# macOS mode: ~/.augur/provision/manifest.conf (flat Homebrew package-name list) and/or
# hook.sh (+ hook.allowlist.conf) run once, as root, inside the base-VM build/update, over a
# DEDICATED egress-filtered proxy/gvproxy pair — see run_base_provisioning.
# Apple Container mode: ~/.augur/provision/container-packages.conf (flat apt package-name
# list) is baked into the image via a --build-arg — the image build already has no egress
# filtering at all (pre-existing, unchanged), so no dedicated proxy is needed there — see
# container_provision_build_args.
# Both are TOFU-approval-gated (AUGUR_ACCEPT_PROVISION_HOOK=1 to accept non-interactively).
AUGUR_PROVISION_DIR="$AUGUR_DIR/provision"
AUGUR_PROVISION_MANIFEST="$AUGUR_PROVISION_DIR/manifest.conf"
AUGUR_PROVISION_HOOK="$AUGUR_PROVISION_DIR/hook.sh"
AUGUR_PROVISION_HOOK_ALLOWLIST="$AUGUR_PROVISION_DIR/hook.allowlist.conf"
AUGUR_PROVISION_CONTAINER_PACKAGES="$AUGUR_PROVISION_DIR/container-packages.conf"
# Fixed (not workspace-derived) ports for the ONE-TIME macOS build-provisioning proxy/gvproxy
# pair: only ever one build/update runs at a time (both hold the base-writer lock, see
# host_lock_acquire), and these sit just past the per-project offset range (offset ∈ [0,899], so
# per-project ports top out at 13899/14899/20899) so the two can never collide.
AUGUR_PROXY_HTTP_PORT_PROVISION="${AUGUR_PROXY_HTTP_PORT_PROVISION:-13999}"
AUGUR_PROXY_SOCKS_PORT_PROVISION="${AUGUR_PROXY_SOCKS_PORT_PROVISION:-14999}"
AUGUR_SSH_FWD_PORT_PROVISION="${AUGUR_SSH_FWD_PORT_PROVISION:-20999}"
# Fixed ports for `augur setup-token --macos`'s throwaway VM (see adopt_setup_token_identity): one
# below the provisioning ports, so they sit outside the per-project range and collide with neither.
# Only one setup-token --macos runs at a time per host (MACOS_SETUP_TOKEN_LOCK).
AUGUR_PROXY_HTTP_PORT_SETUP_TOKEN="${AUGUR_PROXY_HTTP_PORT_SETUP_TOKEN:-13998}"
AUGUR_PROXY_SOCKS_PORT_SETUP_TOKEN="${AUGUR_PROXY_SOCKS_PORT_SETUP_TOKEN:-14998}"
AUGUR_SSH_FWD_PORT_SETUP_TOKEN="${AUGUR_SSH_FWD_PORT_SETUP_TOKEN:-20998}"

# ── Helpers ───────────────────────────────────────────────────────────────────

# The message is printed verbatim: a backslash in it (a path, a printf format shown to the
# operator) stays a backslash instead of being interpreted as an escape.
info()    { printf '%s\n' "${CYAN}[augur]${RESET} $*"; }
success() { printf '%s\n' "${GREEN}[augur]${RESET} $*"; }
warn()    { printf '%s\n' "${YELLOW}[augur]${RESET} $*"; }
error()   { printf '%s\n' "${RED}[augur]${RESET} $*" >&2; }

# Make text that came from a guest (VM or container) safe to show on the operator's terminal.
# The guest is untrusted, and a terminal acts on control bytes it prints: an ESC sequence can
# erase or rewrite augur's own status lines, and some terminals let one set the host clipboard
# (OSC 52). Every C0 control byte and DEL becomes a visible `\xNN`; the backslash is escaped
# first so that a guest-written literal `\x1b` stays distinguishable from a real ESC byte.
# UTF-8 text passes through unchanged. Same scheme as DecisionLog.sanitize in augur-proxy.
# Print guest text through this (or sanitize_guest_lines) before info/warn/error or echo.
sanitize_guest_text() {
    local s="${1//\\/\\\\}" i c hex
    for i in {1..31} 127; do
        printf -v hex '%02x' "$i"
        # shellcheck disable=SC2059  # Deliberately a format: it turns "\x1b" into the byte itself.
        printf -v c "\\x${hex}"
        s="${s//"$c"/\\x${hex}}"
    done
    printf '%s' "$s"
}
# sanitize_guest_text for a stream: each stdin line comes out sanitised, newline-terminated.
sanitize_guest_lines() {
    local _l
    while IFS= read -r _l || [[ -n "$_l" ]]; do
        printf '%s\n' "$(sanitize_guest_text "$_l")"
    done
}
# Show guest text or a log excerpt from stdin as error lines, each `  | <line>`, sanitised
# (sanitize_guest_lines). Blank lines are skipped: a bare `  |` tells the operator nothing, and
# empty captured output then prints no line at all.
show_guest_lines() {
    local _l
    sanitize_guest_lines | while IFS= read -r _l; do if [[ -n "$_l" ]]; then error "  | ${_l}"; fi; done
}

# ══ Apple Container ══════════════════════════════════════════════════════════════
# augur's default (non --macos) mode runs the agent in a Linux container hosted by
# Apple Container (github.com/apple/container) — the `container` CLI on macOS 26+, which
# runs each container in its own lightweight Linux VM. These thin wrappers keep the call
# sites readable and name the few subcommands whose spelling is Apple-specific.

# The container engine binary (run/exec/build/start/image inspect/network create/inspect).
eng() { container "$@"; }

# The shell the boot self-test and the setup-token integrity gate exec in the guest. Deliberately an
# absolute path, never a bare `sh`: Apple Container appends exec `-e` after the container's baked env
# without de-duplicating, and the runtime resolves a slash-less program name through the FIRST
# `PATH=` in that env, which is the image's and starts with /home/dev/.local/bin. The guest user can
# write there, and the container is kept across `down`/`up`, so a stub a prior session left as
# ~/.local/bin/sh would run in place of the shell and could fake every check. An absolute path skips
# the lookup entirely; an `-e PATH=` pin cannot, because it only applies inside the program that has
# already been picked. The same reasoning applies to any tool those checks run: name it by absolute
# path, or under a PATH pinned to system directories inside this shell.
ENGINE_CHECK_SH="/bin/sh"

# Human label for messages.
engine_label() { echo "Apple Container"; }

# Is `container` installed and its service reachable? The launchd apiserver is started
# transparently (no sudo) if down.
engine_ready() {
    command -v container &>/dev/null || {
        error "Apple Container (the 'container' CLI) is not installed or not in PATH."
        error "Install it from https://github.com/apple/container."
        return 1
    }
    if ! container system status &>/dev/null; then
        info "Starting the Apple Container service (container system start)..."
        container system start &>/dev/null || true
        container system status &>/dev/null || {
            error "The Apple Container service is not running and could not be started."
            error "Start it manually: ${BOLD}container system start${RESET}."
            return 1
        }
    fi
}

# Oldest Apple Container CLI augur starts sessions with: the per-session credential exec relies on
# it reading `--env-file` from a process-substitution pipe (see session_credential_env), and the
# boot self-test's direct-egress probes rely on `-e HTTP_PROXY=` meaning an explicit empty value
# rather than "inherit from the host" (see verify_egress_locked).
AUGUR_MIN_CONTAINER_VERSION="1.0.0"

# Print the X.Y.Z release out of `container --version`, whose single line reads
# `container CLI version 1.4.1 (build: release, commit: 1a2b3c4)` (a dev build carries a suffix,
# `0.10.0-27-g9fd15f0`, which is cut off). Prints nothing when no X.Y.Z follows "version ".
engine_cli_version() {
    container --version 2>/dev/null \
        | sed -n 's/.*version \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' \
        | head -n1 || true
}

# True iff dotted version $1 >= $2 (both X.Y.Z, compared field by field as integers).
version_at_least() {
    local a1 a2 a3 b1 b2 b3
    IFS=. read -r a1 a2 a3 <<< "$1"
    IFS=. read -r b1 b2 b3 <<< "$2"
    # 10# so a zero-padded field is read as decimal, not octal.
    (( 10#$a1 != 10#$b1 )) && { (( 10#$a1 > 10#$b1 )); return; }
    (( 10#$a2 != 10#$b2 )) && { (( 10#$a2 > 10#$b2 )); return; }
    (( 10#$a3 >= 10#$b3 ))
}

# Refuse an Apple Container CLI older than AUGUR_MIN_CONTAINER_VERSION. Called by the commands that
# create a container or start a session in it (up / claude / shell / setup-token).
# Deliberately NOT gated: down/destroy/list/status/build/update/install-cert, so an operator on an
# older CLI can still stop and clean up what exists before upgrading.
# Deliberately fail-OPEN when the version cannot be parsed: the floor is a usability guard, not a
# security boundary. A CLI that cannot read the credential pipe fails the session's `exec` loudly
# and injects nothing, while refusing an unparseable string would lock every operator out the day
# Apple reformats `--version`.
require_engine_version() {
    local v; v="$(engine_cli_version)"
    if [[ -z "$v" ]]; then
        warn "Could not read the Apple Container version from 'container --version'; continuing."
        return 0
    fi
    version_at_least "$v" "$AUGUR_MIN_CONTAINER_VERSION" && return 0
    error "Apple Container ${v} is too old: augur needs ${AUGUR_MIN_CONTAINER_VERSION} or newer."
    error "Upgrade it from https://github.com/apple/container/releases, then re-run this command."
    exit 1
}

# Apple spells container removal "delete" (with "rm" as an alias); --force drops a
# still-running container.
engine_rm_force() { container delete --force "$@"; }

# Apple spells network removal "network delete" (alias "rm", no --force).
engine_network_rm() { container network delete "$@"; }
# ══ end Apple Container ══════════════════════════════════════════════════════════

workspace_slug() {
    [[ -n "$TARGET_SLUG" ]] && { echo "$TARGET_SLUG"; return; }
    local dir_name
    dir_name="$(basename "$WORKSPACE_DIR")"
    echo "$dir_name" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-' | sed 's/^-//;s/-$//'
}

make_container_name() {
    # Include the full-path hash (not just the basename slug) so two projects that share a
    # basename (~/work/app vs ~/archive/app) never resolve to the SAME container. This matters
    # because `down` KEEPS the container: without the hash, project B's `up`/`claude` could
    # re-attach to project A's persisted container — with A's mounts, credentials, and any
    # foothold a prior session left behind. Mirrors the macOS project-VM name (macos_project_vm).
    echo "augur-$(workspace_slug)-$(workspace_path_hash)-swift-${SWIFT_IMAGE_TAG//./-}"
}

# The names augur mints for a project's container / VM (make_container_name, macos_project_vm),
# as a regex with the slug and path hash captured. $1 is "container" or "macos". Shared by
# adopt_target_name (what `destroy <name>` accepts) and the completion name lister, so what
# completion offers is exactly what `destroy` accepts — e.g. the base VM and build helpers, which
# also start with `augur-`, are neither.
target_name_re() {
    if [[ "$1" == macos ]]; then
        echo '^augur-macos-([a-z0-9-]+)-([0-9a-f]{12})$'
    else
        echo '^augur-([a-z0-9-]+)-([0-9a-f]{12})-swift-([A-Za-z0-9_-]+)$'
    fi
}

# Point every per-project helper at a container/VM NAME given on the command line instead of the
# current directory: `augur destroy <name>`. The name carries the project's slug and path hash
# (see make_container_name / macos_project_vm), and all per-project host state is keyed on exactly
# those two, so parsing them back out is enough to find and clean up everything the project owns.
# $1 is "container" or "macos". Refuses a name that is not in augur's own naming scheme, so
# `destroy <name>` can never be aimed at someone else's container. The character classes below
# are deliberately tight (what workspace_slug and the Swift tag can produce): the parsed slug and
# name become path components under ~/.augur, so a `/` or `..` must never get through.
adopt_target_name() {
    local kind="$1" name="$2" re
    re="$(target_name_re "$kind")"
    if [[ ! "$name" =~ $re ]]; then
        error "'${name}' is not an augur-managed $([[ "$kind" == macos ]] && echo "macOS VM" || echo container) name."
        echo -e "  List them with: ${BOLD}augur list$([[ "$kind" == macos ]] && echo " --macos")${RESET}" >&2
        return 1
    fi
    TARGET_SLUG="${BASH_REMATCH[1]}"
    TARGET_HASH="${BASH_REMATCH[2]}"
    CONTAINER_NAME="$name"
}

# In-container mount/workdir, suffixed with the project slug so each project gets
# a distinct path. Claude Code keys its per-directory memory off the cwd, so a
# per-project path (e.g. /workspace-avow) keeps each project's memory isolated.
make_workspace_mount() {
    echo "/workspace-$(workspace_slug)"
}

# Apple Container has no `ps` and no Go-template --format, so we inspect the container by
# name and read its running state from the JSON. Confirmed on macOS 26: the container's
# run state is nested at .status.state (.status is an OBJECT, not a string — "state":"running"
# when up). We match that exact field; it is unique to the top-level state, so it can't
# false-positive on config. NOTE: the field is `state`, NOT `status` (which is the enclosing
# object). `container inspect` exits non-zero when the name doesn't exist, which doubles as
# the existence check.
container_running() {
    container inspect "$CONTAINER_NAME" 2>/dev/null \
        | grep -qE '"state"[[:space:]]*:[[:space:]]*"running"'
}

container_exists() {
    container inspect "$CONTAINER_NAME" &>/dev/null
}

require_engine() {
    engine_ready || exit 1
}

ensure_image() {
    if ! eng image inspect "$IMAGE_NAME" &>/dev/null; then
        info "$(engine_label) image '${IMAGE_NAME}' not found. Building..."
        cmd_build
    fi
}

# Print one credential: the env value $1 if set, else the content of host file $2. Prints nothing
# when neither exists; fails when the file exists but cannot be read.
resolve_api_key() {
    local env_val="$1" file_path="$2"
    if [[ -n "$env_val" ]]; then
        echo "$env_val"
    elif [[ -f "$file_path" ]]; then
        cat "$file_path"
    fi
}

# True iff $1 is a shell variable name. Every name augur interpolates into a guest's shell code or
# its sshd configuration (macos_env_add_export, macos_session_env_delivery_cmd,
# macos_session_env_names) must pass it.
valid_env_name() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; }

# Reject a value that could break out of the single-quoted `export VAR='<value>'` lines macOS mode
# writes for a guest shell (macos_env_add_export: ~/.augur-env, and git's credential helper in
# a session's remote command), or smuggle control bytes into a guest environment. This is
# the per-value credential validator the auth seam flagged as future work: a single quote is the only
# character that can escape a single-quoted shell string, and control bytes (newline/CR/tab/…)
# have no place in a credential token. Container mode writes one NAME=value per line into an
# --env-file (session_credential_env), where a newline would smuggle in a second variable. macOS mode
# sends the credentials as ssh env requests (ssh_macos_session), which quote nothing, and holds them
# to the same rule so one check covers both modes. Fails closed — a malformed secret must abort the
# command that would inject it, never be injected.
validate_secret_value() {
    local name="$1" value="$2"
    if [[ "$value" == *\'* ]]; then
        error "Refusing to inject ${name}: value contains a single quote (') and cannot be safely quoted into the guest env."
        return 1
    fi
    if [[ "$value" == *[[:cntrl:]]* ]]; then
        error "Refusing to inject ${name}: value contains a control character (newline/tab/…)."
        return 1
    fi
    return 0
}

# Resolve every credential augur injects, exactly once, and validate each value. The one resolver
# for both modes: the early check and each mode's per-session delivery (Container mode's
# --env-file, macOS mode's ssh_macos_session) use the values it returns, so what is checked is
# what is injected.
#
# Sets the CALLER's `_creds` array (bash dynamic scoping; declare it `local _creds=()` first) to
# NAME=value entries, non-empty values only: each agent_auth_specs credential (host env var, else its
# host file), then the host's `gh auth token` as GH_TOKEN. Also checks agent_fixed_env, which macOS
# mode writes into the guest's sourced ~/.augur-env. Returns 1, after an error naming the variable,
# when a value fails validate_secret_value or a credential file exists but cannot be read; callers
# abort with `|| exit 1`. Must not run inside a subshell or process substitution: `_creds` would not
# reach the caller there.
#
# Resolution reads only host env vars, host files and `gh auth token`, so it can run before a guest
# exists. Callers place it as follows:
#   • Container mode: cmd_claude / cmd_shell, before bringing the container up (cmd_up injects
#     nothing and does not call it).
#   • macOS mode, boot: cmd_up_macos, before the clone. Checked only after `augur-vm clone`,
#     `augur-vm set`, `augur-vm run` and the SSH wait, a bad value would abort `up` with a VM cloned,
#     sized and BOOTED and nothing torn down. `up` itself delivers no credential, but it fails here
#     for a value the next session would refuse. A `claude` / `shell --macos` that boots the VM gets
#     its values from this same call: cmd_up_macos does not declare `_creds` itself.
#   • macOS mode, running VM: through resolve_running_macos_vm_credentials, which on failure still
#     pushes the guest's ~/.augur-env first. prepare_macos_session calls it before its first guest
#     step; cmd_up_macos's already-running branch after its egress self-test, so a bad credential
#     never cancels that branch's reconcile, clock fix or self-test.
# Deliberately NOT called by setup-token in either mode: it injects no credentials (container mode
# runs the login in the project container with no --env-file, macOS mode in a throwaway clone of the
# base VM), so a stored token that fails the check can still be replaced by `augur setup-token`.
#
# Deliberately NOT an error: an ABSENT credential (no env var, no file). A guest with no token is a
# supported state in both modes (the operator mints one with `augur setup-token`). A file that exists
# but cannot be read IS an error: treating it as absent would start the session with no
# credentials when the host has working ones.
# AUGUR_AGENT_SEAM | credential resolution + check — core enforces named-only (never wholesale host
# env, never a mounted credential store); the agent only DECLARES the names + host sources
# (agent_auth_specs), and the core owns the resolver and the validator (validate_secret_value).
# ANTHROPIC_API_KEY wins if both Claude vars are set (official precedence, applied by the agent).
# CONTRACT (credentials): a future multi-agent build adds its per-spec VALIDATOR field here, in ONE
# place, rather than at each injection site.
resolve_session_credentials() {
    local _genv _henv _hfile _hvalidator _aval _gh _kv
    _creds=()
    while IFS='|' read -r _genv _henv _hfile _hvalidator; do
        [[ -z "$_genv" ]] && continue
        _aval="$(resolve_api_key "${!_henv:-}" "$_hfile")" || {
            error "Could not read ${_hfile} (for ${_genv}); fix its permissions or remove it."
            return 1
        }
        [[ -n "$_aval" ]] || continue
        validate_secret_value "$_genv" "$_aval" || return 1
        _creds+=("${_genv}=${_aval}")
    done < <(agent_auth_specs)
    _gh="$(gh auth token 2>/dev/null || true)"
    if [[ -n "$_gh" ]]; then
        validate_secret_value GH_TOKEN "$_gh" || return 1
        _creds+=("GH_TOKEN=${_gh}")
    fi
    for _kv in $(agent_fixed_env); do
        validate_secret_value "${_kv%%=*}" "${_kv#*=}" || return 1
    done
    return 0
}

# The name of every credential resolve_session_credentials can produce, one per line: each
# agent_auth_specs guest variable, then GH_TOKEN. macOS mode's base VM accepts exactly these from a
# session's ssh (install_macos_session_env_acceptance).
session_credential_names() {
    local _genv _rest
    while IFS='|' read -r _genv _rest; do
        [[ -n "$_genv" ]] && printf '%s\n' "$_genv"
    done < <(agent_auth_specs)
    printf '%s\n' GH_TOKEN
}

# True iff the caller's `_creds` (see resolve_session_credentials) holds a gh token.
creds_have_gh_token() {
    local _kv
    for _kv in ${_creds[@]+"${_creds[@]}"}; do [[ "$_kv" == GH_TOKEN=* ]] && return 0; done
    return 1
}

# git's credential helper for github.com, as NAME=value lines of git's environment config
# (GIT_CONFIG_COUNT, then GIT_CONFIG_KEY_<n> / GIT_CONFIG_VALUE_<n> pairs). The one definition for
# both modes: Container mode passes each line as a `container exec -e` (_add_session_exec_env), macOS
# mode exports each in the remote command of a session that sends GH_TOKEN, as
# `export NAME='value'` (macos_session_git_env_cmd).
#
# The Container half relies on the container CLI passing `-e GIT_CONFIG_VALUE_0=` through as a
# variable that is set and empty: neither dropped nor read as `-e NAME`, which takes the value from
# the CLI's own environment. tests/21_container_live.sh checks this in a real container.
#
# The helper makes HTTPS `git push` work off GH_TOKEN alone, without writing any git config file and
# without gh or `gh auth setup-git` in the guest. It holds only the REFERENCE `$GH_TOKEN`, never the
# value: the single quotes keep it literal through augur, the `-e` or the session's `export`, and
# git, which hands the helper to `sh` at call time, and only that shell expands it.
#
# The empty value before it resets the helper chain. git collects every generic `credential.helper`
# and every matching `credential.<url>.helper` into one list, in the order it reads its config, asks
# them in turn on `get`, and calls `store` on ALL of them after a successful push; an empty value
# clears the list collected so far. Environment config is read after every config file (system, XDG,
# global, their includes and includeIfs, the repository's own .git/config), so the reset clears all
# of them: macOS git's system-level osxkeychain (over SSH it prints "failed to store: -25308", and
# with the guest keychain unlocked it would keep a copy of GH_TOKEN there) and the helpers the
# host's ~/.gitconfig names, which the guest gets as a read-only mount or a copy and which cannot
# run there ("'credential-osxkeychain' is not a git command", "/opt/homebrew/bin/gh: not found").
# That includes a github.com section an older augur wrote into a macOS guest's ~/.gitconfig.
# Accepted trade-off: a helper the operator sets up inside the guest is cleared for github.com too.
# Only `git -c` on a command line is read after this.
#
# Prints nothing when the host has no gh token: git then runs whatever helpers the config files
# name, as it would without augur. Deliberately no reset on its own: with no token there is nothing
# to authenticate with either way, so it would only trade the host helpers' stray errors for a
# prompt or failure, and it would clear a credential the operator set up inside the guest by hand.
#
# Accepted trade-off (macOS): augur's exports run in the session's first guest shell, after its
# startup files and before the login zsh that runs the agent or shell sources its own, so a
# GIT_CONFIG_* that a guest startup file exports (/etc/zshenv, ~/.zshenv, ~/.zprofile, ~/.zshrc)
# replaces augur's, reset included. Deliberately not moved after the login zsh's startup files
# (into the agent's `zsh -l -c`): every zsh the agent starts to run a command reads /etc/zshenv and
# ~/.zshenv again (and, as a login or interactive shell, the others), so git run there would still
# see the startup file's set; and the interactive `shell --macos` has no point after its startup
# files at which augur could run a command, short of replacing those files.
git_credential_env() {
    creds_have_gh_token || return 0
    printf '%s\n' \
        'GIT_CONFIG_COUNT=2' \
        'GIT_CONFIG_KEY_0=credential.https://github.com.helper' \
        'GIT_CONFIG_VALUE_0=' \
        'GIT_CONFIG_KEY_1=credential.https://github.com.helper' \
        'GIT_CONFIG_VALUE_1=!f() { test "$1" = get && echo username=x-access-token && echo "password=$GH_TOKEN"; }; f'
}

# Prompts on the terminal for the token the agent's login printed and prints what was pasted. The
# prompt goes to stderr, so a caller captures just the value: token="$(read_agent_token_from_tty)".
read_agent_token_from_tty() {
    local token=""
    read -rp "$(echo -e "${CYAN}[augur]${RESET} Paste the token ($(agent_token_hint)) here to save it on the host: ")" token < /dev/tty || true
    printf '%s' "$token"
}

# Persist a captured Claude subscription token to the host token file augur reads whenever it
# injects credentials (resolve_api_key picks it up as CLAUDE_CODE_OAUTH_TOKEN). Validates the
# shape and writes it 0600. The host never needs claude installed for this.
# $2 is "macos" when the token was minted for macOS VM mode; it only selects the "next up" wording.
# AUGUR_AGENT_SEAM | token persistence — Claude-specific shape (sk-ant-*) + dest file.
# CONTRACT (credentials): this charset/length check is the only credential validator today;
# generalize it to every agent's resolved credential value before broadening agent_auth_specs.
save_oauth_token() {
    local token="$1" dest="$HOME/.claude_code_oauth_token"
    # Validate the shape conservatively: the sk-ant- prefix, a sane length, and only
    # token-safe characters (no whitespace / control bytes). The value comes from
    # `claude setup-token` run inside the guest, so a stricter check limits the blast
    # radius of a tampered or lookalike flow.
    if [[ -z "$token" || "$token" != sk-ant-* ]] \
       || (( ${#token} < 20 || ${#token} > 500 )) \
       || [[ "$token" == *[!A-Za-z0-9._-]* ]]; then
        error "No valid token saved (expected an sk-ant-… value: 20–500 token-safe chars, no spaces)."
        error "If 'claude setup-token' printed one, save it manually:"
        error "  printf '%s\\n' '<token>' > ${dest} && chmod 600 ${dest}"
        return 1
    fi
    ( umask 077; printf '%s\n' "$token" > "$dest" )
    chmod 600 "$dest"
    success "Saved subscription token to ${BOLD}${dest}${RESET} (chmod 600)."
    if [[ "${2:-}" == macos ]]; then
        info "augur hands it as CLAUDE_CODE_OAUTH_TOKEN to every new ${BOLD}claude --macos${RESET} and ${BOLD}shell --macos${RESET} session, so the next one picks it up with no VM restart."
    else
        info "augur injects it as CLAUDE_CODE_OAUTH_TOKEN into every new session (claude, shell) — no host claude needed."
    fi
    # resolve_api_key prefers the host env var over this file, so a set variable hides the new token.
    if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
        warn "CLAUDE_CODE_OAUTH_TOKEN is set in this shell, and augur injects that value instead of ${dest}."
        warn "  The new token is not used until you unset it (${BOLD}unset CLAUDE_CODE_OAUTH_TOKEN${RESET}, and remove it from your shell profile)."
    fi
}

# Security notice shown before the operator pastes a setup-token. The token is produced by
# `claude setup-token` running INSIDE a guest and rendered on the operator's own terminal. Both
# modes check the binary first, but a lookalike sign-in pointing at an attacker's OAuth flow is
# still the failure that matters most, so warn before the host persists and replays whatever is
# pasted into every future guest.
# AUGUR_AGENT_SEAM | operator warning before pasting a token (mentions the genuine claude.ai flow).
setup_token_security_notice() {
    warn "Heads-up: this token comes from 'claude setup-token' running INSIDE the guest."
    warn "Only paste it if the sign-in you completed was the genuine ${BOLD}claude.ai${RESET} flow."
    warn "augur saves it on the host and injects it into ${BOLD}every future guest, in every project${RESET}."
}

# True iff the running container's `claude` is byte-identical to the image's copy. The agent
# runs as the binary's owner (uid 1001) and can replace it, so before setup-token attaches
# it to the operator's TTY we confirm it was not tampered with. The image
# disables the autoupdater, so a mismatch means modification, not version drift; a freshly
# `up`-ped container matches, a reused one a prior session tampered with does not.
#
# On success sets AGENT_VERIFIED_BIN to the absolute path it hashed, and the setup-token launch
# runs exactly that path. That is what makes the check and the launch agree: a launch by bare name
# would be resolved again through the guest-writable image PATH (see ENGINE_CHECK_SH), so it could
# run a different file from the one checked. The path comes from a name lookup in the pristine
# image, never in the container; the container side runs /usr/bin/sha256sum directly, with no shell
# and no lookup a prior session could have influenced.
# AUGUR_AGENT_SEAM | integrity-verify (container engine) — integrity gate before TTY attach.
agent_verify_integrity_engine() {
    AGENT_VERIFIED_BIN=""
    local img_line img_hash bin cont_hash
    # sha256sum prints "HASH  PATH"; the PATH is the one the image resolves the agent CLI to.
    img_line="$(eng run --rm "$IMAGE_NAME" "$ENGINE_CHECK_SH" -c "/usr/bin/sha256sum \"\$(command -v $(agent_cli_name))\"" 2>/dev/null | head -n1)"
    img_hash="${img_line%%  *}"; bin="${img_line#*  }"
    [[ "$img_hash" =~ ^[0-9a-f]{64}$ && "$bin" =~ ^/[A-Za-z0-9._/+-]+$ ]] || return 1
    cont_hash="$(eng exec "$CONTAINER_NAME" /usr/bin/sha256sum "$bin" 2>/dev/null | awk '{print $1}')"
    [[ "$img_hash" == "$cont_hash" ]] || return 1
    AGENT_VERIFIED_BIN="$bin"
}

# Absolute guest path of the agent CLI in a macOS VM (see agent_macos_cli_relpath).
macos_agent_bin() { echo "/Users/${MACOS_SSH_USER}/$(agent_macos_cli_relpath)"; }
# The directory holding it, relative to the guest user's home (what goes on the guest's PATH).
macos_agent_bindir_rel() { dirname "$(agent_macos_cli_relpath)"; }

# A container-side absolute path $1 (an agent_state_* / agent_profile_* value under the container
# user's home), as a path relative to the macOS guest user's home.
#
# Fails (with a message, returning 1) unless $1 is a plain path strictly under /home/dev/ (no empty,
# "." or ".." components): the value
# lands inside remote scripts that rm -rf and ln -sfn it, so anything else must never get that far.
# Callers propagate the failure.
guest_home_relpath() {
    local p="$1"
    if [[ "$p" != /home/dev/?* || "$p" == *..* || "$p" == *//* || "$p" == */./* || "$p" == */. || "$p" == *[!A-Za-z0-9._/-]* ]]; then
        echo "augur: the agent definition gives a guest path that is not a plain path under /home/dev/: $p" >&2
        return 1
    fi
    echo "${p#/home/dev/}"
}

# True iff the agent binary in macOS VM $1 passes `codesign --verify --strict` against a Developer ID
# requirement pinned to the vendor's Team ID (agent_macos_signing_team), AND codesign reports exactly
# that TeamIdentifier. An ad-hoc signature, another team's certificate, or a binary that fails
# verification is refused, whatever its Identifier or Authority text says.
# The check runs inside the guest, through the guest's own shell, so it is only as trustworthy as that
# guest's disk. Callers use it where augur alone has written that disk: the build VM, update's staging
# copy, and setup-token's freshly cloned throwaway VM. Never in a project VM, where a prior session
# could fake codesign itself.
# AUGUR_AGENT_SEAM | integrity-verify (macOS) — codesign signer pinned to the vendor's Team ID.
agent_verify_integrity_macos() {
    local vm="$1" team bin req out
    team="$(agent_macos_signing_team)"; bin="$(macos_agent_bin)"
    [[ "$team" =~ ^[A-Z0-9]{10}$ && "$bin" =~ ^/[A-Za-z0-9._/+-]+$ ]] || return 1
    # Apple's Developer ID requirement (a Developer ID intermediate, a Developer ID Application leaf)
    # plus the team. The leading "=" tells codesign the -R argument is requirement text, not a file.
    req="anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] and certificate leaf[field.1.2.840.113635.100.6.1.13] and certificate leaf[subject.OU] = \"${team}\""
    out="$(ssh_macos "$vm" "/usr/bin/codesign --verify --strict -R=$(printf '%q' "$req") '${bin}' && /usr/bin/codesign -dvv '${bin}' 2>&1")" \
        || return 1
    grep -qx "TeamIdentifier=${team}" <<<"$out"
}
# What agent_verify_integrity_macos refused, for its callers' error output; $1 says which binary
# ("installed", "updated", ...). Callers add one line saying what happens because of it.
agent_signature_check_failed() {
    error "The $1 $(agent_display_name) binary failed the signature check: codesign --verify --strict"
    error "  against a Developer ID signature from Team ID $(agent_macos_signing_team)."
}

# ── macOS VM mode helpers ─────────────────────────────────────────────────────

# Resolve the augur-vm binary (the macOS VM backend): an explicit override, then
# PATH, then the install dir, then a local release build.
resolve_vm_cli() {
    if [[ -n "$AUGUR_VM_BIN" ]]; then echo "$AUGUR_VM_BIN"; return; fi
    if command -v augur-vm &>/dev/null; then command -v augur-vm; return; fi
    local c
    for c in "$SCRIPT_DIR/augur-vm" "$SCRIPT_DIR/augur-vm/.build/release/augur-vm"; do
        [[ -f "$c" && -x "$c" ]] && { echo "$c"; return; }
    done
    echo "augur-vm"
}
VM_CLI="$(resolve_vm_cli)"

require_vz() {
    if [[ "$(uname)" != "Darwin" ]]; then
        error "macOS VM mode requires macOS (Apple Silicon)."
        exit 1
    fi
    if ! command -v "$VM_CLI" &>/dev/null && [[ ! -x "$VM_CLI" ]]; then
        error "augur-vm (the macOS VM backend) was not found."
        error "Build it on macOS: ${BOLD}bash install${RESET}  (or: cd augur-vm && scripts/build.sh)"
        exit 1
    fi
}

# Which first-boot flow `augur build --macos` uses for the freshly created VM $1. Prints
# `automated` (macOS 27's guest provisioning, macos_first_boot_automated) or `manual` (the Setup
# Assistant flow, macos_first_boot_manual); $2 is "true" when --manual-setup was given.
# Eligibility is augur-vm's call (`augur-vm provisioning-support`: host OS, the VM's guest OS,
# and whether the binary was built with the feature at all); this only maps its answer to a flow
# and tells the operator why. Messages go to stderr because stdout is the answer. augur-vm's own
# stderr is held back and shown only when the probe fails unexpectedly (e.g. "No such VM"); the
# usage error of an augur-vm without the subcommand is replaced by augur's install hint.
macos_setup_flow() {
    local vm="$1" manual_flag="$2" answer rc=0 errfile vm_err line
    if [[ "$manual_flag" == true ]]; then
        info "--manual-setup given: using the manual Setup Assistant flow." >&2
        echo manual; return 0
    fi
    errfile="$(mktemp "${TMPDIR:-/tmp}/augur-vm-err.XXXXXX")"
    answer="$("$VM_CLI" provisioning-support "$vm" 2>"$errfile")" || rc=$?
    vm_err="$(cat "$errfile")"; rm -f "$errfile"
    case "$rc:$answer" in
        0:supported)
            info "Host and guest are both macOS 27+ — provisioning the admin account automatically (no manual Setup Assistant needed)." >&2
            echo automated ;;
        0:host|0:guest)
            echo manual ;;
        0:sdk)
            # Never a silent downgrade: both OSes qualify, so name the fix instead of quietly
            # presenting the manual flow as if they had not.
            {
                warn "This augur-vm has no automated provisioning: it was built against an SDK older than macOS 27."
                warn "  Re-run ${BOLD}bash install${RESET} with Xcode 27+ selected to enable it."
                warn "  Falling back to the manual Setup Assistant flow for this build."
            } >&2
            echo manual ;;
        64:*)
            # ArgumentParser's usage-error exit: this augur-vm predates the subcommand.
            warn "This augur-vm cannot report automated-provisioning support; re-run ${BOLD}bash install${RESET} to update it. Using the manual Setup Assistant flow." >&2
            echo manual ;;
        *)
            error "\`augur-vm provisioning-support ${vm}\` failed (exit ${rc}${answer:+, printed: ${answer}})."
            if [[ -n "$vm_err" ]]; then
                while IFS= read -r line; do error "  augur-vm: ${line}"; done <<<"$vm_err"
            fi
            return 1 ;;
    esac
}

# Keyed on basename + workspace_path_hash, not basename alone (see workspace_path_hash; mirrors
# the container-mode host_hist_dir key): ~/work/myapp and ~/archive/myapp must never collide onto
# the same VM/history-dir/egress-config. Changing this key means any
# project VM cloned under the old (basename-only) name is orphaned — a one-time
# fresh clone on next `up`, not data loss (the old VM/clone is left in place;
# `augur list --macos` still shows it and it can be removed manually).
macos_project_vm() {
    echo "augur-macos-$(workspace_slug)-$(workspace_path_hash)"
}

macos_vm_exists() {
    "$VM_CLI" list 2>/dev/null | awk 'NR>1 {print $2}' | grep -qx "$1"
}

macos_vm_running() {
    "$VM_CLI" list 2>/dev/null | awk 'NR>1 {print $2, $NF}' | grep -qx "${1} running"
}

# Poll until VM IP is available (boot takes ~30s); prints IP on success. Wall-clock budget,
# default 90s — callers whose boot does extra work before the guest can even lease an address
# (e.g. `augur-vm run` sitting out a locked auxiliary storage, see macos_wait_for_ssh and
# RunSession.handleStartFailure) must pass a larger one, or they give up mid-boot and tear
# down a VM that was still coming up.
macos_vm_ip() {
    local vm="$1" max_secs="${2:-90}" ip
    local deadline=$(( SECONDS + max_secs ))
    while (( SECONDS < deadline )); do
        ip=$("$VM_CLI" ip "$vm" 2>/dev/null) && [[ -n "$ip" ]] && { echo "$ip"; return 0; }
        sleep 3
    done
    return 1
}

# Poll until the guest's SSH daemon actually accepts a TCP connection — NOT the same thing
# macos_vm_ip checks (a DHCP-leased IP), and callers waiting for "SSH is ready" must not
# conflate the two. Under the manual Setup Assistant flow this distinction does not matter:
# the operator's "Remote Login enabled? Ready to continue?" prompt already gates on a human
# confirming sshd is up before that flow calls macos_vm_ip. The automated provisioning
# path has no such gate — the guest's network interface (hence its IP) routinely
# comes up well before VZMacGuestProvisioningOptions finishes creating the account, logging it
# in, and starting Remote Login — so a caller that stops at macos_vm_ip can start SSHing into
# an IP with nothing listening on port 22 yet ("Connection refused"). Bash's /dev/tcp avoids a
# dependency on `nc`. Wall-clock budget (mirrors wait_for_macos_ssh), not a fixed iteration
# count, and generous: giving up early on a guest that is still legitimately mid-provisioning
# makes the caller tear down (SIGKILL, per StopCommand.swift) a VM that was about to come up,
# turning a slow boot into a failed build. Pass a larger budget for a cold first boot (see
# macos_first_boot_automated).
macos_wait_for_ssh() {
    local ip="$1" port="${2:-22}" max_secs="${3:-180}"
    local deadline=$(( SECONDS + max_secs ))
    while (( SECONDS < deadline )); do
        (exec 3<>"/dev/tcp/${ip}/${port}") 2>/dev/null && return 0
        sleep 3
    done
    return 1
}

# Stop a backgrounded `augur-vm run` process and reap it, bounded. The run process masks
# SIGTERM's default disposition and instead asks the guest for a graceful ACPI shutdown, which
# never completes while the guest is still mid-boot — so a raw `kill "$pid"; wait "$pid"` on it
# can block forever. Route through the bounded `augur-vm stop` (SIGTERM, then SIGKILL after 30s)
# first, so the process is dead and the following `wait` returns promptly instead of hanging.
# The optional pid is a `run` we backgrounded and must reap (avoids a zombie / stray job message).
stop_and_reap_macos_vm() {
    local vm="$1" pid="${2:-}"
    "$VM_CLI" stop "$vm" 2>/dev/null || true
    [[ -n "$pid" ]] && { wait "$pid" 2>/dev/null || true; }
}

# SSH target for a VM. The project VM in egress mode lives behind gvproxy's
# user-space network (no host-routable IP); SSH reaches it via gvproxy's host-side
# forward at 127.0.0.1:<port>. Every other case (build/base VM, or a project VM without
# egress) uses the DHCP-leased guest IP on port 22. Keyed on the project VM having a
# *running* gvproxy, so build/base flows are never affected.
# The forward port is the one that VM's running gvproxy was started with, read back from its argv
# (macos_vm_gvproxy_fwd_port), never AUGUR_SSH_FWD_PORT: that is derived from the current
# directory, and `destroy --macos <name>` run from another project's directory would otherwise
# reach THAT project's VM through its forward. Prints nothing when the port cannot be read back;
# ssh_macos and scp_to_macos refuse an empty port, so nothing ever connects to a guessed one.
macos_via_gvproxy() { [[ "$1" == "$(macos_project_vm)" ]] && gvproxy_running; }
macos_ssh_host() {
    if macos_via_gvproxy "$1"; then echo "127.0.0.1"; else "$VM_CLI" ip "$1" 2>/dev/null; fi
}
macos_ssh_port() {
    if macos_via_gvproxy "$1"; then macos_vm_gvproxy_fwd_port "$1" || true; else echo "22"; fi
}
# Succeeds when both VM $1's SSH host and port resolve, so ssh_macos can connect (see
# _macos_ssh_cmd). Prints nothing. A running egress VM whose gvproxy is down fails it: the fallback
# to `augur-vm ip` finds no DHCP lease on a vfkit-networked guest.
macos_ssh_transport_ok() { [[ -n "$(macos_ssh_host "$1")" && -n "$(macos_ssh_port "$1")" ]]; }

# Per-VM host key store (TOFU): accept a new key on first connect, reject changes thereafter.
# Stored under ~/.augur/known_hosts/<vm-name> — one file per VM so keys don't cross-pollinate.
vm_known_hosts_file() {
    mkdir -p "$AUGUR_DIR/known_hosts"
    echo "$AUGUR_DIR/known_hosts/${1}"
}

# The admin account password of macOS VM $1, used by every macOS-mode sudo/SSH call that needs one.
# It lives in that VM's own bundle directory (macos_admin_password_file, mode 600), and
# cmd_build_macos writes it into the build VM before its first boot:
# - macOS 27's automated guest provisioning: a random password generated for that build.
# - The manual Setup Assistant flow: the fixed MACOS_MANUAL_SETUP_PASSWORD.
#   Deliberately fixed: rotating it after Setup Assistant would desync the auto-login keychain.
# `augur-vm clone` copies the whole bundle directory, so the base VM and every project VM cloned
# from it carry the credential their own disk was built with. Rebuilding the base never changes
# an existing clone's credential, and clones of different bases can coexist.
# A VM without the file (e.g. a base VM built by an older augur) is refused, not guessed at: see
# require_macos_admin_password.
# Never interpolate it into a remote command string: that puts it on the host's `ssh` argv and
# on the guest's process list. Feed it to `sudo -S` through macos_admin_password_stdin instead.
macos_admin_password() {
    require_macos_admin_password "$1"
    cat "$(macos_admin_password_file "$1")"
}

# Where macOS VM $1's admin password is stored: inside the bundle directory augur-vm keeps for
# that VM (~/.augur/vms/<name>/), so it is copied by `clone` and removed by `delete` with the VM.
macos_admin_password_file() { echo "$AUGUR_DIR/vms/$1/admin-password"; }

# Exit with the remedy if macOS VM $1 has no stored admin password. Commands that are about to
# boot or sudo into a VM call this first, so a credential-less VM fails before any work is done.
# With `--running` as $2, for a VM that is running, the refusal goes through
# refuse_running_macos_vm, so the guest's ~/.augur-env is rewritten first: that push uses only
# augur's SSH key, never the admin password.
require_macos_admin_password() {
    [[ -f "$(macos_admin_password_file "$1")" ]] && return 0
    local _lines=(
        "VM '$1' has no stored admin password ($(macos_admin_password_file "$1"))."
        "  Rebuild the base VM:  augur build --macos --ipsw <path> --xcode-xip <path>"
        "  Then recreate each project VM cloned from an older base, in its project directory:"
        "    augur destroy --macos && augur up --macos")
    if [[ "${2:-}" == --running ]]; then refuse_running_macos_vm "$1" "${_lines[@]}"; fi
    local _l; for _l in "${_lines[@]}"; do error "$_l"; done
    exit 1
}

# Store $2 as macOS VM $1's admin password (see macos_admin_password()). A shell function's
# arguments are not a process argv, so the password still appears on no command line. umask for
# the create, then chmod unconditionally: `>` into an already-existing file keeps its old mode.
macos_store_admin_password() {
    local file; file="$(macos_admin_password_file "$1")"
    ( umask 077 && printf '%s' "$2" > "$file" )
    chmod 600 "$file"
}

# VM $1's admin password as one line on stdout, for every guest `sudo -S`:
#   macos_admin_password_stdin "$vm" | ssh_macos "$vm" "sudo -S -p '' <cmd>"
# ssh forwards its stdin to the remote command, and `sudo -S` reads the password from there.
# `printf` is a bash builtin, so the password is never on any argv: not the host's `ssh` command
# line (readable by `ps`) and not the guest's process list. The remote <cmd> must not read stdin;
# when NOPASSWD sudo is already granted, sudo leaves the line unread and <cmd> would see it. A root
# script that has to travel on stdin too goes through macos_run_root_script instead.
# The ssh wrapper must forward stdin: ssh_macos does; ssh_macos_provision passes `-n`, so use
# ssh_macos_provision_stdin there. Prints nothing and fails if the VM has no stored password, so
# under `pipefail` the whole sudo pipeline fails with the remedy on stderr.
macos_admin_password_stdin() {
    local password
    password="$(macos_admin_password "$1")" || return 1
    printf '%s\n' "$password"
}

ssh_macos() {
    local vm="$1" _ssh=() _ssh_dest=""; shift
    _macos_ssh_cmd "$vm"
    "${_ssh[@]}" "$_ssh_dest" "$@"
}

# Sets the caller's `_ssh` array to the ssh command and options for VM $1, and `_ssh_dest` to its
# user@host, for ssh_macos and ssh_macos_session. When the VM's host or port cannot be resolved
# (macos_ssh_transport_ok), it exits 1, after an error, before any connection is made: it does not
# return, so the augur run ends there. Deliberately an exit: most ssh_macos callers rely on it to
# abort the operation. Inside `$( … )` or a pipeline, though, that exit ends only the subshell and
# looks like a remote command's status 1, so a caller that must tell "no way to reach the VM" from
# a failed remote command checks macos_ssh_transport_ok first. Once both resolve, nothing here
# exits.
_macos_ssh_cmd() {
    local vm="$1" host port
    host="$(macos_ssh_host "$vm")"; port="$(macos_ssh_port "$vm")"
    [[ -n "$host" ]] || { error "Cannot resolve SSH host for '${vm}'."; exit 1; }
    [[ -n "$port" ]] || { error "Cannot resolve SSH port for '${vm}': its gvproxy reports no SSH forward port."; exit 1; }
    local key_opts=()
    if [[ -f "$MACOS_SSH_KEY" ]]; then
        key_opts=(-i "$MACOS_SSH_KEY" -o PasswordAuthentication=no -o BatchMode=yes)
    fi
    # Hermetic SSH (-F /dev/null): read NO ssh_config. This closes the one host-env leak in
    # macOS VM mode — OpenSSH's stock `SendEnv LANG LC_*` (and any SendEnv a user added to
    # ~/.ssh/config, which could forward arbitrary host vars/secrets into the guest) would
    # otherwise be sent over the connection. A command-line `-o SendEnv=-LANG -o SendEnv=-LC_*`
    # does NOT work: command-line `-o` is parsed BEFORE the config files, so the system config
    # re-adds the patterns afterwards (verified with `ssh -G`). Dropping ssh_config loses
    # nothing — every option augur relies on is passed explicitly below.
    # ServerAlive* bounds a session that connects at the TCP level but then hangs
    # (ConnectTimeout only covers the initial handshake, not a stalled post-connect
    # session): if the VM dies or the guest sshd stops responding, the client gives up
    # after ~ServerAliveInterval×ServerAliveCountMax seconds instead of blocking forever.
    # No ControlMaster/ControlPath: every call is its own connection, so the env a session sends
    # (ssh_macos_session) belongs to that connection alone.
    _ssh=(ssh -F /dev/null
        -p "$port"
        -o StrictHostKeyChecking=accept-new
        -o UserKnownHostsFile="$(vm_known_hosts_file "$vm")"
        -o LogLevel=ERROR
        -o ConnectTimeout=10
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=4
        ${key_opts[@]+"${key_opts[@]}"})
    _ssh_dest="${MACOS_SSH_USER}@${host}"
}

# The interactive ssh of an `augur claude --macos` / `augur shell --macos` session: ssh_macos plus
# the caller's `_creds` (see resolve_session_credentials), delivered as the session's environment.
# This is the only way credentials reach a macOS guest; nothing writes them to the guest's disk.
#
# Each value goes into the environment of this one `ssh` process: a subshell exports them (`export`
# is a builtin, so no value is on any argv) and execs ssh. `-o SendEnv=<NAME>` names exactly the
# resolved variables; ssh sends them as the session channel's env requests, and the guest's sshd
# sets them for the session only because the base VM's sshd accepts exactly these names
# (install_macos_session_env_acceptance). Deliberately NOT `-o SetEnv=NAME=value`, which would put
# the value on ssh's argv. The ssh options are resolved before the subshell, so the commands that
# resolve the VM's host and port never see the values either.
#
# For a value read from a host file or from `gh`, this ssh is the only process whose environment
# holds it: no other child augur starts gets it in its environment, and it is on no argv and in no
# file. augur's own bash does hold it, as a shell variable (`_creds`) in its memory, and so does
# every subshell it forks while `_creds` is set (this one included), since a fork copies the
# shell's memory; a command those subshells exec gets only their exported environment, which does
# not hold it. Accepted trade-off: a credential the operator exported into augur's environment
# (ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN) is already in augur's environment and inherited by
# every child it starts, as with any other variable of the operator's shell. Those processes run
# as the operator and none of them forwards it: ssh_macos is hermetic and sends no env, so this
# ssh is still the only way the value reaches the guest.
#
# Do not trust the guest's sshd to have set them: its drop-in only says what it should accept, and
# a guest sshd_config that has lost its Include (a guest macOS update, a hand edit) drops them
# without a word. The last argument is the remote command, and this function puts
# macos_session_env_delivery_cmd in front of it, so the guest checks that every name sent arrived
# before it starts the agent or shell; the host maps that check's exit status to the refusal and
# its remedy (macos_session_env_refused). Only a session that sent a credential has the check, so
# only its exit status is read that way. Accepted trade-off: an agent or shell that itself exits
# with MACOS_SESSION_ENV_MISSING_RC after sending a credential is reported as that refusal too,
# whose message allows for it (see macos_session_env_refused).
#
# After the check, and before the remote command, come git's credential helper exports
# (macos_session_git_env_cmd) when GH_TOKEN is sent, so the helper exists only in the shells of a
# session that has the token.
#
# On the host, macOS is expected to serve a process's environment only to its own user and root
# (through the same sysctl as its arguments; not yet observed on a Mac from a second account), so
# the values would be exposed to no one who could not already read the host files and `gh` token
# they were resolved from. In the guest they live in the environment of the session's processes,
# for as long as they run: the login zsh that sshd starts keeps them (nothing augur writes into
# the guest's shell startup files touches them), as do the agent, every shell it spawns and git's
# credential helper, which reads $GH_TOKEN when git runs it. Processes started outside the session
# do not get them.
ssh_macos_session() {
    local vm="$1" _ssh=() _ssh_dest="" _kv _sendenv=() _check _git _remote _rc=0; shift
    _check="$(macos_session_env_delivery_cmd)" || return 1
    _git="$(macos_session_git_env_cmd)" || return 1
    _remote="${_check}${_git}${!#}"
    set -- "${@:1:$#-1}"
    _macos_ssh_cmd "$vm"
    for _kv in ${_creds[@]+"${_creds[@]}"}; do _sendenv+=(-o "SendEnv=${_kv%%=*}"); done
    (
        for _kv in ${_creds[@]+"${_creds[@]}"}; do export "$_kv"; done
        exec "${_ssh[@]}" ${_sendenv[@]+"${_sendenv[@]}"} "$_ssh_dest" "$@" "$_remote"
    ) || _rc=$?
    if [[ -n "$_check" ]] && (( _rc == MACOS_SESSION_ENV_MISSING_RC )); then
        macos_session_env_refused "$vm" delivery
        return 1
    fi
    return "$_rc"
}

# The exit status of a session whose guest is missing a credential the session sent.
MACOS_SESSION_ENV_MISSING_RC=197

# The guest commands, ending in `; `, that exit MACOS_SESSION_ENV_MISSING_RC unless every variable
# the caller's `_creds` names is set and non-empty, for ssh_macos_session to run before its remote
# command. They name the variables and never print a value. Nothing when `_creds` is empty. Returns
# 1, after an error, for a name that is not a shell variable name.
#
# Accepted trade-off: the guest's sshd runs the remote command through the login shell's `-c`, so
# zsh has read the guest's startup files (~/.zshenv and what it sources) before the check runs. A
# startup file that sets one of these names, which augur's own ~/.augur-env never does, hides a
# credential the sshd dropped, and the session starts with that file's value instead. Those files
# are the guest's own, writable by the agent, and no earlier point in the session runs a command.
macos_session_env_delivery_cmd() {
    local _kv _n
    for _kv in ${_creds[@]+"${_creds[@]}"}; do
        _n="${_kv%%=*}"
        valid_env_name "$_n" || { error "Refusing to send '${_n}': not a valid variable name."; return 1; }
        printf '[ -n "${%s:-}" ] || exit %s; ' "$_n" "$MACOS_SESSION_ENV_MISSING_RC"
    done
}

# git's credential helper (git_credential_env) as guest commands, each `export NAME='value'; `, for
# ssh_macos_session to run before its remote command. Nothing when the caller's `_creds` holds no
# gh token. Every line goes through macos_env_add_export, so this returns 1, after its error, for
# an entry it refuses. The values hold only the `$GH_TOKEN` reference, never a credential.
#
# Deliberately in the session's remote command and not in ~/.augur-env: a guest shell augur did not
# start (the VM's GUI Terminal, a hand-run ssh) has no GH_TOKEN, and with the helper chain reset
# git there would lose its own helpers and get an empty password from augur's.
macos_session_git_env_cmd() {
    local _content="" _kv
    while IFS= read -r _kv; do macos_env_add_export "$_kv" || return 1; done < <(git_credential_env)
    printf '%s' "${_content//$'\n'/; }"
}

scp_to_macos() {
    local vm="$1" src="$2" dst="$3"
    local host port
    host="$(macos_ssh_host "$vm")"; port="$(macos_ssh_port "$vm")"
    [[ -n "$host" ]] || { error "Cannot resolve SSH host for '${vm}'."; exit 1; }
    [[ -n "$port" ]] || { error "Cannot resolve SSH port for '${vm}': its gvproxy reports no SSH forward port."; exit 1; }
    local key_opts=()
    if [[ -f "$MACOS_SSH_KEY" ]]; then
        key_opts=(-i "$MACOS_SSH_KEY" -o PasswordAuthentication=no -o BatchMode=yes)
    fi
    # Hermetic SSH (-F /dev/null): same rationale as ssh_macos — never forward host env
    # (LANG/LC_* or any user-configured SendEnv) into the guest over the scp transport.
    scp -F /dev/null \
        -P "$port" \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="$(vm_known_hosts_file "$vm")" \
        -o LogLevel=ERROR \
        ${key_opts[@]+"${key_opts[@]}"} \
        "$src" "${MACOS_SSH_USER}@${host}:${dst}"
}

# One-time bootstrap SSH into a freshly-built VM whose only credential is its admin password (the
# SSH key isn't installed yet): the one stored for VM $1, see macos_admin_password(). OpenSSH's own
# SSH_ASKPASS + SSH_ASKPASS_REQUIRE=force (OpenSSH >= 8.4; macOS ships 10.x) feed that password
# non-interactively — no human prompt and no third-party tool (sshpass would need a non-core
# Homebrew tap, violating the base-VM build's "no third-party tools" principle).
# SSH_ASKPASS_REQUIRE=force is the key: it makes askpass answer
# the *login password* prompt (not just key passphrases) even WITH a controlling TTY and WITHOUT
# DISPLAY, so no setsid/fake-DISPLAY dance is needed. The askpass helper answers ONLY password
# prompts; StrictHostKeyChecking=accept-new (as in ssh_macos) means the host-key question never
# reaches it. Uses the same per-VM known_hosts file as ssh_macos, so the accepted host key carries
# over to the key-auth calls that follow. Hermetic (-F /dev/null): never forward host env, per ssh_macos.
ssh_macos_bootstrap() {
    local vm="$1" host="$2"; shift 2
    [[ -n "$host" ]] || { error "Cannot resolve SSH host for '${vm}'."; exit 1; }
    local askpass password
    password="$(macos_admin_password "$vm")" || exit 1
    askpass="$(mktemp "${TMPDIR:-/tmp}/augur-askpass.XXXXXX")" \
        || { error "Failed to create SSH askpass helper."; exit 1; }
    chmod 700 "$askpass"
    # Embed the password via %q, safe regardless of its content; reply to password prompts only,
    # else exit 1.
    printf '#!/bin/bash\ncase "$1" in *[Pp]assword:*) printf "%%s\\n" %q ;; *) exit 1 ;; esac\n' \
        "$password" > "$askpass"
    # Explicit cleanup (not `trap … RETURN`): a RETURN trap is not function-local — it would
    # persist and re-fire on the caller's return, where $askpass is out of scope (fatal under
    # `set -u`), and it also wouldn't fire when `set -e` aborts on a failed ssh (leaking the file).
    # Capture the ssh status, remove the helper on every path, then propagate the status.
    local rc=0
    SSH_ASKPASS="$askpass" SSH_ASKPASS_REQUIRE=force \
    ssh -F /dev/null \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="$(vm_known_hosts_file "$vm")" \
        -o LogLevel=ERROR \
        -o ConnectTimeout=10 \
        -o PreferredAuthentications=password,keyboard-interactive \
        "${MACOS_SSH_USER}@${host}" "$@" || rc=$?
    rm -f "$askpass"
    return $rc
}

# ── Egress proxy helpers (shared by container and macOS modes) ────────────────

# Resolve the augur-proxy binary: explicit override, PATH, install dir, local build.
resolve_proxy_cli() {
    if [[ -n "$AUGUR_PROXY_BIN" ]]; then echo "$AUGUR_PROXY_BIN"; return; fi
    if command -v augur-proxy &>/dev/null; then command -v augur-proxy; return; fi
    local c
    for c in "$AUGUR_DIR/augur-proxy" \
             "$SCRIPT_DIR/augur-proxy/.build/release/augur-proxy" \
             "$SCRIPT_DIR/augur-proxy/.build/debug/augur-proxy"; do
        [[ -f "$c" && -x "$c" ]] && { echo "$c"; return; }
    done
    echo "augur-proxy"
}

# Is egress filtering active for this invocation?
egress_enabled() {
    case "$AUGUR_EGRESS" in
        0|off|false|no) return 1 ;;
        *)              return 0 ;;  # on by default (auto or explicit 1/on/true)
    esac
}

# The host proxy is PER-MODE, not just per-project. macOS VM mode binds it to 127.0.0.1
# (gvproxy's SOCKS upstream) while container mode binds it to the container's host-only
# gateway — two different addresses, so one proxy process cannot serve both. Both modes can be
# up for the same project at once; keying the pidfile/log on the role keeps them as SEPARATE
# instances. Without this they share one pidfile: the second `up` reuses the first's proxy
# (bound to the wrong address, so its egress silently fails closed), and a `down` in either
# mode kills the shared proxy out from under the other. The two instances bind the same ports
# but on different addresses (127.0.0.1 vs the gateway), so they never collide.
proxy_role() { if $MACOS_MODE; then echo macos; else echo container; fi; }
# Keyed on the FULL workspace path (slug + workspace_path_hash), never the basename slug alone —
# see workspace_path_hash's header for why every host-namespace identifier carries the hash.
proxy_pidfile() { echo "$AUGUR_PROXY_DIR/$(workspace_slug)-$(workspace_path_hash)-$(proxy_role).pid"; }
proxy_logfile() { echo "$AUGUR_PROXY_DIR/$(workspace_slug)-$(workspace_path_hash)-$(proxy_role).log"; }
# The allowlist is shared between the two MODES (identical merge either way), so it is keyed on
# the project and NOT on proxy_role — but it is still per (project PATH), not per basename. It is
# the proxy's live enforcement input (hot-reloaded on mtime change every ~2s), so a basename-only
# key let a same-basename sibling's `up` overwrite a LIVE session's approved policy: `~/work/app`
# and `~/archive/app` resolved to one file, and whichever ran last owned both projects' egress.
proxy_allowlist() { echo "$AUGUR_PROXY_DIR/$(workspace_slug)-$(workspace_path_hash).allowlist"; }

proxy_running() {
    local pf; pf="$(proxy_pidfile)"
    [[ -f "$pf" ]] || return 1
    local pid; pid="$(cat "$pf" 2>/dev/null)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# ── Stale-binary detection for the long-lived egress helpers ──────────────────
# augur-proxy and augur-gvproxy outlive the augur invocation that launched them, and `bash install`
# overwrites their binaries without stopping running instances. Each launch therefore records the
# sha256 of the binary it ran in a sidecar next to the pidfile ("<pidfile>.binsha"). A live helper
# is FRESH iff that sidecar exists, the binary augur would launch now can be hashed, and the two
# digests are equal. Anything else is NOT fresh, for one of these reasons (egress_helper_staleness):
#   changed       the binary on disk differs from the one the helper was launched from.
#   no-record     no sidecar: started by an older augur that wrote none. Not fresh by design — it
#                 cannot be shown to run the installed binary; one restart records it.
#   unreadable    the binary to compare against is missing or unreadable.
#   no-hash-tool  neither shasum nor sha256sum is on PATH.
# The last two mean freshness cannot be PROVEN, so they persist across restarts until the cause is
# fixed. What a not-fresh helper leads to depends on whether a guest can be using it:
#   • Guest running ⇒ up/claude/shell (and container setup-token) refuse to attach
#     (require_fresh_egress_helpers).
#   • Guest not running ⇒ nobody is attached, so start_proxy / start_gvproxy replace it silently.
#   • Build provisioning: start_provision_proxy replaces it, start_provision_gvproxy only warns.
# Compared by CONTENT, not mtime: resolve_proxy_cli may resolve a different path than the one
# running (PATH vs ~/.augur vs a local .build), and `cp -p`/touch/clock skew make mtimes lie both
# ways. Not by VERSION either: dev builds share one VERSION number across many different binaries.
sha256_tool_available() { command -v shasum &>/dev/null || command -v sha256sum &>/dev/null; }
file_sha256() {
    local f="$1" out=""
    [[ -n "$f" && -f "$f" && -r "$f" ]] || return 1
    if command -v shasum &>/dev/null; then out="$(shasum -a 256 "$f" 2>/dev/null)" || return 1
    elif command -v sha256sum &>/dev/null; then out="$(sha256sum "$f" 2>/dev/null)" || return 1
    else return 1; fi
    out="${out%% *}"
    [[ ${#out} -eq 64 ]] || return 1
    echo "$out"
}
binsha_file() { echo "$1.binsha"; }   # $1 = the helper's pidfile
# Record what is about to be launched. $1 = binary (bare name or path), $2 = pidfile. A failed hash
# REMOVES the sidecar rather than leaving a previous binary's digest to be compared against.
record_launched_binsha() {
    local sha side; side="$(binsha_file "$2")"
    if sha="$(file_sha256 "$(command -v "$1" 2>/dev/null)")"; then
        echo "$sha" > "$side" 2>/dev/null || true
    else
        rm -f "$side" 2>/dev/null || true
    fi
}
# Succeeds silently iff the helper launched under pidfile $2 is fresh against binary $1 (bare name,
# path, or empty when not found); otherwise prints one reason code from the list above and fails.
# Hashability is checked first, so the reason reported is the one a restart alone cannot fix.
egress_helper_staleness() {
    local path cur rec
    path="$(command -v "$1" 2>/dev/null)" || path=""
    sha256_tool_available || { echo no-hash-tool; return 1; }
    cur="$(file_sha256 "$path")" || { echo unreadable; return 1; }
    rec="$(cat "$(binsha_file "$2")" 2>/dev/null)" || { echo no-record; return 1; }
    [[ "$rec" == "$cur" ]] || { echo changed; return 1; }
}
# One-line explanation of a reason code, for error/info messages. $1 = code, $2 = the binary as
# resolved (path or name) — named so the operator knows which file to fix or compare.
egress_helper_staleness_text() {
    case "$1" in
        changed)      echo "its binary changed since it started (${2} is not the binary it was launched from)" ;;
        no-record)    echo "no record of the binary it was started from (it was started by an older augur)" ;;
        unreadable)   echo "cannot hash its binary: ${2} is missing or unreadable" ;;
        no-hash-tool) echo "cannot hash its binary: neither shasum nor sha256sum is on PATH" ;;
        *)            echo "not verified as the installed binary" ;;
    esac
}
# `status` text for a live helper: "running", plus "(stale: <why>)" when it is not fresh.
# $1 = binary, $2 = pidfile.
egress_helper_status() {
    local why
    if why="$(egress_helper_staleness "$1" "$2")"; then echo "${GREEN}running${RESET}"; return 0; fi
    case "$why" in
        changed)   why="binary changed" ;;
        no-record) why="no record" ;;
        *)         why="cannot hash" ;;
    esac
    echo "${GREEN}running${RESET} ${YELLOW}(stale: ${why})${RESET}"
}
# SIGTERM a pid and wait for it to exit (its listen ports / socket must be free before the same
# ones are rebound); SIGKILL after ~3s, then wait ~1s more.
terminate_and_wait() {
    local pid="$1" t=30
    [[ -n "$pid" ]] || return 0
    kill "$pid" 2>/dev/null || return 0
    while ((t-- > 0)); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.1; done
    kill -9 "$pid" 2>/dev/null || true
    t=10
    while ((t-- > 0)); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.1; done
    return 0
}
# Stop a live helper that is not fresh so the caller falls through to its normal launch. Only for a
# helper no running guest is attached to (see the header above). $1 = pidfile, $2 = label for
# messages, $3 = reason code, $4 = binary as resolved. Fails closed (exit 1) if the old process
# survives SIGKILL: it may still hold the address, ports or socket, and a second instance must never
# be launched next to it.
replace_stale_helper() {
    local pidfile="$1" label="$2" pid; pid="$(cat "$pidfile" 2>/dev/null)" || pid=""
    info "Replacing the ${label} (pid ${pid}): $(egress_helper_staleness_text "$3" "$4")."
    terminate_and_wait "$pid"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        error "The ${label} (pid ${pid}) did not exit even after SIGKILL; refusing to start a second one next to it."
        error "Wait for it to exit (check with ${BOLD}ps -p ${pid}${RESET}), then retry. If it never exits, a reboot clears it."
        exit 1
    fi
    rm -f "$pidfile" "$(binsha_file "$pidfile")" 2>/dev/null || true
}
# Refuse (exit 1) to attach to a RUNNING guest while one of its live egress helpers is not fresh
# (see the header above file_sha256). ONE gate for both modes: container mode checks the project's
# augur-proxy; macOS VM mode checks the project's augur-proxy and augur-gvproxy.
#   • Refuse, not replace: swapping a helper under a live guest is never transparent — gvproxy's
#     socket IS the VM's NIC, and a replaced augur-proxy drops the guest's in-flight connections —
#     so it takes an explicit `down && up`, which relaunches the helpers from the installed binaries
#     and re-runs the boot self-test. Both modes behave the same way.
#   • Not conditioned on egress_enabled: a live helper for this project is what the guest uses,
#     whatever this invocation's --no-egress says.
#   • A guest that is NOT running has nobody attached, so this lets the command through and
#     start_proxy / start_gvproxy replace the stale helper on the way up.
#   • Placement: first thing in cmd_up/cmd_claude/cmd_shell/cmd_setup_token and the _macos peers of
#     the first three (cmd_setup_token_macos boots its own throwaway VM and helpers, never attaching
#     to a running guest, and start_proxy / start_gvproxy replace a stale one there), right after
#     require_engine (+ require_engine_version) / require_vz (the guest-running check
#     needs the engine / VM CLI) — before the running-vs-up branch (ensure_session_container in
#     container mode's claude/shell), because claude/shell/setup-token on a running guest never
#     reach `up`, and before `up`'s running-guest reconcile. The dispatch tail next to
#     require_safe_workspace would be too early: it runs before require_vz. When claude/shell/
#     setup-token fall through to `up`, the second call only re-hashes.
#   • Cheap when fresh: a liveness check and one sha256 per live helper; the guest is queried only
#     once a helper turns out not fresh.
#   • A running macOS VM is refused through refuse_running_macos_vm, so its ~/.augur-env is
#     rewritten before the exit, even through a gvproxy that is not verified (see
#     refuse_running_macos_vm for why that is acceptable).
# Deliberately NOT called from down/destroy/status/list: they are the way out of this refusal.
# Deliberately no override: egress enforcement is augur's core promise, so there is no flag or env
# var to attach through a helper that cannot be shown to run the installed binary.
require_fresh_egress_helpers() {
    local lines="" why bin pf cannot_hash=false guest remedy kept l vm=""
    if proxy_running; then
        bin="$(resolve_proxy_cli)"; pf="$(proxy_pidfile)"
        if ! why="$(egress_helper_staleness "$bin" "$pf")"; then
            lines+="augur-proxy (pid $(cat "$pf" 2>/dev/null)): $(egress_helper_staleness_text "$why" "$(command -v "$bin" 2>/dev/null || echo "$bin")")"$'\n'
            [[ "$why" == unreadable || "$why" == no-hash-tool ]] && cannot_hash=true
        fi
    fi
    if $MACOS_MODE && gvproxy_running; then
        bin="$(resolve_gvproxy)"; pf="$(gvproxy_pidfile)"
        if ! why="$(egress_helper_staleness "$bin" "$pf")"; then
            lines+="augur-gvproxy (pid $(cat "$pf" 2>/dev/null)): $(egress_helper_staleness_text "$why" "${bin:-augur-gvproxy}")"$'\n'
            [[ "$why" == unreadable || "$why" == no-hash-tool ]] && cannot_hash=true
        fi
    fi
    [[ -n "$lines" ]] || return 0
    if $MACOS_MODE; then
        vm="$(macos_project_vm)"; guest="VM '${vm}'"
        macos_vm_running "$vm" || return 0
        remedy="augur down --macos && augur up --macos"; kept="the VM clone"
    else
        guest="container '${CONTAINER_NAME}'"
        container_running || return 0
        remedy="augur down && augur up"; kept="the container's writable layer"
    fi
    local _out=("Refusing to attach to the running ${guest}: an egress helper serving it is not verified"
        "to run the installed binary.")
    while IFS= read -r l; do [[ -n "$l" ]] && _out+=("  • ${l}"); done <<< "$lines"
    if $cannot_hash; then
        _out+=("Fix that first: until augur can hash the installed binary it cannot verify any running"
            "helper, and this refusal repeats after every restart.")
    fi
    _out+=("Restart the guest and its egress helpers from the installed binaries: ${BOLD}${remedy}${RESET}"
        "  \`down\` ends every running $(agent_cli_name)/shell session of this project; the workspace and"
        "  ${kept} are kept.")
    if $MACOS_MODE; then
        refuse_running_macos_vm "$vm" "${_out[@]}"
    else
        for l in "${_out[@]}"; do error "$l"; done
        exit 1
    fi
}

# Merge the managed baseline + user global + project conf into a host-side runtime
# allowlist the proxy reads. Deliberately written under ~/.augur (NOT the project tree)
# so the guest — which can write the mounted ./.augur/allowlist.conf — cannot widen its own
# policy mid-session.
#
# CONTENT-IDEMPOTENT: builds into a same-directory temp file and `mv`s only when the POLICY
# actually differs (the generated-at header is excluded from that comparison, or the timestamp
# alone would make every call a "change"). Two reasons this matters:
#   • The file's mtime is a SIGNAL, not just metadata. augur-proxy hot-reloads on mtime change
#     (main.swift polls every ~2s) and warn_if_macos_egress_pinned uses "allowlist newer than the
#     gvproxy pidfile" to detect a policy gvproxy snapshotted before it changed. Rewriting the
#     header on every `up` would make both fire unconditionally — a pointless reload, and a
#     warning that cries wolf forever.
#   • `mv` is atomic (rename(2), same directory). Truncating in place would let a poller read a
#     PREFIX of the file. That would not fall open — a prefix is only ever NARROWER — but
#     the rename removes the window entirely.
# The temp file's 0600 mode keeps this file owner-only regardless of umask. Only augur-proxy and
# gvproxy read it, both as this same user, so nothing loses access.
write_merged_allowlist() {
    mkdir -p "$AUGUR_PROXY_DIR"
    local out snap tmp cur_body new_body
    out="$(proxy_allowlist)"
    snap="$(project_conf_hash_file).domains"   # the domains SNAPSHOTTED at approval time (host-side)
    # Same directory as $out so the `mv` below is a rename, not a copy across filesystems.
    tmp="$(mktemp "${out}.XXXXXX")" \
        || { error "Could not stage the merged egress allowlist in ${AUGUR_PROXY_DIR}. Refusing to continue (fail closed)."; exit 1; }
    {
        echo "# generated by augur at $(date) — do not edit (regenerated on 'augur up')"
        [[ -f "$AUGUR_BASELINE_CONF" ]] && { echo "# --- baseline: $AUGUR_BASELINE_CONF"; cat "$AUGUR_BASELINE_CONF"; }
        [[ -f "$AUGUR_GLOBAL_CONF" ]]   && { echo "# --- global: $AUGUR_GLOBAL_CONF"; cat "$AUGUR_GLOBAL_CONF"; }
        # The project conf is GUEST-WRITABLE. Emit the domains that check_project_conf_approved
        # SNAPSHOTTED (host-side, guest-inaccessible) at approval time — NOT a fresh read of the live
        # mounted file. Re-reading the live file here would reopen a TOCTOU: a guest could mutate
        # ./.augur/allowlist.conf between approval and this merge (e.g. during another engine mode's
        # slow VM clone/boot on the same repo) and get UNAPPROVED domains honored.
        # The snapshot is written on every approval path; if it is missing, fail closed by omitting
        # the project block (a more restrictive allowlist) rather than trusting the live file.
        if [[ -f "$AUGUR_PROJECT_CONF" ]]; then
            if [[ -f "$snap" ]]; then
                echo "# --- project: $AUGUR_PROJECT_CONF (approved snapshot)"; cat "$snap"
            else
                error "No approved snapshot for ./.augur/allowlist.conf — its domains are NOT being honored (run 'augur up' to approve). Failing closed."
            fi
        fi
    } > "$tmp"
    # Compare POLICY, not bytes: drop the generated-at header from both sides. `|| true` because
    # grep -v exits 1 when it emits nothing (an empty policy is a legitimate deny-all).
    cur_body="$(grep -v '^# generated by augur at ' "$out" 2>/dev/null || true)"
    new_body="$(grep -v '^# generated by augur at ' "$tmp" || true)"
    if [[ -f "$out" && "$cur_body" == "$new_body" ]]; then
        rm -f "$tmp"                 # unchanged: leave the live file (and its mtime) alone
    else
        mv -f "$tmp" "$out"          # atomic swap; a poller never sees a partial policy
    fi
    echo "$out"
}

# Validate a single ./.augur/allowlist.conf line against the proxy's domain grammar: an optional
# '*.' / '.' prefix plus a strict LDH hostname, and NO byte outside [A-Za-z0-9.*-]. The
# project conf is guest-writable, so this is the chokepoint that (a) stops a hostile conf
# from injecting terminal-escape bytes into the approval UI / `status` and
# (b) keeps the displayed list identical to what the proxy will actually honor. Mirrors
# augur-proxy's isValidHostname (Hostname.swift). Returns 0 iff the line is a valid pattern.
conf_line_valid() {
    local line="$1" host
    [[ -n "$line" ]] || return 1
    # Reject the WHOLE line if it carries any byte outside the hostname-pattern charset
    # (incl. ESC / control bytes used for approval-UI spoofing, and embedded whitespace).
    case "$line" in *[!A-Za-z0-9.*-]*) return 1 ;; esac
    host="$line"
    case "$host" in
        '*.'*) host="${host#'*.'}" ;;   # subdomains-only marker
        '.'*)  host="${host#.}" ;;      # apex + subdomains marker
    esac
    (( ${#host} >= 1 && ${#host} <= 253 )) || return 1
    case "$host" in *'*'*) return 1 ;; esac   # '*' is only valid as the leading '*.'
    local re='^[A-Za-z0-9-]{1,63}(\.[A-Za-z0-9-]{1,63})*\.?$'
    [[ "$host" =~ $re ]]
}

# Effective domain patterns a project ./.augur/allowlist.conf contributes: comments stripped,
# whitespace trimmed, blanks dropped, and — crucially — every line validated by
# conf_line_valid so only clean LDH patterns are ever emitted (for display AND for the
# merged allowlist). Anything that is not a valid hostname pattern is dropped, not rendered.
project_conf_domains() {
    local f="${1:-$AUGUR_PROJECT_CONF}"             # default live conf; callers may pass a stable copy
    [[ -f "$f" ]] || return 0
    local line
    while IFS= read -r line; do
        line="${line%%#*}"                          # strip comment
        line="${line#"${line%%[![:space:]]*}"}"     # ltrim
        line="${line%"${line##*[![:space:]]}"}"     # rtrim
        [[ -n "$line" ]] || continue
        conf_line_valid "$line" && printf '%s\n' "$line"
    done < "$f"
    return 0   # never inherit the last conf_line_valid result: a trailing invalid line would
               # otherwise make this return 1 and abort callers that run it under `set -e`.
}

# Count of ./.augur/allowlist.conf non-comment, non-blank lines that conf_line_valid REJECTED (i.e.
# were dropped as junk / obfuscation). Surfaced at approval so a conf hiding escape bytes
# or garbage becomes a visible red flag instead of a silent omission.
project_conf_invalid_count() {
    local f="${1:-$AUGUR_PROJECT_CONF}"             # default live conf; callers may pass a stable copy
    [[ -f "$f" ]] || { echo 0; return; }
    local line total=0 valid=0
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" ]] || continue
        total=$((total + 1))
        conf_line_valid "$line" && valid=$((valid + 1))
    done < "$f"
    echo $((total - valid))
}

# Write an approved-domain snapshot ($1, the output of project_conf_domains) to file $2,
# preserving "no valid domains => empty file" so write_merged_allowlist emits the project block
# exactly as before (a bare `printf '%s\n'` on empty input would inject a spurious blank line).
write_project_snapshot() {
    if [[ -n "$1" ]]; then printf '%s\n' "$1" > "$2"; else : > "$2"; fi
}

# Read KEY from ./.augur/resources.conf ("KEY=value" lines, '#' comments, blanks
# ignored). No TOFU gate (unlike the allowlist) — see AUGUR_PROJECT_RESOURCES_CONF's
# definition for why a guest-writable resource knob isn't a containment concern.
# Echoes the value (possibly empty) and returns 0 on a match, 1 if KEY is absent.
project_resource_value() {
    local key="$1"
    [[ -f "$AUGUR_PROJECT_RESOURCES_CONF" ]] || return 1
    local line k v
    while IFS='=' read -r k v; do
        k="${k%%#*}"
        k="${k#"${k%%[![:space:]]*}"}"; k="${k%"${k##*[![:space:]]}"}"
        [[ "$k" == "$key" ]] || continue
        v="${v%%#*}"
        v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
        printf '%s' "$v"
        return 0
    done < "$AUGUR_PROJECT_RESOURCES_CONF"
    return 1
}

# Clamp a guest-writable INTEGER resource value to [min,max]. On anything malformed or out of
# range, warn (to STDERR — these resolvers' stdout is captured by $(...)) and return the default.
# Guards against a hostile ./.augur/resources.conf setting an absurd CPU/MEMORY that DoSes the
# host on the next `augur up`. Only the file-derived value is clamped; an explicit AUGUR_* env
# override is operator intent and stays unclamped.
clamp_resource_int() {
    local v="$1" min="$2" max="$3" def="$4" label="$5"
    if [[ "$v" =~ ^[0-9]+$ ]] && (( ${#v} <= 15 )) && (( v >= min && v <= max )); then
        echo "$v"; return
    fi
    warn "Ignoring out-of-range ${label}='$(sanitize_guest_text "$v")' in .augur/resources.conf (allowed ${min}-${max}); using ${def}." >&2
    echo "$def"
}

# Same idea for the Apple-Container --memory SIZE string (<int>[kKmMgG], optional unit = bytes).
# Caps total bytes at 128 GiB so a guest-supplied MEMORY=9999g can't over-commit the host.
clamp_container_memory_value() {
    local v="$1" num unit mult max=$((128 * 1024 * 1024 * 1024))
    if [[ "$v" =~ ^([0-9]{1,15})([kKmMgG]?)$ ]]; then
        num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
        case "$unit" in
            k|K) mult=1024 ;;
            m|M) mult=$((1024 * 1024)) ;;
            g|G) mult=$((1024 * 1024 * 1024)) ;;
            *)   mult=1 ;;
        esac
        # Compare BEFORE multiplying (num <= max/mult) so num*mult is never computed past the
        # ceiling — a post-multiply `bytes <= max` check 64-bit-WRAPS for a crafted value like
        # 17179869185g (2^34+1 GiB -> 2^64+2^30 -> 2^30 bytes) and would slip through. The regex
        # guarantees num >= 1, so anything within the ceiling is a valid positive size.
        if (( num <= max / mult )); then echo "$v"; return; fi
    fi
    warn "Ignoring out-of-range/invalid MEMORY='$(sanitize_guest_text "$v")' in .augur/resources.conf (max 128g); using 4g." >&2
    echo "4g"
}

# Effective Apple-Container memory limit. Precedence: an explicit AUGUR_CONTAINER_MEMORY
# env var (checked with `+x` so an operator override always wins, even set to something
# unusual) > ./.augur/resources.conf's MEMORY= (git-tracked, so it travels with the
# project across machines) > the built-in default. This is what makes the project file
# actually solve the "works on machine A, forgotten on machine B" problem env vars have.
resolve_container_memory() {
    if [[ -n "${AUGUR_CONTAINER_MEMORY+x}" ]]; then
        echo "$AUGUR_CONTAINER_MEMORY"
        return
    fi
    local v
    v="$(project_resource_value MEMORY)" && [[ -n "$v" ]] && { clamp_container_memory_value "$v"; return; }
    echo "4g"
}

# Effective macOS VM vCPU count / memory (MB). Same precedence shape as
# resolve_container_memory: an explicit AUGUR_MACOS_VM_CPU / AUGUR_MACOS_VM_MEMORY_MB env var
# (checked with `+x` so an operator override always wins) > ./.augur/resources.conf's
# MACOS_CPU= / MACOS_MEMORY_MB= (git-tracked, travels with the project) > the built-in default —
# which matches the value every base/project VM has always booted with (augur-vm/Sources/
# augur-vm/Installer.swift's Clamp defaults, applied explicitly in cmd_build_macos), so leaving
# both unset changes nothing for existing users. Unlike container mode, this is APPLIED (not just
# read) on every `augur up --macos` — see cmd_up_macos — because a VM clone's cpuCount/memorySize
# are persisted in its own config.json (augur-vm's `clone` copies it byte-for-byte from the base
# VM) rather than re-specified fresh at boot like a container's `--memory` flag, so without an
# explicit resize call here a project VM would keep whatever the base VM happened to have forever.
resolve_macos_vm_cpu() {
    if [[ -n "${AUGUR_MACOS_VM_CPU+x}" ]]; then
        echo "$AUGUR_MACOS_VM_CPU"
        return
    fi
    local v
    v="$(project_resource_value MACOS_CPU)" && [[ -n "$v" ]] && { clamp_resource_int "$v" 1 64 4 MACOS_CPU; return; }
    echo "4"
}

resolve_macos_vm_memory_mb() {
    if [[ -n "${AUGUR_MACOS_VM_MEMORY_MB+x}" ]]; then
        echo "$AUGUR_MACOS_VM_MEMORY_MB"
        return
    fi
    local v
    v="$(project_resource_value MACOS_MEMORY_MB)" && [[ -n "$v" ]] && { clamp_resource_int "$v" 512 262144 8192 MACOS_MEMORY_MB; return; }
    echo "8192"
}

# A short, stable hex digest of the FULL workspace path. Two different directories that
# share a basename also share workspace_slug; this distinguishes them so security-sensitive
# per-project host state — the .augur/allowlist.conf approval fingerprint and the container history dir —
# is never shared between an unrelated (possibly hostile) same-named project and a trusted
# one.
#
# THE RULE: guest-visible names stay slug-based; HOST-NAMESPACE identifiers get the hash.
# The host has ONE namespace per resource, shared by every project on the machine, so a
# same-basename pair collides there with certainty — which is why the container name, the VM
# name, the TOFU approval file, the carry-over/history/agents dirs, every egress host-state file
# (merged allowlist, proxy + gvproxy pidfiles, logs, vfkit socket), the egress network name AND
# the port/subnet offset all carry it. A guest-visible name lives in a PER-GUEST namespace where
# a collision is harmless and unobservable, so make_workspace_mount (/workspace-<slug>) and
# MACOS_SHARE (~/workspace-<slug>) deliberately stay slug-based and readable.
workspace_path_hash() {
    [[ -n "$TARGET_HASH" ]] && { echo "$TARGET_HASH"; return; }
    local h
    if command -v sha256sum &>/dev/null; then
        h="$(printf '%s' "$WORKSPACE_DIR" | sha256sum)"
    else
        h="$(printf '%s' "$WORKSPACE_DIR" | shasum -a 256)"
    fi
    echo "${h:0:12}"
}

# Refuse to share a workspace that CONTAINS augur's own control plane.
#
# $WORKSPACE_DIR is mounted READ-WRITE into the guest — `-v "${WORKSPACE_DIR}:…"` in
# container mode, `--dir="${MACOS_SHARE}:${WORKSPACE_DIR}"` in macOS mode — so anything
# under it is guest-writable. Accepted trade-off for a project checkout: the guest can attack the
# repo you gave it. It is NOT acceptable for $HOME or $AUGUR_DIR, because `~/.augur` holds the
# host-executed binaries `install` puts FIRST on the host's PATH (install:150) — augur,
# augur-proxy, augur-gvproxy, augur-vm — which resolve_proxy_cli/resolve_gvproxy then run as
# the host user on every `up`. A guest that can write there owns the host account, and it can
# also edit the merged allowlist `augur-proxy` hot-reloads on mtime change every ~2s, which
# lets the guest widen its own allowlist, the very thing writing it host-side prevents.
#
# Reads $WORKSPACE_DIR / $HOME / $AUGUR_DIR as globals at call time so a test can set them.
# Compares PHYSICAL paths: $WORKSPACE_DIR is `$(pwd)` — the LOGICAL path — so `cd ~/link`
# where link → $HOME would otherwise pass a string that isn't $HOME while the engine happily
# shares $HOME. The physical forms are local to this function on purpose: $WORKSPACE_DIR
# itself must NOT change, because workspace_path_hash feeds container/VM names, the TOFU
# approval key and every per-project state dir — re-basing it on `pwd -P` would silently
# rename all of that for anyone whose path crosses a symlink.
require_safe_workspace() {
    local ws home augur_dir ad_parent
    ws="$(cd "$WORKSPACE_DIR" 2>/dev/null && pwd -P)" || ws="$WORKSPACE_DIR"
    [[ -n "$ws" ]] || ws="$WORKSPACE_DIR"
    home="$(cd "$HOME" 2>/dev/null && pwd -P)"        || home="$HOME"
    [[ -n "$home" ]] || home="$HOME"
    # $AUGUR_DIR need not exist yet (first run), so resolve its PARENT and re-append the leaf
    # rather than cd'ing into it. An unresolvable parent falls back to the literal path — a
    # guard that cannot resolve a path must still compare something, never "".
    ad_parent="$(cd "$(dirname "$AUGUR_DIR")" 2>/dev/null && pwd -P)" || ad_parent=""
    if [[ -n "$ad_parent" ]]; then
        augur_dir="${ad_parent%/}/$(basename "$AUGUR_DIR")"
    else
        augur_dir="$AUGUR_DIR"
    fi

    local why=""
    # The filesystem root needs its own branch: "$ws"/* is //* when ws=/ and matches nothing.
    if [[ "$ws" == "/" ]]; then
        why="it is the filesystem root"
    elif [[ "$ws" == "$home" ]]; then
        why="it is your home directory"
    elif [[ "$home" == "$ws"/* ]]; then
        why="it contains your home directory"
    elif [[ "$ws" == "$augur_dir" || "$augur_dir" == "$ws"/* || "$ws" == "$augur_dir"/* ]]; then
        why="it is, contains, or lives inside augur's own directory ($augur_dir)"
    else
        return 0
    fi

    error "Refusing to share ${BOLD}${ws}${RESET} with the guest: ${why}."
    error "The workspace is mounted ${BOLD}read-write${RESET}, so the guest could rewrite augur's"
    error "own binaries in ${augur_dir} — which the host then executes as you — and the egress"
    error "allowlist that confines it."
    error ""
    error "Instead:"
    error "  • ${BOLD}cd${RESET} into a subdirectory holding just the project you want the agent to see, or"
    error "  • run ${BOLD}augur destroy${RESET} here first if an older augur already made a container/VM"
    error "    from this directory, then re-run from that subdirectory."
    exit 1
}

# Host-side record of approved project-conf fingerprints (TOFU). Under ~/.augur — NEVER the
# project tree or a mounted share — so the guest cannot forge its own approval. Keyed on the
# FULL workspace path (slug + path hash), so a hostile repo that shares a basename with a
# trusted project cannot inherit that project's egress approval.
project_conf_hash_file() {
    mkdir -p "$AUGUR_DIR/project-hashes"
    echo "$AUGUR_DIR/project-hashes/$(workspace_slug)-$(workspace_path_hash)"
}

project_conf_hash() {
    if command -v sha256sum &>/dev/null; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

# Trust-on-first-use: a project's ./.augur/allowlist.conf widens the egress allowlist, so
# treat it as untrusted input (a hostile repo, or an agent that wrote it). Require the
# operator to approve it on first sight and again whenever it changes — the same TOFU
# model as the SSH host keys above. Approved fingerprints live host-side under
# ~/.augur/project-hashes, so a guest that edits the mounted ./.augur/allowlist.conf cannot get
# the change honored without a fresh host-side approval. Non-interactive runs fail
# closed unless AUGUR_ACCEPT_PROJECT_CONF=1 (kept for CI / disposable flows). Only the
# egress-enabled paths call this — with filtering off, ./.augur/allowlist.conf has no effect.
check_project_conf_approved() {
    [[ -f "$AUGUR_PROJECT_CONF" ]] || return 0

    local hash_file snap_file stable cur recorded
    hash_file="$(project_conf_hash_file)"
    snap_file="${hash_file}.domains"

    # TOCTOU fix: copy the GUEST-WRITABLE conf to a host-side file ONCE, then derive the
    # fingerprint, the approval display, AND the stored domain snapshot ALL from that copy. The
    # honored policy is later rebuilt by write_merged_allowlist from $snap_file — NOT a fresh read
    # of the live mounted file — so a guest that races ./.augur/allowlist.conf between this approval
    # and the merge (e.g. during another engine mode's slow VM clone/boot on the same repo) cannot
    # get unapproved domains honored. sha256 of the faithful copy == sha256 of the original, so
    # existing recorded approvals still match (no re-prompt on upgrade).
    stable="$(mktemp "${TMPDIR:-/tmp}/augur-projconf.XXXXXX")" \
        || { error "Could not stage ./.augur/allowlist.conf. Refusing to continue (fail closed)."; exit 1; }
    cp "$AUGUR_PROJECT_CONF" "$stable" 2>/dev/null \
        || { rm -f "$stable"; error "Could not read ./.augur/allowlist.conf. Refusing to continue (fail closed)."; exit 1; }

    cur="$(project_conf_hash "$stable")"
    # Fail closed if the conf could not be fingerprinted (no sha256 tool): a security gate must
    # never silently approve. project_conf_hash runs in a $(...) subshell, so an `exit` there
    # wouldn't abort us — guard here in the caller instead.
    if [[ -z "$cur" ]]; then
        rm -f "$stable"
        error "Could not fingerprint ./.augur/allowlist.conf (no sha256sum/shasum?). Refusing to continue (fail closed)."
        exit 1
    fi
    # Derive everything from the stable copy up front — the sanitized domain snapshot and the
    # dropped-line count — then delete the copy immediately. The TOCTOU capture is complete here,
    # and nothing below reads the file, so no later exit path (including Ctrl-C at the approval
    # prompt) can leak it. Explicit rm, not a `trap` — see ssh_macos_bootstrap for the rationale.
    local snap_content dropped
    snap_content="$(project_conf_domains "$stable")"
    dropped="$(project_conf_invalid_count "$stable")"
    rm -f "$stable"

    recorded=""
    [[ -f "$hash_file" ]] && recorded="$(cat "$hash_file" 2>/dev/null || true)"

    if [[ "$cur" == "$recorded" ]]; then
        # Already approved: (re)write the snapshot from the SAME bytes we just hashed — healing an
        # approval made before snapshots existed, or a snapshot removed out from under us.
        write_project_snapshot "$snap_content" "$snap_file"
        return 0
    fi

    warn "This project's ${BOLD}.augur/allowlist.conf${RESET} widens the egress allowlist with:"
    local d had=0
    while IFS= read -r d; do
        # printf %s (NOT echo -e) on the guest-derived domain; conf_line_valid already
        # guarantees a clean LDH pattern, so the approval list cannot be spoofed by
        # embedded terminal-escape bytes.
        [[ -n "$d" ]] || continue
        printf '    %b+ %s%b\n' "$YELLOW" "$d" "$RESET"; had=1
    done <<< "$snap_content"
    [[ "$had" == 1 ]] || printf '    %s\n' "(no valid domain patterns)"
    [[ "${dropped:-0}" -gt 0 ]] && \
        warn "Ignored ${dropped} line(s) that are not valid domain patterns (possible obfuscation — inspect ./.augur/allowlist.conf)."

    # Persist BOTH the hash and the approved-domain snapshot from the stable copy, so the honored
    # policy is byte-identical to what was shown here.
    if [[ "${AUGUR_ACCEPT_PROJECT_CONF:-}" == "1" ]]; then
        write_project_snapshot "$snap_content" "$snap_file"
        echo "$cur" > "$hash_file"
        info "Accepted via AUGUR_ACCEPT_PROJECT_CONF=1."
        return 0
    fi

    if [[ -t 0 && -t 1 ]]; then
        local yn=""
        read -rp "$(echo -e "${CYAN}[augur]${RESET} Accept these domains for this project? [y/N] ")" yn || true
        if [[ "$yn" == [yY] ]]; then
            write_project_snapshot "$snap_content" "$snap_file"
            echo "$cur" > "$hash_file"
            success "Approved — won't ask again until .augur/allowlist.conf changes."
            return 0
        fi
        error "Declined. Edit ./.augur/allowlist.conf or approve it to continue."
        exit 1
    fi

    error "Project ./.augur/allowlist.conf is unapproved and augur is non-interactive."
    error "Re-run in a terminal to review it, or set AUGUR_ACCEPT_PROJECT_CONF=1 to accept."
    exit 1
}

require_proxy_bin() {
    local bin; bin="$(resolve_proxy_cli)"
    if ! command -v "$bin" &>/dev/null && [[ ! -x "$bin" ]]; then
        error "Egress filtering is enabled but augur-proxy was not found."
        error "Build it: ${BOLD}cd augur-proxy && swift build -c release${RESET}  (or run: bash install)"
        exit 1
    fi
    echo "$bin"
}

# Start the host-side proxy for this project (idempotent). $1 = listen address.
start_proxy() {
    local listen="$1"
    local bin allowlist pidfile logfile
    bin="$(require_proxy_bin)"
    allowlist="$(write_merged_allowlist)"
    pidfile="$(proxy_pidfile)"
    logfile="$(proxy_logfile)"

    # Reuse a live proxy only if it is fresh (see the header above file_sha256); otherwise stop it
    # and launch below. A running guest never gets here with a stale one — require_fresh_egress_helpers
    # refused before `up` — so the proxy replaced here is one nobody is attached to.
    if proxy_running; then
        local why
        if why="$(egress_helper_staleness "$bin" "$pidfile")"; then
            info "Egress proxy already running (pid $(cat "$pidfile"))."
            return 0
        fi
        replace_stale_helper "$pidfile" "egress proxy" "$why" "$(command -v "$bin" 2>/dev/null || echo "$bin")"
    fi
    mkdir -p "$AUGUR_PROXY_DIR"
    info "Starting egress proxy (allowlist: ${BOLD}${allowlist}${RESET})..."
    record_launched_binsha "$bin" "$pidfile"
    "$bin" --allowlist "$allowlist" \
           --listen "$listen" \
           --http-port "$AUGUR_PROXY_HTTP_PORT" \
           --socks-port "$AUGUR_PROXY_SOCKS_PORT" \
           --log "$logfile" \
           --pidfile "$pidfile" &>/dev/null &
    disown
    # Give it a moment to bind / fail closed.
    local tries=20
    while ((tries-- > 0)); do
        proxy_running && return 0
        sleep 0.1
    done
    error "Egress proxy failed to start. See ${logfile}."
    exit 1
}

stop_proxy() {
    local pidfile; pidfile="$(proxy_pidfile)"
    if proxy_running; then
        info "Stopping egress proxy..."
        kill "$(cat "$pidfile")" 2>/dev/null || true
    fi
    rm -f "$pidfile" "$(binsha_file "$pidfile")" 2>/dev/null || true
    # Migration: reap a proxy left running under an OLDER pidfile name, in the two generations
    # this file has had. Both are invisible to the current proxy_running above, so without this
    # they survive every `down` and the next same-address `up` collides with them:
    #   • "<slug>.pid"        — before the per-role split (proxy_role).
    #   • "<slug>-<role>.pid" — before the path-hash keying. NOTE: on a same-basename pair
    #     this name was SHARED, so whichever project runs `down` first reaps it. That is
    #     correct — the process it points at is serving a basename, not a project, and it is
    #     exactly the shared instance the path-hash keying exists to prevent.
    local legacy
    for legacy in "$AUGUR_PROXY_DIR/$(workspace_slug).pid" \
                  "$AUGUR_PROXY_DIR/$(workspace_slug)-$(proxy_role).pid"; do
        if [[ -f "$legacy" ]]; then
            kill "$(cat "$legacy" 2>/dev/null)" 2>/dev/null || true
            rm -f "$legacy" 2>/dev/null || true
        fi
    done
}

# ── Container egress topology (no host sudo) ──────────────────────────────────
# One goal — the agent's ONLY way out is augur-proxy's allowlist. Apple Container's
# --internal network is "host-only": the guest can reach the HOST (but not the internet).
# augur-proxy runs ON THE HOST (the same native binary macOS VM mode uses), bound to the
# host-only gateway, and the agent's HTTP_PROXY points at it.
#   TRADE-OFF: host-only also lets the agent reach other host services bound to 0.0.0.0.
#   Closing that needs host pf rules (sudo), which augur deliberately avoids, so it's
#   documented, not enforced.

# Keyed on the FULL workspace path, like the container name it is wired to. ensure_egress_network
# checks existence BY NAME only, so a basename-keyed name would make project B's `up` silently
# ATTACH to project A's live network — same subnet, same gateway, same host-side proxy port. The
# name must be keyed together with _augur_port_offset: an install still holding a network under
# the old basename-keyed name would otherwise find it by name and keep its old subnet while the
# path-keyed offset expects a different one, i.e. a gateway the proxy never binds.
egress_network_name() { echo "augur-$(workspace_slug)-$(workspace_path_hash)-net"; }
# Pre-hash name, kept ONLY so the teardown path can still reap a network an older augur created
# for this project. Never used to create or look up a network.
legacy_egress_network_name() { echo "augur-$(workspace_slug)-net"; }

# The agent's --internal "host-only" network (host reachable, internet severed). Sets
# EGRESS_NETWORK_CREATED when this run created it (see restart_egress_network_helper).
EGRESS_NETWORK_CREATED=false
ensure_egress_network() {
    local net; net="$(egress_network_name)"
    if ! eng network inspect "$net" &>/dev/null; then
        info "Creating internal egress network '${net}' (${AUGUR_INTERNAL_SUBNET})..."
        local err
        if ! err="$(eng network create --internal --subnet "$AUGUR_INTERNAL_SUBNET" "$net" 2>&1)"; then
            error "Failed to create egress network '${net}': ${err}"
            # The subnet is derived per-project, but a hash collision (or a leftover
            # network from another project) can still overlap. Override with a free one:
            error "Retry with a different subnet, e.g. ${BOLD}AUGUR_INTERNAL_SUBNET=172.31.42.0/28 augur up${RESET}"
            exit 1
        fi
        EGRESS_NETWORK_CREATED=true
    fi
}

# The address the agent points HTTP_PROXY at: the host-only network's gateway = the host
# where augur-proxy listens.
egress_proxy_url() {
    echo "http://$(container_egress_gateway):${AUGUR_PROXY_HTTP_PORT}"
}

# Apple host-only gateway: the IP of the host's vmnet interface for this network, which the
# guest reaches the host-side proxy through, and which the host proxy binds. Confirmed on
# macOS 26: `container network inspect` reports it as .status.ipv4Gateway, and it equals the
# first usable address of the subnet (network+1). NOTE: that host interface only comes up
# once a container ATTACHES to the network — so the proxy must be bound AFTER `eng run`
# (see start_egress_proxy), not before. Prefer the inspected value, fall back to computed,
# and allow an explicit override.
container_egress_gateway() {
    [[ -n "${AUGUR_CONTAINER_GATEWAY:-}" ]] && { echo "$AUGUR_CONTAINER_GATEWAY"; return; }
    local gw
    # Match the ipv4Gateway field (any "*gateway*" key, case-insensitive) and pull its IP.
    # `|| true`: a no-match grep trips pipefail, which would abort this plain assignment under
    # set -e — fall through to the computed default instead.
    gw="$(container network inspect "$(egress_network_name)" 2>/dev/null \
          | grep -iE 'gateway' | grep -oE '[0-9]+(\.[0-9]+){3}' | head -1 || true)"
    [[ -n "$gw" ]] && { echo "$gw"; return; }
    echo "172.31.${_augur_subnet_third}.$(( _augur_subnet_fourth + 1 ))"
}

# Bring up the egress network BEFORE the agent container is created. The host proxy is
# deferred to start_egress_proxy() (post-attach): the host's gateway interface for an
# --internal network doesn't come up until a container attaches, so the proxy can't bind
# it yet.
start_egress() {
    ensure_egress_network
}

# Restart this project's network helper (the launchd service Apple Container runs per network)
# so the container's coming attachment gets a bridge interface of its own. Call it right before
# `container run` / `container start`, and only while this project's container is not running.
#
# Apple Container fixes a network's bridge unit (bridge100, bridge101, …) at the network's first
# attachment and keeps it after the bridge goes down. `down` keeps our network, so if another
# network takes that unit meanwhile, our next attachment reconfigures that live bridge with our
# gateway: the other project's containers fall off it and its augur-proxy, bound to the vanished
# gateway, becomes unreachable (apple/container#2051). A restarted helper has no unit fixed yet,
# so the attachment picks one no live bridge holds.
#
# A restart drops the helper's live attachments, hence "not running" above. It also cannot protect
# a project from networks augur does not restart (the default network used by `container build`
# and --no-egress, or networks created by hand).
#
# Deliberately best-effort: the label and launchd domain are Apple Container internals, and a
# skipped restart only leaves the collision possible, it never weakens egress filtering. So every
# failure warns and returns 0.
restart_egress_network_helper() {
    egress_enabled || return 0
    # A network this run just created has never had an attachment, so it has no unit fixed yet.
    $EGRESS_NETWORK_CREATED && return 0
    command -v launchctl &>/dev/null || return 0
    local label target="" dom state
    label="com.apple.container.container-network-vmnet.$(egress_network_name)"
    # Apple Container registers its services in the gui domain from a desktop session and in the
    # user domain otherwise (e.g. over SSH).
    for dom in "gui/$(id -u)" "user/$(id -u)"; do
        if launchctl print "$dom/$label" &>/dev/null; then target="$dom/$label"; break; fi
    done
    if [[ -z "$target" ]]; then
        warn "Network helper '${label}' not found, so augur cannot guard this project against Apple Container's shared-bridge bug (README: \"Running several projects at once\")."
        return 0
    fi
    # Another augur run for this project (a second `claude`/`shell`) may have started the container
    # since cmd_up checked; restarting now would cut it off. This only narrows the window: a run
    # that attaches between this check and the kickstart below is still cut off.
    # Accepted trade-off: concurrent runs for the same project are not supported anyway (nothing
    # serializes cmd_up, and two recreates can delete each other's container).
    if container_running; then return 0; fi
    if ! launchctl kickstart -k "$target" &>/dev/null; then
        warn "Could not restart network helper '${label}'; continuing without it."
        return 0
    fi
    local t=40
    while :; do
        # Captured, not piped into `grep -q`: an early grep exit would SIGPIPE launchctl and, under
        # pipefail, turn a match into a failure.
        state="$(launchctl print "$target" 2>/dev/null || true)"
        [[ "$state" == *"state = running"* ]] && break
        if ((t-- <= 0)); then
            warn "Network helper '${label}' did not report running after a restart; continuing."
            return 0
        fi
        sleep 0.25
    done
    # `state = running` can be reported before the helper's XPC listener is ready; give it a
    # moment so the attach right after does not race it.
    sleep 1
}

# Start the host-side proxy once the agent container has ATTACHED to the host-only network.
# On macOS 26 the host's vmnet interface for an --internal network — carrying the gateway
# IP — comes up only when a container attaches, so this must run AFTER `eng run`.
# Binding that gateway IP (not 0.0.0.0) keeps the proxy reachable by the guest but OFF the
# host's physical LAN/Wi-Fi: 0.0.0.0 would expose this allowlist forward proxy (HTTP CONNECT
# + SOCKS5) as a LAN-reachable relay — weaker than macOS VM mode (loopback). AUGUR_PROXY_LISTEN
# overrides the bind address (e.g. 0.0.0.0) for diagnosis.
start_egress_proxy() {
    local listen; listen="${AUGUR_PROXY_LISTEN:-$(container_egress_gateway)}"
    # The gateway interface can appear a beat after `eng run` returns. Wait (briefly) for the
    # bind address to show up on a host interface so start_proxy doesn't race it and fail to
    # bind. Skipped for 0.0.0.0 (always bindable) and if ifconfig is unavailable.
    if [[ "$listen" != "0.0.0.0" ]] && command -v ifconfig &>/dev/null; then
        local _t=25
        while (( _t-- > 0 )); do
            ifconfig 2>/dev/null | grep -qwF "$listen" && break
            sleep 0.2
        done
    fi
    start_proxy "$listen"
}

# Tear down the egress datapath (safe no-ops if it was never up).
stop_egress() {
    stop_proxy
    engine_network_rm "$(egress_network_name)" &>/dev/null || true
    # Migration: also reap the pre-hash name (augur-<slug>-net) an older augur created for this
    # project. It is not looked up anywhere else, so nothing else would ever remove it and
    # `destroy` would leave its subnet allocated for good. Best-effort, same as above: on a
    # same-basename pair the sibling project may own that name, and `network delete` refuses a
    # network with attached containers — which is exactly the right outcome there.
    engine_network_rm "$(legacy_egress_network_name)" &>/dev/null || true
}

# Boot self-test: prove the agent can ONLY egress via the proxy. Direct (proxy-less)
# requests must fail; a request THROUGH the proxy must get an HTTP response.
verify_egress_locked() {
    info "Running egress self-test..."
    local leaked=false purl; purl="$(egress_proxy_url)"
    # Direct egress (no proxy) must fail. The hostname probe also catches a working resolver,
    # but on the Apple path DNS is closed by --no-dns, so it can pass without proving routing
    # is severed. The IP-LITERAL probes are what actually test raw routing — use several
    # distinct public IPv4 AND IPv6 anycast addresses on both :443 and :80 so a single
    # blackholed/rerouted IP (or a v6-only leak the v4 probes would miss) can't make a
    # routable network look isolated. ANY success is a leak.
    # Every probe runs ENGINE_CHECK_SH by absolute path with PATH pinned to root-owned system dirs
    # inside it, so neither the shell nor curl/getent can be a stub a prior guest session planted in
    # ~/.local/bin (see ENGINE_CHECK_SH). curl and getent live in /usr/bin, so the pin can never
    # cause a "not found" false failure; it only stops the tripwire being shadowed.
    # Deliberately run through a shell, never curl/getent directly: the baked HTTP_PROXY and PATH stay
    # in the environment next to the exec `-e` copies. The shell keeps the LAST duplicate and passes
    # one clean copy on; curl called directly would read the FIRST (baked) HTTP_PROXY through libc
    # and send every "direct" probe via the proxy, so the test could no longer see a leak.
    local _probe_path="/usr/bin:/bin:/usr/local/bin"
    local _probe
    for _probe in https://example.com https://1.1.1.1 https://8.8.8.8 http://1.1.1.1 http://8.8.8.8 \
                  'https://[2606:4700:4700::1111]' 'http://[2001:4860:4860::8888]'; do
        if eng exec -e PATH="$_probe_path" -e HTTP_PROXY= -e HTTPS_PROXY= -e http_proxy= -e https_proxy= -e NO_PROXY="*" \
            "$CONTAINER_NAME" "$ENGINE_CHECK_SH" -c "curl -s --max-time 6 -o /dev/null ${_probe}" 2>/dev/null; then
            leaked=true; error "Self-test: the container reached ${_probe} directly (not isolated)."
        fi
    done
    # External DNS must fail closed (--no-dns leaves the guest no external resolver).
    if eng exec -e PATH="$_probe_path" "$CONTAINER_NAME" "$ENGINE_CHECK_SH" -c 'getent hosts dns-leak-probe.example' &>/dev/null; then
        leaked=true; error "Self-test: the container resolved an external name (DNS not fail-closed)."
    fi
    # The proxy MUST be reachable: a request through it (even a 403 deny) must return an HTTP
    # status, not a connection failure. curl prints 000 (and exits nonzero) on failure, so
    # `|| true` keeps the failure on the fail-closed branch below instead of aborting under set -e.
    local pcode
    pcode="$(eng exec -e PATH="$_probe_path" "$CONTAINER_NAME" "$ENGINE_CHECK_SH" -c \
        "curl -s -o /dev/null -w '%{http_code}' --max-time 8 -x '${purl}' http://egress-proxy-probe.invalid/" 2>/dev/null || true)"
    if [[ -z "$pcode" || "$pcode" == "000" ]]; then
        leaked=true
        error "Self-test: the egress proxy (${purl}) is not reachable."
    fi
    if $leaked; then
        error "Egress self-test FAILED — refusing to continue. Tearing down."
        engine_rm_force "$CONTAINER_NAME" &>/dev/null || true
        stop_egress
        exit 1
    fi
    success "Egress self-test passed: the proxy is the agent's only egress; only allowlisted domains are reachable."
}

# ── macOS egress datapath (VZFileHandle + gvproxy) ────────────────────────────
# The guest's only NIC is a host-owned unixgram socket; gvproxy runs the guest's
# userspace network stack on the host and forwards all guest TCP to augur-proxy's
# SOCKS5 listener (the allowlist decision point). Because that socket is the sole
# egress, a root agent in the VM cannot bypass it — and nothing here needs host
# sudo or the Apple-gated vmnet entitlement. Requires the augur gvproxy fork.
AUGUR_GVPROXY_BIN="${AUGUR_GVPROXY_BIN:-}"

resolve_gvproxy() {
    if [[ -n "$AUGUR_GVPROXY_BIN" ]]; then echo "$AUGUR_GVPROXY_BIN"; return; fi
    command -v augur-gvproxy &>/dev/null && { command -v augur-gvproxy; return; }
    local c
    for c in "$AUGUR_DIR/augur-gvproxy" "$SCRIPT_DIR/gvproxy/augur-gvproxy"; do
        [[ -x "$c" ]] && { echo "$c"; return; }
    done
    echo ""   # not found
}

# The vfkit socket is the ONE per-project host-state name whose slug is TRUNCATED (24 chars).
# It is a unix-domain socket path, and macOS `sockaddr_un.sun_path` is 104 bytes — 103 usable —
# so unlike the pidfiles/logs/allowlist next to it (regular files under PATH_MAX 1024) it has a
# hard, short budget. With AUGUR_PROXY_DIR="$HOME/.augur/proxy" the fixed parts cost
# 21 + len($USER) as a prefix and 11 as a suffix ("<slug>-<12hex>.vfkit.sock"), so adding the
# path hash moved the breaking slug length from ~66 to ~53 for a 5-char username. Truncating
# costs nothing but readability: uniqueness is carried by the hash, not the slug, and any slug
# under 24 chars is unchanged. The resulting 69 + len($USER) is ~74 for "admin" and still 99 for
# a 30-char username. AUGUR_SOCKET_MAX_LEN below is the backstop for the residual (a relocated
# AUGUR_PROXY_DIR, a very long username).
# The naming asymmetry with gvproxy_pidfile (full slug) is fine: stop_gvproxy derives BOTH from
# these helpers and never correlates them by name.
AUGUR_SOCKET_MAX_LEN=103          # macOS sockaddr_un.sun_path is 104 bytes incl. the NUL
gvproxy_socket()  { local s; s="$(workspace_slug)"; echo "$AUGUR_PROXY_DIR/${s:0:24}-$(workspace_path_hash).vfkit.sock"; }
gvproxy_pidfile() { echo "$AUGUR_PROXY_DIR/$(workspace_slug)-$(workspace_path_hash).gvproxy.pid"; }
# Diagnostic logs for the macOS egress datapath. gvproxy and the VM run are otherwise
# launched with output discarded, which makes an "SSH did not come up" failure opaque;
# these capture their stderr so the failure path can surface the real cause.
gvproxy_log()     { echo "$AUGUR_PROXY_DIR/$(workspace_slug)-$(workspace_path_hash).gvproxy.log"; }
macos_vm_log()    { echo "$AUGUR_PROXY_DIR/$(workspace_slug)-$(workspace_path_hash).vm.log"; }

# Host-side record of the egress mode ("on" or "off") the project VM was BOOTED with. Written just
# before `augur-vm run` (macos_record_egress_mode), removed by down/destroy. A running VM cannot
# change its datapath — under egress gvproxy's socket IS its NIC, otherwise it is on NAT — so every
# command that attaches to a running VM compares this with the mode it was asked for
# (require_macos_egress_mode_current). Deliberately not inferred from the gvproxy pidfile: that is
# just as absent for a --no-egress boot as for an egress VM whose gvproxy died.
macos_egress_mode_file() { echo "$AUGUR_PROXY_DIR/$(workspace_slug)-$(workspace_path_hash).egress-mode"; }
requested_egress_mode()  { if egress_enabled; then echo on; else echo off; fi; }
# Accepted trade-off: two `up --macos` racing for the same project can leave a record that does not
# match the VM that won. Concurrent runs for the same project are not supported anyway (nothing
# serializes cmd_up_macos), the same as in Container mode.
macos_record_egress_mode() {
    mkdir -p "$AUGUR_PROXY_DIR"
    requested_egress_mode > "$(macos_egress_mode_file)"
}
# Refuse running VM $1 (refuse_running_macos_vm) unless it was booted with the egress mode this
# invocation asks for. A missing record (a VM booted some other way) refuses too: the mode it runs
# under is then unknown. The macOS peer of require_running_container_current.
require_macos_egress_mode_current() {
    local vm="$1" want have remedy="augur down --macos && augur up --macos"
    want="$(requested_egress_mode)"
    have="$(cat "$(macos_egress_mode_file)" 2>/dev/null || true)"
    [[ "$have" == "$want" ]] && return 0
    [[ "$want" == off ]] && remedy+=" --no-egress"
    if [[ -z "$have" ]]; then
        refuse_running_macos_vm "$vm" \
            "VM '${vm}' is running with an unknown egress mode (e.g. it was started by an older augur)." \
            "Restart it once: ${BOLD}${remedy}${RESET}"
    fi
    refuse_running_macos_vm "$vm" \
        "VM '${vm}' was started with a different config (egress ${have}; this command asks for egress ${want})." \
        "A running VM cannot switch its network datapath: ${BOLD}${remedy}${RESET}"
}

# Host-side record that the egress self-test (verify_macos_egress_locked) passed during the project
# VM's current boot. A session that attaches to a running VM sends it credentials with no self-test
# of its own (prepare_macos_session), so it first requires this record
# (require_macos_egress_verified): without it, an `up --macos` interrupted between `augur-vm run`
# and the self-test (Ctrl-C, a kill, a host crash) would leave a running VM that the next session
# trusts. Removed just before every `augur-vm run`, by stop_unverified_macos_vm and by
# down/destroy; written by cmd_up_macos only once the self-test has passed, on a boot and on the
# already-running branch, which re-runs it.
#
# It holds the VM's run id (macos_vm_run_id) at the moment the self-test passed, which ties it to
# that boot: a VM booted again by any means, augur-vm by hand included, has a new id and does not
# match even if a record survived (a host crash removes nothing).
#
# Deliberately egress-on only: a --no-egress boot has no self-test to record, and a session asking
# for --no-egress attaches only to a VM booted that way (require_macos_egress_mode_current), where
# there is no containment for a record to vouch for.
macos_egress_verified_file() { echo "$AUGUR_PROXY_DIR/$(workspace_slug)-$(workspace_path_hash).egress-verified"; }
# The id of VM $1's current boot, as `<pid> <start time>`: the pid augur-vm's `run` writes to the
# VM's run.pid for as long as it runs (the file augur-vm decides a VM's running state by), and the
# start time `ps -o lstart` gives for that process. The start time keeps a recycled pid from
# matching: after a host crash, an `augur-vm run` started by hand can get the pid an earlier boot's
# record holds, but not that process's start time too. Empty, which matches no record, when the
# pidfile is missing or holds no pid, or no process has that pid.
#
# ps prints lstart in the local time zone and the locale's format, so both are pinned (TZ=UTC0,
# LC_ALL=C): the record is written by one augur run and read by another, whose TZ can differ (a
# second terminal, a shell that sets TZ), and one process must give one id in all of them.
macos_vm_run_id() {
    local pid start _w=()
    pid="$(cat "$AUGUR_DIR/vms/$1/run.pid" 2>/dev/null)" || return 0
    pid="${pid//[[:space:]]/}"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    start="$(LC_ALL=C TZ=UTC0 ps -o lstart= -p "$pid" 2>/dev/null)" || return 0
    # Word-split so ps's column padding (`Nov  8`) cannot make one start time compare unequal.
    read -r -a _w <<<"$start"
    (( ${#_w[@]} > 0 )) || return 0
    printf '%s %s\n' "$pid" "${_w[*]}"
}
# Record that running VM $1 just passed its egress self-test. Without a run id to tie the pass to,
# or when the record cannot be written, this returns 1, after an error, and leaves no record at
# all (one written earlier in this boot is removed too), so every session refuses the VM until a
# later `up` records a pass. The caller
# decides what happens to the VM: cmd_up_macos's boot path stops the VM it just booted, and its
# already-running branch leaves running a VM that may be serving live sessions.
macos_record_egress_verified() {
    local id; id="$(macos_vm_run_id "$1")"
    if [[ -z "$id" ]]; then
        rm -f "$(macos_egress_verified_file)"
        error "Could not read VM '$1''s run id (the pid in $AUGUR_DIR/vms/$1/run.pid and that process's"
        error "  start time), so its passed egress self-test cannot be recorded for its sessions."
        return 1
    fi
    # Written to a temp file in the same directory and renamed into place, so a session checking the
    # record at the same moment (require_macos_egress_verified) reads the old record or the new one,
    # never an empty or partial file. A failed write leaves no record either.
    local f; f="$(macos_egress_verified_file)"
    mkdir -p "$AUGUR_PROXY_DIR"
    if ! { printf '%s\n' "$id" > "${f}.tmp.$$" && mv -f "${f}.tmp.$$" "$f"; } 2>/dev/null; then
        rm -f "${f}.tmp.$$" "$f"
        error "Could not write $f, so VM '$1''s passed egress self-test cannot be recorded for its sessions."
        return 1
    fi
}
# Refuse running VM $1, leaving it running: rewrite its ~/.augur-env (push_macos_guest_env
# --refusing, whose failure only adds its own warning), print each further argument as an error
# line, and exit 1.
#
# Every refusal of a running VM goes through here, so a refused guest never keeps credentials augur
# could have removed: a ~/.augur-env an older augur wrote holds them, the VM stays up after the
# refusal, and the push replaces that file (see push_macos_guest_env). That includes the refusals
# made before augur's first other connection to the guest (require_fresh_egress_helpers,
# require_macos_egress_mode_current, require_macos_admin_password --running), whose VM is the
# likeliest to hold such a file: one started by an older augur. While arm_macos_push_on_exit is
# armed, this push is the run's one push: the exit that follows does not push again. Deliberately
# done on a VM whose containment is unproven, whose egress mode is wrong or whose egress helpers are not verified: the
# push sends no credential, only the per-VM environment built from host-side constants, and needs
# only augur's SSH key, never the admin password. The refusals inside a push (the acceptance
# check) need no call here: that push already rewrote the file.
refuse_running_macos_vm() {
    local vm="$1" _l; shift
    push_macos_guest_env "$vm" --refusing || true
    disarm_macos_push_on_exit
    for _l in "$@"; do error "$_l"; done
    exit 1
}

# Until disarm_macos_push_on_exit, any exit of this augur run rewrites running VM $1's ~/.augur-env
# first (push_macos_guest_env --refusing): a check, a failing command, an exit during the egress
# self-test or the clock and timezone fixes, Ctrl-C (INT, TERM and HUP are turned into exits, with
# the shell's usual 128+N status). This is the one mechanism behind "a running VM never keeps an
# older augur's credentials": cmd_up_macos's already-running branch and prepare_macos_session arm
# it as soon as they find the VM running. The boot path never arms it: the VM it booted got its
# push right after the SSH wait. A VM that is no longer running when the run exits (a failed
# self-test stops it) is skipped; its next boot's push rewrites the file.
#
# Every push of an armed run disarms it once the push has returned, whatever its status, so each
# run pushes once: refuse_running_macos_vm after its push, and the callers' own final push, which
# exits on failure. A push cut short (Ctrl-C mid-ssh) has not returned, so the trap pushes again.
# Accepted trade-off: a kill -9 or a host crash runs no trap at all; the next up or session against
# the VM pushes before anything else.
arm_macos_push_on_exit() {
    _MACOS_PUSH_ON_EXIT_VM="$1"
    trap macos_push_on_exit EXIT
    trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
}
# A no-op unless armed, so a refusal outside an armed run leaves any other trap alone.
disarm_macos_push_on_exit() {
    [[ -n "$_MACOS_PUSH_ON_EXIT_VM" ]] || return 0
    trap - EXIT INT TERM HUP; _MACOS_PUSH_ON_EXIT_VM=""
}
macos_push_on_exit() {
    [[ -n "$_MACOS_PUSH_ON_EXIT_VM" ]] && macos_vm_running "$_MACOS_PUSH_ON_EXIT_VM" || return 0
    push_macos_guest_env "$_MACOS_PUSH_ON_EXIT_VM" --refusing || true
}
_MACOS_PUSH_ON_EXIT_VM=""

# Exit 1, leaving the VM running, unless running VM $1 passed its egress self-test during its
# current boot (macos_egress_verified_file). Nothing to check with egress off.
require_macos_egress_verified() {
    local vm="$1" have
    egress_enabled || return 0
    have="$(cat "$(macos_egress_verified_file)" 2>/dev/null || true)"
    [[ -n "$have" && "$have" == "$(macos_vm_run_id "$vm")" ]] && return 0
    refuse_running_macos_vm "$vm" \
        "VM '${vm}' is running, but no egress self-test has passed since it booted (its ${BOLD}augur up --macos${RESET}" \
        "  was interrupted, or the VM was started some other way). Refusing to send it credentials." \
        "  Run ${BOLD}augur up --macos${RESET} to re-run the egress self-test on the running VM."
}

# Fail closed on a socket path that cannot fit in sun_path. Without this, gvproxy's
# --listen-vfkit bind fails with a bare "invalid argument" and augur reports only "gvproxy did
# not create its socket in time" — an opaque failure whose real cause (a long $HOME or a
# relocated AUGUR_PROXY_DIR) is invisible. Checked in BYTES: workspace_slug emits only
# [a-z0-9-], but AUGUR_PROXY_DIR is operator-supplied and may be multi-byte.
require_socket_path_fits() {
    local sock="$1" len
    len=$(printf '%s' "$sock" | LC_ALL=C wc -c | tr -d ' ')
    if (( len > AUGUR_SOCKET_MAX_LEN )); then
        error "The gvproxy socket path is ${len} bytes, over the ${AUGUR_SOCKET_MAX_LEN}-byte macOS"
        error "unix-socket limit (sockaddr_un.sun_path is 104 bytes including the NUL):"
        error "  ${sock}"
        error "Set ${BOLD}AUGUR_PROXY_DIR${RESET} to a shorter path (e.g. /tmp/augur-proxy) and retry."
        exit 1
    fi
}
# Base-VM maintenance boot log (augur update --macos). Not project-specific, so it lives
# under AUGUR_DIR (always present) rather than the per-project proxy dir. Captures the
# base VM's NAT boot stderr so an "SSH did not come up" failure can surface the real cause.
macos_base_vm_log() { echo "$AUGUR_DIR/base-vm.vm.log"; }
# cmd_build_macos's build-VM boot log (both the automated-provisioning and manual-Setup-
# Assistant headless restart). Same rationale as macos_base_vm_log: the run is backgrounded,
# so without this every boot failure augur-vm reports is discarded and the build can only say
# "did not become reachable", leaving even a plain `vm.start` error undiagnosed.
macos_build_vm_log() { echo "$AUGUR_DIR/build-vm.vm.log"; }

# Surface the otherwise-discarded cause of a build-VM boot/reachability failure (mirrors
# cmd_update_macos's inline diagnostics). Called right before exiting on either "no IP" or
# "IP but no SSH" — both leave whatever augur-vm printed sitting in macos_build_vm_log.
macos_dump_build_vm_log() {
    local log; log="$(macos_build_vm_log)"
    error "  VM log: ${log}"
    if [[ -s "$log" ]]; then
        error "  ---- last VM lines ----"
        tail -n 20 "$log" 2>/dev/null | show_guest_lines
    fi
}

gvproxy_running() {
    local pf; pf="$(gvproxy_pidfile)"
    [[ -f "$pf" ]] || return 1
    local pid; pid="$(cat "$pf" 2>/dev/null)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# The host-side SSH forward port of a macOS VM's running gvproxy, for ANY project's VM (not just
# the current one); fails when that VM has no live gvproxy (the base VM, an egress-off run).
# The pidfile name is the VM name minus its `augur-macos-` prefix — both are `<slug>-<path hash>`
# (see gvproxy_pidfile, macos_project_vm). The port is read back from gvproxy's own argv because
# it is derived from the project's full path, which the VM name does not carry.
# The pid in the pidfile may be stale and reused by an unrelated process, so the process is
# trusted only if its argv also names THIS VM's own vfkit socket (the path gvproxy_socket gives:
# the slug cut to 24 characters, then the path hash); otherwise this fails rather than guess.
# `-ww`: on a terminal, BSD ps cuts args at the terminal width, and gvproxy's long socket and
# allowlist paths come before --ssh-port.
macos_vm_gvproxy_fwd_port() {
    local stem="${1#augur-macos-}" pf pid args sock slug
    pf="$AUGUR_PROXY_DIR/${stem}.gvproxy.pid"
    slug="${stem%-*}"
    sock="$AUGUR_PROXY_DIR/${slug:0:24}-${stem##*-}.vfkit.sock"
    [[ -f "$pf" ]] || return 1
    pid="$(cat "$pf" 2>/dev/null)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || return 1
    args="$(ps -ww -o args= -p "$pid" 2>/dev/null)" || return 1
    [[ "$args " == *"unixgram://${sock} "* ]] || return 1
    [[ "$args" =~ --ssh-port[[:space:]]+([0-9]+) ]] || return 1
    echo "${BASH_REMATCH[1]}"
}

# Start gvproxy: creates the vfkit unixgram socket the VM attaches to, and routes
# guest egress to augur-proxy's SOCKS5. Fail closed if the fork isn't installed.
start_gvproxy() {
    local gvp sock pidfile
    gvp="$(resolve_gvproxy)"
    if [[ -z "$gvp" ]]; then
        error "macOS egress filtering needs the augur gvproxy fork (augur-gvproxy), which was not found."
        error "Build/install it (see gvproxy/README), or run with ${BOLD}--no-egress${RESET} to disable filtering."
        stop_proxy
        exit 1
    fi
    sock="$(gvproxy_socket)"; pidfile="$(gvproxy_pidfile)"
    # Reuse a live gvproxy only if it is fresh (see the header above file_sha256); otherwise stop it
    # and launch below. This runs only on the VM boot path, so no VM is attached to the one replaced
    # here; a running VM with a stale gvproxy is refused earlier by require_fresh_egress_helpers.
    if gvproxy_running; then
        local why
        why="$(egress_helper_staleness "$gvp" "$pidfile")" && return 0
        replace_stale_helper "$pidfile" "gvproxy" "$why" "$gvp"
    fi
    # Checked on the path that actually BINDS the socket (same placement rule as the unlink
    # below): a reused gvproxy already proved its path fits, and the failure this catches is
    # `--listen-vfkit`'s, which happens here and nowhere else.
    require_socket_path_fits "$sock"
    # Only once no live gvproxy owns this path: clear a socket left behind by a crashed one,
    # or the -S wait at the end of this function succeeds instantly against a dead file. The
    # unlink must stay BELOW the early return — above it, reusing a running gvproxy would unlink
    # the socket the VM is about to attach to, and return 0 as if all was well.
    rm -f "$sock"
    info "Starting gvproxy (guest netstack → SOCKS5 allowlist)..."
    # --listen-vfkit: the socket the VM's NIC attaches to (one datagram = one frame).
    # --socks-upstream: send all guest TCP to augur-proxy by name for the allowlist
    #   decision. --deny-direct: never net.Dial directly (the fork's egress hook).
    # --ssh-port: gvproxy forwards host 127.0.0.1:<port> → guest :22 so augur can
    #   reach the VM (it has no host-routable IP behind gvproxy's user-space net).
    # --dns-allowlist: only resolve names in the same merged allowlist used for
    #   connections, so DNS-resolvable == connection-allowed (closes DNS-exfil).
    # AUGUR_DEBUG=1 makes gvproxy log every frame/DHCP/ARP event — needed to tell a
    # silent guest (no frames) apart from a wrong-IP guest (DHCP served, not .2).
    local gvp_debug=()
    [[ "${AUGUR_DEBUG:-}" == "1" ]] && gvp_debug=(--debug)
    record_launched_binsha "$gvp" "$pidfile"
    "$gvp" --listen-vfkit "unixgram://${sock}" \
           --socks-upstream "127.0.0.1:${AUGUR_PROXY_SOCKS_PORT}" \
           --dns-allowlist "$(proxy_allowlist)" \
           --ssh-port "$AUGUR_SSH_FWD_PORT" \
           ${gvp_debug[@]+"${gvp_debug[@]}"} \
           --deny-direct &>"$(gvproxy_log)" &
    echo $! > "$pidfile"
    disown
    local tries=30
    while ((tries-- > 0)); do [[ -S "$sock" ]] && return 0; sleep 0.1; done
    error "gvproxy did not create its socket in time."
    exit 1
}

stop_gvproxy() {
    local pidfile; pidfile="$(gvproxy_pidfile)"
    gvproxy_running && kill "$(cat "$pidfile")" 2>/dev/null || true
    rm -f "$pidfile" "$(binsha_file "$pidfile")" "$(gvproxy_socket)" 2>/dev/null || true
    # Migration: mirror of stop_proxy's reap, for the pre-path-hash gvproxy names
    # ("<slug>.gvproxy.pid" + "<slug>.vfkit.sock"). gvproxy_running only ever consults the
    # CURRENT pidfile, so a gvproxy started by an older augur is invisible to `down --macos`
    # and to `status` — the operator would be left with an orphan holding a live vfkit socket
    # and no augur command that finds it. The socket is unlinked unconditionally: a socket file
    # with no live owner is exactly the stale file start_gvproxy's `-S` wait would accept.
    local legacy_pid; legacy_pid="$AUGUR_PROXY_DIR/$(workspace_slug).gvproxy.pid"
    if [[ -f "$legacy_pid" ]]; then
        kill "$(cat "$legacy_pid" 2>/dev/null)" 2>/dev/null || true
        rm -f "$legacy_pid" 2>/dev/null || true
    fi
    rm -f "$AUGUR_PROXY_DIR/$(workspace_slug).vfkit.sock" 2>/dev/null || true
}

# Boot self-test, macOS-VM peer of verify_egress_locked — the fail-closed tripwire on this engine.
# Read that function first: this one deliberately keeps its shape, including the property that
# matters most.
#
# A probe that only checks "direct egress fails" reports SUCCESS when the guest has NO network at
# all. Both halves are therefore load-bearing, exactly as in the container version:
#
#   NEGATIVE — direct egress must FAIL. Container probes IP literals + a hostname with every proxy
#     env var unset. There is no proxy env to unset here (the forwarding is transparent: gvproxy is
#     the guest's only NIC and dials augur-proxy's SOCKS5 per connection), so "direct" means the
#     things that can leave WITHOUT the allowlist deciding — and each maps to exactly ONE gvproxy
#     flag in start_gvproxy, which is what makes deleting that flag detectable:
#       • an IP-literal TCP connect        → only --socks-upstream stops it
#       • a non-allowlisted NAME resolving → only --dns-allowlist stops it
#       • raw UDP / ICMP                   → only --deny-direct stops those
#     Without these probes, deleting any one of those three from start_gvproxy's argv would leave
#     `up --macos` printing "Egress restricted…" and then "VM is up." with nothing detecting it.
#   POSITIVE — allowlisted egress must WORK, or a total network outage reads as "secure".
#
# Container proves its positive half WITHOUT the network: it sends a request THROUGH the proxy to
# a `.invalid` host and accepts any HTTP status (even a 403 deny), because reaching the proxy at
# all is the proof. That trick is unavailable here — the guest cannot address the proxy, and any
# name must clear gvproxy's DNS allowlist first — so this half necessarily reaches a real
# allowlisted host. `up --macos` with egress ON therefore REQUIRES working egress to
# _SELFTEST_HOST; `--no-egress` skips the whole self-test, as it does in container mode.
#
# Every probe shape below was measured in a live gvproxy-backed guest, not inferred.
_SELFTEST_HOST="api.github.com"
verify_macos_egress_locked() {
    local vm="$1"
    info "Running egress self-test (in-guest)..."
    local leaked=false
    # PATH pinning, same reason as verify_egress_locked's and the same blast radius: `down --macos`
    # KEEPS the clone, and augur's own ~/.augur-env puts $HOME/.local/bin FIRST
    # in the PATH of every guest shell — including the non-login shell `ssh <host> <cmd>` runs, which
    # still sources ~/.zshenv. A prior guest session could otherwise plant ~/.local/bin/curl|dig|
    # dscacheutil|ping and fake every isolated answer below. The real tools live in system dirs a
    # project VM has no sudo grant to write (curl/dig/dscacheutil in /usr/bin, ping in /sbin), so
    # this can never cause a "not found" false failure — it only stops the tripwire being shadowed.
    local pp='export PATH=/usr/bin:/bin:/usr/sbin:/sbin;'

    # The transport itself, first. Every negative probe below "passes" when the guest is merely
    # unreachable, so an unverifiable datapath must be named as such rather than reported as
    # isolated. It still fails CLOSED (same teardown) — container mode does the same thing when
    # `eng exec` stops working, because its proxy probe then returns no status either.
    #
    # Resolvability is checked before the first probe, and separately (macos_ssh_transport_ok),
    # because ssh_macos does not return when it cannot name a host or port for the VM: the
    # _macos_ssh_cmd it calls `exit 1`s the whole script (see _macos_ssh_cmd). Every probe below
    # invokes it under `&>/dev/null` or inside `$( … )`, so without this check that exit would be
    # UNOBSERVABLE and, being an exit rather than a non-zero return, it would jump clean over the
    # fail-closed teardown at the bottom of this function — leaving precisely the live VM with a
    # live NIC that the teardown exists to prevent, and ending `up --macos` at rc=1 with no
    # diagnostic at all. The `cannot run a command` branch below exists for this very situation and
    # could never be reached in it otherwise.
    #
    # The state is reachable, not theoretical: a RUNNING VM with gvproxy DOWN (see
    # macos_ssh_transport_ok). `cmd_down_macos` stopping gvproxy first leads straight here (see
    # tests/37_macos_down_verify.sh's header), and `make e2e` constructs it on the already-running
    # reconcile branch. Once a host and a port resolve, _macos_ssh_cmd has no other exit path, so
    # every probe below is covered. An empty port (gvproxy up, forward unreadable; see
    # macos_ssh_port) is the same no-way-in state.
    if ! macos_ssh_transport_ok "$vm"; then
        error "Self-test: no SSH transport to '${vm}' — egress cannot be VERIFIED."
        error "  The VM is running but gvproxy is not (or has no readable SSH forward), so nothing can reach it."
        error "  gvproxy cannot be restarted under a live VM (its unixgram socket IS the guest's"
        error "  NIC), so this fails closed and stops the VM below; \`augur up --macos\` then boots a"
        error "  fresh guest with a working datapath."
        leaked=true
    # A host that resolves can still be unreachable (gvproxy dying between the check above and the
    # probe below is a genuine, if narrow, race). That lands here rather than in the branch above:
    # same fail-closed verdict, less specific remedy.
    elif ! ssh_macos "$vm" "${pp} true" &>/dev/null; then
        error "Self-test: cannot run a command in the guest over SSH — egress cannot be VERIFIED."
        leaked=true
    else
        # Raw routing. ANY success is a leak. Two distinct public IPv4 anycast addresses plus an
        # IPv6 literal, so one blackholed/rerouted address (or a v6-only leak the v4 probes would
        # miss) cannot make a routable network look isolated. Only :443 — unlike container's
        # routeless --internal network, the deny here comes from the proxy refusing an IP-literal
        # destination unconditionally, which is port-agnostic, so container's second :80 pass
        # would buy no coverage and cost another full timeout. --max-time is 4 rather than
        # container's 6 for the same reason it matters at all: gvproxy's netstack ACCEPTS the
        # connection and the SOCKS deny closes it afterwards, so a severed IP-literal probe burns
        # its entire budget (measured: curl exits 28 at the deadline) instead of failing instantly.
        local _probe
        for _probe in https://1.1.1.1 https://8.8.8.8 'https://[2606:4700:4700::1111]'; do
            # Single-quoted in the remote string: the guest shell is zsh, which ABORTS on an
            # unmatched glob, and a bare IPv6 literal in brackets is one.
            if ssh_macos "$vm" "${pp} curl -s --max-time 4 -o /dev/null '${_probe}'" &>/dev/null; then
                leaked=true; error "Self-test: the guest reached ${_probe} directly (raw routing not severed)."
            fi
        done
        # DNS is the FIRST gate in this mode (gvproxy's --dns-allowlist gates resolution; the
        # proxy's SNI peek happens later), so a non-allowlisted name must not resolve.
        #
        # Two deliberate divergences from container's `getent hosts dns-leak-probe.example`:
        #   • macOS has no getent. dscacheutil goes through the guest's REAL resolver stack
        #     (mDNSResponder → gvproxy's DNS at the gateway) — the path curl/git/claude take. It
        #     exits 0 whether or not the name resolved, so the ANSWER is the signal, not $?.
        #   • the probe name must be one that genuinely RESOLVES publicly. Container can use a
        #     bogus `.example` TLD because its guest has no resolver at all, so any answer is a
        #     leak. Here the gate is a filter in FRONT of a working resolver: a bogus TLD would
        #     NXDOMAIN with --dns-allowlist deleted too, and the mutation would go undetected.
        # Matched on *_address* rather than ip_address so a AAAA-only answer (dscacheutil prints
        # `ipv6_address:`) is a leak here too.
        local _dnsout
        _dnsout="$(ssh_macos "$vm" "${pp} dscacheutil -q host -a name 'example.com'" 2>/dev/null || true)"
        if [[ "$_dnsout" == *_address* ]]; then
            leaked=true; error "Self-test: the guest resolved non-allowlisted example.com (DNS allowlist not enforced)."
        fi
        # UDP and ICMP, the two forwarders --deny-direct refuses to register. Neither is reachable
        # through the SOCKS allowlist, so neither of the TCP probes above can see them: a DNS query
        # aimed straight at a public resolver bypasses the guest's configured (gvproxy) one entirely,
        # which is a full-bandwidth exfil channel that resolves nothing through the allowlist.
        # An ANSWER is the signal, not dig's exit status (0 on an NXDOMAIN too) and not its raw
        # output — `dig +short` prints its "connection timed out" diagnostic on STDOUT, so the
        # dotted-quad shape is filtered in the guest and the host side only asks "was there one".
        local _udpout
        _udpout="$(ssh_macos "$vm" "${pp} dig +time=2 +tries=1 +short @1.1.1.1 example.com A | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'" 2>/dev/null || true)"
        if [[ -n "$_udpout" ]]; then
            leaked=true; error "Self-test: the guest resolved via direct UDP to 1.1.1.1 (UDP egress not dropped)."
        fi
        if ssh_macos "$vm" "${pp} ping -c 1 -t 2 1.1.1.1" &>/dev/null; then
            leaked=true; error "Self-test: the guest got an ICMP reply from 1.1.1.1 (ICMP egress not dropped)."
        fi
        # POSITIVE half — two assertions, because they fail for different reasons and a single one
        # would mask the other. The NAME must resolve, which proves gvproxy's DNS gate is armed and
        # DISCRIMINATING rather than simply closed (or absent, with the host offline); and a request
        # to it must come back with an HTTP status, which proves the SOCKS forward plus the proxy's
        # ALLOW decision. Deliberately a MANAGED-BASELINE domain: the already-running path warns
        # that gvproxy snapshots its DNS allowlist once at boot, so a project-conf domain could be
        # allowlisted host-side and still unresolvable in a live guest — a false leak. A merged
        # allowlist missing the baseline entirely is a broken install that denies the agent's own
        # API too, and failing `up` closed is the right answer there.
        local _okdns _pcode
        _okdns="$(ssh_macos "$vm" "${pp} dscacheutil -q host -a name '${_SELFTEST_HOST}'" 2>/dev/null || true)"
        if [[ "$_okdns" != *_address* ]]; then
            leaked=true
            error "Self-test: the guest cannot resolve allowlisted ${_SELFTEST_HOST} (egress is DOWN, not locked)."
        fi
        # curl prints 000 (and exits nonzero) when it never got a response, so `|| true` keeps the
        # failure on the fail-closed branch below instead of aborting under `set -e`.
        _pcode="$(ssh_macos "$vm" "${pp} curl -s -o /dev/null -w '%{http_code}' --max-time 12 'https://${_SELFTEST_HOST}/'" 2>/dev/null || true)"
        if [[ -z "$_pcode" || "$_pcode" == "000" ]]; then
            leaked=true
            error "Self-test: allowlisted egress to ${_SELFTEST_HOST} does not work (HTTP '${_pcode:-<none>}')."
        fi
    fi

    if $leaked; then
        error "Egress self-test FAILED — refusing to continue. Tearing down."
        # The macOS analogue of container mode's engine_rm_force + stop_egress, and the same
        # teardown as every other failure before a VM's containment is proven
        # (stop_unverified_macos_vm): a detected leak must not leave a live VM with a live NIC
        # behind. `up --macos` ends with a stopped VM here, on a running VM too (see the call
        # sites).
        stop_unverified_macos_vm "$vm"
        exit 1
    fi
    success "Egress self-test passed: gvproxy+proxy are the guest's only egress; only allowlisted domains resolve and connect."
}

# ── Container mode commands (Apple Container) ─────────────────────────────────

cmd_build() {
    require_engine
    info "Building $(engine_label) image '${IMAGE_NAME}' (Swift ${SWIFT_IMAGE_TAG})..."
    # `build --build-arg … -t … <ctx>` is identical argv on both engines (both read the
    # Dockerfile in the context; Apple's BuildKit-based builder honors .dockerignore too).
    container_provision_prepare
    local build_args=(--build-arg "SWIFT_VERSION=${SWIFT_IMAGE_TAG}")
    local _a
    while IFS= read -r _a; do build_args+=("$_a"); done < <(container_provision_build_args)
    eng build "${build_args[@]}" -t "$IMAGE_NAME" "$SCRIPT_DIR"
    success "Image '${IMAGE_NAME}' built successfully."
    invalidate_persisted_container "the new image"
}

# A rebuilt image only reaches the guest through a FRESH container — a persisted (stopped)
# container keeps the old image's filesystem, and `container start` never re-derives it. Remove
# THIS project's container (if any) so the next `augur up` recreates it from the new image; the
# workspace and Claude history are bind-mounted, so only the throwaway writable layer is dropped.
# Only this project's container is reachable by name here; the fingerprint does not track image
# content, so OTHER projects on the same image tag need their own `augur destroy && augur up`.
invalidate_persisted_container() {
    local why="$1"
    if container_exists; then
        # `build`/`update`/`install-cert` reach here with the container possibly still RUNNING, and
        # they are about to discard its writable layer. Snapshot the prompt history first. (Not the
        # only other live-container teardown — verify_egress_locked also force-removes a running
        # container when the boot self-test trips — but that one is a leak tripwire deliberately
        # producing a clean guest, so it is left alone.) No-ops when already stopped.
        save_guest_history
        info "Removing this project's container so ${why} takes effect on next ${BOLD}augur up${RESET}..."
        engine_rm_force "$CONTAINER_NAME" &>/dev/null || true
        rm -f "$(container_fingerprint_file)" 2>/dev/null || true
    fi
}

# The host's IANA zone name (e.g. "Asia/Tokyo"), read off /etc/localtime the same way macOS
# itself resolves it — NOT `date +%Z`, which gives an abbreviation ("JST") that neither a Linux
# container's tzdata lookup nor the macOS VM guest's `systemsetup -settimezone` accepts. Falls
# back to UTC (a safe no-op, not a guess) if the symlink is ever missing or doesn't point into a
# zoneinfo tree; on a real Mac this has never been observed to happen. Shared by both guest kinds
# augur can run: the container's per-session `-e TZ=` (_add_session_exec_env), and
# sync_macos_guest_timezone.
host_timezone() {
    local link="" tz=""
    link="$(readlink /etc/localtime 2>/dev/null)"
    tz="${link##*/zoneinfo/}"
    if [[ -z "$tz" || "$tz" == "$link" ]]; then
        printf 'UTC'
    else
        printf '%s' "$tz"
    fi
}

# ── Persisted-container reconcile (Apple Container mode keeps the container across `down`) ──
# `down` STOPS the container instead of deleting it, so the next `up` can restart it for a fast,
# cache-preserving resume. But a container's egress wiring, memory and mounts are baked once at
# `container run` and are NOT re-evaluated by `container start` — so reusing a container whose
# inputs have since changed would silently run stale/wrong config (a flipped egress mode, a resized
# memory limit). The fingerprint records exactly those baked inputs; `up` reuses the container only
# on an exact match and otherwise recreates it clean. Credentials and TZ are not baked at all (see
# session_credential_env), so a rotated token or a moved host never recreates it.
container_fingerprint_file() {
    mkdir -p "$AUGUR_DIR/container-state"
    # Key on the FULL container name (which already includes the Swift tag) so a project persisted
    # across multiple --swift versions keeps ONE fingerprint PER container. A tag-agnostic key could
    # match one tag's container while describing another tag's baked config → stale-config reuse.
    echo "$AUGUR_DIR/container-state/${CONTAINER_NAME}.fingerprint"
}

# Hash of everything cmd_up bakes into the container at `run` time and cannot change without
# recreating it. NOTE: image CONTENT is handled separately — build/update/install-cert remove
# this project's container so a rebuilt image always takes effect (a persisted container keeps
# the old image's filesystem). Holds no credential: those are injected per session, never baked.
# The digest is written host-side 0600, never in the project tree.
container_fingerprint() {
    local egress_state egress_wiring
    if egress_enabled; then
        egress_state="on"
        # Fingerprint the STABLE inputs that DETERMINE the baked HTTP_PROXY (subnet → gateway, an
        # explicit gateway override, and the proxy PORT) — NOT the live-inspected gateway. The live
        # value needs the network to exist at compare time and its computed fallback ignores a
        # custom subnet, both of which cause false mismatches; these three fully pin the proxy URL
        # cmd_up bakes into HTTP_PROXY, including the port the bare gateway omitted.
        egress_wiring="subnet=${AUGUR_INTERNAL_SUBNET} gw=${AUGUR_CONTAINER_GATEWAY:-} port=${AUGUR_PROXY_HTTP_PORT}"
    else
        egress_state="off"; egress_wiring="-"
    fi
    {
        echo "egress=${egress_state}"
        echo "wiring=${egress_wiring}"
        echo "memory=$(resolve_container_memory)"
        echo "workspace=${WORKSPACE_DIR}"
        echo "mount=${WORKSPACE_MOUNT}"
        # The operator-profile mount is baked at `run` like any other -v, so it belongs here by this
        # function's own contract. Only the MOUNT PATH is hashed, never the profile's CONTENT:
        # commands/ and skills/ are symlinked live and settings.json/CLAUDE.md are re-copied on every
        # `up`, so hashing content would throw away the writable layer on every slash-command tweak
        # for no gain. Its one upgrade effect is deliberate — a container created before the profile
        # existed has no such mount, and hashing the path recreates it once so the feature is
        # actually present rather than silently missing until the operator happens to `destroy`.
        echo "profile_mount=$(agent_profile_guest_mount)"
        # else-less `if`, NOT `[[ -f ]] && echo`: the &&-form returns 1 when no ~/.gitconfig, and
        # under `set -o pipefail` that 1 becomes the pipeline's (hence the function's) exit status,
        # which would abort the STANDALONE write_container_fingerprint call under `set -e` — skipping
        # finish_up and its boot self-test on a fresh up. An else-less if with a false test
        # returns 0.
        if [[ -f "$HOME/.gitconfig" ]]; then echo "gitconfig=present"; fi
    } | { if command -v sha256sum &>/dev/null; then sha256sum; else shasum -a 256; fi; } | awk '{print $1}'
}

# True iff a persisted container's stored fingerprint still matches the current config.
container_fingerprint_matches() {
    local f; f="$(container_fingerprint_file)"
    [[ -f "$f" ]] || return 1
    [[ "$(cat "$f" 2>/dev/null)" == "$(container_fingerprint)" ]]
}

write_container_fingerprint() {
    local f; f="$(container_fingerprint_file)"
    ( umask 077; container_fingerprint > "$f" )
}

# AUGUR_AGENT_SEAM | wire the opt-in operator profile into the guest's ~/.claude. Runs from
# finish_up, so on EVERY `up` — create AND reuse — which is what lets a host-side profile edit land
# without a container recreate.
#
# Two mechanisms, on purpose (see the agent_profile_* accessors):
#   • commands/ + skills/ are SYMLINKED at the read-only mount. Claude only reads them, so a host
#     edit is live on the next `claude` and costs nothing.
#   • settings.json + CLAUDE.md are COPIED. Claude Code rewrites settings.json at user scope, and a
#     symlink into a READ-ONLY mount would make that a write error rather than a feature.
#
# The copy overwrites on every `up`. That is ownership, not carelessness: a file the operator put in
# the profile is DECLARED host-owned, so the host is its source of truth. augur only ever writes a
# name that actually EXISTS in the profile, so an operator who ships no settings.json never has one
# written and sees no behavior change at all.
#
# ~/.claude/agents and ~/.claude/projects are deliberately absent from both lists: they are
# per-project RW mounts, and wiring them here would fight those mounts.
#
# STRICTLY best-effort: never aborts `up` (we run under `set -e`). Worst case nothing is wired,
# which is exactly the no-profile behavior.
apply_guest_profile() {
    # Paths and the entry lists travel as env vars, never interpolated into the shell program, so an
    # odd value cannot break quoting (POSIX sh does not re-expand a variable's value).
    if eng exec \
        -e "AUGUR_PROFILE_SRC=$(agent_profile_guest_mount)" \
        -e "AUGUR_PROFILE_DST=$(agent_profile_guest_dir)" \
        -e "AUGUR_PROFILE_LINKS=$(agent_profile_link_dirs)" \
        -e "AUGUR_PROFILE_COPIES=$(agent_profile_copy_files)" \
        "$CONTAINER_NAME" sh -c '
            set -eu
            # No mount at all (a container created before the profile existed): leave the guest alone.
            [ -d "$AUGUR_PROFILE_SRC" ] || exit 0
            mkdir -p "$AUGUR_PROFILE_DST"
            for d in $AUGUR_PROFILE_LINKS; do
                if [ -d "$AUGUR_PROFILE_SRC/$d" ]; then
                    # A REAL directory sits where the link goes. NEVER rm -rf it: the guest may have
                    # created commands/skills of its own before the operator populated the profile,
                    # and silently deleting them is data loss the operator never asked for. Empty is
                    # free to drop; anything else is moved aside once, and if that name is taken we
                    # leave the entry unwired rather than destroy either copy.
                    if [ ! -L "$AUGUR_PROFILE_DST/$d" ] && [ -e "$AUGUR_PROFILE_DST/$d" ]; then
                        if rmdir "$AUGUR_PROFILE_DST/$d" 2>/dev/null; then
                            :                                   # was empty — nothing to preserve
                        elif [ ! -e "$AUGUR_PROFILE_DST/$d.pre-profile" ]; then
                            mv "$AUGUR_PROFILE_DST/$d" "$AUGUR_PROFILE_DST/$d.pre-profile"
                        else
                            continue                            # already rescued once; do not touch
                        fi
                    fi
                    ln -sfn "$AUGUR_PROFILE_SRC/$d" "$AUGUR_PROFILE_DST/$d"
                elif [ -L "$AUGUR_PROFILE_DST/$d" ]; then
                    # The operator REMOVED this entry from the profile. Drop the link we made rather
                    # than leaving it dangling — but only ever a symlink, never a real directory the
                    # guest owns.
                    rm -f "$AUGUR_PROFILE_DST/$d"
                fi
            done
            for f in $AUGUR_PROFILE_COPIES; do
                [ -f "$AUGUR_PROFILE_SRC/$f" ] || continue
                cp "$AUGUR_PROFILE_SRC/$f" "$AUGUR_PROFILE_DST/$f"
            done
        ' >/dev/null 2>&1
    then
        return 0
    fi
    warn "Could not wire the operator profile into the guest; continuing without it."
    return 0
}

# ── Prompt-history carry-over (Container mode) ───────────────────────────────────────────────
# augur recreates the container for its OWN reasons — an egress toggle, a memory change,
# `build`/`update`/`install-cert`, or any other fingerprint drift. Each of those discards the
# writable layer, and ~/.claude/history.jsonl (up-arrow prompt recall) lives directly
# in ~/.claude rather than under one of the mounts, so it goes with it.
#
# Scope is deliberately JUST the prompt history. augur does not snapshot ~/.claude.json: augur
# makes no per-container write to that file on purpose, and its per-project entry
# carries folder trust and tool permissions — replaying those across a recreate would quietly
# re-grant approvals the operator gave to a container that no longer exists, undoing that choice.
#
# `destroy` DROPS the snapshot rather than feeding it forward: it is the clean-guest button (the
# integrity remedy), and carrying guest-written data across it would defeat the guarantee asked for.
#
# BOUNDED twice over — by lines AND by bytes. The only in-guest write mechanism this codebase has
# proven is `eng exec` with the payload in `-e` env vars (augur never uses `container cp`), and
# Linux caps a SINGLE env string at 128 KiB. A line cap alone would not hold: one pathological
# prompt can be arbitrarily long.
AUGUR_HISTORY_MAX_LINES="${AUGUR_HISTORY_MAX_LINES:-200}"
AUGUR_HISTORY_MAX_BYTES="${AUGUR_HISTORY_MAX_BYTES:-65536}"

guest_carryover_dir() {
    local d
    d="$AUGUR_DIR/$(agent_state_carryover_host_subdir)/$(workspace_slug)-$(workspace_path_hash)"
    # `umask 077` in a subshell, NOT mkdir-then-chmod: this holds guest-written data, and the
    # chmod-after form leaves a window where it is group/world readable. Same shape as
    # write_container_fingerprint. Kept OUTSIDE the host's own ~/.claude (the same discipline the
    # history/agents mounts follow). Failure is non-fatal — every caller is best-effort.
    ( umask 077; mkdir -p "$d" ) 2>/dev/null || true
    echo "$d"
}

# Snapshot the guest's prompt history. Only ever called where the container is RUNNING (`exec` needs
# it): on the way out of an interactive session, and in `down` before the stop. Best-effort — a
# failed snapshot must never fail the command the operator actually asked for.
save_guest_history() {
    container_running || return 0
    local d; d="$(guest_carryover_dir)"
    [[ -d "$d" ]] || return 0
    # tail -n bounds the entries, tail -c bounds the bytes. The byte cut can only slice the FIRST
    # line (it trims from the left), so the awk keeps line 1 only when it still looks like a whole
    # record — `{`…`}` — and keeps every later line untouched.
    # The awk PROGRAM travels as an env var, never interpolated into the shell string — the same
    # discipline the rest of this file uses for jq programs, and it keeps the regex escaping out of
    # two nested quoting layers (POSIX sh does not re-expand a variable's value).
    if ( umask 077; eng exec \
            -e "AUGUR_HIST=$(agent_state_guest_history_file)" \
            -e "AUGUR_N=${AUGUR_HISTORY_MAX_LINES}" \
            -e "AUGUR_B=${AUGUR_HISTORY_MAX_BYTES}" \
            -e 'AUGUR_AWK=NR>1 || (/^\{/ && /\}$/)' \
            "$CONTAINER_NAME" sh -c 'tail -n "$AUGUR_N" "$AUGUR_HIST" | tail -c "$AUGUR_B" | awk "$AUGUR_AWK"' \
            >"$d/history.jsonl.tmp" ) 2>/dev/null && [[ -s "$d/history.jsonl.tmp" ]]
    then
        # EVERY mutation below is guarded. This function runs on the way out of `claude`/`shell`, in
        # `down` before the stop, and in invalidate_persisted_container — under `set -e` a bare `mv`
        # that failed (full disk, bad perms) would abort the operator's ACTUAL command, skipping the
        # stop or the container removal. Best-effort has to mean it.
        cp "$d/history.jsonl" "$d/history.jsonl.prev" 2>/dev/null || true   # keep one generation
        mv "$d/history.jsonl.tmp" "$d/history.jsonl" 2>/dev/null || rm -f "$d/history.jsonl.tmp"
    else
        rm -f "$d/history.jsonl.tmp" 2>/dev/null || true
    fi
    return 0
}

# Push the snapshot into a freshly CREATED container. Best-effort.
restore_guest_history() {
    local d f; d="$(guest_carryover_dir)"; f="$d/history.jsonl"
    # Fall back to the previous generation when the current snapshot is missing or empty — that is
    # the case save_guest_history keeps `.prev` FOR (a failed restore leaves the guest with no
    # history, and the next save would otherwise replace a good snapshot with that emptier one).
    [[ -s "$f" ]] || f="$d/history.jsonl.prev"
    [[ -s "$f" ]] || return 0
    # Re-check the byte bound on the way IN as well: the file on disk could predate a lowered cap,
    # or have been edited by hand. Better to skip than to blow the env-string limit mid-`up`.
    local bytes; bytes="$(wc -c < "$f" 2>/dev/null | tr -d ' ')"
    if [[ -z "$bytes" || "$bytes" -gt "$AUGUR_HISTORY_MAX_BYTES" ]]; then
        warn "Carried-over prompt history is too large to restore; skipping it."
        return 0
    fi
    eng exec \
        -e "AUGUR_HIST=$(agent_state_guest_history_file)" \
        -e "AUGUR_HIST_BODY=$(cat "$f")" \
        "$CONTAINER_NAME" sh -c '
            set -eu
            mkdir -p "$(dirname "$AUGUR_HIST")"
            printf "%s\n" "$AUGUR_HIST_BODY" > "$AUGUR_HIST"
        ' >/dev/null 2>&1 \
        || warn "Could not restore prompt history into the guest."
    return 0
}

# `destroy` means clean. Drop the snapshot so the next `up` starts from nothing.
drop_guest_history() {
    rm -rf "$AUGUR_DIR/$(agent_state_carryover_host_subdir)/$(workspace_slug)-$(workspace_path_hash)" 2>/dev/null || true
    return 0
}

# Shared tail of `up` — ALL THREE paths (fresh create, stopped→running reuse, and the
# already-running reconcile): bring the host egress proxy up now that the container has attached,
# run the fail-closed boot self-test (runs on EVERY up, never cached from a prior boot), and
# print the ready banner.
#
# On the already-running path this one line buys three distinct things:
#   • start_egress_proxy → start_proxy rewrites the merged allowlist AND REVIVES A DEAD PROXY. That
#     is the only recovery from a proxy killed out from under a live session; nothing else in
#     `up`/`claude` revives or replaces one — `claude`/`shell` on a running guest never touch the
#     proxy, and one whose binary is not verified is refused by require_fresh_egress_helpers.
#   • verify_egress_locked restores the boot self-test on that path.
#   • apply_guest_profile picks up a structural profile change.
finish_up() {
    if egress_enabled; then
        start_egress_proxy
        verify_egress_locked
    fi
    # Every `up` path lands here, so a host-side profile edit is picked up without a recreate. That
    # is still NOT sufficient on its own: cmd_claude/cmd_shell reach cmd_up only when the container
    # is NOT running (ensure_session_container), so on the common case — repeated
    # `claude`/`shell` with no intervening `down` — nothing in this function runs at all. They
    # therefore call apply_guest_profile directly too; see those call sites (without that, a
    # profile entry added/removed while the container stays running would be invisible until an
    # explicit `down`). Best-effort; never aborts `up`. Runs AFTER the egress self-test so
    # it can never delay or mask that tripwire.
    apply_guest_profile
    success "Container '${CONTAINER_NAME}' is up."
    echo ""
    echo -e "  ${BOLD}augur claude${RESET}  → Launch $(agent_display_name)"
    echo -e "  ${BOLD}augur shell${RESET}   → Open bash shell"
    echo -e "  ${BOLD}augur down${RESET}    → Stop (kept for a fast restart)"
    echo -e "  ${BOLD}augur destroy${RESET} → Remove the container entirely"
}

# The container is already running: rebuild the host side only, or refuse (exit 1) on config drift.
reconcile_running_container() {
    warn "Container '${CONTAINER_NAME}' is already running — reconciling host-side state only."
    if egress_enabled; then
        check_project_conf_approved      # the gate runs wherever policy is written
        # DELIBERATELY REDUNDANT with the write inside start_proxy on the match path below.
        # It is here so a REVOCATION still lands on the MISMATCH path, which exits before
        # finish_up is ever reached. Do not "simplify" it away.
        write_merged_allowlist >/dev/null
    fi
    # Refuse rather than warn and continue: continuing into start_egress_proxy with a container
    # created under --no-egress fails opaquely anyway — container_egress_gateway falls back to a
    # COMPUTED IP when `network inspect` reports none, start_egress_proxy then burns its 5s ifconfig
    # wait on an address no interface holds, and start_proxy dies on the bind.
    require_running_container_current
    finish_up                            # restores the boot self-test on this path
}

# Exit 1 unless the RUNNING container's fingerprint matches the current config. A running container
# cannot be re-provisioned: --network / --cap-drop / HTTP_PROXY / --no-dns / --memory / mounts are
# baked once at `container run`, and the remedy is a stop plus the recreate `up` does on mismatch.
# The fingerprint is an opaque digest, so the message cannot name the drifted field.
#
# A missing or older-format fingerprint lands here too — including a container created by an augur
# that baked credentials and TZ into `container run`. That case must refuse, not continue: a value
# baked at `run` shadows the per-session one (see _add_session_exec_env), so the session would run
# on the baked, possibly stale, credentials.
require_running_container_current() {
    container_fingerprint_matches && return 0
    error "Container '${CONTAINER_NAME}' was created with a different config (egress mode, memory or mounts changed"
    error "since, or an older augur created it). A running container cannot pick those up: ${BOLD}augur down && augur up${RESET}"
    exit 1
}

# Build a fresh container from the image: drop any old one, assemble the `container run` argv,
# run it, record its fingerprint, then bring egress up via finish_up.
recreate_container() {
    # Recreate: drop any existing container (its config drifted, or it wouldn't start), then
    # build a fresh one from the image below.
    if container_exists; then
        engine_rm_force "$CONTAINER_NAME" &>/dev/null
    fi

    info "Starting container '${CONTAINER_NAME}'..."
    info "Mounting: ${BOLD}${WORKSPACE_DIR}${RESET} → ${WORKSPACE_MOUNT}"

    # Detached only — NO -t/-i: a detached TTY (-t) gets hung up when `run` returns, and
    # Apple Container then SIGHUPs PID 1 (sleep infinity), stopping the container. The
    # interactive TTY belongs on `exec -it` (augur claude/shell), not the keep-alive PID 1.
    local run_args=(
        run -d
        --name "$CONTAINER_NAME"
        -v "${WORKSPACE_DIR}:${WORKSPACE_MOUNT}"
        -w "${WORKSPACE_MOUNT}"
    )

    # Apple `container`'s default per-container memory is ~1GB — too tight for an agent.
    # See resolve_container_memory for the override precedence.
    run_args+=(--memory "$(resolve_container_memory)")

    # Deliberately NO credentials and NO TZ here: both go on each session's `exec` instead
    # (see session_credential_env and _add_session_exec_env).
    _add_egress_run_args
    _add_state_mount_run_args
    _add_host_config_run_args

    # Keep-alive PID 1 so the container stays up (detached) for repeated `exec` (augur
    # claude/shell). A bare `bash` exits immediately on Apple Container (no stdin) and stops the
    # container; the backgrounded-and-`wait`ed `sleep infinity` keeps it up with no TTY (see -d
    # above). The `trap … TERM` is what makes `augur down` fast: the kernel only delivers PID 1 a
    # signal it has a HANDLER for, so a bare `sleep infinity` ignores `container stop`'s SIGTERM
    # and stop must wait its full grace period, then SIGKILL (~5s observed). With the handler,
    # SIGTERM exits PID 1 cleanly (0) at once; the writable layer persists either way. The
    # agent/shell still run via `<engine> exec -it`, not PID 1. (Verified: dash and bash both keep
    # running and exit 0 within ms of SIGTERM.)
    run_args+=("$IMAGE_NAME" sh -c 'trap "exit 0" TERM; sleep infinity & wait')

    restart_egress_network_helper
    if ! eng "${run_args[@]}" &>/dev/null; then
        error "Failed to start the container."
        # Don't leave a started proxy / internal network orphaned.
        if egress_enabled; then stop_egress; fi
        exit 1
    fi
    # Record the config this fresh container was created with, so the next `up` can tell whether
    # the persisted container is still reusable or must be recreated (see the reconcile in cmd_up).
    write_container_fingerprint

    # Carry this project's prompt history into the fresh container (create path only; the reuse path
    # in cmd_up kept it in its writable layer). `destroy` drops the snapshot, so a deliberate clean
    # slate stays clean. Best-effort.
    restore_guest_history

    # The agent container has now ATTACHED to the network — the host's host-only gateway
    # interface comes up at that point, so finish_up starts the host proxy and runs the boot
    # self-test. Shared with the reuse path in cmd_up (the datapath is rebuilt on EVERY up).
    finish_up
}

# The _add_*_run_args functions below append to the caller's `local run_args` (bash dynamic scoping).
_add_egress_run_args() {
    # Egress allowlist: put the agent on an --internal network with NET_ADMIN dropped so
    # the root agent can't re-route, and point all egress at the HOST augur-proxy reached
    # over the host-only gateway. No host sudo required. The proxy enforces the allowlist
    # and egresses for the agent.
    if egress_enabled; then
        start_egress
        local proxy_url; proxy_url="$(egress_proxy_url)"
        run_args+=(
            --network "$(egress_network_name)"
            --cap-drop NET_ADMIN
            -e "HTTP_PROXY=${proxy_url}"  -e "http_proxy=${proxy_url}"
            -e "HTTPS_PROXY=${proxy_url}" -e "https_proxy=${proxy_url}"
            -e "NO_PROXY=localhost,127.0.0.1" -e "no_proxy=localhost,127.0.0.1"
        )
        # External DNS must fail closed — the agent reaches the proxy by IP and proxies by
        # name, so it needs no working external resolver. This shuts DNS-exfil. --no-dns
        # injects no resolver at all (and the host-only network has no external DNS anyway).
        # Confirmed on macOS 26: --no-dns leaves no usable resolver (empty /etc/resolv.conf;
        # the host's nameservers are NOT reachable via the host-only gateway). Verified from
        # inside a running guest: `cat /etc/resolv.conf` is empty and `getent hosts <name>`
        # fails, while allowlisted egress still works through the proxy (resolves host-side).
        # verify_egress_locked's getent probe fails the boot self-test if this ever regresses.
        run_args+=(--no-dns)
        info "Egress restricted to allowlisted domains (proxy: ${BOLD}${proxy_url}${RESET})."
    fi
}

_add_state_mount_run_args() {
    # AUGUR_AGENT_SEAM | history mount — core decides where history lives and who can see it;
    # the agent only declares its guest paths.
    # Persist this project's agent history across down/up:
    # - Host side: ~/.augur/claude-projects/<slug>-<path hash>, OUTSIDE the host's own
    #   ~/.claude/projects. The guest can write anything into this mount, and a forged transcript
    #   resumed by the host's Claude could inject instructions into that higher-privilege agent.
    #   The path hash keeps two same-named projects apart: no other project's history, and nothing
    #   else of the host's ~/.claude, is reachable.
    # - Guest side: Claude keeps one leaf dir per cwd (projects/-workspace-<slug>). The whole
    #   projects/ parent is mounted, not one leaf, so every leaf this project creates (the main
    #   checkout, ad-hoc `claude --worktree` sessions) persists.
    #   Accepted trade-off: those leaves can read and modify each other.
    # - The image pre-bakes projects/ and a minimal ~/.claude.json (Dockerfile) only as a
    #   fallback; this mount normally shadows them.
    local agent_proj_leaf host_hist_dir
    agent_proj_leaf="$(agent_state_guest_leaf "$(workspace_slug)")"
    host_hist_dir="$AUGUR_DIR/$(agent_state_host_subdir)/$(workspace_slug)-$(workspace_path_hash)"
    mkdir -p "$host_hist_dir"
    # One-time, idempotent migration: installs from an older augur wrote this
    # project's *.jsonl directly under host_hist_dir. The whole parent is mounted
    # below, so move them one level deeper — under host_hist_dir/$agent_proj_leaf/ —
    # so they surface at the guest path Claude expects.
    migrate_pre_option_a_history "$host_hist_dir" "$agent_proj_leaf"
    run_args+=(-v "${host_hist_dir}:$(agent_state_guest_projects_dir)")

    # AUGUR_AGENT_SEAM | user-level subagent defs (~/.claude/agents) — SAME keying/scope as the
    # history mount above: a per-project host dir (slug + path hash), kept OUTSIDE the host's own
    # ~/.claude, so a compromised guest can plant subagent defs only into its OWN project's dir,
    # never the host's real ~/.claude/agents nor another project's. This persists user-level
    # subagents created in the guest via `/agents` across down/up AND destroy/recreate (the host
    # dir is untouched by down/destroy), matching how this project's history already persists.
    local host_agents_dir
    host_agents_dir="$AUGUR_DIR/$(agent_state_agents_host_subdir)/$(workspace_slug)-$(workspace_path_hash)"
    mkdir -p "$host_agents_dir"
    run_args+=(-v "${host_agents_dir}:$(agent_state_guest_agents_dir)")

    # AUGUR_AGENT_SEAM | opt-in operator profile — READ-ONLY, host-global. Always created and always
    # mounted, so a profile populated LATER needs no container recreate; an empty dir wires nothing
    # (apply_guest_profile skips every absent entry). Unlike the two mounts above this is
    # host-GLOBAL rather than per-project, which is exactly why it must be read-only: a compromised
    # guest must not be able to write a hook/command/skill back into a directory that every project
    # on this host reads. augur still never touches the host's ~/.claude.
    local host_profile_dir
    host_profile_dir="$AUGUR_DIR/$(agent_profile_host_subdir)"
    mkdir -p "$host_profile_dir"
    run_args+=(-v "${host_profile_dir}:$(agent_profile_guest_mount):ro")
}

_add_host_config_run_args() {
    # An if, not `[[ -f ]] && …`: as this function's last command the &&-form would return 1 when
    # there is no ~/.gitconfig and abort cmd_up under `set -e`.
    if [[ -f "$HOME/.gitconfig" ]]; then
        run_args+=(-v "${HOME}/.gitconfig:/home/dev/.gitconfig:ro")
    fi

    # Deliberately NOT mounted: the host's ~/.config/gh, in either engine (cmd_up_macos shares none
    # either). gh in the guest authenticates only through the per-session GH_TOKEN (see
    # session_credential_env), which gh prefers over any hosts.yml. The host's gh config adds nothing
    # to that and costs two things: on a macOS host gh keeps its token in the Keychain, so the
    # mounted hosts.yml lists the account with no usable token and `gh auth status` in the guest
    # reports it as a failed, invalid login next to the working GH_TOKEN one; and after
    # `gh auth login --insecure-storage`, hosts.yml holds the token in plaintext for the guest to
    # read. Accepted trade-off: the operator's aliases, git_protocol, editor and GHE host entries are
    # not available in the guest. augur does not create ~/.config/gh on the host either.
}

# ── Per-session credentials (Container mode) ───────────────────────────────────────────────────
# Credentials are never baked into `container run`: Apple Container persists the run config — the
# init process's environment included — as plaintext in the container bundle, `container inspect`
# prints it, and the container outlives `down`. They go only on the `container exec` that starts an
# augur session (cmd_claude / cmd_shell), as `--env-file <(session_credential_env)`:
#   • printf is a bash builtin, so no value ever reaches any process's argv;
#   • the CLI reads the process-substitution pipe once at startup, so nothing is written to disk;
#   • exec-time config is not persisted in the container bundle.
# A rotated token or a new `gh auth login` therefore reaches the next session with no recreate, and
# the credentials live only in the environment of that session's processes.
# Deliberately none for `augur setup-token` (it exists to mint a token; the current one is not handed
# to a guest binary for that) or for augur's own non-interactive execs (profile wiring, history
# carry-over, the integrity check). Accepted trade-off: a manual `container exec` gets none either.
#
# Prints the caller's `_creds` (see resolve_session_credentials) as NAME=value lines for the
# `--env-file <(…)` above. It only prints values that were already resolved and validated: an
# `exit` in here would end only the process substitution's subshell, never augur, so nothing that
# can fail belongs here.
session_credential_env() {
    local _kv
    for _kv in ${_creds[@]+"${_creds[@]}"}; do printf '%s\n' "$_kv"; done
    return 0
}

# Append the NON-secret per-session env for the same `exec` to the caller's `local _env` array (bash
# dynamic scoping), as plain `-e`:
#   • TZ — Container mode shares the host kernel's clock but defaults to UTC like any bare Linux
#     image. Per session, so a host that changed zone is picked up by the next session.
#   • git's credential helper for github.com (git_credential_env): the GIT_CONFIG_* set, which
#     holds no secret and is empty when the caller's `_creds` holds no gh token.
# Deliberately NEVER at `run`, for these and for the credentials alike: Apple Container appends
# exec env to the container's baked init env without de-duplicating, and libc `getenv` takes the
# FIRST duplicate (bash takes the last), so a baked value would silently win over the per-session
# one for `date` and any other program that reads it through libc.
_add_session_exec_env() {
    local _kv
    _env+=(-e "TZ=$(host_timezone)")
    while IFS= read -r _kv; do _env+=(-e "$_kv"); done < <(git_credential_env)
}

# Bring the container up for an interactive session. Not running → the FULL `up` (reconcile +
# egress bring-up + boot self-test), never a bare `container start`: with a persisted container,
# `down`(stop) then `claude` is a normal reuse path, and a bare start would re-attach the guest with
# NO proxy re-established and NO self-test — silently bypassing egress. Mirrors macOS
# prepare_macos_session (running || up). Already running → cmd_up is skipped, so check the fingerprint
# here with the same refusal `augur up` gives (see require_running_container_current).
ensure_session_container() {
    if container_running; then
        require_running_container_current
    else
        cmd_up
    fi
}

# Usage: migrate_pre_option_a_history <host_hist_dir> <leaf>
migrate_pre_option_a_history() {
    local host_hist_dir="$1" agent_proj_leaf="$2"
    if [[ ! -d "$host_hist_dir/$agent_proj_leaf" ]]; then
        shopt -s dotglob nullglob
        local _pre_option_a_entries=("$host_hist_dir"/*)
        shopt -u dotglob nullglob
        mkdir -p "$host_hist_dir/$agent_proj_leaf"
        if [[ ${#_pre_option_a_entries[@]} -gt 0 ]]; then
            mv "${_pre_option_a_entries[@]}" "$host_hist_dir/$agent_proj_leaf/"
        fi
    fi
}

cmd_up() {
    require_engine
    require_engine_version
    require_fresh_egress_helpers
    ensure_image

    # Already running: the container itself can't change, but the host side is rebuilt on
    # every `up` — rewrite the allowlist (augur-proxy hot-reloads it, so a revocation takes
    # effect), check the config fingerprint, and re-run the boot self-test.
    if container_running; then
        reconcile_running_container
        return 0
    fi

    # Gate the untrusted project ./.augur/allowlist.conf before tearing anything down or
    # starting the proxy (only relevant when egress filtering is on).
    if egress_enabled; then check_project_conf_approved; fi

    # Reconcile: `down` STOPS (keeps) the container, so if a persisted one exists AND the
    # config it was created with is unchanged (see container_fingerprint), reuse it — start it,
    # bring egress up, and return. A reused container re-applies its ORIGINAL egress wiring,
    # memory and mounts (baked once at `run`), so ANY drift must instead force a
    # clean recreate below; the boot self-test in finish_up still gates the reuse.
    if container_exists && container_fingerprint_matches; then
        info "Reusing stopped container '${CONTAINER_NAME}' (config unchanged; fast restart)..."
        # The internal egress network is kept across `down`; ensure it still exists (idempotent)
        # so the container can re-attach.
        if egress_enabled; then start_egress; fi
        restart_egress_network_helper
        if start_stopped_container; then
            finish_up
            return 0
        fi
        warn "Could not start the existing container; recreating it clean..."
    fi

    recreate_container
}

# Start the persisted container, retrying before the caller falls back to a recreate. A retry costs
# seconds, but a recreate throws away the writable layer, so a transient failure must not reach it —
# e.g. the network helper restart_egress_network_helper just restarted may still be coming up.
start_stopped_container() {
    local tries=3
    while ! eng start "$CONTAINER_NAME" &>/dev/null; do
        ((--tries > 0)) || return 1
        sleep 1
    done
}

cmd_claude() {
    require_engine
    require_engine_version
    require_fresh_egress_helpers
    # Resolved and checked once, before anything starts (see resolve_session_credentials); the
    # session's --env-file and git helper below use exactly these values.
    local _creds=()
    resolve_session_credentials || exit 1
    ensure_session_container
    # The line above reaches `cmd_up` only when the container is NOT running, so on the common case
    # — repeated `claude`/`shell` calls without an intervening `down` — cmd_up (and therefore its
    # finish_up, and the apply_guest_profile inside it) never runs. Call it here too, matching macOS
    # mode's ensure_macos_agent_profile (already called from cmd_claude_macos/cmd_shell_macos
    # unconditionally). Content edits inside an already-symlinked entry are live via the mount with
    # no re-wiring needed; this is for STRUCTURAL changes — an entry added, removed, or replaced in
    # the profile since the guest was last wired — which only apply_guest_profile can pick up.
    apply_guest_profile
    info "Launching $(agent_display_name) in '${CONTAINER_NAME}'..."
    # AUGUR_AGENT_SEAM | interactive launch (engine `exec`: argv array — safe by construction)
    local _env=() _argv=() kv
    _add_session_exec_env
    for kv in $(agent_fixed_env); do _env+=(-e "$kv"); done
    read -ra _argv <<< "$(agent_launch_argv)"
    # empty-safe expansion (bash 3.2 + set -u) so a future agent_fixed_env="" can't crash this
    local _rc=0
    eng exec -it --env-file <(session_credential_env) ${_env[@]+"${_env[@]}"} \
        "$CONTAINER_NAME" ${_argv[@]+"${_argv[@]}"} || _rc=$?
    # Snapshot on the way out, while the container is still running — the freshest moment for the
    # prompt history a later recreate would otherwise discard. Never changes the agent's own status.
    save_guest_history
    return "$_rc"
}

cmd_shell() {
    require_engine
    require_engine_version
    require_fresh_egress_helpers
    local _creds=()
    resolve_session_credentials || exit 1      # same as cmd_claude
    ensure_session_container
    # Same reasoning as cmd_claude: an already-running container never reaches `cmd_up` at all, so
    # re-wire the profile here too — otherwise a structural profile change (an entry
    # added/removed/replaced) is invisible until an intervening `down`.
    apply_guest_profile
    info "Opening bash shell in '${CONTAINER_NAME}'..."
    # Same per-session env as cmd_claude (see session_credential_env), minus the agent's fixed env.
    local _env=() _rc=0
    _add_session_exec_env
    eng exec -it --env-file <(session_credential_env) ${_env[@]+"${_env[@]}"} "$CONTAINER_NAME" bash || _rc=$?
    # Same snapshot-on-exit as cmd_claude: a `claude` run ad hoc from this shell writes the same
    # history file, and the container is still running here.
    save_guest_history
    return "$_rc"
}

# Generate a long-lived Claude subscription token by running `claude setup-token`
# INSIDE the guest (so the host never needs claude installed), then save it on the
# host for augur to inject. setup-token uses a copy-the-code OAuth flow that works
# headless: it prints a URL to open in any browser; paste the code back here.
cmd_setup_token() {
    require_engine
    require_engine_version
    require_fresh_egress_helpers
    # Auto-start a container if none is running, and stop it again afterward (kept, like any
    # `down`), so the token flow doesn't leave a RUNNING container/proxy behind. The token is
    # saved to the host for future sessions regardless; an already-running container is left
    # running, but only if its fingerprint is current — one an older augur created may still carry
    # credentials baked into its environment, and this flow must run without any.
    local started_here=false
    if container_running; then require_running_container_current; else cmd_up; started_here=true; fi
    # Integrity gate: the guest can overwrite its own (uid 1001-owned) claude binary, and setup-token
    # attaches that binary to the operator's TTY. Refuse if it differs from the image's pristine
    # copy — a freshly-CREATED container matches; a reused one tampered with by a prior session
    # does not. Because `down` only STOPS (the tampered filesystem persists), the clean-binary
    # remedy is `augur destroy` (full removal) followed by `augur up`, NOT `down && up`.
    if ! agent_verify_integrity_engine; then
        error "The $(agent_cli_name) binary in '${CONTAINER_NAME}' differs from the image — it may have been modified by the guest."
        error "Recreate a clean container first: ${BOLD}augur destroy && augur up${RESET}, then re-run setup-token."
        if $started_here; then cmd_down; fi
        return 1
    fi
    info "Running '$(agent_login_argv)' in '${CONTAINER_NAME}'..."
    info "Complete the browser sign-in; when it prints the token, copy it."
    # Run attached straight to the terminal (no pipe). `claude setup-token` is a
    # full-screen TUI; capturing its stdout forces a non-TTY and garbles the redraw,
    # so we don't capture it — the token is pasted back here instead. Deliberately no
    # --env-file: this flow gets no credentials (see session_credential_env).
    # AUGUR_AGENT_SEAM | login launch (engine `exec`: argv array)
    local _lenv=() _largv=() kv
    for kv in $(agent_fixed_env); do _lenv+=(-e "$kv"); done
    read -ra _largv <<< "$(agent_login_argv)"
    # Run the exact file the integrity gate hashed, not a fresh lookup of the name (see
    # agent_verify_integrity_engine).
    _largv[0]="$AGENT_VERIFIED_BIN"
    eng exec -it ${_lenv[@]+"${_lenv[@]}"} "$CONTAINER_NAME" "${_largv[@]}" || true
    stty sane 2>/dev/null || true   # restore cooked mode if the TUI left the tty raw
    # Apple's `container exec -it` returns with our inherited stdin (fd 0) left in
    # non-blocking mode. O_NONBLOCK is an open-file-description status flag (fcntl),
    # a different axis from the termios state `stty sane` resets — so stty can't clear
    # it, and the `read` below would then fail with EAGAIN ("read error: 0: Resource
    # temporarily unavailable"). Clear the flag (perl ships with macOS) and read from a
    # freshly opened /dev/tty as a belt-and-suspenders, so the paste works even if perl
    # is somehow unavailable.
    perl -e 'use Fcntl; fcntl(STDIN, F_SETFL, fcntl(STDIN, F_GETFL, 0) & ~O_NONBLOCK);' 2>/dev/null || true
    echo ""
    setup_token_security_notice
    local token
    token="$(read_agent_token_from_tty)"
    local rc=0
    save_oauth_token "$token" || rc=1
    # Restore the prior state even if the save failed.
    if $started_here; then cmd_down; fi
    return $rc
}

cmd_down() {
    require_engine
    if container_exists; then
        # Snapshot before the stop: `exec` needs a RUNNING container. No-ops if already stopped.
        save_guest_history
        info "Stopping container '${CONTAINER_NAME}' (keeping it for a fast restart)..."
        # STOP, don't delete: the container's writable layer (caches and tool state OUTSIDE the
        # bind-mounted workspace) survives so the next `up` resumes fast. `augur destroy` removes
        # it. PID 1 traps SIGTERM (see cmd_up's keep-alive), so `container stop` exits it promptly
        # instead of waiting its grace period then SIGKILL.
        # Keep the `|| true` (a stop failure must NOT abort before stop_proxy below), but re-check
        # the real state instead of reporting success unconditionally, so a rare stop failure is
        # surfaced rather than mislabeled as a clean stop.
        eng stop "$CONTAINER_NAME" &>/dev/null || true
        if container_running; then
            warn "Container '${CONTAINER_NAME}' did not stop cleanly (still running)."
            warn "Force-remove it with ${BOLD}augur destroy${RESET} if needed."
        else
            success "Container '${CONTAINER_NAME}' stopped (kept; CoW writable layer preserved)."
            echo -e "  ${BOLD}augur up${RESET}       → restart it (fast, reuses the container)"
            echo -e "  ${BOLD}augur destroy${RESET}  → remove it entirely"
        fi
    else
        warn "No container found for this directory (${CONTAINER_NAME})."
    fi
    # Stop the host-side egress proxy, but KEEP the internal network so the persisted container
    # can re-attach on the next up (destroy removes the network). Safe no-op if egress was off.
    stop_proxy
}

# Fully remove this project's container and its egress network — the counterpart to `down`'s
# keep-it behavior (mirrors `augur destroy --macos`). Use it to reclaim disk, or to force a
# from-scratch container (e.g. after a suspected guest compromise, or to pick up a rebuilt image).
cmd_destroy() {
    if (( $# > 1 )); then error "Usage: augur destroy [<container-name>]"; exit 1; fi
    # With a name (as shown by `augur list`), remove that container instead of this directory's.
    if [[ -n "${1:-}" ]]; then adopt_target_name container "$1" || exit 1; fi
    require_engine
    if container_exists; then
        info "Stopping and removing container '${CONTAINER_NAME}'..."
        engine_rm_force "$CONTAINER_NAME" &>/dev/null
        success "Container '${CONTAINER_NAME}' has been removed."
    else
        warn "No container found for this directory (${CONTAINER_NAME})."
    fi
    # Drop the reconcile fingerprint and tear down the whole egress datapath (proxy + network).
    rm -f "$(container_fingerprint_file)" 2>/dev/null || true
    # `destroy` is the clean-guest button (the integrity remedy), so the carried-over prompt
    # history goes too. Feeding guest-written data forward across an explicit destroy would defeat
    # exactly the guarantee the operator asked for. A drift-recreate inside `up` keeps it.
    drop_guest_history
    stop_egress
}

# ── install-cert: trust a custom CA in the guest (edge feature) ───────────────
# Some users must reach an internal HTTPS endpoint served with a private/self-signed CA.
# `augur install-cert <cert.crt>` installs that CA into the guest's OS trust store so every
# TLS client inside (curl/git/gh + Claude Code, which reads the OS store) trusts it. It is a
# DELIBERATE, explicit command — never part of build/up — because a trusted CA lets its
# key-holder MITM the guest's TLS to every allowlisted domain. Container mode bakes it into
# the image; macOS mode adds it to the base VM's System keychain (see cmd_install_cert_macos).

# Validate a host-provided certificate file: it must exist, end in .crt, parse as PEM X.509,
# and contain EXACTLY ONE certificate (the documented one-cert-per-file contract). Fails
# closed — a missing openssl or any parse failure refuses the install rather than proceeding.
validate_cert_file() {
    local cert="$1"
    [[ -f "$cert" ]] || { error "Certificate file not found: ${cert}"; return 1; }
    [[ "$cert" == *.crt ]] || { error "Expected a .crt file (PEM X.509 certificate): ${cert}"; return 1; }
    command -v openssl &>/dev/null || {
        error "openssl not found on the host — cannot validate the certificate. Refusing (fail closed)."
        return 1
    }
    openssl x509 -in "$cert" -noout &>/dev/null || {
        error "Not a valid PEM X.509 certificate: ${cert}"
        return 1
    }
    local n; n="$(grep -c '^-----BEGIN CERTIFICATE-----' "$cert" 2>/dev/null || true)"
    [[ "${n:-0}" -eq 1 ]] || {
        error "Expected exactly one certificate in ${cert} (found ${n:-0}). One cert per .crt file."
        return 1
    }
    return 0
}

# Show the cert's identity and a blast-radius warning, then require explicit approval. Unlike
# the project-conf/provision TOFU (auto-detected inputs need a first-sight gate), this runs an
# EXPLICIT operator command, so the "approval" is a per-invocation y/N (no persisted hash).
# AUGUR_ACCEPT_CERT_INSTALL=1 accepts non-interactively (CI / disposable flows). $2 = target label.
confirm_cert_install() {
    local cert="$1" target="$2" subject fpr enddate
    subject="$(openssl x509 -in "$cert" -noout -subject 2>/dev/null | sed 's/^subject=[[:space:]]*//')"
    fpr="$(openssl x509 -in "$cert" -noout -fingerprint -sha256 2>/dev/null | sed 's/^.*=//')"
    enddate="$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')"
    echo ""
    warn "About to install a custom trusted CA into the ${target}:"
    echo -e "    Subject:  ${subject:-<unknown>}"
    echo -e "    SHA-256:  ${fpr:-<unknown>}"
    echo -e "    Expires:  ${enddate:-<unknown>}"
    echo ""
    warn "SECURITY: anyone holding this certificate's private key can silently intercept the"
    warn "guest's TLS to ${BOLD}every allowlisted domain${RESET} (api.anthropic.com, github.com, …)."
    warn "Install it only if you fully trust whoever issued it."
    echo ""
    if [[ "${AUGUR_ACCEPT_CERT_INSTALL:-}" == "1" ]]; then
        info "Accepted via AUGUR_ACCEPT_CERT_INSTALL=1."
        return 0
    fi
    if [[ -t 0 && -t 1 ]]; then
        local yn=""
        read -rp "$(echo -e "${CYAN}[augur]${RESET} Install this CA? [y/N] ")" yn || true
        [[ "$yn" == [yY] ]] && return 0
        error "Declined — no certificate installed."
        return 1
    fi
    error "Refusing to install a CA non-interactively. Re-run in a terminal, or set AUGUR_ACCEPT_CERT_INSTALL=1."
    return 1
}

# Container mode: bake the CA into the image via the inert Dockerfile build-arg (see Dockerfile).
# Reuses the proven `eng build` path (Apple Container's builder pulls FROM the registry base, so
# a derived FROM-local-image build is deliberately avoided). Existing container-packages
# provisioning still applies. Single custom root: re-running REPLACES it; a later build/update
# rebuilds clean and DROPS it (documented — re-run install-cert after those).
cmd_install_cert() {
    local cert="${1:-}"
    [[ -n "$cert" ]] || { error "Usage: augur install-cert <cert.crt>"; exit 1; }
    local _a
    require_engine
    validate_cert_file "$cert" || exit 1
    # The image tag is shared by EVERY project built on this Swift tag (IMAGE_NAME=augur:swift-<tag>),
    # so be explicit that the trust is not scoped to the current project.
    confirm_cert_install "$cert" "container image '${IMAGE_NAME}' (trusted by every project on Swift tag '${SWIFT_IMAGE_TAG}')" || exit 1
    local b64
    b64="$(base64 < "$cert" | tr -d '\n')" || { error "Failed to base64-encode the certificate."; exit 1; }
    info "Baking the custom CA into image '${IMAGE_NAME}' (Swift ${SWIFT_IMAGE_TAG})..."
    container_provision_prepare
    local build_args=(--build-arg "SWIFT_VERSION=${SWIFT_IMAGE_TAG}" --build-arg "AUGUR_CA_CERT_B64=${b64}")
    while IFS= read -r _a; do build_args+=("$_a"); done < <(container_provision_build_args)
    if ! eng build "${build_args[@]}" -t "$IMAGE_NAME" "$SCRIPT_DIR"; then
        error "Failed to bake the CA into '${IMAGE_NAME}'."
        exit 1
    fi
    success "Custom CA installed into image '${IMAGE_NAME}'."
    # Same rebuild-orphans-the-previous-image effect as `update` — see the comment there.
    eng image prune
    info "Trusted by OS-store clients: curl, git, wget, gh, and $(agent_display_name). Tools with their OWN"
    info "trust store need their own knob: Node/npm → ${BOLD}NODE_EXTRA_CA_CERTS${RESET}, Python → ${BOLD}REQUESTS_CA_BUNDLE${RESET}."
    warn "Single custom root: re-running ${BOLD}install-cert${RESET} REPLACES it (not additive)."
    warn "A later ${BOLD}augur build${RESET}/${BOLD}update${RESET} rebuilds the image clean and DROPS the CA — re-run install-cert after those."
    invalidate_persisted_container "the newly-trusted CA (baked into the image)"
    warn "Other projects on this image tag: ${BOLD}augur destroy && augur up${RESET} to pick up the CA."
}

# Print the container toolchain WITHOUT building anything — status inspects only what
# already exists. Prefer the running container (the exact env Claude runs in), fall back
# to a one-shot run against the built image, and note when nothing is built yet.
engine_toolchain_versions() {
    local runner
    if container_running; then
        runner=(eng exec "$CONTAINER_NAME")
    elif eng image inspect "$IMAGE_NAME" &>/dev/null; then
        runner=(eng run --rm "$IMAGE_NAME")
    else
        echo -e "    ${YELLOW}(image not built — run: augur up)${RESET}"
        return 0
    fi
    "${runner[@]}" swift --version 2>/dev/null | sanitize_guest_lines || echo "    swift:  (unable to fetch)"
    # AUGUR_AGENT_SEAM | agent version probe
    local _vcmd=(); read -ra _vcmd <<< "$(agent_version_cmd)"
    "${runner[@]}" ${_vcmd[@]+"${_vcmd[@]}"} 2>/dev/null | sanitize_guest_lines || echo "    $(agent_cli_name): (unable to fetch)"
    "${runner[@]}" gh --version 2>/dev/null | head -1 | sanitize_guest_lines || echo "    gh:     (unable to fetch)"
}

# Is the host egress proxy up?
egress_proxy_running() { proxy_running; }

cmd_status() {
    require_engine
    echo -e "${BOLD}Engine:${RESET}     Apple Container"
    echo -e "${BOLD}Container:${RESET}  ${CONTAINER_NAME}"
    echo -e "${BOLD}Directory:${RESET}  ${WORKSPACE_DIR}"
    echo -e "${BOLD}Image:${RESET}      ${IMAGE_NAME}"
    echo -e "${BOLD}Memory:${RESET}     $(resolve_container_memory)"
    if egress_enabled; then
        local estate="${RED}stopped${RESET}" ekind="host proxy"
        egress_proxy_running && estate="$(egress_helper_status "$(resolve_proxy_cli)" "$(proxy_pidfile)")"
        echo -e "${BOLD}Egress:${RESET}     ${GREEN}on${RESET} (allowlist; ${ekind} ${estate})"
        echo -e "${BOLD}Allowlist:${RESET}  baseline$( [[ -f "$AUGUR_GLOBAL_CONF" ]] && echo " + augur.conf" )$( [[ -f "$AUGUR_PROJECT_CONF" ]] && echo " + .augur/allowlist.conf" )"
        if [[ -f "$AUGUR_PROJECT_CONF" ]]; then
            local _st="${YELLOW}unapproved (prompts on next up)${RESET}"
            [[ "$(project_conf_hash "$AUGUR_PROJECT_CONF")" == "$(cat "$(project_conf_hash_file)" 2>/dev/null || true)" ]] && _st="${GREEN}approved${RESET}"
            printf '%b.augur/allowlist.conf:%b [%b] %s\n' "$BOLD" "$RESET" "$_st" "$(project_conf_domains | tr '\n' ' ')"
        fi
    else
        echo -e "${BOLD}Egress:${RESET}     ${YELLOW}off${RESET} (disabled via --no-egress or AUGUR_EGRESS=0)"
    fi

    if container_running; then
        echo -e "${BOLD}Status:${RESET}     ${GREEN}running${RESET}"
    elif container_exists; then
        echo -e "${BOLD}Status:${RESET}     ${YELLOW}stopped${RESET}"
    else
        echo -e "${BOLD}Status:${RESET}     ${RED}not created${RESET}"
    fi
    echo ""

    echo -e "${BOLD}Toolchain:${RESET}"
    engine_toolchain_versions
    echo ""
}

cmd_update() {
    require_engine
    info "Updating $(engine_label) image '${IMAGE_NAME}' (Swift ${SWIFT_IMAGE_TAG}) to latest versions..."
    container_provision_prepare
    local build_args=(--no-cache --build-arg "SWIFT_VERSION=${SWIFT_IMAGE_TAG}")
    local _a
    while IFS= read -r _a; do build_args+=("$_a"); done < <(container_provision_build_args)
    eng build "${build_args[@]}" -t "$IMAGE_NAME" "$SCRIPT_DIR"
    success "Image '${IMAGE_NAME}' updated successfully."
    # --no-cache retags $IMAGE_NAME onto a freshly built image; the previous generation's
    # layers lose their tag and become dangling. Without this they'd silently accumulate
    # on every update (observed: tens of GB after repeated updates).
    eng image prune
    invalidate_persisted_container "the updated image"
    warn "Other projects' containers still use the old image — run ${BOLD}augur destroy && augur up${RESET} in each to update."
}

# Report augur's version. The NUMBER is the single source of truth in the committed VERSION
# file next to this script — it is NEVER derived from git tags (a tag is the OUTPUT of a
# release, not its input). Git only adds dev-build traceability:
#   • installed tree (~/.augur, no .git): print what `install` stamped into VERSION.
#   • a checkout whose HEAD is exactly the release tag v<VERSION>: the bare number.
#   • any other checkout (work in progress toward the next release): <VERSION>-dev+<sha>.
# A missing/empty VERSION degrades to "unknown" rather than aborting (augur runs set -e).
augur_version() {
    local v
    if ! v="$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null)" || [[ -z "$v" ]]; then
        echo "unknown"; return
    fi
    # Only a checkout — a .git *directly* in the script dir — earns a live dev suffix. Gate on
    # $SCRIPT_DIR/.git, NOT `git rev-parse` alone: rev-parse discovers a repo in any ANCESTOR, so
    # an installed ~/.augur nested under a git-tracked $HOME would otherwise be misread as a
    # checkout and print a bogus -dev suffix instead of the stamped number.
    if [[ -e "$SCRIPT_DIR/.git" ]] && git -C "$SCRIPT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
        if git -C "$SCRIPT_DIR" describe --exact-match --tags HEAD 2>/dev/null | grep -qx "v$v"; then
            echo "$v"                                              # released commit
        else
            echo "$v-dev+$(git -C "$SCRIPT_DIR" rev-parse --short HEAD)"
        fi
    else
        echo "$v"                                                 # installed (git-less) tree
    fi
}

# `version` reports the installed augur commit and nothing else. It is side-effect-free
# (no engine calls), so it answers instantly even with the service down or the image unbuilt.
# The image name/tag and the actual container toolchain live in `augur status`.
cmd_version() {
    echo ""
    echo -e "  ${BOLD}augur${RESET}  ${CYAN}$(augur_version)${RESET}"
    echo ""
}

# ── macOS VM mode commands ────────────────────────────────────────────────────

# The two first-boot flows of `augur build --macos` (macos_setup_flow picks one). Each boots the
# freshly created MACOS_BUILD_VM for the first time, stores its admin credential before anything
# can read it (see macos_admin_password()), and returns with the VM running headless, SSH
# accepting connections and auto-login configured for the base image. Auto-login gives the guest
# the GUI (Aqua) session `xcodebuild test` needs to reach testmanagerd; a headless SSH login has
# none. They hand back the backgrounded `augur-vm run` pid (for stop_and_reap_macos_vm) and the
# guest IP in the globals MACOS_BUILD_VM_PID and MACOS_BUILD_VM_IP. Globals, not stdout: capturing
# stdout runs the function in a subshell, and only the shell that started a child can `wait` on it.
# Build/setup boots use plain NAT (gvproxy isn't running and no agent is present); --net-nat is
# required because egress-filtered networking is the fail-closed default. Headless boot stderr
# goes to macos_build_vm_log so a failure can show the real cause instead of just "not running".

# macOS 27's guest provisioning: the account (with a random password), auto-login and Remote
# Login are all created by the framework on first boot, so there is no GUI step.
macos_first_boot_automated() {
    # base64: its alphabet ([A-Za-z0-9+/=]) has no quotes, whitespace or newlines, so the value
    # survives every hop unchanged (augur-vm's stdin, the 0600 file, and the one-line `sudo -S`
    # feed in macos_admin_password_stdin).
    local password
    password="$(openssl rand -base64 24)"
    # Stored before the boot, in the build VM's own bundle: a failed build deletes it along with
    # the VM, and an AUGUR_KEEP_BUILD_VM=1 one keeps it for logging in to inspect.
    macos_store_admin_password "$MACOS_BUILD_VM" "$password"

    # The password goes in on STDIN, never as an argument: argv is observable (`ps`), and a boot
    # lasts minutes. `$!` on a backgrounded pipeline is the LAST member, the `run` process.
    printf '%s' "$password" | "$VM_CLI" run --no-graphics --net-nat \
        --provision-username "$MACOS_SSH_USER" \
        --provision-password-stdin \
        --provision-full-name "augur" \
        "$MACOS_BUILD_VM" &>"$(macos_build_vm_log)" &
    MACOS_BUILD_VM_PID=$!

    info "Waiting for SSH..."
    # 240s, not the default 90s: this boot follows `create` immediately, so `augur-vm run` may
    # spend its first ~30s waiting out the installer's still-held auxiliary-storage lock
    # (RunSession.handleStartFailure) before the guest even starts booting.
    MACOS_BUILD_VM_IP="$(macos_vm_ip "$MACOS_BUILD_VM" 240)" || {
        stop_and_reap_macos_vm "$MACOS_BUILD_VM" "$MACOS_BUILD_VM_PID"
        error "VM did not become reachable after automated provisioning."
        macos_dump_build_vm_log
        exit 1
    }
    # The IP shows up well before provisioning has created the account and started Remote Login
    # (see macos_wait_for_ssh). Generous 300s budget: a cold first boot doing real
    # account-provisioning work, not a warm reboot.
    macos_wait_for_ssh "$MACOS_BUILD_VM_IP" 22 300 || {
        stop_and_reap_macos_vm "$MACOS_BUILD_VM" "$MACOS_BUILD_VM_PID"
        error "VM got an IP but SSH never came up after automated provisioning."
        macos_dump_build_vm_log
        exit 1
    }
    # logsInAutomatically, set on the provisioning options `run` passed, already configured it.
    info "Auto-login configured by automated provisioning."
}

# The manual Setup Assistant flow: the operator creates the admin account with the fixed
# MACOS_MANUAL_SETUP_PASSWORD and enables Remote Login in a VM window; augur then reboots the
# VM headless and writes the auto-login configuration itself.
macos_first_boot_manual() {
    # MACOS_MANUAL_SETUP_KCPASSWORD encodes exactly this password. Checked before the operator
    # spends any time in Setup Assistant.
    [[ "$MACOS_MANUAL_SETUP_PASSWORD" == "admin" ]] || {
        error "MACOS_MANUAL_SETUP_KCPASSWORD encodes \"admin\", not MACOS_MANUAL_SETUP_PASSWORD: re-encode it."
        exit 1
    }
    macos_store_admin_password "$MACOS_BUILD_VM" "$MACOS_MANUAL_SETUP_PASSWORD"
    echo ""
    echo -e "${BOLD}── Setup Assistant (manual) ──────────────────────────────────────────────────${RESET}"
    echo ""
    echo -e "  A VM window will open. Complete Setup Assistant, then:"
    echo ""
    echo -e "  1. Create a user account with these exact credentials:"
    echo -e "       Username : ${CYAN}${MACOS_SSH_USER}${RESET}"
    echo -e "       Password : ${CYAN}${MACOS_MANUAL_SETUP_PASSWORD}${RESET}"
    echo -e "  2. After reaching the desktop, enable Remote Login:"
    echo -e "       System Settings → General → Sharing → Remote Login → ON"
    echo -e "  3. Close the VM window."
    echo ""
    echo -e "${BOLD}─────────────────────────────────────────────────────────────────────────────${RESET}"
    echo ""
    read -rp "$(echo -e "${CYAN}[augur]${RESET} Press Enter to open the VM window...")"
    "$VM_CLI" run --net-nat "$MACOS_BUILD_VM"

    local yn
    read -rp "$(echo -e "${CYAN}[augur]${RESET} Remote Login enabled? Ready to continue? [y/N] ")" yn
    [[ "$yn" == [yY] ]] || { info "Aborted."; exit 0; }

    info "Restarting VM headlessly..."
    "$VM_CLI" run --no-graphics --net-nat "$MACOS_BUILD_VM" &>"$(macos_build_vm_log)" &
    MACOS_BUILD_VM_PID=$!

    info "Waiting for SSH..."
    MACOS_BUILD_VM_IP="$(macos_vm_ip "$MACOS_BUILD_VM")" || {
        stop_and_reap_macos_vm "$MACOS_BUILD_VM" "$MACOS_BUILD_VM_PID"
        error "VM did not become reachable. Check that Remote Login is enabled."
        macos_dump_build_vm_log
        exit 1
    }
    macos_wait_for_ssh "$MACOS_BUILD_VM_IP" || {
        stop_and_reap_macos_vm "$MACOS_BUILD_VM" "$MACOS_BUILD_VM_PID"
        error "VM got an IP but SSH never came up. Check that Remote Login is enabled."
        macos_dump_build_vm_log
        exit 1
    }

    # `sysadminctl -autologin` is broken (error 22) on current macOS, so write kcpassword
    # directly (method per cirruslabs). No key or sudo grant exists yet, so this logs in with the
    # password (ssh_macos_bootstrap) and feeds `sudo -S` the same way every other sudo does.
    info "Enabling auto-login (required for headless xcodebuild test)..."
    macos_admin_password_stdin "$MACOS_BUILD_VM" | ssh_macos_bootstrap "$MACOS_BUILD_VM" "$MACOS_BUILD_VM_IP" \
        "sudo -S -p '' bash -c \
            'echo ${MACOS_MANUAL_SETUP_KCPASSWORD} | xxd -r -p > /etc/kcpassword \
             && chmod 600 /etc/kcpassword \
             && defaults write /Library/Preferences/com.apple.loginwindow autoLoginUser ${MACOS_SSH_USER}'"
}

# EXIT trap of build and update: stop and delete their scratch VM $1 (MACOS_BUILD_VM /
# MACOS_UPDATE_VM), so a failure never leaves a running VM behind or turns a half-finished one into
# the base VM.
# AUGUR_KEEP_BUILD_VM=1 keeps it (stopped) instead. Debugging aid only: a fresh build VM costs a
# 15–30 min IPSW install, so discarding it on every failed attempt makes iterating on a boot-time
# failure (see macos_build_vm_log) impractical. The VM is still replaced by the next build or
# update, so this only ever preserves the most recent failure.
macos_discard_scratch_vm() {
    local vm="$1"
    if [[ "${AUGUR_KEEP_BUILD_VM:-}" == "1" ]]; then
        macos_vm_running "$vm" && "$VM_CLI" stop "$vm" 2>/dev/null || true
        warn "AUGUR_KEEP_BUILD_VM=1: keeping VM '${vm}' for inspection."
    elif macos_vm_exists "$vm"; then
        macos_vm_running "$vm" && "$VM_CLI" stop "$vm" 2>/dev/null || true
        "$VM_CLI" delete "$vm" 2>/dev/null || true
    fi
}

# Boot build/update's scratch VM $1 headless on NAT and wait for SSH, logging to $2. The `run` pid
# goes into MACOS_SCRATCH_VM_PID (a global, so this must not run in a subshell: the caller reaps
# that pid with stop_and_reap_macos_vm). Returns 1 if SSH is not up within 300s, leaving the VM
# running for the caller's diagnostics and EXIT trap. 300s: a cold boot (full macOS boot, fresh DHCP
# lease, sshd up) can take well over the 2 min a warm project VM needs. `--net-nat` is an explicit
# opt-in: base-VM maintenance needs open network, and egress filtering is the fail-closed default.
macos_boot_scratch_vm_nat() {
    "$VM_CLI" run --no-graphics --net-nat "$1" &>"$2" &
    MACOS_SCRATCH_VM_PID=$!
    wait_for_macos_ssh "$1" 300 &>/dev/null
}

cmd_build_macos() {
    require_vz

    local ipsw_path="" xcode_xip_path="" platforms="iOS" manual_setup=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ipsw)      ipsw_path="${2:?'--ipsw requires a file path'}";           shift 2 ;;
            --xcode-xip) xcode_xip_path="${2:?'--xcode-xip requires a file path'}"; shift 2 ;;
            --platforms) platforms="${2:?'--platforms requires a value'}";          shift 2 ;;
            # Escape hatch out of macOS 27's automated provisioning: take the manual Setup
            # Assistant flow even on a macOS 27+ host/guest pair. Without it, a host
            # where the automated first boot doesn't complete (for any reason — the guest side
            # of it is opaque and unattended) would have no way to build a base VM at all. The
            # manual flow stays the known-good fallback.
            --manual-setup) manual_setup=true; shift ;;
            *) error "Unknown option: $1"; exit 1 ;;
        esac
    done

    [[ -n "$ipsw_path" ]]      || { error "--ipsw <path> is required.";      exit 1; }
    [[ -f "$ipsw_path" ]]      || { error "IPSW not found: ${ipsw_path}";    exit 1; }
    [[ -n "$xcode_xip_path" ]] || { error "--xcode-xip <path> is required."; exit 1; }
    [[ -f "$xcode_xip_path" ]] || { error "XIP not found: ${xcode_xip_path}"; exit 1; }

    # Simulator runtimes to bake into the base VM. `all` pulls every platform Xcode offers;
    # otherwise a comma-separated list (e.g. "iOS,watchOS"). Default: iOS only.
    local -a platform_list=()
    if [[ "$platforms" == "all" ]]; then
        platform_list=(all)
    else
        IFS=',' read -ra platform_list <<< "$platforms"
    fi

    # Held until the build ends, released by the EXIT trap on every path: no update, second build or
    # setup-token clone runs while this replaces the base VM.
    host_lock_acquire "$MACOS_BASE_WRITER_LOCK" build
    trap 'host_lock_release "$MACOS_BASE_WRITER_LOCK" build' EXIT

    # Step 1: Warn if base VM already exists
    if macos_vm_exists "$MACOS_BASE_VM"; then
        warn "Existing base VM '${MACOS_BASE_VM}' will be replaced."
        read -rp "$(echo -e "${CYAN}[augur]${RESET} Continue? [y/N] ")" yn
        [[ "$yn" == [yY] ]] || { info "Aborted."; exit 0; }
        macos_vm_running "$MACOS_BASE_VM" && "$VM_CLI" stop "$MACOS_BASE_VM" 2>/dev/null || true
        "$VM_CLI" delete "$MACOS_BASE_VM"
    fi
    if macos_vm_exists "$MACOS_BUILD_VM"; then
        macos_vm_running "$MACOS_BUILD_VM" && "$VM_CLI" stop "$MACOS_BUILD_VM" 2>/dev/null || true
        "$VM_CLI" delete "$MACOS_BUILD_VM"
    fi

    trap 'macos_discard_scratch_vm "$MACOS_BUILD_VM"; host_lock_release "$MACOS_BASE_WRITER_LOCK" build' EXIT

    # Step 2: Create VM from IPSW
    info "Creating VM from IPSW — this takes 15–30 minutes..."
    "$VM_CLI" create "$MACOS_BUILD_VM" --from-ipsw "$(realpath "$ipsw_path")" --disk-size 120
    "$VM_CLI" set "$MACOS_BUILD_VM" --cpu 4 --memory 8192

    # Step 3: First boot, by whichever flow this host/guest/binary supports. The choice has to be
    # made here, before the very first `run`: macOS 27's guest provisioning only takes effect on
    # a guest's first boot after restore. Each flow leaves the VM running headless with SSH up,
    # its credential stored and auto-login configured, and sets MACOS_BUILD_VM_PID/_IP.
    local flow
    flow="$(macos_setup_flow "$MACOS_BUILD_VM" "$manual_setup")" || exit 1
    # A fresh build always produces a new VM with a new SSH host key. Discard any stale entry
    # before the flow's first SSH connection, so the TOFU check stores the new key cleanly.
    rm -f "$(vm_known_hosts_file "$MACOS_BUILD_VM")"
    case "$flow" in
        automated) macos_first_boot_automated ;;
        manual)    macos_first_boot_manual ;;
    esac
    MACOS_SCRATCH_VM_PID="$MACOS_BUILD_VM_PID"

    # Set up SSH key authentication FIRST: this is the last login that needs the admin password,
    # which augur feeds non-interactively via SSH_ASKPASS (ssh_macos_bootstrap), so the operator
    # types nothing here. Installing the key is a plain write to the user's own ~/.ssh (no sudo),
    # so it can run first; every step after this uses key auth.
    info "Setting up SSH key authentication..."
    if [[ ! -f "$MACOS_SSH_KEY" ]]; then
        mkdir -p "$(dirname "$MACOS_SSH_KEY")"
        ssh-keygen -t ed25519 -f "$MACOS_SSH_KEY" -N "" -C "augur-vm"
    fi
    ssh_macos_bootstrap "$MACOS_BUILD_VM" "$MACOS_BUILD_VM_IP" \
        "mkdir -p ~/.ssh && chmod 700 ~/.ssh && \
         echo '$(cat "${MACOS_SSH_KEY}.pub")' >> ~/.ssh/authorized_keys && \
         chmod 600 ~/.ssh/authorized_keys"

    # Configure passwordless sudo so subsequent ssh_macos calls don't need a TTY. The key is
    # installed now, so this runs over key auth (no login-password prompt); the sudo password is
    # still fed to `sudo -S` (see macos_admin_password_stdin).
    info "Configuring passwordless sudo..."
    macos_admin_password_stdin "$MACOS_BUILD_VM" | ssh_macos "$MACOS_BUILD_VM" \
        "sudo -S -p '' bash -c \
            'echo \"${MACOS_SSH_USER} ALL=(ALL) NOPASSWD:ALL\" > /etc/sudoers.d/augur \
             && chmod 440 /etc/sudoers.d/augur'"

    # NOTE: the workspace is exposed at ~/workspace-<slug> (a symlink to the virtiofs auto-mount under
    # "/Volumes/My Shared Files/"), created at runtime by ensure_macos_workspace — no
    # /etc/synthetic.conf / mount_virtiofs needed (the sealed root cannot host a runtime symlink).

    ssh_macos "$MACOS_BUILD_VM" "sudo systemsetup -setsleep Off 2>/dev/null || true"
    # Baked into the base too, so a clone's very first auto-login is already unlocked: applying it
    # only after SSH is up cannot undo a lock the console received at that first login.
    configure_macos_guest_session "$MACOS_BUILD_VM"

    # Step 5: Install Xcode via SSH
    # Use a fixed safe remote filename to avoid shell injection via the source path's basename.
    info "Copying Xcode XIP to VM ($(du -sh "$xcode_xip_path" | cut -f1))..."
    scp_to_macos "$MACOS_BUILD_VM" "$xcode_xip_path" "/tmp/Xcode.xip"

    info "Expanding Xcode XIP — this takes ~20 minutes..."
    ssh_macos "$MACOS_BUILD_VM" "cd /tmp && xip --expand Xcode.xip && rm Xcode.xip"

    info "Installing Xcode..."
    ssh_macos "$MACOS_BUILD_VM" "sudo mv /tmp/Xcode.app /Applications/Xcode.app && \
        sudo xcode-select -s /Applications/Xcode.app/Contents/Developer"

    info "Accepting Xcode license..."
    ssh_macos "$MACOS_BUILD_VM" "sudo xcodebuild -license accept"

    info "Running Xcode first launch..."
    ssh_macos "$MACOS_BUILD_VM" "sudo xcodebuild -runFirstLaunch"

    # Installing Xcode from a XIP does NOT bundle Simulator runtimes — Xcode 15+ ships them as
    # separate downloadable components, so -runFirstLaunch alone leaves the VM without any
    # simulator platform. Pull the requested platforms into the base VM so every clone has them
    # (installing later into a clone would not persist and would re-download per project).
    if [[ "${platform_list[0]}" == "all" ]]; then
        info "Downloading all Simulator platforms — this takes a while (many GB)..."
        ssh_macos "$MACOS_BUILD_VM" "sudo xcodebuild -downloadAllPlatforms"
    else
        for platform in "${platform_list[@]}"; do
            [[ "$platform" =~ ^[a-zA-Z]+$ ]] || { error "Invalid platform name: '${platform}' (letters only, e.g. iOS, watchOS)"; exit 1; }
            info "Downloading ${platform} platform (Simulator runtime) — this takes a while (several GB)..."
            ssh_macos "$MACOS_BUILD_VM" "sudo xcodebuild -downloadPlatform ${platform}"
        done
    fi

    # Step 6: Install CLI tools (Homebrew + Claude Code)
    info "Installing Homebrew and CLI tools..."
    # The agent installer's URL, channel and PATH directory come from the seam as constants, set as
    # variables ahead of the single-quoted script, which expands them guest-side.
    ssh_macos "$MACOS_BUILD_VM" "_agent_url='$(agent_installer_url)'; _agent_args='$(agent_installer_args)'; _agent_bindir='$(macos_agent_bindir_rel)'
"'
        # Download installers to temp files before executing — separates network fetch from execution
        # so the scripts can be inspected and avoids piping untrusted content directly to a shell.
        _brew_installer=$(mktemp)
        curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$_brew_installer"
        NONINTERACTIVE=1 /bin/bash "$_brew_installer"
        rm -f "$_brew_installer"
        eval "$(/opt/homebrew/bin/brew shellenv)"
        echo '\''eval "$(/opt/homebrew/bin/brew shellenv)"'\'' >> ~/.zprofile
        # GitHub CLI. augur hands every claude/shell session the host gh token as GH_TOKEN, and gh
        # respects GH_TOKEN automatically, so installing the binary is all that is needed for an
        # authenticated gh (no hosts.yml / Keychain handling required). See ssh_macos_session.
        brew install gh
        # AUGUR_AGENT_SEAM | macOS base-VM agent install + provenance (codesign signer).
        # Claude Code: do NOT use npm. The npm-distributed native binary arrives with a code
        # signature that gets corrupted during tar extraction, so Apple Silicon AMFI kills it
        # on launch (SIGKILL / "zsh: killed"). The official installer downloads a correctly
        # Developer-ID-signed + notarized binary straight from Anthropic, which passes AMFI.
        # Its signer is verified last, right before the base VM is saved (agent_verify_integrity_macos).
        _agent_installer=$(mktemp)
        curl -fsSL "$_agent_url" -o "$_agent_installer"
        bash "$_agent_installer" "$_agent_args"
        rm -f "$_agent_installer"
        echo "export PATH=\"\$HOME/$_agent_bindir:\$PATH\"" >> ~/.zprofile
        # Pin the Xcode developer directory via DEVELOPER_DIR so xcodebuild/xcrun use the full
        # Xcode install regardless of what xcode-select points at. ~/.zshenv, not ~/.zprofile:
        # zsh reads it for every invocation, including the non-login `ssh host "cmd"` shells
        # augur and provisioning hooks run.
        echo '\''export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer'\'' >> ~/.zshenv
    '

    # augur's managed Claude Code policy — the one settings layer a repo cannot override. Must land
    # before the sudo revoke below, and before the base VM is frozen, since /Library is root-owned.
    # Before custom provisioning: the install replaces the whole policy directory, and the
    # operator's provisioning may then add its own files to it (see install_macos_managed_settings).
    install_macos_managed_settings "$MACOS_BUILD_VM" || { error "Aborting the build; no base VM was saved."; exit 1; }

    # Step 6.5: optional custom provisioning (~/.augur/provision/manifest.conf and/or
    # hook.sh) — no-op unless the operator created those files. See run_base_provisioning.
    run_base_provisioning "$MACOS_BUILD_VM"

    # Scrub any ~/.claude.json this base VM has accumulated (e.g. a manual `claude` login during
    # Setup Assistant / manual verification) before it's frozen into the base image. augur never
    # seeds this file with real account state on purpose — a leaked account here would
    # otherwise be inherited by every `augur up --macos` clone forever. Neither this build script
    # nor run_base_provisioning invokes `claude` interactively, so this is normally a no-op; it
    # exists to guarantee the invariant even when a human has poked at the VM by hand.
    info "Scrubbing any accumulated $(agent_display_name) account state from the base VM..."
    macos_scrub_agent_config "$MACOS_BUILD_VM"

    # Root-owned too. Fatal: every claude/shell session in a clone of a base without it is refused.
    install_macos_session_env_acceptance "$MACOS_BUILD_VM" || exit 1

    # Last, after Homebrew and any custom provisioning: either can leave the Command Line Tools
    # selected, and whatever is selected here is what every project VM clone inherits.
    select_macos_full_xcode "$MACOS_BUILD_VM" \
        || { error "Could not select the full Xcode install in '${MACOS_BUILD_VM}'."; exit 1; }

    # Step 7: Save as base VM
    # Revoke the build-time NOPASSWD sudo grant before saving. Project VMs are cloned from
    # this base, so leaving the grant in place would give the AI agent root access.
    # run_base_provisioning already revoked it when it ran something above; when it was a no-op
    # the grant from Step 4 is still there and this is the first/only revoke.
    if ! provision_files_present; then
        info "Revoking build-time sudo grant..."
        ssh_macos "$MACOS_BUILD_VM" "sudo rm -f /etc/sudoers.d/augur"
    fi

    # Last, on the final guest state: provisioning runs a root hook, so a check any earlier could
    # pass on a binary that was replaced afterwards. Fail closed on a binary that is not the
    # vendor's: the EXIT trap above discards the build VM.
    agent_verify_integrity_macos "$MACOS_BUILD_VM" || {
        agent_signature_check_failed installed
        error "Aborting the build; no base VM was saved."
        exit 1
    }

    # The managed policy installed before custom provisioning must still be augur's, as installed:
    # provisioning's root hook or a cask's postinstall could have replaced or loosened it.
    verify_macos_managed_settings "$MACOS_BUILD_VM" || {
        error "Aborting the build; no base VM was saved."
        exit 1
    }

    # The last guest step: the drop-in installed above must still be live in the guest saved as the
    # base (see verify_macos_session_env_acceptance).
    verify_macos_session_env_acceptance "$MACOS_BUILD_VM" || {
        error "Aborting the build; no base VM was saved."
        exit 1
    }

    info "Saving base VM '${MACOS_BASE_VM}'..."
    stop_and_reap_macos_vm "$MACOS_BUILD_VM" "$MACOS_SCRATCH_VM_PID"
    macos_save_scratch_as_base "$MACOS_BUILD_VM" build
    "$VM_CLI" delete "$MACOS_BUILD_VM" || warn "Could not delete the build VM '${MACOS_BUILD_VM}'; the next build removes it."
    # A rebuilt base VM gets a fresh SSH host key. Discard the key pinned for the previous one
    # (install-cert SSHes into the base VM by name), so the next TOFU accept-new starts clean.
    rm -f "$(vm_known_hosts_file "$MACOS_BASE_VM")"
    host_lock_release "$MACOS_BASE_WRITER_LOCK" build

    success "macOS base VM '${MACOS_BASE_VM}' is ready."
    echo ""
    echo -e "  ${BOLD}augur up --macos${RESET}     → Start VM for current directory"
    echo -e "  ${BOLD}augur claude --macos${RESET} → Launch $(agent_display_name) in VM"
    echo ""
}

# Poll until SSH is actually accepting connections (the VM having an IP does not guarantee
# the SSH daemon is ready). Bounded by a wall-clock budget (default ~2 min) rather than a
# fixed iteration count, so slow per-probe cases (a stale DHCP lease pointing at a dead IP,
# giving "Host is down") can't blow the intended ceiling. Callers may pass a larger budget
# for a cold first boot. Prints the IP on success.
wait_for_macos_ssh() {
    local vm="$1"
    local max_secs="${2:-120}"
    local host port key_opts=()
    [[ -f "$MACOS_SSH_KEY" ]] && key_opts=(-i "$MACOS_SSH_KEY" -o PasswordAuthentication=no -o BatchMode=yes)
    local deadline=$(( SECONDS + max_secs ))
    while (( SECONDS < deadline )); do
        host="$(macos_ssh_host "$vm")"; port="$(macos_ssh_port "$vm")"
        # ServerAlive* caps a probe that connects but then stalls (e.g. sshd accepted the
        # TCP connection while the guest is still mid-boot): without it such a probe blocks
        # forever — ConnectTimeout only bounds the handshake — and wedges the whole retry
        # loop past its nominal timeout, which shows up as an indefinite silent hang.
        [[ -n "$host" && -n "$port" ]] && \
            ssh -F /dev/null \
                -p "$port" \
                -o StrictHostKeyChecking=accept-new \
                -o UserKnownHostsFile="$(vm_known_hosts_file "$vm")" \
                -o LogLevel=ERROR \
                -o ConnectTimeout=5 \
                -o ServerAliveInterval=4 \
                -o ServerAliveCountMax=2 \
                ${key_opts[@]+"${key_opts[@]}"} \
                "${MACOS_SSH_USER}@${host}" true 2>/dev/null && { echo "$host"; return 0; }
        sleep 3
    done
    return 1
}

# Expose the shared workspace inside the VM. The virtiofs automount tag mounts every --dir share
# (read-write, owned by the guest user) under "/Volumes/My Shared Files/<name>". There is NO per-name virtiofs
# tag, so `mount_virtiofs workspace /workspace` silently fails and leaves /workspace empty.
# We just symlink the auto-mounted (per-project) share to a stable path. The sealed system
# volume cannot host a runtime symlink at /workspace (read-only), so we use ~/workspace-<slug>. Idempotent.
#
# NOTE: ~/.claude is deliberately NOT shared — on macOS Claude's credential lives in the Keychain
# (not ~/.claude), so sharing it would persist nothing; auth is injected via the environment instead
# (see ssh_macos_session). ~/.claude is a normal writable local dir in the VM.
ensure_macos_workspace() {
    local vm="$1"
    ssh_macos "$vm" "ln -sfn '/Volumes/My Shared Files/${MACOS_SHARE}' \"\$HOME/${MACOS_SHARE}\""
}

# Point the guest's Claude history (projects/ only) at the per-VM isolated share so this project's
# conversation history persists on the host across clones. For isolation the host side is a
# per-VM directory (~/.augur/claude-projects/<vm>), NOT the host's shared ~/.claude/projects — the
# guest can therefore neither read other projects' transcripts nor write into them. Consequence:
# cross-mode (container<->macOS) resume is not shared and pre-existing sessions under the host's
# ~/.claude/projects aren't auto-listed (they are not destroyed, just not surfaced here). Whatever
# subdir name Claude derives from the guest cwd lands inside the shared parent, so no path-encoding
# assumption is needed. Auth is NOT shared (see the ~/.claude note above). Idempotent.
# AUGUR_AGENT_SEAM | macOS state symlink — in-VM agent projects dir → shared share.
# CONTRACT (state dir): the share name MUST equal agent_state_host_subdir; the in-VM path is
# the agent's projects dir. Keep both in lockstep when swapping agents.
ensure_macos_agent_projects() {
    local vm="$1" dir share
    dir="$(guest_home_relpath "$(agent_state_guest_projects_dir)")" || return 1
    share="/Volumes/My Shared Files/$(agent_state_host_subdir)"
    # The remote script is double-quoted so the two seam constants expand host-side (the share into
    # single quotes); the guest's own $HOME stays escaped. The VM-local projects dir is throwaway
    # (lost on clone), so a non-symlink is replaced with the share.
    ssh_macos "$vm" "
        set -e
        mkdir -p \"\$HOME/$(dirname "$dir")\"
        [ -L \"\$HOME/${dir}\" ] || rm -rf \"\$HOME/${dir}\"
        ln -sfn '${share}' \"\$HOME/${dir}\"
    "
}

# Point the guest's ~/.claude/agents at the per-VM host share so user-level subagent defs created
# in the VM via `/agents` persist across down/up AND destroy/re-clone (the share is host-side,
# under $AUGUR_DIR — untouched by `vm delete`). Mirrors ensure_macos_agent_projects; the share
# name here ("claude-agents") must match the --dir= share cmd_up_macos adds.
# AUGUR_AGENT_SEAM | macOS user-level subagent-defs persistence (share name = agent_state_agents_host_subdir)
ensure_macos_agent_agents() {
    local vm="$1" dir share
    dir="$(guest_home_relpath "$(agent_state_guest_agents_dir)")" || return 1
    share="/Volumes/My Shared Files/$(agent_state_agents_host_subdir)"
    # Only wire the symlink once the host share is actually MOUNTED (it appears only after a
    # `vm run` with the --dir). Guards a VM booted BEFORE this share existed (upgrade-in-place):
    # without this, the agent/shell paths would rm -rf a real VM-local agents dir and leave
    # a DANGLING symlink until the next up. Skipping here leaves it untouched; `down --macos &&
    # up --macos` re-runs `vm run` with the --dir and self-heals. ensure_macos_agent_projects needs
    # no such guard — its share predates this one, so a running VM always already has it.
    # Quoted as in ensure_macos_agent_projects. The VM-local agents dir is throwaway (lost on
    # clone), so a non-symlink is replaced with the share.
    ssh_macos "$vm" "
        set -e
        [ -d '${share}' ] || exit 0
        mkdir -p \"\$HOME/$(dirname "$dir")\"
        [ -L \"\$HOME/${dir}\" ] || rm -rf \"\$HOME/${dir}\"
        ln -sfn '${share}' \"\$HOME/${dir}\"
    "
}

# AUGUR_AGENT_SEAM | macOS peer of apply_guest_profile — wire the opt-in operator profile from the
# READ-ONLY host share into the VM's agent config dir (agent_profile_guest_dir). The share name here must match the --dir=
# cmd_up_macos adds (agent_profile_host_subdir). Same split as the container path: symlink what
# Claude only reads, copy what Claude may rewrite. Unlike the history/agents shares this one is
# host-GLOBAL (no per-VM subdir) — personal tooling is not project-scoped — which is exactly why the
# share is mounted read-only. Idempotent; runs on every `up`.
ensure_macos_agent_profile() {
    local vm="$1" src pdir
    src="/Volumes/My Shared Files/$(agent_profile_host_subdir)"
    pdir="$(guest_home_relpath "$(agent_profile_guest_dir)")" || return 1
    # The seam lists expand HOST-side into plain word lists (`commands skills`); every remote
    # variable stays escaped so it is the guest's shell that expands it.
    ssh_macos "$vm" "
        set -eu
        src='${src}'
        # Only wire once the share is actually MOUNTED (it appears only after a \`vm run\` with the
        # --dir). Guards a VM booted BEFORE this share existed (upgrade-in-place): without it the
        # loop below would replace a real ~/.claude/commands with a DANGLING symlink. Skipping
        # leaves the guest untouched; \`down --macos && up --macos\` re-runs \`vm run\` and self-heals.
        [ -d \"\$src\" ] || exit 0
        mkdir -p \"\$HOME/${pdir}\"
        for d in $(agent_profile_link_dirs); do
            if [ -d \"\$src/\$d\" ]; then
                # Same non-destructive rule as the container peer: never rm -rf a real directory the
                # guest may have created. Empty is free to drop; otherwise move it aside once, and
                # if that name is taken leave the entry unwired rather than destroy either copy.
                if [ ! -L \"\$HOME/${pdir}/\$d\" ] && [ -e \"\$HOME/${pdir}/\$d\" ]; then
                    if rmdir \"\$HOME/${pdir}/\$d\" 2>/dev/null; then
                        :
                    elif [ ! -e \"\$HOME/${pdir}/\$d.pre-profile\" ]; then
                        mv \"\$HOME/${pdir}/\$d\" \"\$HOME/${pdir}/\$d.pre-profile\"
                    else
                        continue
                    fi
                fi
                ln -sfn \"\$src/\$d\" \"\$HOME/${pdir}/\$d\"
            elif [ -L \"\$HOME/${pdir}/\$d\" ]; then
                rm -f \"\$HOME/${pdir}/\$d\"
            fi
        done
        for f in $(agent_profile_copy_files); do
            [ -f \"\$src/\$f\" ] || continue
            cp \"\$src/\$f\" \"\$HOME/${pdir}/\$f\"
        done
    " || warn "Could not wire the operator profile into the VM; continuing without it."
    return 0
}

# Warn when host-side egress state has changed since this VM booted, because a LIVE macOS VM cannot
# pick that change up. Entirely host-side (it compares two host mtimes and never asks the guest
# anything), for the two things pinned at BOOT on this datapath:
#
#   1. gvproxy's DNS ALLOWLIST. gvproxy reads --dns-allowlist exactly ONCE, at startup (a single
#      os.ReadFile in GvproxyConfigure — no watcher, no reload, unlike augur-proxy which polls the
#      merged file's mtime every ~2s). And on this datapath DNS is the FIRST gate: the guest
#      resolves through gvproxy's gateway resolver before augur-proxy ever sees an SNI. So the two
#      directions are ASYMMETRIC on a live VM — a REVOCATION lands at once (augur-proxy reloads and
#      denies), but a newly APPROVED domain stays NXDOMAIN in the guest until a restart. gvproxy
#      cannot be restarted under a live VM: its unixgram socket IS the VM's NIC.
#   2. VM SIZING. `augur-vm set --cpu/--memory` requires the VM stopped, so cmd_up_macos re-applies
#      the resolved sizing only on a boot.
#
# The staleness signal needs NO new state file. The gvproxy pidfile is written when gvproxy STARTS,
# i.e. at the exact moment it snapshotted the DNS allowlist — so "the merged allowlist is newer than
# the gvproxy pidfile" is precisely "gvproxy is enforcing a policy older than the one on disk".
# That is only exact because write_merged_allowlist is content-idempotent (it does not bump the
# mtime when the policy is unchanged); without that this would warn on every single `up`. Both names
# are keyed on the full workspace path, so this never reads another project's state.
#
# It reports what the LAST POLICY WRITE knows. An edit to ./.augur/allowlist.conf that has not been
# approved+merged yet (i.e. `claude --macos` with no intervening `up --macos`) is invisible here —
# by construction, since an unapproved conf has no honored policy to be stale against.
warn_if_macos_egress_pinned() {
    local vm="$1" allowlist gvp_pid
    allowlist="$(proxy_allowlist)"; gvp_pid="$(gvproxy_pidfile)"
    # No pidfile: nothing snapshotted a DNS allowlist for this VM (egress off, or a gvproxy started
    # by an augur that predates this name). Say nothing rather than guess: a false alarm here would
    # train people to ignore the warning that matters.
    [[ -f "$gvp_pid" ]] || return 0
    [[ -f "$allowlist" ]] || return 0
    [[ "$allowlist" -nt "$gvp_pid" ]] || return 0
    warn "The egress allowlist changed since VM '${vm}' booted — the guest will NOT see it yet."
    warn "gvproxy snapshots its DNS allowlist ONCE at startup and DNS is the FIRST gate here, so a"
    warn "newly APPROVED domain stays unresolvable in the guest (a REVOKED one is already denied by"
    warn "the proxy). gvproxy cannot be restarted under a live VM — its socket is the VM's NIC."
    warn "VM sizing (cpu/memory) is pinned at boot too."
    warn "To apply both now: ${BOLD}augur down --macos && augur up --macos${RESET}"
    return 0
}

# AUGUR_AGENT_SEAM | agent managed policy (macOS peer of the Dockerfile's /etc/claude-code block).
# Installed into the BASE VM, never a project clone: /Library is root-owned and project VMs
# deliberately have no sudo grant (build revokes it before the base is saved), so this is the only
# place it can be written. Every clone then inherits it.
#
# Run from BOTH cmd_build_macos and cmd_update_macos so a base VM built before this existed
# self-heals on the next routine update instead of needing a full rebuild — the same reason the
# ~/.claude.json scrub runs in both.
#
# HONEST SCOPE: the base VM's admin password is the published fixed one for a manual-setup build
# (see macos_admin_password()), so this is a policy DEFAULT, not a tamper-proof control — anyone with
# that password can rewrite it. It still does the job it is here for: stopping a repository's own
# settings from re-enabling the auto-updater and swapping out the binary the integrity gate
# verifies. In Container mode the same file IS root-owned against an unprivileged agent.
#
# Deliberately, the policy directory (the target's parent) is wholly augur's in the base VM when
# augur installs its policy: Claude Code reads other managed files from it too, so each install
# replaces the whole directory (macos_managed_settings_swap_sh), and whatever was in it, root's
# included, is discarded with the old one; the names of what was discarded are shown. build and
# update run the operator's custom provisioning (trusted root content) right after it, and that may
# add its own files to the fresh directory; nothing after provisioning replaces it again, and
# verify_macos_managed_settings checks the policy file is still augur's before the base is saved.
# Deliberately, then, the directory is rebuilt on every update from augur's policy plus the
# operator's provisioning: provisioning must be idempotent and recreate what it owns there.
#
# Returns 1, after an error carrying the guest's output, on ANY failure (the policy cannot be
# produced, the VM cannot be reached, or the root script fails or does not report the policy
# live), and build/update then stop without saving the base VM: a base saved with no policy, an
# old one, or a directory someone else can write would hand that state to every clone. One
# exception is only a warning: the policy is live and checked, and only the removal of the old
# directory failed.
install_macos_managed_settings() {
    local vm="$1" script outf out rc=0 _l discarded="" leftover=""
    info "Installing augur's managed $(agent_display_name) policy into the base VM..."
    script="$(macos_managed_settings_vars_sh)" || return 1
    script+=$'\n'"$(macos_policy_checks_sh)"$'\n'"$(macos_managed_settings_swap_sh)"
    outf="$(mktemp)" || { error "Could not create a temporary file."; return 1; }
    # `sudo -S` (inside macos_run_root_script) works whether or not the build-time NOPASSWD grant
    # is still present, which is what lets `update --macos` reach a base VM that no longer has it.
    # The password is this base VM's own admin password (see macos_admin_password()), so this takes
    # no privilege augur's build doesn't already take.
    macos_run_root_script "$vm" "$script" > "$outf" || rc=$?
    out="$(cat "$outf")"; rm -f "$outf"
    # Success is status 0 AND the script's own report that the policy is live, never a status alone.
    if (( rc != 0 )) || ! grep -qx 'AUGUR_POLICY_LIVE' <<< "$out"; then
        error "Could not install the managed $(agent_display_name) policy in the VM:"
        printf '%s\n' "$MACOS_ROOT_SCRIPT_ERR" | show_guest_lines
        return 1
    fi
    while IFS= read -r _l; do
        case "$_l" in
            "AUGUR_POLICY_DISCARDED "*) discarded+="${discarded:+, }${_l#AUGUR_POLICY_DISCARDED }" ;;
            "AUGUR_POLICY_LEFTOVER "*)  leftover="${_l#AUGUR_POLICY_LEFTOVER }" ;;
        esac
    done <<< "$out"
    if [[ -n "$discarded" ]]; then
        info "Discarded with the old policy directory (custom provisioning must recreate what it owns): $(sanitize_guest_text "$discarded")"
    fi
    if [[ -n "$leftover" ]]; then
        warn "The managed $(agent_display_name) policy is installed, but the old policy directory could not be removed: $(sanitize_guest_text "$leftover")"
    fi
    return 0
}

# Fail (return 1, after an error saying what differs) unless base-VM-to-be $1 still holds augur's
# managed policy exactly as install_macos_managed_settings left it: the policy directory a
# root-owned 755 directory, not a symlink, with no ACL entry that allows anything, and in it
# managed-settings.json a root:wheel 644 regular file with no ACL and no other hard link, holding
# agent_managed_settings_json's bytes. Other files in the directory are fine (custom provisioning
# may add them). Read-only. cmd_build_macos and cmd_update_macos run it after everything that
# could change the policy (custom provisioning's root hook, a cask's postinstall), right before
# the sshd drop-in re-check, and refuse to save the base VM when it fails.
verify_macos_managed_settings() {
    local vm="$1" script outf out rc=0
    info "Checking that the base VM still holds augur's managed $(agent_display_name) policy..."
    script="$(macos_managed_settings_vars_sh)" || return 1
    script+=$'\n'"$(macos_policy_checks_sh)"$'\n'"$(macos_managed_settings_check_sh)"
    outf="$(mktemp)" || { error "Could not create a temporary file."; return 1; }
    macos_run_root_script "$vm" "$script" > "$outf" || rc=$?
    out="$(cat "$outf")"; rm -f "$outf"
    (( rc == 0 )) && grep -qx 'AUGUR_POLICY_OK' <<< "$out" && return 0
    error "The base VM no longer holds augur's managed $(agent_display_name) policy as installed:"
    printf '%s\n' "$MACOS_ROOT_SCRIPT_ERR" | show_guest_lines
    error "Custom provisioning must not replace or change augur's $(basename "$(agent_macos_managed_settings_path)"); it may add its own files beside it."
    return 1
}

# The shell assignments both root scripts above start with: base, dir and name (the policy path
# split up; plain constants from agent_macos_managed_settings_path, safe in single quotes) and b64,
# the policy base64-encoded. base64 characters are safe inside single quotes, so the script carries
# the payload as a plain shell value, and the decode restores its exact bytes, quotes, `$`,
# backslashes and trailing newlines included. GNU base64 wraps its output and macOS's does not;
# the newlines are dropped so both give one line. Fails, after an error, when the policy cannot be
# produced.
macos_managed_settings_vars_sh() {
    local dst dir b64
    dst="$(agent_macos_managed_settings_path)"; dir="$(dirname "$dst")"
    if ! b64="$(agent_managed_settings_json | base64 | tr -d '\n')" \
            || [[ ! "$b64" =~ ^[A-Za-z0-9+/]+=*$ ]]; then
        error "Could not produce the managed $(agent_display_name) policy."
        return 1
    fi
    printf "base='%s'; dir='%s'; name='%s'; b64='%s'" "$(dirname "$dir")" "$dir" "$(basename "$dst")" "$b64"
}

# Root shell code both policy scripts share (after macos_managed_settings_vars_sh): the checks.
#   ls_ok PATH TYPE OWNER MODE [deny]: PATH is not a symlink, is of TYPE (test -d or -f), its
#     numeric uid:gid matches the pattern OWNER, its `ls` mode string (less a trailing `@`, `.` or,
#     for an accepted ACL, `+`) matches the pattern MODE, and it has no ACL, or with `deny`, an ACL
#     of deny entries only (deny_only). The ACL comes from macOS's `ls -le`, which lists ACL
#     entries on the lines after the entry's own (`ls -l` alone shows `@` instead of `+` when there
#     are also extended attributes). An `ls -le` that fails or prints nothing is refused, never
#     guessed around.
#   deny_only LS-LDEN-OUTPUT: every ACL line after the first (` 0: group:everyone deny delete`,
#     with `inherited` before `deny` when inherited) is a deny entry. An allow entry, or a line of
#     any other shape, fails.
#   policy_file_ok PATH: ls_ok as a root:wheel 644 regular file with no ACL, one hard link (no other
#     name can change it), and holding exactly the bytes in $b64.
# Absolute tool paths, because the guest's PATH starts at ~/.local/bin. Deliberately
# `base64 --decode`: the spelling both macOS's base64 and GNU's accept. `printf` is a shell
# builtin, so the payload is on no argv (it is not secret either way).
macos_policy_checks_sh() {
    cat <<'SCRIPT'
set -f
nl='
'
deny_only() {
    printf '%s\n' "$1" | {
        IFS= read -r _
        while IFS= read -r a; do
            set -- $a
            case "$1" in [0-9]*:) ;; *) exit 1 ;; esac
            case "${1%:}" in *[!0-9]*) exit 1 ;; esac
            case "$2" in ?*:?*) ;; *) exit 1 ;; esac
            if [ "$3" = inherited ]; then kind="$4"; perms="$5"; else kind="$3"; perms="$4"; fi
            [ "$kind" = deny ] && [ -n "$perms" ] || exit 1
        done
    }
}
ls_ok() {
    [ ! -L "$1" ] && [ "$2" "$1" ] || return 1
    l="$(/bin/ls -ldn "$1")" || return 1
    acl="$(/bin/ls -lden "$1" 2>/dev/null)" && [ -n "$acl" ] || return 1
    owner="$3"; mode="$4"; acl_ok=
    case "$acl" in *"$nl"*) [ "$5" = deny ] && deny_only "$acl" && acl_ok=1 || return 1 ;; esac
    set -- $l
    case "$3:$4" in $owner) ;; *) return 1 ;; esac
    m="${1%[@.]}"
    [ -z "$acl_ok" ] || m="${m%+}"
    case "$m" in $mode) return 0 ;; esac
    return 1
}
policy_file_ok() {
    ls_ok "$1" -f 0:0 -rw-r--r-- || return 1
    set -- "$1" $(/bin/ls -ldn "$1")
    [ "$3" = 1 ] || return 1
    printf '%s' "$b64" | /usr/bin/base64 --decode | /usr/bin/cmp -s - "$1"
}
SCRIPT
}

# Root shell code for verify_macos_managed_settings (after macos_managed_settings_vars_sh and
# macos_policy_checks_sh): read-only, it names the first thing that differs on stderr and exits 1,
# or prints AUGUR_POLICY_OK.
macos_managed_settings_check_sh() {
    cat <<'SCRIPT'
f="$dir/$name"
{ [ -e "$dir" ] || [ -L "$dir" ]; } || { echo "$dir is missing" >&2; exit 1; }
ls_ok "$dir" -d '0:*' drwxr-xr-x deny || { echo "$dir is not a root-owned 755 directory without an ACL that allows anything" >&2; exit 1; }
{ [ -e "$f" ] || [ -L "$f" ]; } || { echo "$f is missing" >&2; exit 1; }
ls_ok "$f" -f 0:0 -rw-r--r-- || { echo "$f is not a root:wheel 644 regular file without an ACL" >&2; exit 1; }
policy_file_ok "$f" || { echo "$f has other hard links or does not hold augur's policy" >&2; exit 1; }
echo AUGUR_POLICY_OK
SCRIPT
}

# Root shell code for install_macos_managed_settings (after macos_managed_settings_vars_sh and
# macos_policy_checks_sh) that replaces the policy directory $dir as a whole, never editing it in
# place, so nothing a non-root user put in or on the old one (entries, hard links, ACLs, a symlink,
# a file or directory where the policy belongs) can survive:
#   0. $base itself must be a real directory owned by root, not writable by group or others, with
#      no ACL that allows anything (any group: stock macOS has root:admin 755), or no other user
#      could be kept from renaming things in it. Refused otherwise.
#   1. A fresh directory is made next to $dir in $base: root:wheel, 755, its ACL stripped
#      (`chmod -N`; mktemp may inherit one from $base). The payload is decoded straight into
#      $name in it, which then gets root:wheel, 644, no ACL. Both are checked before anything
#      goes live; nobody else can write the fresh directory meanwhile.
#   2. The old $dir, whatever it is (a directory, a file, a symlink, which `mv` moves as a link),
#      is moved into a fresh 700 quarantine directory under /var/root, which only root can
#      traverse, so its removal at the end cannot be raced through its path. The names in an old
#      directory, other than $name, are reported (AUGUR_POLICY_DISCARDED <name> on stdout). The
#      fresh directory is then renamed to $dir, a free name by then, so `mv` cannot put it inside
#      anything.
#      Accepted trade-off: a process already holding a directory of the old tree open (its cwd)
#      can still change that directory during the removal; `rm -rf` does not follow symlinks, so
#      at worst it removes less.
#   3. The live $dir and its file are checked again, and only then is AUGUR_POLICY_LIVE printed on
#      stdout: the host takes nothing else as success. Then the quarantine is removed; when that
#      fails, the script reports it (AUGUR_POLICY_LEFTOVER <path>) and still exits 0. Deliberately
#      not a failure: the policy is in place, and the leftover sits under /var/root, which only
#      root can reach.
# Any other failure exits 1 with the reason on stderr (fail): the fresh directory is removed (after
# step 2's rename, by moving the new $dir into the quarantine), an old $dir already moved aside is
# put back, and the quarantine is removed once nothing of the old one is left in it. When either
# move fails, it says so, says where the old one is, and keeps the quarantine.
macos_managed_settings_swap_sh() {
    cat <<'SCRIPT'
fresh=; quar=; moved=; live=
fail() {
    echo "$1" >&2
    [ -z "$fresh" ] || /bin/rm -rf "$fresh"
    if [ -n "$live" ] && ! /bin/mv "$dir" "$quar/new"; then
        echo "cannot move the new $dir aside${moved:+, so the old one was not put back; it is at $quar/old}" >&2; exit 1
    fi
    if [ -n "$moved" ]; then
        /bin/mv "$quar/old" "$dir" || { echo "cannot put the old $dir back; it is at $quar/old" >&2; exit 1; }
    fi
    [ -z "$quar" ] || /bin/rm -rf "$quar"
    exit 1
}
# Deliberately tolerates a deny-only ACL on $base: a deny entry cannot grant anyone write.
ls_ok "$base" -d '0:*' 'd????[!w]??[!w]?' deny || fail "$base is not a directory owned by root, unwritable by group and others, without an ACL that allows anything"
fresh="$(/usr/bin/mktemp -d "$base/.augur-policy.XXXXXX")" || { fresh=; fail "cannot create a directory in $base"; }
/usr/sbin/chown root:wheel "$fresh" && /bin/chmod 755 "$fresh" && /bin/chmod -N "$fresh" || fail "cannot make $fresh root:wheel 755 without an ACL"
printf '%s' "$b64" | /usr/bin/base64 --decode > "$fresh/$name" || fail "cannot decode the policy"
/usr/sbin/chown root:wheel "$fresh/$name" && /bin/chmod 644 "$fresh/$name" && /bin/chmod -N "$fresh/$name" \
    || fail "cannot make the policy file root:wheel 644 without an ACL"
ls_ok "$fresh" -d 0:0 drwxr-xr-x && policy_file_ok "$fresh/$name" || fail "the new policy is not root:wheel without an ACL"
quar="$(/usr/bin/mktemp -d /var/root/.augur-quarantine.XXXXXX)" || { quar=; fail "cannot create a quarantine directory in /var/root"; }
/bin/chmod 700 "$quar" && /bin/chmod -N "$quar" || fail "cannot make $quar 700 without an ACL"
if [ -e "$dir" ] || [ -L "$dir" ]; then /bin/mv "$dir" "$quar/old" && moved=1 || fail "cannot move the old $dir aside"; fi
if [ -n "$moved" ] && [ -d "$quar/old" ] && [ ! -L "$quar/old" ]; then
    /bin/ls -A "$quar/old" | while IFS= read -r e; do [ "$e" = "$name" ] || echo "AUGUR_POLICY_DISCARDED $e"; done
fi
/bin/mv "$fresh" "$dir" || fail "cannot move the new policy directory to $dir"
fresh=; live=1
ls_ok "$dir" -d 0:0 drwxr-xr-x && policy_file_ok "$dir/$name" && [ "$(/bin/ls -A "$dir")" = "$name" ] \
    || fail "$dir is not exactly the new policy after the swap"
echo AUGUR_POLICY_LIVE
/bin/rm -rf "$quar" || { echo "cannot remove the old policy directory, left in $quar" >&2; echo "AUGUR_POLICY_LEFTOVER $quar"; }
exit 0
SCRIPT
}

# The sshd drop-in that lets a macOS guest receive a session's credentials, and the one line in it.
# macOS's /etc/ssh/sshd_config includes /etc/ssh/sshd_config.d/*, and AcceptEnv patterns from every
# file add up, so this sits beside macOS's own `AcceptEnv LANG LC_*` without replacing it. The
# names are exact, never patterns: the guest accepts the credentials augur sends and nothing else
# a client might.
macos_session_sshd_dropin() { echo "/etc/ssh/sshd_config.d/200-augur-session-env.conf"; }
# The drop-in's line for the names $1 (macos_session_env_names).
macos_session_accept_env_line() { printf 'AcceptEnv %s' "$1"; }

# The marker line between the admin password and the script on macos_run_root_script's stdin. A
# shell comment, so a password that happened to equal it would still run nothing.
MACOS_ROOT_SCRIPT_BEGIN='#augur-root-script'

# Run shell script $2 as root in macOS VM $1 over ONE ssh connection, with nothing staged in the
# guest: a script written to a file first could be swapped by any process of the guest user before
# root runs it. The connection's stdin carries the VM's admin password line, the marker line
# (MACOS_ROOT_SCRIPT_BEGIN), then the script, and the guest runs `sudo -S -k -p ''` on a root
# shell that skips to the marker and runs the rest (`sh -s`):
#   • `sudo -S` reads the password one byte at a time up to its newline, so it takes that line and
#     nothing after it. -k makes it ignore a cached credential, which would skip the read.
#   • A NOPASSWD grant (a build has one until it revokes it) still skips the read. Hence the
#     marker: whether or not sudo read the password, the root shell discards every line up to the
#     marker, so the password never reaches the shell that runs the script, where an unknown
#     command would print it into the output.
# A wrong password makes sudo fail after taking further lines as retries, so the script never runs.
# The script must not read stdin itself (it is that stdin). The password is on no argv (see
# macos_admin_password_stdin).
# Its stdout and exit status are the caller's. Its stderr (sudo's, the script's, ssh's) is guest
# text and is NOT passed on: it is left in MACOS_ROOT_SCRIPT_ERR, for the caller to show through
# show_guest_lines. augur's own messages go to stderr as usual: before connecting, a VM with no
# stored admin password or no SSH transport is refused (return 1, after augur's error), so nothing
# connects without a password to send.
MACOS_ROOT_SCRIPT_ERR=""
macos_run_root_script() {
    local vm="$1" script="$2" _rc=0
    MACOS_ROOT_SCRIPT_ERR=""
    # Accepted trade-off: the transport can stop resolving between the checks below and the connection;
    # ssh_macos then reports it, and that error lands in MACOS_ROOT_SCRIPT_ERR as if from the guest.
    ( require_macos_admin_password "$vm" ) || return 1
    macos_ssh_transport_ok "$vm" || { error "Cannot reach VM '${vm}' over SSH: its SSH host or port does not resolve."; return 1; }
    { MACOS_ROOT_SCRIPT_ERR="$(
    { macos_admin_password_stdin "$vm" && printf '%s\n' "$MACOS_ROOT_SCRIPT_BEGIN" "$script"; } \
        | ssh_macos "$vm" "sudo -S -k -p '' /bin/sh -c 'm=; while IFS= read -r l; do if [ \"\$l\" = \"${MACOS_ROOT_SCRIPT_BEGIN}\" ]; then m=1; break; fi; done; [ -n \"\$m\" ] && exec /bin/sh -s; exit 1'" 2>&1 >&3 3>&-
    )"; } 3>&1 || _rc=$?
    return "$_rc"
}

# The credential names of an augur session (session_credential_names) on one line, space-separated,
# for a root shell script, the drop-in's line (macos_session_accept_env_line) and the session check
# (macos_session_env_check_cmd), which take this output and validate nothing themselves. Fails,
# after an error, on a name that is not a shell variable name.
macos_session_env_names() {
    local _n _names=""
    while IFS= read -r _n; do
        valid_env_name "$_n" || { error "Refusing to write an sshd AcceptEnv for the credential name '${_n}'."; return 1; }
        _names+="${_names:+ }${_n}"
    done < <(session_credential_names)
    printf '%s' "$_names"
}

# Root shell code (for macos_run_root_script) that creates the temp file "$err" and defines
# `accepts [sshd -T args]`: true iff that sshd configuration parses and accepts every name in $1,
# from ONE sshd -T run, with sshd's own message (or the name it lacks) in "$err" otherwise. macOS
# prints `AcceptEnv <NAME>`, one name per line; upstream OpenSSH prints `acceptenv`. The one test of
# acceptance, for both install_macos_session_env_acceptance and
# verify_macos_session_env_acceptance.
macos_session_env_accepts_sh() {
    cat <<SCRIPT
err="\$(mktemp)" || exit 1
accepts() {
    out="\$(/usr/sbin/sshd -T "\$@" 2>"\$err" </dev/null)" || return 1
    envs="\$(printf '%s\n' "\$out" | awk 'tolower(\$1) == "acceptenv" { for (i = 2; i <= NF; i++) print \$i }')"
    for n in $1; do
        printf '%s\n' "\$envs" | grep -qxF "\$n" || { echo "sshd does not accept \$n" >> "\$err"; return 1; }
    done
}
SCRIPT
}

# Make base-VM-to-be $1's sshd accept the credential names of an augur session (see
# ssh_macos_session), and prove it took. Returns non-zero, after an error carrying sshd's own
# message, when it did not; callers refuse to save the base VM then, since every claude/shell
# session in its clones would be refused.
#
# macOS starts a new sshd for every connection (launchd), so a file in sshd_config.d is live for
# the very next login: one sshd cannot parse would lock SSH out of the guest at once. So, as root
# (macos_run_root_script), the candidate is checked BEFORE it goes live: written outside
# sshd_config.d, then `sshd -T -f <test config>` (a copy of /etc/ssh/sshd_config that also includes
# the candidate) must parse and accept every name. Only then is it renamed into sshd_config.d, the
# live configuration is checked the same way (removing the drop-in again if that fails), and one
# fresh connection proves sshd still lets augur in. Script exit codes: 2, the candidate is
# rejected; 3, the live configuration is; 4 (set here), no fresh connection.
#
# Accepted trade-off: when that fresh connection fails, the drop-in stays live and nothing rolls it
# back, so the guest may be locked out of SSH. Only a scratch VM kept with AUGUR_KEEP_BUILD_VM=1 for
# debugging can be affected: the failure is fatal, so the build or update never saves that guest as
# the base VM, and the scratch VM is otherwise deleted. A rollback timer in the guest, or a probe
# from inside it, would need a detached root process or guest-side SSH credentials, and neither can
# be verified off a Mac.
install_macos_session_env_acceptance() {
    local vm="$1" dst _line _names _script _err _rc=0
    dst="$(macos_session_sshd_dropin)"
    _names="$(macos_session_env_names)" || return 1
    _line="$(macos_session_accept_env_line "$_names")"
    info "Configuring the base VM's sshd to accept augur's session credentials (${_names})..."
    _script="$(macos_session_env_accepts_sh "$_names"; cat <<SCRIPT
dst='${dst}'; cand=/etc/ssh/augur-session-env.candidate; main=/etc/ssh/augur-session-env.sshd_config
cleanup() { rm -f "\$cand" "\$main" "\$err"; }
printf '%s\n' '# augur: the credential names an augur claude/shell session sends.' '${_line}' > "\$cand" \
    && chown root:wheel "\$cand" && chmod 644 "\$cand" \
    && { printf 'Include %s\n' "\$cand"; cat /etc/ssh/sshd_config; } > "\$main" || { cleanup; exit 1; }
accepts -f "\$main" || { cat "\$err" >&2; cleanup; exit 2; }
mv -f "\$cand" "\$dst" || { cleanup; exit 1; }
accepts || { cat "\$err" >&2; rm -f "\$dst"; cleanup; exit 3; }
cleanup
SCRIPT
)"
    macos_run_root_script "$vm" "$_script" >/dev/null || _rc=$?
    _err="$MACOS_ROOT_SCRIPT_ERR"
    if (( _rc == 0 )) && ! ssh_macos "$vm" true </dev/null; then
        _rc=4; _err="no new SSH connection is accepted after installing ${dst}"
    fi
    (( _rc == 0 )) && return 0
    error "Could not make the base VM's sshd accept augur's session credentials (${dst}):"
    printf '%s\n' "$_err" | show_guest_lines
    return 1
}

# Re-check base-VM-to-be $1 the two ways its clones depend on, as root in one connection: the live
# sshd configuration still accepts every name (the `sshd -T` test the install ran; exit 3), and the
# drop-in still holds the exact line every clone's `up` and session check for
# (macos_session_env_check_cmd, the very command they run; exit 5). The two can disagree: sshd may
# accept the names from another file while the drop-in has changed or gone, and then every clone
# would be refused. cmd_build_macos and cmd_update_macos run it as their last guest step before the
# VM is saved as the base, so nothing that ran after the install (Homebrew, the agent installer,
# custom provisioning's root hook) can leave a base whose clones refuse every session. Returns
# non-zero, after an error carrying sshd's own message or the failed check, when either fails;
# callers then refuse to save the base VM.
verify_macos_session_env_acceptance() {
    local vm="$1" _names _check _script _err _rc=0
    _names="$(macos_session_env_names)" || return 1
    _check="$(macos_session_env_check_cmd "$_names")"
    info "Checking that the base VM's sshd still accepts augur's session credentials..."
    _script="$(macos_session_env_accepts_sh "$_names")"
    _script+=$'\naccepts || { cat "$err" >&2; rm -f "$err"; exit 3; }\nrm -f "$err"'
    _script+=$'\n'"${_check} || { echo \"$(macos_session_sshd_dropin) does not hold the line every clone checks for: $(macos_session_accept_env_line "$_names")\" >&2; exit 5; }"
    macos_run_root_script "$vm" "$_script" >/dev/null || _rc=$?
    _err="$MACOS_ROOT_SCRIPT_ERR"
    (( _rc == 0 )) && return 0
    error "The base VM's sshd no longer accepts augur's session credentials ($(macos_session_sshd_dropin)):"
    printf '%s\n' "$_err" | show_guest_lines
    return 1
}

# Point the VM's system-wide developer directory at the full Xcode install. Homebrew's installer
# adds the Command Line Tools and switches `xcode-select` to them, and a shell that does not set
# DEVELOPER_DIR itself (e.g. a plain `ssh_macos "$vm" "xcodebuild …"`) then fails with "tool
# 'xcodebuild' requires Xcode". Callers run this after everything that might install the CLT.
# `sudo -S` for the same reason as install_macos_managed_settings: it works with or without the
# build-time NOPASSWD grant. Returns non-zero if the selection did not take.
select_macos_full_xcode() {
    local vm="$1" dev="/Applications/Xcode.app/Contents/Developer"
    info "Selecting the full Xcode install as the developer directory..."
    macos_admin_password_stdin "$vm" | ssh_macos "$vm" "sudo -S -p '' xcode-select -s '${dev}' && [ \"\$(xcode-select -p)\" = '${dev}' ]"
}

# Fail (return 1, with the remedy on stderr) unless project VM $1 has the agent CLI at
# macos_agent_bin. The base VM build and `augur update --macos` are the only places augur installs
# it, so a VM without it is never patched from inside: the fix is a base VM that has it.
# Deliberately NO signature check here: a project VM is guest-controlled (a prior session can replace
# the binary and also fake codesign itself), so the check would prove nothing, and `claude` gets
# nothing the guest does not already hold. The check guards where a binary is attached to the
# operator's TTY to capture a credential, i.e. setup-token, which runs in a fresh clone.
# AUGUR_AGENT_SEAM | macOS agent presence (installed by build/update at agent_macos_cli_relpath).
ensure_macos_agent_bin() {
    local vm="$1" bin state
    bin="$(macos_agent_bin)"
    state="$(ssh_macos "$vm" "if [ -x '${bin}' ]; then echo present; else echo missing; fi" 2>/dev/null || true)"
    case "$state" in
        *present*) return 0 ;;
        *missing*) error "$(agent_display_name) is not installed in VM '${vm}' (${bin})." ;;
        *)         error "Could not check for $(agent_display_name) in VM '${vm}' over SSH." ;;
    esac
    error "  Install it in the base VM: ${BOLD}augur update --macos${RESET} (or rebuild: ${BOLD}augur build --macos${RESET}),"
    error "  then recreate this project's VM from it: ${BOLD}augur destroy --macos && augur up --macos${RESET}"
    return 1
}

# The last line of every ~/.augur-env push. The guest installs the new file only when it ends with
# this line, so content cut short in transit never replaces a working file.
MACOS_AUGUR_ENV_END_LINE='# augur-env: end'

# Append NAME=value $1 to the caller's `_content` as the line `export NAME='value'`, for a guest
# shell to run: ~/.augur-env, which the guest sources (push_macos_guest_env), and git's credential
# helper in a session's remote command (macos_session_git_env_cmd). The single quotes keep the value
# literal, so the `$GH_TOKEN` in git's helper stays a reference. Fails closed, after an error naming
# the variable and with nothing appended, when NAME is not a shell variable name or the value holds
# a single quote (the one character that ends a single-quoted string) or a control byte (a newline
# would start a second line of shell).
macos_env_add_export() {
    local name="${1%%=*}" value="${1#*=}"
    if [[ "$1" != *=* ]] || ! valid_env_name "$name"; then
        error "Refusing to write '${name}' into the guest env: not NAME=value with a valid variable name."
        return 1
    fi
    validate_secret_value "$name" "$value" || return 1
    _content+="export ${name}='${value}'"$'\n'
}

# Write VM $1's ~/.augur-env and make ~/.zshenv source it, in one ssh session. ~/.augur-env holds
# the guest's per-VM environment, and no credential: the Homebrew shellenv, the agent's PATH,
# DEVELOPER_DIR and agent_fixed_env. Credentials reach a guest only as the environment of an
# augur-started session, and git's credential helper only in that session's remote command
# (ssh_macos_session). Nothing here reads the caller's `_creds`, so a push carries no secret and is
# safe before any self-test.
# cmd_up_macos calls it on every boot and every `augur up --macos` against a running VM, and
# prepare_macos_session on every `augur claude --macos` / `augur shell --macos` against a running
# VM. A guest zsh that is already running keeps the environment it sourced at its start.
#
# A ~/.augur-env written by an older augur (and a ~/.augur-env.tmp.* its killed push left) holds
# the credentials and git's helper set, and ~/.zshenv sources that file in every shell of every
# session, after sshd has set the session's credentials, so its `export` lines would replace them.
# The file is rewritten whole every time, so it holds only what the latest push wrote: such a
# guest loses them at its first push. Hence every session pushes before it launches
# (prepare_macos_session), and every refusal of a running VM pushes before it refuses
# (refuse_running_macos_vm; the acceptance check below refuses inside the push itself). Accepted
# trade-off: the rename frees the old file's blocks without overwriting them, so an older augur's
# credential bytes may remain in the clone's free disk space; the remedy for such a VM
# (macos_session_env_refused) deletes the clone. Every line goes through macos_env_add_export.
#
# The first step of every push, before anything is written, checks that the guest accepts a
# session's credentials (macos_session_env_check_cmd). A guest that does not still gets its new
# ~/.augur-env and ~/.zshenv line, so the credentials an older augur wrote leave it, and then the
# push fails with the remedy (macos_session_env_refused). The refusal is reported whichever later
# step failed, together with that step, so no session follows a refusal.
#
# With `--refusing` as $2 the caller refuses the VM after this push whatever it returns, so a push
# that could not rewrite ~/.augur-env, or whose outcome is unknown, also says that the file may
# still hold an older augur's credentials, as a refusal by the check does.
#
# Returns non-zero, after saying what happened, when the push did not install everything; callers
# decide whether that is fatal. The status says what a second attempt could change
# (push_macos_guest_env_retrying):
#   1  it cannot work: a value cannot be written safely (macos_env_add_export) or a credential name
#      is not a variable name (nothing is sent to the guest then, because the whole content is
#      built before the ssh), there is no SSH transport to the VM (macos_ssh_transport_ok; nothing
#      is sent then either), or the guest's ~/.zshenv could not be updated (its new ~/.augur-env
#      is in place).
#   2  the guest was refused (MACOS_PUSH_REFUSED_RC), whatever else failed.
#   3  the guest kept its old ~/.augur-env (a failed write: a full disk, or this push's temp file
#      gone before its rename), or the outcome is unknown (ssh failure)
#      (MACOS_PUSH_RETRYABLE_RC).
push_macos_guest_env() {
    local vm="$1" _refusing=false _kv _content _cmd _names _check _find _rc=0
    [[ "${2:-}" == --refusing ]] && _refusing=true
    local _env="/Users/${MACOS_SSH_USER}/.augur-env"
    local _tmp="${_env}.tmp.\$\$"
    _content='# augur (rewritten on every up and session; local edits are lost)'$'\n'
    _content+='eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true'$'\n'
    _content+="export PATH=\"\$HOME/$(macos_agent_bindir_rel):\$PATH\"   # $(agent_cli_name) (official installer)"$'\n'
    # Also written into the base VM's ~/.zshenv at build time; repeated here because a base VM built
    # by an older augur has it only in ~/.zprofile, which non-login SSH shells never read.
    _content+='export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer'$'\n'
    # The agent's fixed env goes in the file so every guest zsh session (a shell, an ssh one-off, the
    # agent started by hand) sees it, as in Container mode where it is part of the image environment.
    for _kv in $(agent_fixed_env); do macos_env_add_export "$_kv" || return 1; done
    _content+="$MACOS_AUGUR_ENV_END_LINE"

    # Guest side, in one ssh session:
    #   0. The acceptance check. A refusal adds 10 to the exit status of a failing step 2 or 3
    #      below (11, 14), and is acted on after step 3 (exit 10).
    #   1. Remove temp files left by an earlier push whose ssh was killed mid-write (see above for
    #      an older augur's): every `.augur-env.tmp.*` but this push's own that is older than a
    #      minute, or whose mtime is more than a minute ahead of the guest's clock (newer than a
    #      reference file touched to a minute from now). A file written before a reboot looks that
    #      way while the guest clock lags right after a boot, which a plain age test would take for
    #      a fresh one. A concurrent push finishes well within the minute and dates its file by the
    #      same clock, so it keeps its file. A file less than a minute ahead stays until a later push
    #      finds it older than a minute. `date -r <seconds>` is macOS's form and `date -d @<seconds>`
    #      GNU's; when neither works, the reference keeps its mtime of now, the plain "ahead of the
    #      clock" test. Accepted trade-off: a step of the guest clock between two concurrent pushes
    #      (or that fallback) can still make one's file look stale to the other, which then loses
    #      its file and fails with the old file in place (exit 1); its caller tries once more
    #      (push_macos_guest_env_retrying). When the guest cannot create the reference file
    #      (mktemp fails), only the age test runs, so old files still go. Best-effort: a failed
    #      cleanup does not stop the install.
    #   2. ~/.augur-env, atomically: the content goes to this session's temp file, created under
    #      umask 077 (mode 600), and is renamed over ~/.augur-env only if its last line is the end
    #      marker. A zsh starting at the same moment (a second `augur shell --macos`) sources either
    #      the old file or the new one, never a partial one. Any failure here exits 1 with the old
    #      file in place.
    #   3. The ~/.zshenv line that sources it (exit 4 if that fails). Accepted trade-off: two pushes
    #      racing here can both append it; a repeated line only sources the same file twice, and
    #      macos_scrub_augur_credentials removes every copy.
    # Any other status (ssh's own 255 when the connection drops) leaves the outcome unknown: the drop
    # may have come before or after the rename, and before or after the check.
    _names="$(macos_session_env_names)" || return 1
    _check="$(macos_session_env_check_cmd "$_names")"
    _cmd="_acc=0; ${_check} || _acc=10"
    _find="find /Users/${MACOS_SSH_USER} -maxdepth 1 -name '.augur-env.tmp.*' ! -name ${_tmp##*/}"
    _cmd+="; _ref=\$(mktemp /tmp/augur-env-ref.XXXXXX 2>/dev/null) || _ref=''"
    _cmd+="; if [ -n \"\$_ref\" ]; then _t=\$(( \$(date +%s) + 60 ))"
    _cmd+="; touch -t \"\$(date -r \"\$_t\" +%Y%m%d%H%M.%S 2>/dev/null || date -d \"@\$_t\" +%Y%m%d%H%M.%S 2>/dev/null)\" \"\$_ref\" 2>/dev/null"
    _cmd+="; ${_find} \\( -mmin +1 -o -newer \"\$_ref\" \\) -exec rm -f {} + 2>/dev/null; rm -f \"\$_ref\""
    _cmd+="; else ${_find} -mmin +1 -exec rm -f {} + 2>/dev/null; fi"
    _cmd+="; rm -f ${_tmp} && ( umask 077 && cat > ${_tmp} ) && [ \"\$(tail -n 1 ${_tmp})\" = '${MACOS_AUGUR_ENV_END_LINE}' ] && mv -f ${_tmp} ${_env} || { rm -f ${_tmp}; exit \$((1 + _acc)); }"
    _cmd+="; { grep -q '.augur-env' ~/.zshenv 2>/dev/null || echo '${MACOS_AUGUR_ENV_SOURCE_LINE}' >> ~/.zshenv; } || exit \$((4 + _acc))"
    _cmd+="; [ \$_acc = 0 ] || exit 10"
    # Checked here, not left to ssh_macos, whose exit on an unresolvable host or port would look,
    # inside the pipeline below, like a failed write (see _macos_ssh_cmd). A transport lost between
    # this check and the ssh still reads as a failed write, and the retry then stops here.
    if ! macos_ssh_transport_ok "$vm"; then
        warn "No SSH transport to VM '${vm}' (its SSH host or port cannot be resolved; is its gvproxy running?)."
        warn "  Nothing was pushed: the guest's ~/.augur-env is unchanged."
        if $_refusing; then warn "  It may still hold credentials an older augur wrote into it."; fi
        return 1
    fi
    # Only ssh's status counts: the guest checked the end marker, so a printf cut short by an early
    # close cannot have installed anything.
    printf '%s\n' "$_content" | ssh_macos "$vm" "$_cmd" || _rc="${PIPESTATUS[1]}"
    local _refused=false _ret=1
    case "$_rc" in 10|11|14) _refused=true; _refusing=true; _rc=$(( _rc - 10 )) ;; esac
    case "$_rc" in
        0) _ret=0 ;;
        4) warn "VM '${vm}' got its new ~/.augur-env, but ~/.zshenv could not be updated to source it." ;;
        1) _ret="$MACOS_PUSH_RETRYABLE_RC"
           warn "Could not write ~/.augur-env in VM '${vm}'; the guest's ~/.augur-env is unchanged."
           if $_refusing; then warn "  It may still hold credentials an older augur wrote into it."; fi ;;
        *) _ret="$MACOS_PUSH_RETRYABLE_RC"
           warn "The ~/.augur-env push to VM '${vm}' has an unknown outcome (ssh exit ${_rc}); the guest may hold the old or the new file."
           if $_refusing; then warn "  The old one may still hold credentials an older augur wrote into it."; fi ;;
    esac
    if $_refused; then
        macos_session_env_refused "$vm"
        return "$MACOS_PUSH_REFUSED_RC"
    fi
    return "$_ret"
}
# push_macos_guest_env's statuses for a refused guest, and for a push a second attempt may fix.
MACOS_PUSH_REFUSED_RC=2
MACOS_PUSH_RETRYABLE_RC=3

# push_macos_guest_env for a push that must succeed (the boot's, `up` on a running VM's, every
# session's), tried a second time when the first failed in a way that may pass: a dropped or
# failed ssh connection, or a write that failed with the old file in place, which is also how a
# push fails whose temp file a concurrent push removed (see push_macos_guest_env). Once only, and
# at once: a guest that fails twice in a row is not having a passing hiccup. Returns the status of
# the last attempt.
#
# Deliberately never retries a refusal: the guest does not accept a session's credentials, which no
# second attempt changes, and the refusal must stop the caller at once. Deliberately not retried
# either: a ~/.zshenv that could not be updated (status 1), which fails the same way every time,
# and a push that sent nothing (an unsafe value, no SSH transport to the VM).
push_macos_guest_env_retrying() {
    local _rc=0
    push_macos_guest_env "$1" || _rc=$?
    (( _rc == MACOS_PUSH_RETRYABLE_RC )) || return "$_rc"
    warn "Trying the ~/.augur-env push to VM '$1' once more..."
    push_macos_guest_env "$1"
}

# Tolerance, in seconds, for both the "is it worth correcting" test and the read-back after
# correcting. One constant so the two can't drift apart. 5s: nothing that consumes the clock (JWT
# nbf/exp windows, X.509 validity) can tell 5s from 0, and it sits above the normal 0–1s noise of
# reading both clocks at whole-second granularity across an SSH round-trip.
_MACOS_CLOCK_TOLERANCE_S=5

# The guest's CLOCK_REALTIME in epoch seconds, or nothing at all. The output shape is checked
# rather than scrubbed: `ssh` runs the command under the guest's zsh, which sources ~/.zshenv (and
# so augur's ~/.augur-env), and anything else printed on that path would otherwise be spliced into
# the number and silently move the clock.
_macos_guest_epoch() {
    local raw
    raw="$(ssh_macos "$1" '/bin/date +%s' 2>/dev/null || true)"
    raw="${raw//[[:space:]]/}"
    if [[ "$raw" =~ ^[0-9]{10,11}$ ]]; then printf '%s' "$raw"; fi
    return 0
}

# Set the guest's wall clock from the host's, over SSH, on every path that hands a guest to the
# agent. A cloned macOS guest boots a fixed ~95 min behind the host (the offset is inherited from
# the base VM), so a freshly issued token looks not-yet-valid and git/TLS timestamps are skewed.
# - Not NTP: UDP has no path out of the egress datapath, by design.
# - The host's clock, not the guest's own kern.monotonicclock: nothing guarantees the latter
#   tracks real time on another host or Virtualization.framework version.
# - Written with `sudo -S` fed the admin password, as for every privileged command in a project
#   guest (clones have no passwordless sudo). This is guest-side; augur's sudo-free rule is
#   about the host. `/bin/date` is absolute because ~/.augur-env puts ~/.local/bin first, where a
#   previous guest session could shadow `date` (hygiene, not a security control).
# - Best-effort: warns and continues, never fails `up`. A wrong clock degrades the guest but does
#   not uncontain it — unlike verify_macos_egress_locked, which must exit on failure.
sync_macos_guest_clock() {
    local vm="$1" tol="$_MACOS_CLOCK_TOLERANCE_S" host_epoch guest_epoch drift adrift stamp setout
    # Read first. This is what makes the correction idempotent across the four call sites (a second
    # `up`, or a `claude`/`shell` attach, must not re-`sudo` a guest that is already right), and it
    # is also the only way to report HOW far off the guest was rather than just "we set the clock".
    host_epoch="$(date +%s)"
    guest_epoch="$(_macos_guest_epoch "$vm")"
    if [[ -z "$guest_epoch" ]]; then
        warn "Could not read the guest's clock over SSH; leaving it as it is."
        warn "  A guest clock behind the host's can make a freshly issued token look not-yet-valid."
        return 0
    fi
    drift=$(( guest_epoch - host_epoch )); adrift="${drift#-}"
    if (( adrift <= tol )); then return 0; fi

    info "Guest clock is ${drift}s off the host's — correcting from the host."
    # Stamped fresh, NOT derived from the $host_epoch read before the round-trip above, so the value
    # sent is the host's time now. `date`'s own positional setting format — [[[mm]dd]HH]MM[[cc]yy][.SS]
    # read as UTC under -u — is used rather than a `-f %s` parse: it is what the guest's `date(1)`
    # documents in its synopsis, and `+%m%d%H%M%Y.%S` needs only POSIX conversion specifiers on the
    # host side, so this line does not depend on BSD `date` (`date -r <seconds>` would have, and the
    # offline test tier runs on a Linux runner).
    stamp="$(date -u +%m%d%H%M%Y.%S)"
    setout="$(macos_admin_password_stdin "$vm" | ssh_macos "$vm" "sudo -S -p '' /bin/date -u '${stamp}'" 2>&1)" || {
        warn "Could not set the guest's clock (${drift}s off the host's): $(sanitize_guest_text "${setout%%$'\n'*}")"
        warn "  Tokens, TLS validity windows and commit timestamps in the guest will use that skewed clock."
        return 0
    }

    # VERIFY, do not trust the exit status. It only covers the two failures `sudo`/`date` report —
    # a rejected password and a malformed stamp. It cannot see the third: /usr/libexec/timed is
    # running in the guest, and `systemsetup -getusingnetworktime` needs root even to READ, so augur
    # cannot cheaply know whether network time is on. In augur's own datapath timed has no reference
    # to step back to (UDP/123 is dropped, see above — measured: this offset held byte-identical for
    # 7h36m with timed live), and under --no-egress NAT it would correct the clock to the same answer
    # anyway. But "the command exited 0 and the clock is still wrong" is precisely the silent case a
    # read-back turns into a named warning, for one extra round-trip on a path that already makes a
    # dozen.
    host_epoch="$(date +%s)"
    guest_epoch="$(_macos_guest_epoch "$vm")"
    if [[ -z "$guest_epoch" ]]; then
        warn "Set the guest's clock but could not read it back to confirm."
        return 0
    fi
    drift=$(( guest_epoch - host_epoch )); adrift="${drift#-}"
    if (( adrift > tol )); then
        warn "The guest's clock is still ${drift}s off the host's after being set."
        warn "  Something in the guest is overriding it; tokens and TLS validity may be misjudged there."
        return 0
    fi
    success "Guest clock synchronised with the host (within ${adrift}s)."
    return 0
}

# Keep the guest's console session usable from a --gui window. Auto-login does log the admin in, but
# two things then put the lock screen — which looks just like a login screen — in front of it:
# macOS 27's automated provisioning sets "log in automatically, then lock the screen", and the
# virtual display goes to sleep after a minute or so of no input, which locks it again. Nothing
# headless notices either, which is why only a window shows it. So: no lock after auto-login, no
# display/system sleep, no screen saver on the login window or the session, no password after the
# screen saver. This relaxes the GUI lock only; SSH, sudo and the egress controls are untouched.
# - System-wide settings go through `sudo -S` fed the admin password, as for the clock; the
#   per-user ones (the session's screen saver) run as the admin itself, in the same round-trip.
# - Applied in the base VM build (so a clone's first auto-login is already unlocked) AND again on every
#   fresh boot: the screen saver's idle time is a per-host preference that a clone does not reliably
#   keep, and the boot-time pass also covers a base VM built before this existed. The writes are
#   idempotent. Absolute tool paths, because the guest's PATH starts at ~/.local/bin.
# - Best-effort: warns and continues, never fails `up` — a locked screen degrades the --gui window,
#   it does not uncontain anything.
configure_macos_guest_session() {
    local vm="$1" out
    out="$(macos_admin_password_stdin "$vm" | ssh_macos "$vm" "sudo -S -p '' /bin/sh -c \
            '/usr/bin/defaults write /Library/Preferences/com.apple.loginwindow autoLoginUserScreenLocked -bool false \
             && /usr/bin/defaults write /Library/Preferences/com.apple.screensaver loginWindowIdleTime -int 0 \
             && /usr/bin/pmset -a displaysleep 0 sleep 0' \
        && /usr/bin/defaults write com.apple.screensaver askForPassword -int 0 \
        && /usr/bin/defaults -currentHost write com.apple.screensaver idleTime -int 0" 2>&1)" || {
        warn "Could not disable the guest's screen lock and screen saver: $(sanitize_guest_text "${out%%$'\n'*}")"
        warn "  A --gui window may show a lock screen after a minute or so; log in with the admin password"
        warn "  stored in $(macos_admin_password_file "$vm")."
        return 0
    }
    return 0
}

# The guest's IANA zone name, or nothing at all. Same discipline as _macos_guest_epoch: `ssh <host>
# <cmd>` runs under the guest's zsh (sources ~/.zshenv, hence ~/.augur-env), so the shape is
# checked rather than scrubbed — anything a login shell ever printed on that path would otherwise
# be spliced into what looks like a zone name. A real zone identifier is letters/digits/underscore
# segments separated by '/' (e.g. "Asia/Tokyo", "UTC", "America/Argentina/Buenos_Aires"); anything
# else is treated as unreadable.
_macos_guest_timezone() {
    local raw
    raw="$(ssh_macos "$1" 'readlink /etc/localtime' 2>/dev/null || true)"
    raw="${raw//[[:space:]]/}"
    raw="${raw##*/zoneinfo/}"
    if [[ "$raw" =~ ^[A-Za-z0-9_]+(/[A-Za-z0-9_+-]+)*$ ]]; then printf '%s' "$raw"; fi
    return 0
}

# Not a clock-accuracy fix — CLOCK_REALTIME is corrected above regardless of this — but a guest
# cloned from a base built in a different zone (or just defaulting to whatever the installer
# picked) displays every local timestamp wrong even once its epoch is right: `date`, log lines,
# anything the agent or operator reads by eye. Same shape as sync_macos_guest_clock on purpose
# (idempotent, best-effort, read-back verified) — see that function's header comment for why a
# guest-side failure here warns rather than fails the boot.
sync_macos_guest_timezone() {
    local vm="$1" host_tz guest_tz setout
    host_tz="$(host_timezone)"
    guest_tz="$(_macos_guest_timezone "$vm")"
    if [[ -z "$guest_tz" ]]; then
        warn "Could not read the guest's timezone over SSH; leaving it as it is."
        return 0
    fi
    if [[ "$guest_tz" == "$host_tz" ]]; then return 0; fi

    info "Guest timezone is '${guest_tz}' (host is '${host_tz}') — correcting from the host."
    setout="$(macos_admin_password_stdin "$vm" | ssh_macos "$vm" "sudo -S -p '' systemsetup -settimezone '${host_tz}'" 2>&1)" || {
        warn "Could not set the guest's timezone (guest is '${guest_tz}', host is '${host_tz}'): $(sanitize_guest_text "${setout%%$'\n'*}")"
        warn "  Local timestamps in the guest (date, logs) will keep reading in ${guest_tz}."
        return 0
    }

    guest_tz="$(_macos_guest_timezone "$vm")"
    if [[ "$guest_tz" != "$host_tz" ]]; then
        warn "The guest's timezone is still '${guest_tz:-unreadable}' after being set to '${host_tz}'."
        return 0
    fi
    success "Guest timezone synchronised with the host (${host_tz})."
    return 0
}


# Delete the agent's per-user config file (agent_config_file_relpath) from VM $1, so no account state
# it accumulated is frozen into the base VM.
macos_scrub_agent_config() {
    ssh_macos "$1" "rm -f ~/$(agent_config_file_relpath)"
}

# Write a minimal agent config file into VM $1 that carries onboarding state only: NOT auth (on macOS
# the OAuth token lives in the Keychain, not in this file) and NOT folder-trust (augur deliberately
# does not pre-trust the workspace). The host's ~/.claude.json is deliberately never copied, not even
# stripped: it enumerates every repo on the host (`projects`) and can hold third-party MCP API keys
# (`mcpServers`), and the guest needs none of it. This is the exact static stub the container image
# bakes (Dockerfile), independent of the host config and of whether jq is installed. Overwrites.
macos_seed_agent_config() {
    local cj; cj="$(mktemp)"
    agent_config_seed_json > "$cj"
    scp_to_macos "$1" "$cj" "/Users/${MACOS_SSH_USER}/$(agent_config_file_relpath)" || { rm -f "$cj"; return 1; }
    rm -f "$cj"
}

# The just-booted VM $1 never answered SSH: show why, tear down what the boot started (VM, gvproxy,
# proxy) so nothing is stranded, and exit 1.
macos_boot_ssh_failed() {
    local vm="$1"
    error "VM SSH did not become available in time."
    # Surface the otherwise-discarded output so the cause is visible. The VM boots
    # but is unreachable via SSH most often because gvproxy crashed or the guest
    # never got its address — both show up in these logs.
    error "Diagnostics (kept on disk):"
    # One probe with stderr shown — the wait loop suppresses it, which hides the
    # common cases (a changed/pinned host key, or auth failure) behind the timeout.
    error "  ---- ssh probe (stderr) ----"
    ssh_macos "$vm" true 2>&1 | head -n 6 | show_guest_lines || true
    error "  VM log:      $(macos_vm_log)"
    if egress_enabled; then
        error "  gvproxy log: $(gvproxy_log)"
        if [[ -s "$(gvproxy_log)" ]]; then
            error "  ---- last gvproxy lines ----"
            tail -n 20 "$(gvproxy_log)" 2>/dev/null | show_guest_lines
        fi
    fi
    if [[ -s "$(macos_vm_log)" ]]; then
        error "  ---- last VM lines ----"
        tail -n 10 "$(macos_vm_log)" 2>/dev/null | show_guest_lines
    fi
    stop_unverified_macos_vm "$vm"
    exit 1
}

# Stop VM $1 and the gvproxy and proxy serving it, and remove its record of a passed egress
# self-test (macos_egress_verified_file), for a VM whose containment is unproven or disproven: a
# boot that failed before or in its self-test, a running VM whose self-test failed, and a boot whose
# pass cannot be recorded (macos_record_egress_verified). A VM left running there would be attached
# to by the next `claude` / `shell --macos`, or refused by every one. Prints nothing; the
# caller has said why. Deliberately keeps the VM itself: removing a project VM's clone is the
# operator's call (`augur destroy --macos`), and setup-token deletes its throwaway clone itself.
stop_unverified_macos_vm() {
    "$VM_CLI" stop "$1" 2>/dev/null || true
    stop_gvproxy
    stop_proxy
    rm -f "$(macos_egress_verified_file)"
}

cmd_up_macos() {
    require_vz
    require_fresh_egress_helpers
    # No `local _creds`: resolve_session_credentials below fills the caller's, so a session that
    # boots the VM through here (prepare_macos_session) launches with the values checked here.
    local project_vm
    project_vm="$(macos_project_vm)"

    # Already running: like cmd_up, rebuild what the host owns — rewrite the allowlist (so a
    # revocation takes effect), re-run the boot self-test and push the guest's environment
    # (push_macos_guest_env).
    # The one drift it refuses on is the egress mode, the only boot-time setting that decides
    # whether the guest is contained at all; the rest (sizing, a newly approved domain) is only
    # warned about below.
    if macos_vm_running "$project_vm"; then
        # Any exit from here to the push at the end pushes first (arm_macos_push_on_exit).
        arm_macos_push_on_exit "$project_vm"
        # The stopped/fresh path's refusal below, as a refusal of a running VM (it pushes first): a
        # running VM without a stored admin password would otherwise reconcile "successfully"
        # while every sudo into it fails.
        require_macos_admin_password "$project_vm" --running
        # Before anything else touches the guest but its refusal's push: a VM booted under
        # --no-egress must be refused here, not "detected" as a leak by the self-test and stopped
        # under the operator.
        require_macos_egress_mode_current "$project_vm"
        warn "VM '${project_vm}' is already running — reconciling host-side state and refreshing the guest's environment."
        if egress_enabled; then
            check_project_conf_approved      # the gate runs wherever policy is written
            # Rewrites the merged allowlist (augur-proxy hot-reloads it) AND revives a proxy that
            # died under this live VM — the only recovery from that, since gvproxy dials
            # --socks-upstream per CONNECTION, so a fresh proxy on the same port is picked up with
            # no gvproxy or VM restart.
            start_proxy "127.0.0.1"
        fi
        # …and the half a live VM genuinely cannot pick up. Warn; do not pretend to have applied it.
        warn_if_macos_egress_pinned "$project_vm"
        # The guest clock, corrected here too. The measured offset is a
        # boot-invariant constant, so a single correction per boot is enough for the defect as
        # observed — but a VM this branch exists to serve is by definition long-lived (`down --macos`
        # keeps the clone), and a guest paused while the host sleeps has its
        # CLOCK_REALTIME frozen while the host's advances, which would reintroduce drift no boot-time
        # correction can reach. Idempotent: it re-reads first and only writes when it must.
        sync_macos_guest_clock "$project_vm"
        sync_macos_guest_timezone "$project_vm"
        # The boot self-test on THIS path too, mirroring container mode: finish_up (and therefore
        # verify_egress_locked) runs on cmd_up's already-running branch. Accepted trade-off:
        # `augur up` against a running guest can end an operator's session, but only on a
        # DETECTED leak, which is precisely when it should. A live check on a running VM
        # is if anything MORE valuable than one on a fresh
        # boot: this branch is the only place a proxy killed out from under a live session is
        # revived, and the self-test is what proves that revival actually restored enforcement. It
        # runs after the pinned-state warning so that warning is still printed if it ends the run.
        # Skipped with --no-egress, as on the boot path; the mode check above guarantees the VM was
        # booted that way. A pass is recorded as on the boot path (macos_egress_verified_file), so a
        # running VM whose boot was interrupted before its self-test takes sessions again after it:
        # the remedy require_macos_egress_verified names.
        #
        # A pass that cannot be recorded (an unreadable run id) fails `up` and leaves no record, so
        # sessions refuse the VM. Deliberately does not stop it, unlike the boot path: the VM has
        # just passed its self-test and may be serving live sessions, and the cause can be as
        # transient as a `ps` that failed once.
        if egress_enabled; then
            verify_macos_egress_locked "$project_vm"
            macos_record_egress_verified "$project_vm" || refuse_running_macos_vm "$project_vm" \
                "VM '${project_vm}' is left running, but no new session will attach to it until a passed self-test is" \
                "  recorded. Run ${BOLD}augur up --macos${RESET} again; if this keeps failing, restart the VM:" \
                "  ${BOLD}augur down --macos && augur up --macos${RESET}"
        fi
        # After the self-test, as on the boot path: a session that attaches through here sends its
        # credentials only to a guest just proven contained. Resolved only now, so a bad or
        # unreadable credential cannot cancel the reconcile, the clock fix or the self-test above;
        # it still stops `up` and any session (fail closed), after the push of ~/.augur-env (see
        # resolve_running_macos_vm_credentials). A failed push is fatal here as on the boot path
        # (see push_macos_guest_env_retrying). The push also refuses a guest that would drop a
        # session's credentials, as the boot path does right after its SSH wait.
        resolve_running_macos_vm_credentials "$project_vm"
        local _prc=0; push_macos_guest_env_retrying "$project_vm" || _prc=$?
        disarm_macos_push_on_exit; (( _prc == 0 )) || exit 1
        return 0
    fi

    # Deliberately after the already-running branch: reconciling a running VM does not use the base,
    # and every way that branch ends rewrites the guest's ~/.augur-env first.
    macos_vm_exists "$MACOS_BASE_VM" || {
        error "Base VM '${MACOS_BASE_VM}' not found."
        error "Run: augur build --macos --ipsw <path> --xcode-xip <path>"
        exit 1
    }

    # Gate the untrusted project ./.augur/allowlist.conf before cloning or starting the proxy
    # (only relevant when egress filtering is on).
    if egress_enabled; then check_project_conf_approved; fi

    # Resolve and validate the credentials BEFORE anything irreversible happens — before the clone,
    # before `augur-vm set`, before `augur-vm run`, as container mode checks before `container run`
    # (see resolve_session_credentials). Placed ABOVE the _fresh_clone split on purpose — a reused
    # stopped clone must fail before `set`/`run` too, not just a fresh one.
    resolve_session_credentials || exit 1

    local _fresh_clone=false
    if ! macos_vm_exists "$project_vm"; then
        _fresh_clone=true
        info "Cloning base VM to '${project_vm}'..."
        "$VM_CLI" clone "$MACOS_BASE_VM" "$project_vm"
        # A fresh clone gets a fresh SSH host key. The egress SSH target is a fixed
        # 127.0.0.1:<fwd-port>, so a pinned key from a previous clone of the same
        # project would mismatch and StrictHostKeyChecking=accept-new would reject it
        # (the connection reaches sshd but is refused — looks like an SSH timeout).
        # Drop the stale pin so the new key is accepted on first connect.
        rm -f "$(vm_known_hosts_file "$project_vm")"
    fi
    # Before `set`/`run`: a VM augur cannot sudo into stops here, not halfway through the bring-up.
    require_macos_admin_password "$project_vm"

    # A clone's cpuCount/memorySize start as a byte-for-byte copy of the base VM's config.json
    # (augur-vm's `clone`) and are otherwise never revisited, so a fixed base-VM default would
    # follow every project VM forever regardless of host capability or .augur/resources.conf.
    # Re-apply the resolved sizing here on every `up` (not just at first clone) so a
    # resources.conf/env-var change takes effect on the VM's next boot — safe because we've
    # already confirmed above the VM isn't running. See resolve_macos_vm_cpu/_memory_mb.
    "$VM_CLI" set "$project_vm" --cpu "$(resolve_macos_vm_cpu)" --memory "$(resolve_macos_vm_memory_mb)"

    # Per-VM isolated history parent (NOT the host's shared ~/.claude/projects): the
    # guest only ever sees its own project's transcripts, never other projects'.
    # AUGUR_AGENT_SEAM | per-VM history parent (share dir name = agent_state_host_subdir)
    mkdir -p "$AUGUR_DIR/$(agent_state_host_subdir)/$project_vm"
    # AUGUR_AGENT_SEAM | per-VM user-level subagent-defs share (dir name = agent_state_agents_host_subdir):
    # a host-side dir so `/agents` created in the VM persist across down/up AND destroy/re-clone.
    mkdir -p "$AUGUR_DIR/$(agent_state_agents_host_subdir)/$project_vm"
    # AUGUR_AGENT_SEAM | opt-in operator profile share. Host-GLOBAL — no per-VM subdir, unlike the
    # two above — and shared READ-ONLY, so a compromised guest cannot write a hook/command/skill
    # back into a directory every project on this host reads.
    mkdir -p "$AUGUR_DIR/$(agent_profile_host_subdir)"
    info "Starting VM '${project_vm}'..."
    info "Mounting: ${BOLD}${WORKSPACE_DIR}${RESET} → ~/${MACOS_SHARE}"
    # A GUI window (--gui) and headless mode build the same VM (same NAT networking and
    # directory shares); --gui only adds the host-side display window. SSH-based setup
    # below still runs because the VM is backgrounded either way.
    local graphics_flag="--no-graphics"
    if $MACOS_GUI; then
        graphics_flag=""
        info "Opening a GUI window for '${project_vm}'..."
    fi

    # Egress allowlist: replace NAT with the vfkit/file-handle datapath so all guest
    # traffic flows through the host proxy. The proxy's SOCKS5 is the decision point;
    # gvproxy provides the guest netstack and forwards to it. No host sudo required.
    local net_args=()
    if egress_enabled; then
        start_proxy "127.0.0.1"          # SOCKS5 reachable locally by gvproxy
        start_gvproxy
        net_args=(--net-vfkit="$(gvproxy_socket)")
        info "Egress restricted to allowlisted domains (file-handle datapath)."
    else
        # Egress filtering off (AUGUR_EGRESS=0 / --no-egress): opt into unfiltered NAT
        # explicitly. augur-vm fails closed without a net flag, so this branch is
        # required to keep the --no-egress path booting.
        net_args=(--net-nat)
        warn "Egress filtering OFF — guest has unrestricted network access (NAT)."
    fi

    # This boot has passed no self-test yet; the record is written again only once it has.
    rm -f "$(macos_egress_verified_file)"
    # Deliberately NOT shared: ~/.config/gh, same as Container mode (see _add_host_config_run_args
    # for why neither engine hands the guest the host's gh config). Here a share would also be
    # inert: it lands at /Volumes/My Shared Files/gh-config and nothing wires it to ~/.config/gh, so
    # it would carry the host's real config.yml and hosts.yml into the guest without gh ever reading
    # them. gh still works: GH_TOKEN is the auth path.
    macos_record_egress_mode
    "$VM_CLI" run $graphics_flag \
        ${net_args[@]+"${net_args[@]}"} \
        --dir="${MACOS_SHARE}:${WORKSPACE_DIR}" \
        --dir="$(agent_state_host_subdir):${AUGUR_DIR}/$(agent_state_host_subdir)/${project_vm}" \
        --dir="$(agent_state_agents_host_subdir):${AUGUR_DIR}/$(agent_state_agents_host_subdir)/${project_vm}" \
        --dir="$(agent_profile_host_subdir):${AUGUR_DIR}/$(agent_profile_host_subdir):ro" \
        "$project_vm" &>"$(macos_vm_log)" &
    disown

    info "Waiting for VM to boot and SSH to be ready..."
    wait_for_macos_ssh "$project_vm" &>/dev/null || macos_boot_ssh_failed "$project_vm"

    # After the SSH wait, exactly three guest steps precede the boot self-test, and none of them
    # sends an agent or gh credential (the clock and the screen-lock steps feed `sudo -S` the
    # guest's own admin password, which is not one):
    #   1. The acceptance check, riding in a push of the non-secret ~/.augur-env
    #      (require_macos_session_env_accepted, which stops the VM on any failure). First, so an
    #      old-base VM is scrubbed and refused before the rest of the bring-up.
    #   2. The clock fix. Everything after it judges an absolute instant: the self-test's TLS
    #      handshakes evaluate certificate validity windows, a session hands the agent a JWT whose
    #      `nbf`/`exp` it will check against this clock, and the git credential helper's token is
    #      the same object. Going after the self-test instead would leave its positive half judging
    #      a certificate window 95 minutes early, i.e. able to tear down a healthy VM over a
    #      certificate rotated minutes ago. The host's wall-clock time is no secret: the guest can
    #      already read it off the mtimes of the virtiofs share it is mounting.
    #   3. The screen-lock settings (configure_macos_guest_session), which touch no credential and
    #      no network.
    require_macos_session_env_accepted "$project_vm"
    sync_macos_guest_clock "$project_vm"
    configure_macos_guest_session "$project_vm"

    # The boot self-test, as early as it can usefully run: right after the three steps above, and
    # BEFORE any of the wiring below — in particular before any session can hand the guest an
    # Anthropic token or a gh token. A guest whose egress is not contained is exactly the guest that
    # must not receive credentials, so this deliberately precedes the wiring rather than sitting just
    # above the success banner. Skipped entirely with --no-egress, like container mode's (finish_up
    # guards verify_egress_locked the same way): with filtering off there is no allowlist to be
    # locked to, and the warning above already said so. Its pass is what lets a later session attach
    # to this running VM (macos_egress_verified_file). A pass that cannot be recorded stops the VM
    # just booted (the clone kept): left running, it would be refused by every session.
    if egress_enabled; then
        verify_macos_egress_locked "$project_vm"
        if ! macos_record_egress_verified "$project_vm"; then
            error "Stopping VM '${project_vm}' (its clone is kept). Run ${BOLD}augur up --macos${RESET} to boot it again."
            stop_unverified_macos_vm "$project_vm"
            exit 1
        fi
    fi

    # Unlike the clock, not a security-relevant read (nothing here judges a validity window by
    # zone), so it sits AFTER the self-test rather than racing to precede it like the clock does:
    # nothing joins the steps before the self-test unless it must.
    sync_macos_guest_timezone "$project_vm"

    ensure_macos_workspace "$project_vm"
    ensure_macos_agent_projects "$project_vm"
    ensure_macos_agent_agents "$project_vm"
    ensure_macos_agent_profile "$project_vm"
    # Not fatal here: the VM is still usable through `augur shell --macos`; `claude --macos` refuses.
    ensure_macos_agent_bin "$project_vm" \
        || warn "Continuing: 'augur shell --macos' works, but 'augur claude --macos' will refuse until this is fixed."

    # Copy git config, and seed the onboarding-only .claude.json (macos_seed_agent_config).
    #
    # WRITE-ONCE, gated on `_fresh_clone` (this `up` just created the VM above) — NOT on the
    # file's absence. `down --macos` keeps the clone, so unlike a throwaway VM
    # this file accumulates real guest state after the first boot — prompt history, guest-side MCP
    # servers, caches, whatever folder-trust decision the operator made — and an unconditional
    # overwrite on a REUSED VM would silently destroy all of that. A fresh clone gets the opposite
    # treatment: overwrite unconditionally, regardless of whether the inherited disk already has
    # some `.claude.json`. Keying off "did we just clone" rather than "does the file exist" matters
    # because the base VM is a long-lived, mutable disk that can itself accumulate a stale/real
    # `.claude.json` between builds (see cmd_build_macos/cmd_update_macos's scrub) —
    # an existence check alone would silently inherit that into every new project clone again.
    if $_fresh_clone; then
        macos_seed_agent_config "$project_vm"
    fi
    [[ -f "$HOME/.gitconfig" ]] && \
        scp_to_macos "$project_vm" "$HOME/.gitconfig" "/Users/${MACOS_SSH_USER}/.gitconfig"

    # Deliberately no push of ~/.augur-env here: the boot path's one push is
    # require_macos_session_env_accepted's, right after the SSH wait, and nothing since writes
    # ~/.augur-env or ~/.zshenv, while its content is built from host-side constants only.

    success "VM '${project_vm}' is up."
    echo ""
    echo -e "  ${BOLD}augur claude --macos${RESET} → Launch $(agent_display_name)"
    echo -e "  ${BOLD}augur shell --macos${RESET}  → Open a zsh shell"
    echo -e "  ${BOLD}augur down --macos${RESET}   → Stop the VM (keeps the clone)"
}

# Get VM $1 ready for an `augur claude --macos` / `augur shell --macos` session, leaving the
# caller's `_creds` (see resolve_session_credentials) holding the credentials its launch sends
# (ssh_macos_session). A VM that is not running gets the full cmd_up_macos, which resolves them,
# boots the VM and wires it. A running VM is attached to without going through `up`, so the per-run
# guest work an `up` does is done here instead. One function so the two commands cannot drift.
# Either way, the guest must accept the session's credentials before it gets them
# (macos_session_env_check_cmd), checked within a push of ~/.augur-env on every path, and with
# egress on its containment must have been proven during its current boot: by cmd_up_macos's
# self-test on the boot path, by the record of one on a running VM (require_macos_egress_verified).
#
# Accepted trade-off: a VM that comes up between the running check and cmd_up_macos goes through
# its already-running branch, which skips the ensure_* wiring. That needs a second augur command
# on the same project at once, which augur does not support (see restart_egress_network_helper).
prepare_macos_session() {
    local vm="$1"
    if ! macos_vm_running "$vm"; then
        cmd_up_macos
        return 0
    fi
    # Any exit from here to this session's push pushes first (arm_macos_push_on_exit).
    arm_macos_push_on_exit "$vm"
    # A running VM is attached to only if it was booted with the egress mode asked for here; without
    # the check `up --macos --no-egress` followed by a plain `claude --macos` would run the agent on
    # an unfiltered network without a word.
    require_macos_egress_mode_current "$vm"
    # Before any other guest step, so a VM whose boot never reached a passing self-test (an
    # interrupted `up`) gets nothing from this session but the push its refusal makes.
    require_macos_egress_verified "$vm"
    # Before any other guest step: a credential that cannot be injected (or a credential file that
    # cannot be read) aborts after only the push of ~/.augur-env
    # (see resolve_running_macos_vm_credentials).
    resolve_running_macos_vm_credentials "$vm"
    # The interactive launch hands a JWT to the agent, and a token minted on the host seconds ago
    # looks NOT-YET-VALID to a guest sitting 95 minutes in the past; a shell is where the operator
    # runs `git`, `gh` and `curl` by hand, all of which sign, stamp or validate against this clock.
    # Cheap and idempotent (a read, then a write only if needed).
    sync_macos_guest_clock "$vm"
    sync_macos_guest_timezone "$vm"
    # Accepted trade-off: no egress self-test before this session. Like Container mode's
    # per-session `exec`, it hands credentials to a guest whose containment was proven during its
    # current boot (require_macos_egress_verified). Fatal, unlike a helper failure: the session must
    # not start before ~/.augur-env is rewritten (see push_macos_guest_env), though a failure a
    # second attempt may fix (a dropped connection, a concurrent session's push) gets one
    # (push_macos_guest_env_retrying). Also where a guest that would drop the credentials is
    # refused, before any is sent.
    local _prc=0; push_macos_guest_env_retrying "$vm" || _prc=$?
    disarm_macos_push_on_exit; (( _prc == 0 )) || exit 1
    ensure_macos_workspace "$vm"
    ensure_macos_agent_projects "$vm"
    ensure_macos_agent_agents "$vm"
    ensure_macos_agent_profile "$vm"
    warn_if_macos_egress_pinned "$vm"
}

# The guest command that succeeds only if the guest's sshd accepts every credential name a session
# sends, for the names $1 (macos_session_env_names). The base VM build writes that acceptance
# (install_macos_session_env_acceptance), and a project VM has it only if its base did. Without it
# the guest's sshd silently drops the session's credentials, and the agent would start
# unauthenticated with no sign of why. Checked on every `up` and every session, with or without
# credentials to send, so an affected VM is refused from the start rather than from the first
# session after a `gh auth login`.
#
# Reads the drop-in file, which only root can write, and compares the exact line augur writes, so a
# change to the credential names refuses a VM built for the old ones. A guest that lies here gains
# nothing: its sshd decides what it accepts, and a session whose credentials it drops is refused
# by the delivery check (macos_session_env_delivery_cmd). The base VM build and update run this
# same command before they save the base (verify_macos_session_env_acceptance). `-s`: a guest with
# no drop-in (an old base) fails the check without grep's own "No such file" on the operator's
# terminal; the refusal says what is wrong.
macos_session_env_check_cmd() {
    printf "grep -sqxF '%s' %s" "$(macos_session_accept_env_line "$1")" "$(macos_session_sshd_dropin)"
}

# Say that VM $1 was refused, and how to fix it. With `delivery` as $2: a session that sent
# credentials exited with MACOS_SESSION_ENV_MISSING_RC, the status of a guest missing one of them
# (macos_session_env_delivery_cmd), or of the agent or shell itself (see ssh_macos_session), so the
# message says both and starts with the cheap check: `augur up --macos` re-checks the drop-in
# (macos_session_env_check_cmd), though not the Include that reads it, which only recreating the VM
# restores. Otherwise macos_session_env_check_cmd failed.
macos_session_env_refused() {
    local rc="$MACOS_SESSION_ENV_MISSING_RC"
    if [[ "${2:-}" == delivery ]]; then
        error "The session in VM '$1' exited with status ${rc}, which augur's delivery check exits with"
        error "  when the guest's sshd did not pass on a credential augur sent (the agent or shell is"
        error "  then never started). If the agent or shell itself exited with ${rc}, ignore this."
        error "  Otherwise the guest's sshd configuration may have lost augur's drop-in"
        error "  ($(macos_session_sshd_dropin)) or the Include that reads it."
        error "  Run ${BOLD}augur up --macos${RESET}, which checks that the drop-in is still in place. If it passes"
        error "  and sessions keep exiting with ${rc}, recreate the VM, in its project directory:"
        error "  ${BOLD}augur destroy --macos && augur up --macos${RESET} (first ${BOLD}augur update --macos${RESET} if the"
        error "  base VM is out of date)."
        return 0
    fi
    error "VM '$1' does not accept augur's session credentials over SSH: it was cloned from a base VM"
    error "  built before augur delivered them per session, or for a different set of credentials."
    error "  Refusing to go on: an augur session would run without them."
    error "  Recreate this project's VM from an up-to-date base VM, in its project directory. If the"
    error "  base VM is already up to date, ${BOLD}augur destroy --macos && augur up --macos${RESET} is enough;"
    error "  otherwise run ${BOLD}augur update --macos${RESET} first."
}

# Exit 1 unless VM $1 passes macos_session_env_check_cmd, for cmd_up_macos's boot path, which checks
# right after the SSH wait, before the boot self-test. The check is the first step of the push of
# the non-secret ~/.augur-env (push_macos_guest_env_retrying), the same code path that refuses a
# running VM. It is also the boot's only push of ~/.augur-env.
#
# A push that still fails after its one retry (a refusal gets none) stops the VM, the clone kept
# (stop_unverified_macos_vm): the boot cannot go on, and a refused VM is of no use anyway.
require_macos_session_env_accepted() {
    push_macos_guest_env_retrying "$1" && return 0
    error "Stopping VM '$1' (its clone is kept): its boot cannot go on."
    stop_unverified_macos_vm "$1"
    exit 1
}

# resolve_session_credentials for a session or `up` against RUNNING VM $1. When resolution fails,
# the VM is refused (refuse_running_macos_vm), so it still gets its push before the exit, and an
# old-base VM is named with its remedy, next to the resolution error. A stopped VM is not booted
# for this: cmd_up_macos resolves before it touches the VM at all.
resolve_running_macos_vm_credentials() {
    resolve_session_credentials && return 0
    refuse_running_macos_vm "$1" \
        "Stopping: a credential could not be used (see above); no credential was sent to VM '$1'."
}

cmd_claude_macos() {
    require_vz
    require_fresh_egress_helpers
    local project_vm _creds=()
    project_vm="$(macos_project_vm)"
    prepare_macos_session "$project_vm"
    ensure_macos_agent_bin "$project_vm" || exit 1
    info "Launching $(agent_display_name) in '${project_vm}'..."
    # AUGUR_AGENT_SEAM | interactive launch (macOS: interpolated into SSH string — see agent_launch_argv)
    local _renv _rargv
    _renv="$(agent_fixed_env)"; _rargv="$(agent_launch_argv)"
    ssh_macos_session "$project_vm" -t "zsh -l -c 'cd ~/${MACOS_SHARE} && ${_renv} ${_rargv}'"
}

cmd_shell_macos() {
    require_vz
    require_fresh_egress_helpers
    local project_vm _creds=()
    project_vm="$(macos_project_vm)"
    prepare_macos_session "$project_vm"
    info "Opening shell in '${project_vm}'..."
    ssh_macos_session "$project_vm" -t "cd ~/${MACOS_SHARE} && exec zsh -l"
}

# ── Host-wide locks ───────────────────────────────────────────────────────────
# A lock is a symlink at ~/.augur/<name>.lock whose target names its holder as "<pid>:<command>"
# (e.g. "4242:update"). symlink(2) creates the name and its content in one step and fails if the
# name exists, so there is never a lock without a holder. The locks are MACOS_BASE_WRITER_LOCK and
# MACOS_SETUP_TOKEN_LOCK.
host_lock_path() { echo "$AUGUR_DIR/$1.lock"; }

# Remove lock $1 only if it still names the dead holder $2, and report whether it did. The lock is
# first renamed to a name private to this process (rename is atomic, so two processes cannot both
# take the same lock), then checked: if another process replaced it in the meantime, it is put back
# untouched and this fails.
host_lock_reap() {
    local dead="$2" lock private got
    lock="$(host_lock_path "$1")"; private="${lock}.reap.$$"
    mv "$lock" "$private" 2>/dev/null || return 1
    got="$(readlink "$private" 2>/dev/null || true)"
    if [[ "$got" == "$dead" ]]; then
        rm -f "$private"
        return 0
    fi
    mv "$private" "$lock" 2>/dev/null || rm -f "$private"
    return 1
}

# Take lock $1 for augur command $2 (e.g. "update"), or exit 1 naming the command that holds it. A
# lock whose holder pid is no longer alive was left by a crash and is taken over (host_lock_reap).
# Anything else — a live holder, or a lock that does not name a pid at all — refuses: only a lock
# proven stale is ever removed.
host_lock_acquire() {
    local name="$1" cmd="$2" lock holder other="" tries=5
    lock="$(host_lock_path "$name")"
    mkdir -p "$AUGUR_DIR"
    # `ln -s` into an existing directory would create a link inside it and "succeed".
    if [[ -d "$lock" && ! -L "$lock" ]]; then
        error "'${lock}' is a directory, not an augur lock. Remove it, then retry."
        exit 1
    fi
    while (( tries-- > 0 )); do
        ln -s "$$:${cmd}" "$lock" 2>/dev/null && return 0
        holder="$(readlink "$lock" 2>/dev/null || true)"
        if [[ "$holder" =~ ^([0-9]+)(:[a-z-]+)?$ ]] && ! kill -0 "${BASH_REMATCH[1]}" 2>/dev/null; then
            host_lock_reap "$name" "$holder" || true
            continue
        fi
        if [[ -z "$holder" ]] && [[ ! -e "$lock" && ! -L "$lock" ]]; then
            continue   # released between our create and our read: try again
        fi
        break
    done
    [[ "$holder" =~ ^[0-9]+:([a-z-]+)$ ]] && other="${BASH_REMATCH[1]}"
    if [[ "$other" == "$cmd" ]]; then
        error "Another 'augur ${cmd} --macos' is running (lock ${lock} → ${holder}). Wait for it to finish."
    elif [[ -n "$other" ]]; then
        error "'augur ${other} --macos' is running, so 'augur ${cmd} --macos' cannot run now (lock ${lock} → ${holder})."
        error "  Wait for it to finish, then retry."
    else
        error "'augur ${cmd} --macos' cannot run: lock ${lock} is held (→ ${holder:-?})."
    fi
    error "  If no augur command is running, remove the lock: ${BOLD}rm -f ${lock}${RESET}"
    exit 1
}

# Release lock $1 taken for command $2, only if this process holds it.
host_lock_release() {
    local lock; lock="$(host_lock_path "$1")"
    if [[ "$(readlink "$lock" 2>/dev/null || true)" == "$$:$2" ]]; then rm -f "$lock"; fi
    return 0
}

# ── setup-token --macos: a throwaway clone of the base VM ──────────────────────
# `augur setup-token --macos` never touches the project VM. A project VM is kept across `down`, so a
# prior guest session can have replaced its claude binary, its shell rc files (every SSH command runs
# through the guest's zsh, which sources ~/.zshenv) or the tools a check would use; on a manual-setup
# build the guest user is even an admin with a known password. No check run inside such a guest can
# be trusted before a binary from it is attached to the operator's TTY to mint a credential. A fresh
# clone of the base VM has never run a guest session, so its disk is exactly what build/update wrote.
#
# The clone gets nothing project-specific: no workspace, history, agents or profile share, no
# ~/.augur-env, no gh token, no git config — only what the login needs. Its egress is filtered the same
# way as a normal `up --macos` (gvproxy + augur-proxy, then the boot self-test), against the baseline
# and global allowlist layers but NOT the project's ./.augur/allowlist.conf: the login only needs
# Anthropic's own endpoints, which the baseline carries, and a project's domains have no business
# widening a host-wide flow. The global layer stays because it is operator-written host-side input
# that every normal `up` honours too, so this allowlist is never wider than a normal `up`'s.

# Point every per-VM helper (macos_project_vm, the proxy/gvproxy pidfiles, logs, socket and merged
# allowlist, the egress-mode record, the SSH forward) at the throwaway VM instead of the current
# project. Same override `destroy <name>` uses (TARGET_SLUG/TARGET_HASH), with a slug no workspace can
# produce (workspace_slug never emits "_", and target_name_re never matches it, so `destroy <name>`
# and its completion never offer this VM) and the fixed *_SETUP_TOKEN ports. Clearing
# AUGUR_PROJECT_CONF makes write_merged_allowlist emit the baseline and global layers only.
adopt_setup_token_identity() {
    TARGET_SLUG="_setup-token"
    TARGET_HASH="throwaway"
    AUGUR_PROXY_HTTP_PORT="$AUGUR_PROXY_HTTP_PORT_SETUP_TOKEN"
    AUGUR_PROXY_SOCKS_PORT="$AUGUR_PROXY_SOCKS_PORT_SETUP_TOKEN"
    AUGUR_SSH_FWD_PORT="$AUGUR_SSH_FWD_PORT_SETUP_TOKEN"
    AUGUR_PROJECT_CONF=""
}

# Remove the throwaway VM and everything that served it: VM, gvproxy, proxy, merged allowlist,
# pinned host key. Needs adopt_setup_token_identity first. Idempotent and silent when there is
# nothing to remove, so it runs both at the start (what a crash left behind) and from the EXIT trap;
# never fails, so it cannot cut the trap short. The VM is stopped without asking the guest to shut
# down: its disk is about to be deleted, so there is nothing to flush.
setup_token_vm_teardown() {
    local vm; vm="$(macos_project_vm)"
    if macos_vm_running "$vm"; then "$VM_CLI" stop "$vm" 2>/dev/null || true; fi
    stop_gvproxy || true
    stop_proxy || true
    if macos_vm_exists "$vm"; then
        "$VM_CLI" delete "$vm" >/dev/null 2>&1 \
            || warn "Could not delete the throwaway VM '${vm}'; the next 'augur setup-token --macos' removes it."
    fi
    rm -f "$(vm_known_hosts_file "$vm")" "$(proxy_allowlist)" 2>/dev/null || true
    return 0
}

# Names of the augur-vm VMs running right now, one per line.
macos_running_vms() {
    "$VM_CLI" list 2>/dev/null | awk 'NR>1 && $NF == "running" {print $2}'
}

# Virtualization.framework runs at most two macOS guests per host (Apple's license limit), so an
# extra VM would only fail later as an opaque SSH timeout. Exit 1, naming the running VMs, when
# booting one more is bound to fail. $1 names what the extra VM is for. Counts augur's VMs only;
# a macOS guest of another tool still surfaces as that boot failure.
require_macos_vm_slot() {
    local running n vm
    running="$(macos_running_vms)"
    n="$(grep -c . <<<"$running" || true)"
    (( n < 2 )) && return 0
    error "Cannot start ${1}: ${n} macOS VMs are already running, and macOS allows at most two at once."
    while IFS= read -r vm; do [[ -n "$vm" ]] && error "  • ${vm}"; done <<<"$running"
    error "Stop one first: ${BOLD}augur down --macos${RESET} in its project directory (see ${BOLD}augur list --macos${RESET})."
    exit 1
}

# Remove from VM $1 the files augur itself puts into a project VM's home: ~/.augur-env and any
# ~/.augur-env.tmp.* a killed push left behind (an older augur's hold credentials; see
# push_macos_guest_env), the ~/.zshenv line that sources ~/.augur-env, and ~/.gitconfig, the copy
# of the host's file that cmd_up_macos makes. augur puts these into project VMs only, never into
# the base VM, so in setup-token's fresh clone this is defense in depth. Deliberately includes
# ~/.gitconfig, though augur writes no helper into it: the host's file may carry the host's own
# helpers or credentials (a token in a url.insteadOf or an http.extraHeader), and none of that
# belongs in a clone handed to setup-token. Deliberately limited to augur's own files: the Keychain
# and whatever a human may have left in the base VM by hand are out of its scope.
macos_scrub_augur_credentials() {
    ssh_macos "$1" "rm -f ~/.augur-env ~/.gitconfig && find ~ -maxdepth 1 -name '.augur-env.tmp.*' -exec rm -f {} + && if [ -f ~/.zshenv ]; then
        grep -vxF '${MACOS_AUGUR_ENV_SOURCE_LINE}' ~/.zshenv > ~/.zshenv.augur-scrub
        [ \$? -le 1 ] && mv ~/.zshenv.augur-scrub ~/.zshenv
    fi"
}

# Refuse to go on while the base VM is running. A running base VM is a hand-started session, an
# 'augur install-cert --macos' window, or a leftover from an interrupted run; stopping it for the
# caller could kill someone's live session, and clonefile does not refuse a running source, so a
# clone or replacement of it would be inconsistent. The operator stops it deliberately. (`build
# --macos` is the one command that stops it itself, after asking.) $1 is the command name shown in
# the message. Callers holding the base-writer lock release it through their EXIT trap.
require_base_vm_stopped() {
    macos_vm_running "$MACOS_BASE_VM" || return 0
    error "Cannot run ${1} --macos: the base VM '${MACOS_BASE_VM}' is running (started by hand, an 'augur install-cert --macos' window, or left over from an interrupted run)."
    error "  Finish or stop it first (${BOLD}augur-vm stop ${MACOS_BASE_VM}${RESET}), then retry."
    exit 1
}

# macOS counterpart of cmd_setup_token: run `claude setup-token` in a throwaway clone of the base VM
# (see the section header) and save the resulting token on the host. Same copy-the-code flow (no host
# claude needed). Works whether or not this project's VM exists or runs; it is never touched.
cmd_setup_token_macos() {
    require_vz
    macos_vm_exists "$MACOS_BASE_VM" || {
        error "Base VM '${MACOS_BASE_VM}' not found."
        error "Run: augur build --macos --ipsw <path> --xcode-xip <path>"
        exit 1
    }
    require_macos_admin_password "$MACOS_BASE_VM"
    require_base_vm_stopped setup-token
    if ! egress_enabled; then
        warn "setup-token --macos always runs with egress filtering on; ignoring --no-egress / AUGUR_EGRESS=0."
        AUGUR_EGRESS=1
    fi
    adopt_setup_token_identity
    local vm; vm="$(macos_project_vm)"
    # One setup-token --macos per host at a time: the throwaway VM's name and ports are fixed.
    host_lock_acquire "$MACOS_SETUP_TOKEN_LOCK" setup-token
    # Every exit path removes the throwaway VM: success, failure (including the self-test's and
    # ssh_macos' own `exit 1`), and Ctrl-C, which INT/TERM/HUP turn into a normal exit.
    trap 'setup_token_vm_teardown; host_lock_release "$MACOS_BASE_WRITER_LOCK" setup-token; host_lock_release "$MACOS_SETUP_TOKEN_LOCK" setup-token' EXIT
    trap 'exit 130' INT TERM HUP
    setup_token_vm_teardown
    require_macos_vm_slot "the throwaway VM for setup-token"

    # The base-writer lock only for the clone itself: it refuses while a build or update is
    # replacing the base VM, and keeps one from starting until the clone is taken.
    host_lock_acquire "$MACOS_BASE_WRITER_LOCK" setup-token
    info "Cloning base VM '${MACOS_BASE_VM}' to the throwaway VM '${vm}' (deleted afterwards)..."
    "$VM_CLI" clone "$MACOS_BASE_VM" "$vm"
    host_lock_release "$MACOS_BASE_WRITER_LOCK" setup-token
    start_proxy "127.0.0.1"
    start_gvproxy
    info "Starting '${vm}' with no workspace and no credentials, egress restricted to the baseline + global allowlist..."
    "$VM_CLI" run --no-graphics --net-vfkit="$(gvproxy_socket)" "$vm" &>"$(macos_vm_log)" &
    disown
    info "Waiting for VM to boot and SSH to be ready..."
    wait_for_macos_ssh "$vm" &>/dev/null || macos_boot_ssh_failed "$vm"
    macos_scrub_augur_credentials "$vm" || {
        error "Could not remove augur's credential files from the throwaway VM; refusing to run setup-token."
        exit 1
    }
    # Before the self-test, for the reason given in cmd_up_macos: its TLS probes judge certificate
    # validity windows against this clock.
    sync_macos_guest_clock "$vm"
    verify_macos_egress_locked "$vm"
    if ! agent_verify_integrity_macos "$vm"; then
        agent_signature_check_failed "base VM's"
        error "Refusing to run setup-token. Reinstall it in the base VM: ${BOLD}augur update --macos${RESET} (or rebuild: ${BOLD}augur build --macos${RESET})."
        exit 1
    fi
    macos_seed_agent_config "$vm"

    info "Running '$(agent_login_argv)' in '${vm}'..."
    info "Complete the browser sign-in; when it prints the token, copy it."
    # Run attached to the terminal (no pipe) so the full-screen TUI renders cleanly;
    # the token is pasted back here instead of being captured.
    # Launched by absolute path: the file the signature check just verified, not a PATH lookup.
    # AUGUR_AGENT_SEAM | login launch (macOS: interpolated into SSH string — see agent_launch_argv)
    local _lenv _largv=()
    _lenv="$(agent_fixed_env)"
    read -ra _largv <<< "$(agent_login_argv)"
    _largv[0]="$(macos_agent_bin)"
    ssh_macos "$vm" -t "${_lenv} ${_largv[*]}" || true
    stty sane 2>/dev/null || true   # restore cooked mode if the TUI left the tty raw
    # Same guard as the container path: an attached interactive client (`ssh -t` here)
    # can return with our stdin (fd 0) left non-blocking, which `stty sane` cannot clear
    # (O_NONBLOCK is an fcntl file-status flag, not termios), making the `read` below fail
    # with EAGAIN. Clear it and read from a fresh /dev/tty.
    perl -e 'use Fcntl; fcntl(STDIN, F_SETFL, fcntl(STDIN, F_GETFL, 0) & ~O_NONBLOCK);' 2>/dev/null || true
    echo ""
    setup_token_security_notice
    local token
    token="$(read_agent_token_from_tty)"
    local rc=0
    save_oauth_token "$token" macos || rc=1
    info "Removing the throwaway VM '${vm}'..."
    setup_token_vm_teardown
    host_lock_release "$MACOS_SETUP_TOKEN_LOCK" setup-token
    trap - EXIT INT TERM HUP
    return $rc
}

# SIGKILL a process and all its descendants. SIGKILL rather than SIGTERM on purpose: the caller
# abandons the process, and one that ignores or traps SIGTERM would let the caller's `wait` block
# past its deadline. ssh_macos is a function, so the real `ssh` is a grandchild of anything that
# backgrounds it; killing only the direct child would orphan it.
macos_kill_tree() {
    local c
    for c in $(pgrep -P "$1" 2>/dev/null); do macos_kill_tree "$c"; done
    kill -KILL "$1" 2>/dev/null || true
}

# Ask a running guest to power itself off from the inside, then wait for its `run` process to
# exit. The host-side alternative, `augur-vm stop`, presses the guest's virtual power button, and a
# logged-in macOS guest answers that with a "Are you sure you want to shut down?" dialog nobody is
# there to click, so the stop only ever ends via its 30s force-kill. `shutdown -h now` has no dialog
# and lets the guest flush its disks, so this is both faster and gentler.
# Best-effort by design: the caller's `augur-vm stop` remains the fallback whenever this returns 1.
# Needs gvproxy still up, because ssh_macos reaches the project VM through its forward — so callers
# must run this BEFORE stop_gvproxy.
# $2 bounds the WHOLE function. The SSH request runs in the background so a connected session whose
# sudo or shutdown hangs (ssh's own timeouts do not cover that) is SIGKILLed when the budget runs
# out, and so a guest that already powered off is noticed even while ssh is still waiting on a
# connection that never closed. Ctrl-C reaps the request too, so an aborted `down` cannot go on to
# deliver a shutdown afterwards.
# The remote side prints a marker only AFTER sudo accepted the password, which is what tells a
# request that never landed (sshd not up, forward missing, wrong password) from one that landed and
# whose connection then dropped with the guest — ssh exits non-zero for both. The former waits only
# $3 before the caller's fallback; the latter keeps the full budget, because the guest is mid-
# shutdown and must be left to finish flushing rather than have its network cut and be force-killed.
macos_guest_poweroff() {
    local vm="$1" max_secs="${2:-60}" grace_secs="${3:-10}"
    local deadline=$(( SECONDS + max_secs )) pid out rc=0 n=0 sent=false stopped=false
    out="$(mktemp)"
    { macos_admin_password_stdin "$vm" | ssh_macos "$vm" "sudo -S -p '' sh -c 'echo AUGUR_POWEROFF_SENT; exec /sbin/shutdown -h now'"; } >"$out" 2>&1 &
    pid=$!
    trap 'macos_kill_tree "$pid"; rm -f "$out"; exit 130' INT TERM
    while kill -0 "$pid" 2>/dev/null; do
        if (( ++n % 5 == 0 )) && ! macos_vm_running "$vm"; then stopped=true; break; fi
        if (( SECONDS >= deadline )); then break; fi
        sleep 0.2
    done
    if kill -0 "$pid" 2>/dev/null; then macos_kill_tree "$pid"; fi
    wait "$pid" 2>/dev/null || rc=$?
    if grep -q AUGUR_POWEROFF_SENT "$out"; then sent=true; fi
    if ! $stopped; then
        if ! $sent && (( SECONDS + grace_secs < deadline )); then deadline=$(( SECONDS + grace_secs )); fi
        while (( SECONDS < deadline )); do
            if ! macos_vm_running "$vm"; then stopped=true; break; fi
            sleep 1
        done
        if ! $stopped && ! macos_vm_running "$vm"; then stopped=true; fi
    fi
    trap - INT TERM
    rm -f "$out"
    $stopped
}

# Power a running project VM off from the inside, ahead of a teardown that then calls
# `augur-vm stop` (see macos_guest_poweroff for why that is faster than the stop alone). Must run
# BEFORE stop_gvproxy: the SSH request reaches the guest through gvproxy's forward, so once gvproxy
# is down there is no way in, which is why this is skipped when gvproxy is not running. Also skipped
# when the forward port cannot be read back from that gvproxy (see macos_ssh_port): the shutdown
# must never be sent to a guessed port, which could be another project's VM. Its failure is not an
# error: the caller's `augur-vm stop` is the fallback, and the caller's own check is the authority
# on whether the VM is down.
macos_poweroff_before_teardown() {
    local vm="$1"
    if macos_vm_exists "$vm" && macos_vm_running "$vm" && gvproxy_running; then
        if [[ -z "$(macos_ssh_port "$vm")" ]]; then
            # Accepted trade-off: the VM is hard-stopped without a graceful in-guest shutdown, which
            # risks unflushed guest disk state in the clone augur keeps; that is accepted over
            # connecting to a guessed port, which could be another project's VM.
            warn "Cannot read the SSH forward port of '${vm}' from its gvproxy; stopping it without an in-guest shutdown."
            return 0
        fi
        info "Shutting down VM '${vm}'..."
        macos_guest_poweroff "$vm" || true
    fi
}

cmd_down_macos() {
    require_vz
    local project_vm
    project_vm="$(macos_project_vm)"
    macos_poweroff_before_teardown "$project_vm"
    # Always tear down the host-side egress (gvproxy/proxy) so a stranded one from a
    # crashed VM is cleaned up, even if the VM clone itself is already gone.
    stop_gvproxy
    stop_proxy
    # Dropped even if the stop below fails: a VM still running without these records is refused by
    # every attach (require_macos_egress_mode_current, require_macos_egress_verified) until it is
    # down and booted again.
    rm -f "$(macos_egress_mode_file)" "$(macos_egress_verified_file)"
    if ! macos_vm_exists "$project_vm"; then
        warn "No VM found for this directory (${project_vm})."
        return 0
    fi
    # Deliberately stops and KEEPS the clone (never `vm delete`): the Xcode state inside it —
    # DerivedData, Simulator runtimes, resolved dependencies — is expensive to rebuild.
    # `destroy --macos` is the full removal.
    info "Stopping VM '${project_vm}'..."
    # Keep the `|| true` (a stop failure must not abort the rest of this teardown), but re-check the
    # REAL state instead of reporting success unconditionally — the same re-check cmd_down does after
    # its `eng stop`, for the same reason, and it matters more here. `augur-vm stop` swallows its
    # diagnostics (2>/dev/null) and exits 0 even on its force-kill path, so the one case that counts
    # — the signal never landed (a `run` process this host user cannot signal, or a stop that errored
    # before signalling at all) — is otherwise completely invisible, and this function's last word
    # would be "stopped" about a VM that is still executing. Unlike container mode's version of that
    # lie, gvproxy and the proxy are ALREADY down by this point (see the top of the function), so the
    # guest keeps running with this workspace still shared into it while no augur command can reach
    # it any more: ssh_macos routes through gvproxy's forward when gvproxy is up and falls back to a
    # DHCP lease that a vfkit-networked guest never had. Do NOT drop this as redundant on the grounds
    # that a bounded stop "cannot fail" — the bound is what makes it exit 0, not what makes it work.
    "$VM_CLI" stop "$project_vm" 2>/dev/null || true
    if macos_vm_running "$project_vm"; then
        warn "VM '${project_vm}' did NOT stop — it is still running, with its egress datapath already torn down."
        warn "The guest keeps running and keeps writing to ${WORKSPACE_DIR} through its share, and no augur"
        warn "command can reach it again (SSH goes through the gvproxy this teardown just stopped)."
        warn "Kill its VM process, then re-run the teardown:"
        warn "  ${BOLD}kill \$(cat ~/.augur/vms/${project_vm}/run.pid) && augur down --macos${RESET}"
        warn "${BOLD}augur destroy --macos${RESET} cannot help while it runs — 'augur-vm delete' refuses a running VM."
    else
        success "VM '${project_vm}' stopped (clone kept; CoW so it costs ~0 on disk)."
        echo -e "  ${BOLD}augur up --macos${RESET}      → restart it (fast, no re-clone)"
        echo -e "  ${BOLD}augur destroy --macos${RESET} → remove the clone entirely"
    fi
}

cmd_destroy_macos() {
    if (( $# > 1 )); then error "Usage: augur destroy --macos [<vm-name>]"; exit 1; fi
    # With a name (as shown by `augur list --macos`), remove that VM instead of this directory's.
    if [[ -n "${1:-}" ]]; then adopt_target_name macos "$1" || exit 1; fi
    require_vz
    local project_vm
    project_vm="$(macos_project_vm)"
    macos_poweroff_before_teardown "$project_vm"
    stop_gvproxy
    stop_proxy
    rm -f "$(macos_egress_mode_file)" "$(macos_egress_verified_file)"
    if ! macos_vm_exists "$project_vm"; then
        warn "No VM found for this directory (${project_vm})."
        return 0
    fi
    info "Stopping and removing VM '${project_vm}'..."
    "$VM_CLI" stop "$project_vm" 2>/dev/null || true
    # No `|| true` on the delete, and that is what makes this path need no re-check of its own
    # (cmd_down_macos's, above, is not redundant here — it is unreachable). `augur-vm delete`
    # validates that the VM is NOT running and refuses otherwise, so a stop that failed above turns
    # into a hard, visible failure right here: the message reaches the terminal (no 2>/dev/null) and
    # `set -e` aborts before the "has been removed" success below. Adding `|| true` to this line
    # would produce exactly what cmd_down_macos's re-check guards against — a false success over a
    # live VM whose egress datapath is already gone — so if this ever needs to tolerate a delete
    # failure, it needs a `macos_vm_running` re-check first, not a swallowed exit status.
    "$VM_CLI" delete "$project_vm"
    # Drop the pinned SSH host key so the next clone (which will have a new key) is
    # not rejected against this project's fixed 127.0.0.1:<fwd-port> egress target.
    rm -f "$(vm_known_hosts_file "$project_vm")"
    success "VM '${project_vm}' has been removed."
}

cmd_status_macos() {
    require_vz
    local project_vm
    project_vm="$(macos_project_vm)"

    echo -e "${BOLD}VM (project):${RESET}  ${project_vm}"
    echo -e "${BOLD}VM (base):${RESET}     ${MACOS_BASE_VM}"
    echo -e "${BOLD}Directory:${RESET}     ${WORKSPACE_DIR}"
    echo -e "${BOLD}Resources:${RESET}     $(resolve_macos_vm_cpu) vCPU / $(resolve_macos_vm_memory_mb) MB$(macos_vm_running "$project_vm" && echo " (applies on next up --macos if changed)")"

    if macos_vm_running "$project_vm"; then
        local ip port
        if macos_via_gvproxy "$project_vm"; then
            port="$(macos_ssh_port "$project_vm")"
            ip="127.0.0.1:${port:-?} (gvproxy fwd)"
        else
            ip="$("$VM_CLI" ip "$project_vm" 2>/dev/null || echo '?')"
        fi
        echo -e "${BOLD}Status:${RESET}        ${GREEN}running${RESET}  (${ip})"
    elif macos_vm_exists "$project_vm"; then
        echo -e "${BOLD}Status:${RESET}        ${YELLOW}stopped${RESET}"
    else
        echo -e "${BOLD}Status:${RESET}        ${RED}not created${RESET}"
    fi
    if egress_enabled; then
        local estate="${RED}stopped${RESET}"
        proxy_running && estate="$(egress_helper_status "$(resolve_proxy_cli)" "$(proxy_pidfile)")"
        local gstate="${RED}stopped${RESET}"
        gvproxy_running && gstate="$(egress_helper_status "$(resolve_gvproxy)" "$(gvproxy_pidfile)")"
        echo -e "${BOLD}Egress:${RESET}        ${GREEN}on${RESET} (proxy ${estate}, gvproxy ${gstate})"
        echo -e "${BOLD}Allowlist:${RESET}     baseline$( [[ -f "$AUGUR_GLOBAL_CONF" ]] && echo " + augur.conf" )$( [[ -f "$AUGUR_PROJECT_CONF" ]] && echo " + .augur/allowlist.conf" )"
        if [[ -f "$AUGUR_PROJECT_CONF" ]]; then
            local _st="${YELLOW}unapproved (prompts on next up)${RESET}"
            [[ "$(project_conf_hash "$AUGUR_PROJECT_CONF")" == "$(cat "$(project_conf_hash_file)" 2>/dev/null || true)" ]] && _st="${GREEN}approved${RESET}"
            printf '%b.augur/allowlist.conf:%b    [%b] %s\n' "$BOLD" "$RESET" "$_st" "$(project_conf_domains | tr '\n' ' ')"
        fi
    else
        echo -e "${BOLD}Egress:${RESET}        ${YELLOW}off${RESET} (disabled via --no-egress or AUGUR_EGRESS=0)"
    fi
    echo ""

    if macos_vm_exists "$MACOS_BASE_VM"; then
        echo -e "  ${GREEN}✓${RESET} Base VM (${MACOS_BASE_VM})"
    else
        echo -e "  ${RED}✗${RESET} Base VM not found"
        echo -e "    Run: augur build --macos --ipsw <path> --xcode-xip <path>"
    fi

    echo ""
    # Toolchain is read from the running project VM only — status never boots a VM.
    # When the VM is stopped we just point at `augur up --macos` instead.
    echo -e "${BOLD}Toolchain:${RESET}"
    # Gate on the address ssh_macos will actually use: with egress on, that is gvproxy's local
    # forward and the guest has no DHCP lease, so a lease-based check would never pass.
    if macos_vm_running "$project_vm" && [[ -n "$(macos_ssh_host "$project_vm")" && -n "$(macos_ssh_port "$project_vm")" ]]; then
        # DEVELOPER_DIR (full Xcode, not the CLT) comes from ~/.augur-env; see push_macos_guest_env.
        # AUGUR_AGENT_SEAM | agent version (macOS, in-VM; runs `claude --version`)
        # The agent's name, version command and bin dir are seam constants set as variables ahead of
        # the single-quoted script; eval re-splits the command, which the guest's zsh does not do itself.
        ssh_macos "$project_vm" "_agent_name='$(agent_cli_name)'; _agent_ver='$(agent_version_cmd)'; _agent_bindir='$(macos_agent_bindir_rel)'
"'
            eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null
            export PATH="$HOME/$_agent_bindir:$PATH"
            echo "    xcode:  $(xcodebuild -version 2>/dev/null | head -1 || echo "(unable to fetch)")"
            echo "    $_agent_name: $(eval "$_agent_ver" 2>/dev/null || echo "(unable to fetch)")"
        ' | sanitize_guest_lines || true
    elif macos_vm_running "$project_vm"; then
        echo -e "    ${YELLOW}(VM is running, but its SSH forward port could not be read from gvproxy — run: augur down --macos && augur up --macos)${RESET}"
    else
        echo -e "    ${YELLOW}(VM not running — run: augur up --macos)${RESET}"
    fi
    echo ""
}

# Container mode: list every augur-OWNED container across all projects, with run state and
# address — the container-mode analogue of cmd_list_macos. `container list` shows EVERY
# container on the host (other tools, other projects); we filter to the `augur-` prefix that
# make_container_name always mints, so a user sees only THEIR augur containers. `--all` is
# required: Apple `container list` hides stopped containers by default, but `augur down` KEEPS
# a stopped container — so a listing that omitted them would hide exactly the ones a user is
# most likely hunting for (finished projects to reclaim).
#
# Parsing note: this runs on the HOST (macOS), where jq is NOT assumed (mirrors container_running,
# which greps rather than parses). Apple `container list --all` (confirmed on macOS 26) prints a
# whitespace-padded table: `ID IMAGE OS ARCH STATE IP CPUS MEMORY STARTED`. We read the header row
# and locate the ID/STATE/IP columns BY LABEL (not fixed positions), so a column reorder can't
# silently mis-map name/state.
#
# The IP column is the tricky one: a STOPPED container has a BLANK IP, and whitespace-splitting
# cannot see an empty field — the trailing CPUS/MEMORY values then shift left into the IP slot, so
# a naive $ip would print the CPU count for a stopped row. But a stopped container genuinely has no
# address, so we only trust the IP field for a RUNNING row (where it is present, hence unshifted)
# and require it to look address-shaped; everything else degrades to "-". STATE sits at a column
# that is never blank, so field-splitting resolves it reliably.
list_container_rows() {
    eng list --all 2>/dev/null | awk '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                u = toupper($i)
                if (u == "ID" || u == "NAME")                        nc = i
                else if (u == "STATE" || u == "STATUS")              sc = i
                else if (u == "ADDR" || u == "ADDRESS" || u == "IP") ac = i
            }
            if (nc == 0) nc = 1   # first column is the identifier if the header is unlabeled
            next
        }
        $nc ~ /^augur-/ {
            state = (sc && $sc != "") ? $sc : "-"
            # Only a running row has a real (unshifted) IP; require an address-shaped value so a
            # shifted CPU count can never masquerade as an IP.
            addr = (state == "running" && ac && $ac ~ /[.:]/) ? $ac : "-"
            print $nc, state, addr
        }
    '
}

cmd_list() {
    require_engine
    local rows
    rows="$(list_container_rows)"
    if [[ -z "$rows" ]]; then
        info "No augur containers found."
        echo -e "  Create one with: ${BOLD}augur up${RESET}"
        return
    fi

    # Width the NAME column to the longest actual name: container names
    # (augur-<slug>-<hash>-swift-<tag>) run far longer than macOS VM names, so a fixed width
    # like cmd_list_macos's %-28s would wrap. Never narrower than the "NAME" header itself.
    local name state addr width=4
    while read -r name state addr; do
        [[ ${#name} -gt $width ]] && width=${#name}
    done <<< "$rows"

    echo -e "  ${BOLD}$(printf "%-${width}s %-10s %s" NAME STATE IP)${RESET}"
    local color
    while read -r name state addr; do
        [[ -z "$name" ]] && continue
        if [[ "$state" == "running" ]]; then color="$GREEN"; else color="$YELLOW"; fi
        echo -e "  $(printf "%-${width}s" "$name") ${color}$(printf '%-10s' "$state")${RESET} ${addr}"
    done <<< "$rows"
}

# Bare names, one per line, for the shell completion scripts (`augur destroy <TAB>`). Hidden: not in
# `augur help`. Unlike `list` it must be quiet and fast and never change anything, so it does NOT
# call require_engine (which would start the container service on a TAB press). With no `container`
# CLI it prints nothing and succeeds; with the service down it prints nothing and exits 3, so the
# completion script can tell "no containers" from "service not running" and say so.
cmd_names() {
    command -v container &>/dev/null || return 0
    container system status &>/dev/null || return 3
    print_destroyable_names container < <(list_container_rows | awk '{print $1}')
}

cmd_names_macos() {
    command -v "$VM_CLI" &>/dev/null || return 0
    print_destroyable_names macos < <("$VM_CLI" list 2>/dev/null | awk 'NR>1 {print $2}')
}

# Echo the names on stdin that `destroy <name>` would accept (see target_name_re).
print_destroyable_names() {
    local re name; re="$(target_name_re "$1")"
    while IFS= read -r name; do
        [[ "$name" =~ $re ]] && echo "$name"
    done
    return 0
}

cmd_list_macos() {
    require_vz
    local rows
    rows="$("$VM_CLI" list 2>/dev/null | awk 'NR>1 {print $2, $NF}')"
    if [[ -z "$rows" ]]; then
        info "No macOS VMs found."
        echo -e "  Create one with: ${BOLD}augur build --macos --ipsw <path> --xcode-xip <path>${RESET}"
        return
    fi

    echo -e "  ${BOLD}$(printf '%-28s %-10s %s' NAME STATE IP)${RESET}"
    local name state ip color port
    while read -r name state; do
        [[ -z "$name" ]] && continue
        if [[ "$state" == "running" ]]; then
            # An egress-on VM has no DHCP lease (its NIC is gvproxy's), so `augur-vm ip` finds
            # nothing for it; show the forward ssh_macos connects through instead.
            if port="$(macos_vm_gvproxy_fwd_port "$name")"; then
                ip="127.0.0.1:${port} (gvproxy fwd)"
            else
                ip="$("$VM_CLI" ip "$name" 2>/dev/null || echo '-')"
            fi
            color="$GREEN"
        else
            ip="-"
            color="$YELLOW"
        fi
        echo -e "  $(printf '%-28s' "$name") ${color}$(printf '%-10s' "$state")${RESET}${ip}"
    done <<< "$rows"
}

# Best-effort: is the host cert $1 already present in the base VM's System keychain? Matches by
# SHA-256 fingerprint (colons stripped, upper-cased on both sides). Returns non-zero on ANY doubt
# (parse failure, ssh error, not found) — callers treat that as "unconfirmed", never a hard error,
# so a quirk in `security`'s output format can't turn a good manual install into a false failure.
_cert_present_in_base_vm() {
    local cert="$1" want
    want="$(openssl x509 -in "$cert" -noout -fingerprint -sha256 2>/dev/null | sed 's/.*=//; s/://g' | tr 'a-f' 'A-F')"
    [[ -n "$want" ]] || return 1
    ssh_macos "$MACOS_BASE_VM" "security find-certificate -a -Z /Library/Keychains/System.keychain 2>/dev/null" 2>/dev/null \
        | tr -d ':' | tr 'a-f' 'A-F' | grep -q "$want"
}

# Notice for install-cert --macos when certificate $1 is already in the base VM's System keychain.
# Presence is checked by fingerprint only; the trust setting is not read, so say so plainly and
# give the manual way to (re)apply it.
report_cert_already_installed() {
    local cert="$1" subject enddate sha1
    subject="$(openssl x509 -in "$cert" -noout -subject 2>/dev/null | sed 's/^subject=[[:space:]]*//')"
    enddate="$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')"
    sha1="$(openssl x509 -in "$cert" -noout -fingerprint -sha1 2>/dev/null | sed 's/^.*=//; s/://g')"
    success "This certificate is already in the System keychain of base VM '${MACOS_BASE_VM}'; nothing was changed."
    echo -e "    Subject:  ${subject:-<unknown>}"
    echo -e "    Expires:  ${enddate:-<unknown>}"
    warn "Its TRUST SETTING was NOT verified (augur checks only that the certificate is present). It is"
    warn "assumed trusted, because trusting it is part of the normal install."
    warn "No option forces the GUI flow again. To re-apply the trust by hand: boot the base VM with a"
    warn "window (${BOLD}augur-vm run --net-nat ${MACOS_BASE_VM}${RESET}), put the certificate file in the VM, and run in the"
    warn "VM's own Terminal:"
    echo -e "    ${BOLD}sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain <cert>${RESET}"
    warn "Or remove the certificate there (${BOLD}sudo security delete-certificate -Z ${sha1:-<sha1>} /Library/Keychains/System.keychain${RESET})"
    warn "and re-run ${BOLD}augur install-cert --macos${RESET}. Shut the VM down afterwards, before any ${BOLD}augur up --macos${RESET}."
}

# macOS mode: install the CA into the base VM's System keychain, so every cloned project VM
# inherits it (keychain-consulting clients — curl, git, gh (Go uses Security.framework on
# darwin), and native Claude Code — then trust it). Modifying System-keychain trust settings
# needs an interactive GUI authorization that a non-console SSH session cannot obtain (an
# SSH-invoked `security add-trusted-cert` fails "authorization denied, no user interaction
# possible" — confirmed on macOS 26). So we first boot the base VM headless and stop if the cert is already in the keychain; otherwise we boot it WITH a GUI window, copy the cert in,
# and have the OPERATOR run `security add-trusted-cert` in the VM's own Terminal; augur then
# verifies it landed. Mirrors cmd_update_macos's boot-base-VM/stop-and-reap shape.
cmd_install_cert_macos() {
    local cert="${1:-}"
    [[ -n "$cert" ]] || { error "Usage: augur install-cert --macos <cert.crt>"; exit 1; }
    require_vz
    validate_cert_file "$cert" || exit 1
    # scp reads "host:path" syntax, so a cert path whose first segment contains a colon (e.g.
    # "corp:ca.crt", a real local file) would be misread as a remote target. A slash-less path is
    # anchored to "./" so the colon is unambiguously part of the local filename.
    [[ "$cert" == */* ]] || cert="./$cert"
    confirm_cert_install "$cert" "macOS base VM '${MACOS_BASE_VM}' (inherited by every NEW project VM cloned afterward)" || exit 1
    macos_vm_exists "$MACOS_BASE_VM" || {
        error "Base VM '${MACOS_BASE_VM}' not found."
        error "Run: augur build --macos --ipsw <path> --xcode-xip <path>"
        exit 1
    }
    # The operator types this password into the VM's Terminal below.
    require_macos_admin_password "$MACOS_BASE_VM"
    # This writes into the base VM itself, so it takes the base-writer lock like build and update:
    # neither can stop or replace the base VM under the operator's trust window.
    host_lock_acquire "$MACOS_BASE_WRITER_LOCK" install-cert
    trap 'host_lock_release "$MACOS_BASE_WRITER_LOCK" install-cert' EXIT
    require_base_vm_stopped install-cert
    info "Booting base VM '${MACOS_BASE_VM}' headless to check whether the certificate is already installed..."
    # Headless + NAT, backgrounded so we can drive it over SSH. A window is opened (second boot
    # below) only when the certificate is missing and the operator has to approve the trust.
    "$VM_CLI" run --no-graphics --net-nat "$MACOS_BASE_VM" &>"$(macos_base_vm_log)" &
    local vm_pid=$!
    # CRITICAL: the base VM is now running. Guarantee it is stopped on EVERY exit — including
    # Ctrl-C at the interactive prompts below. A base VM left running would be cloned in a live,
    # crash-consistent (possibly inconsistent) state by the next `augur up --macos` (clonefile
    # does not refuse a running source), silently corrupting that project VM — a failure that
    # escapes this edge command into the normal `up` path. INT/TERM convert to a normal exit so
    # the single EXIT trap does the teardown; disarmed only on the clean success path. Mirrors
    # cmd_build_macos's build-VM trap.
    # ${vm_pid:-} (not $vm_pid): the EXIT trap fires while the function frame is live on every
    # abort path here, so the local is normally visible — but tolerate an unbound value so the
    # teardown degrades to a stop-by-name (stop_and_reap needs only the VM name) instead of a
    # set -u crash, per this codebase's "traps referencing locals are fragile" rule.
    trap 'stop_and_reap_macos_vm "$MACOS_BASE_VM" "${vm_pid:-}"; host_lock_release "$MACOS_BASE_WRITER_LOCK" install-cert' EXIT
    trap 'exit 130' INT TERM
    if ! wait_for_macos_ssh "$MACOS_BASE_VM" 300 &>/dev/null; then
        error "Base VM '${MACOS_BASE_VM}' did not become reachable over SSH in time."
        error "  VM log: $(macos_base_vm_log)"
        exit 1
    fi
    if _cert_present_in_base_vm "$cert"; then
        report_cert_already_installed "$cert"
        stop_and_reap_macos_vm "$MACOS_BASE_VM" "$vm_pid"
        trap - EXIT INT TERM
        host_lock_release "$MACOS_BASE_WRITER_LOCK" install-cert
        return 0
    fi
    info "Not installed yet. Restarting base VM '${MACOS_BASE_VM}' with a GUI window (for the trust prompt)..."
    stop_and_reap_macos_vm "$MACOS_BASE_VM" "$vm_pid"
    # GUI (no --no-graphics) + NAT. augur-vm waits out the previous boot's still-held auxiliary-storage lock itself, within the SSH budget below.
    "$VM_CLI" run --net-nat "$MACOS_BASE_VM" &>"$(macos_base_vm_log)" &
    vm_pid=$!
    if ! wait_for_macos_ssh "$MACOS_BASE_VM" 300 &>/dev/null; then
        error "Base VM '${MACOS_BASE_VM}' did not become reachable over SSH after the restart with a window."
        error "  VM log: $(macos_base_vm_log)"
        exit 1
    fi
    local remote="/tmp/augur-install-ca.crt"
    if ! scp_to_macos "$MACOS_BASE_VM" "$cert" "$remote"; then
        error "Failed to copy the certificate into the base VM."
        exit 1
    fi
    # macOS denies an SSH-invoked System-keychain trust change ("no user interaction possible"),
    # so we DON'T attempt it over SSH (that only leaks a scary error). The cert is already staged
    # at $remote in the VM; the operator runs the trust command in the VM's own Terminal — where
    # the GUI authorization CAN appear — and we verify it landed. Needs an interactive host tty.
    local manual_cmd="sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain ${remote}"
    if [[ ! -t 0 || ! -t 1 ]]; then
        error "Trusting a macOS CA must be approved inside the VM, which needs an interactive"
        error "terminal. Re-run ${BOLD}augur install-cert --macos${RESET} from a real terminal."
        exit 1
    fi
    echo ""
    warn "macOS only lets you trust a CA from ${BOLD}inside the VM's own session${RESET} (an SSH-driven"
    warn "attempt is denied 'no user interaction possible'). Finish it in the VM window:"
    echo -e "    1. The base VM desktop is up (it auto-logs in). Open ${BOLD}Terminal${RESET} there."
    echo -e "    2. Run:  ${BOLD}${manual_cmd}${RESET}"
    echo -e "    3. Enter the base VM's admin password when sudo asks; approve any prompt."
    echo -e "       It is stored on this Mac in ${BOLD}$(macos_admin_password_file "$MACOS_BASE_VM")${RESET}."
    echo ""
    read -rp "$(echo -e "${CYAN}[augur]${RESET} Press Enter once you've run it in the VM (Ctrl-C to abort)... ")" _ || true
    if _cert_present_in_base_vm "$cert"; then
        info "Verified the certificate is now in the base VM's System keychain."
    else
        error "The certificate is not in the base VM's System keychain — it was not installed."
        error "Re-run and make sure the command above completes ${BOLD}inside the VM${RESET}."
        exit 1
    fi
    ssh_macos "$MACOS_BASE_VM" "rm -f '${remote}'" 2>/dev/null || true
    success "Custom CA trusted in base VM '${MACOS_BASE_VM}'."
    warn "Newly cloned project VMs will trust it. ${BOLD}Existing${RESET} project VMs are NOT updated —"
    warn "re-clone a project with: ${BOLD}augur destroy --macos && augur up --macos${RESET}."
    warn "Additive: CAs installed earlier stay trusted too (augur never removes one; delete it in the base VM by hand)."
    warn "A full ${BOLD}augur build --macos${RESET} (base VM rebuild) drops the CA — re-run install-cert."
    # Clean success: stop the VM ourselves and disarm the trap so the normal exit doesn't re-stop it.
    stop_and_reap_macos_vm "$MACOS_BASE_VM" "$vm_pid"
    trap - EXIT INT TERM
    host_lock_release "$MACOS_BASE_WRITER_LOCK" install-cert
}

# Save stopped scratch VM $1 as the base VM, for augur command $2 (build or update), which holds the
# base-writer lock: delete any existing base VM, then clone $1 into its place. The caller deletes
# $1 afterwards and releases its lock.
# From the delete on, $1 may be the only good copy, so the EXIT trap set here never deletes it: if
# the save does not complete, $1 is kept and macos_base_save_exit says how to finish it by hand.
# INT/TERM/HUP are ignored for these two quick steps so an interrupt cannot land between them; a
# SIGKILL there still leaves $1 on disk. Returns with EXIT/INT/TERM/HUP traps cleared.
macos_save_scratch_as_base() {
    local scratch="$1" cmd="$2"
    MACOS_BASE_SAVED=0
    trap '' INT TERM HUP
    trap "macos_base_save_exit $(printf '%q' "$scratch"); host_lock_release $(printf '%q' "$MACOS_BASE_WRITER_LOCK") $(printf '%q' "$cmd")" EXIT
    if macos_vm_exists "$MACOS_BASE_VM"; then "$VM_CLI" delete "$MACOS_BASE_VM"; fi
    "$VM_CLI" clone "$scratch" "$MACOS_BASE_VM"
    MACOS_BASE_SAVED=1
    trap - EXIT INT TERM HUP
}
# EXIT trap of macos_save_scratch_as_base: nothing to do once the save completed. Otherwise the
# base VM is missing, or is still the old one, or is a clone that may be incomplete (a failed clone
# can leave a partial destination), so it is treated as unsaved either way.
macos_base_save_exit() {
    [[ "${MACOS_BASE_SAVED:-0}" == 1 ]] && return 0
    error "The base VM was not saved. The new VM is kept as '$1'; save it with:"
    if macos_vm_exists "$MACOS_BASE_VM"; then
        error "  ${BOLD}augur-vm delete ${MACOS_BASE_VM} && augur-vm clone $1 ${MACOS_BASE_VM} && augur-vm delete $1${RESET}"
        error "  (the '${MACOS_BASE_VM}' there now is the old base VM or an incomplete copy)"
    else
        error "  ${BOLD}augur-vm clone $1 ${MACOS_BASE_VM} && augur-vm delete $1${RESET}"
    fi
}

cmd_update_macos() {
    require_vz
    macos_vm_exists "$MACOS_BASE_VM" || {
        error "Base VM '${MACOS_BASE_VM}' not found."
        error "Run: augur build --macos --ipsw <path> --xcode-xip <path>"
        exit 1
    }
    require_macos_admin_password "$MACOS_BASE_VM"
    # Held until the update ends, released by the EXIT trap on every path: no build, second update
    # or setup-token clone runs while this replaces the base VM. A build replaces the same base VM
    # and uses the same fixed provisioning ports, so the two can never overlap.
    host_lock_acquire "$MACOS_BASE_WRITER_LOCK" update
    trap 'host_lock_release "$MACOS_BASE_WRITER_LOCK" update' EXIT
    trap 'exit 130' INT TERM HUP
    require_base_vm_stopped update
    info "Updating base VM '${MACOS_BASE_VM}': $(agent_display_name) and the Homebrew formulae (gh included), then any custom provisioning..."
    # With the lock held no other update runs, so a staging VM that exists now, running or not, was
    # left by one that was killed. The build VM is never touched (it may be one kept with
    # AUGUR_KEEP_BUILD_VM=1).
    if macos_vm_exists "$MACOS_UPDATE_VM"; then
        macos_vm_running "$MACOS_UPDATE_VM" && "$VM_CLI" stop "$MACOS_UPDATE_VM" 2>/dev/null || true
        "$VM_CLI" delete "$MACOS_UPDATE_VM"
    fi
    # Every step runs on a staging copy (MACOS_UPDATE_VM), and the base VM is replaced only once all
    # of them, the signature check included, have passed. Until then any failure or Ctrl-C leaves
    # the base VM as it was and discards the copy. The replacement itself is guarded so that at
    # least one of the two always survives (macos_save_scratch_as_base).
    trap 'macos_discard_scratch_vm "$MACOS_UPDATE_VM"; host_lock_release "$MACOS_BASE_WRITER_LOCK" update' EXIT
    info "Cloning '${MACOS_BASE_VM}' to the staging VM '${MACOS_UPDATE_VM}'..."
    "$VM_CLI" clone "$MACOS_BASE_VM" "$MACOS_UPDATE_VM"
    rm -f "$(vm_known_hosts_file "$MACOS_UPDATE_VM")"
    # The boot log stays on disk (not /dev/null) so a reachability failure below can show the cause.
    if ! macos_boot_scratch_vm_nat "$MACOS_UPDATE_VM" "$(macos_base_vm_log)"; then
        error "VM '${MACOS_UPDATE_VM}' did not become reachable over SSH in time."
        # Surface the otherwise-discarded cause (mirrors cmd_up_macos). The VM boots over NAT; the
        # usual reasons it stays unreachable are a boot failure or a missing/stale DHCP lease —
        # augur-vm resolves its IP from /var/db/dhcpd_leases by MAC, so an empty host means it
        # never booted far enough to lease an address.
        local _bhost
        _bhost="$(macos_ssh_host "$MACOS_UPDATE_VM" 2>/dev/null || true)"
        error "Diagnostics (kept on disk):"
        error "  staging VM SSH host (from DHCP lease): ${_bhost:-<none — VM did not boot or never got an IP>}"
        if [[ -n "$_bhost" ]]; then
            error "  ---- ssh probe (stderr) ----"
            ssh_macos "$MACOS_UPDATE_VM" true 2>&1 | head -n 6 | show_guest_lines || true
        fi
        error "  VM log:      $(macos_base_vm_log)"
        if [[ -s "$(macos_base_vm_log)" ]]; then
            error "  ---- last VM lines ----"
            tail -n 15 "$(macos_base_vm_log)" 2>/dev/null | show_guest_lines
        fi
        stop_and_reap_macos_vm "$MACOS_UPDATE_VM" "$MACOS_SCRATCH_VM_PID"
        error "The base VM was left as-is; it may just be slow to boot — re-run ${BOLD}augur update --macos${RESET}."
        exit 1
    fi
    # On every update too, so updating a base VM is enough to give its future clones the session
    # credentials' sshd acceptance. Fatal, as in cmd_build_macos; the base VM is left as it was.
    # First, before every step that needs the network (the agent installer, Homebrew, custom
    # provisioning): it needs none, so a failure here is reported before a long download, and it
    # does not depend on Homebrew or a mirror being healthy. The update still saves the base VM
    # only once every step has passed, so a failing Homebrew upgrade still leaves an old base VM
    # without it until an update succeeds. It is checked again as the update's last guest step
    # (verify_macos_session_env_acceptance), after everything that could undo it.
    install_macos_session_env_acceptance "$MACOS_UPDATE_VM" || {
        error "The base VM was left as-is."
        exit 1
    }
    # Before the Homebrew upgrade below: a base VM built with the Command Line Tools selected needs
    # the full Xcode selected for a formula that builds from source. It is selected again after
    # provisioning, which can leave the Command Line Tools selected.
    select_macos_full_xcode "$MACOS_UPDATE_VM" || {
        error "Could not select the full Xcode install in '${MACOS_UPDATE_VM}'."
        error "The base VM was left as-is."
        exit 1
    }
    # Seam constants set as variables ahead of the single-quoted script, as in cmd_build_macos.
    if ! ssh_macos "$MACOS_UPDATE_VM" "_agent_url='$(agent_installer_url)'; _agent_args='$(agent_installer_args)'; _agent_bindir='$(macos_agent_bindir_rel)'; _agent_name='$(agent_display_name)'
"'
        # The agent via its official installer (see cmd_build_macos for why npm is avoided).
        # The VM has no virtiofs mounts here, so ~/.claude is local and writable.
        # Download to a temp file before executing — avoids piping untrusted content to a shell.
        # No "timeout" binary on stock macOS: background the command, race it against a
        # backgrounded sleep+kill, and wait on the real PID for its actual exit status — a
        # stalled network call (curl gives no output at all while blocked) cannot hang this
        # step forever.
        _with_timeout() {
            local _secs="$1"; shift
            "$@" & local _cpid=$!
            ( sleep "$_secs"; pkill -TERM -P "$_cpid" 2>/dev/null; kill -TERM "$_cpid" 2>/dev/null ) & local _wpid=$!
            wait "$_cpid" 2>/dev/null; local _rc=$?
            kill "$_wpid" 2>/dev/null; wait "$_wpid" 2>/dev/null
            return $_rc
        }
        _installer=$(mktemp)
        curl -fsSL --connect-timeout 10 --max-time 120 "$_agent_url" -o "$_installer" \
            || { echo "augur: ERROR failed to download the $_agent_name installer (timed out or unreachable)" >&2; rm -f "$_installer"; exit 1; }
        _with_timeout 180 bash "$_installer" "$_agent_args" \
            || { echo "augur: ERROR $_agent_name installer failed or timed out" >&2; rm -f "$_installer"; exit 1; }
        rm -f "$_installer"
        grep -q "$_agent_bindir" ~/.zprofile 2>/dev/null || echo "export PATH=\"\$HOME/$_agent_bindir:\$PATH\"" >> ~/.zprofile
        # Homebrew formulae (gh included), over the same plain NAT as the installer above. Formulae
        # only: a cask upgrade can need root, which this unprivileged call does not have.
        [ -x /opt/homebrew/bin/brew ] || { echo "augur: ERROR Homebrew is missing from the base VM (/opt/homebrew/bin/brew)" >&2; exit 1; }
        eval "$(/opt/homebrew/bin/brew shellenv)"
        _with_timeout 900 brew update \
            || { echo "augur: ERROR brew update failed or timed out" >&2; exit 1; }
        _with_timeout 1800 brew upgrade --formula \
            || { echo "augur: ERROR brew upgrade failed or timed out" >&2; exit 1; }
    '; then
        error "Failed to update the base VM's tools (see the error above; a network problem or a single broken Homebrew formula both land here)."
        error "The base VM was left as-is. Try running 'augur update --macos' again."
        exit 1
    fi

    # Re-assert augur's managed policy on every update, so a base VM built before this existed
    # self-heals on routine maintenance instead of needing a full rebuild. Each install replaces the
    # whole policy directory with a fresh one holding the same policy. Before custom provisioning,
    # as in cmd_build_macos: provisioning, re-run below on every update, then adds its own files to
    # the directory again.
    install_macos_managed_settings "$MACOS_UPDATE_VM" || {
        error "The base VM was left as-is; re-run ${BOLD}augur update --macos${RESET}, or rebuild with ${BOLD}augur build --macos${RESET}."
        exit 1
    }

    # Optional custom provisioning (~/.augur/provision/manifest.conf and/or hook.sh) — kept
    # in sync with the base VM on every update too, not just at first build. No-op unless
    # the operator created those files. See run_base_provisioning.
    run_base_provisioning "$MACOS_UPDATE_VM"

    # Same scrub as cmd_build_macos: re-assert the no-account-state invariant on every
    # update too, not just at build. The base VM is long-lived and mutable, so a human can log
    # into `claude` by hand between updates (the actual leak vector — neither build's provisioning
    # nor this update step ever runs `claude` interactively); running this on every update makes
    # that self-healing instead of requiring a full rebuild to notice and fix.
    macos_scrub_agent_config "$MACOS_UPDATE_VM"

    # Same as the end of cmd_build_macos, re-run here so a base VM built with the Command Line
    # Tools left selected self-heals without a rebuild, and provisioning above cannot undo it.
    select_macos_full_xcode "$MACOS_UPDATE_VM" || {
        error "Could not select the full Xcode install in '${MACOS_UPDATE_VM}'."
        error "The base VM was left as-is."
        exit 1
    }

    # Last, on the final guest state, for the reason given in cmd_build_macos.
    agent_verify_integrity_macos "$MACOS_UPDATE_VM" || {
        agent_signature_check_failed updated
        error "The base VM was left as-is."
        exit 1
    }

    # As in cmd_build_macos: the managed policy must still be augur's after custom provisioning.
    verify_macos_managed_settings "$MACOS_UPDATE_VM" || {
        error "The base VM was left as-is; re-run ${BOLD}augur update --macos${RESET}, or rebuild with ${BOLD}augur build --macos${RESET}."
        exit 1
    }

    # The last guest step, as in cmd_build_macos: the drop-in installed first, before Homebrew,
    # the agent installer and custom provisioning, must still be live in the guest saved as the base.
    verify_macos_session_env_acceptance "$MACOS_UPDATE_VM" || {
        error "The base VM was left as-is."
        exit 1
    }

    info "Saving base VM '${MACOS_BASE_VM}'..."
    stop_and_reap_macos_vm "$MACOS_UPDATE_VM" "$MACOS_SCRATCH_VM_PID"
    # Deliberately keeps the base VM's pinned SSH host key (unlike build): the staging VM is a clone
    # of the base VM, so the saved one has the same key.
    macos_save_scratch_as_base "$MACOS_UPDATE_VM" update
    "$VM_CLI" delete "$MACOS_UPDATE_VM" || warn "Could not delete the staging VM '${MACOS_UPDATE_VM}'; the next update removes it."
    host_lock_release "$MACOS_BASE_WRITER_LOCK" update
    success "Base VM '${MACOS_BASE_VM}' updated."
    warn "Project VMs cloned before this update will not be affected."
    warn "Run ${BOLD}augur destroy --macos && augur up --macos${RESET} to apply to the current project."
}

# ── Base-image custom provisioning ─────────────────────────────────────────────
# Two independent, mode-scoped mechanisms — not one shared config, because the underlying
# execution model differs completely:
#   macOS:            ~/.augur/provision/{manifest.conf,hook.sh,hook.allowlist.conf} run
#                      once, as root, inside the base-VM build/update over a DEDICATED
#                      egress-filtered proxy/gvproxy pair (see run_base_provisioning).
#   Apple Container:  ~/.augur/provision/container-packages.conf is baked into the image
#                      via a --build-arg (see container_provision_build_args) — that build
#                      already has zero egress filtering (pre-existing), so no proxy needed.
# Both share the TOFU approval primitives below, generalizing check_project_conf_approved's
# pattern (~line 814) past a single hardcoded file.

# Concatenated content hash of the given files (whichever exist; order matters, so adding/
# removing/editing any one of them changes the hash). Generic hashing primitive behind every
# provisioning TOFU gate below.
files_content_hash() {
    local f
    { for f in "$@"; do
          [[ -f "$f" ]] && { printf '## %s\n' "$f"; cat "$f"; }
      done
    } | { if command -v sha256sum &>/dev/null; then sha256sum; else shasum -a 256; fi; } | awk '{print $1}'
}

# Shared TOFU decision core (trust-on-first-use — same model as check_project_conf_approved):
# $1 = host-side cache file recording the last-approved hash, $2 = the CURRENT content hash
# (already computed by the caller via files_content_hash), $3 = a human label for prompts,
# $4 = the name of a function the caller defines that prints what changed (invoked only when
# approval is actually needed, so unrelated modes never show each other's prompts).
# Non-interactive runs fail closed unless AUGUR_ACCEPT_PROVISION_HOOK=1 (mirrors
# AUGUR_ACCEPT_PROJECT_CONF=1). Fails closed if the hash could not be computed (no sha256
# tool) — a security gate must never silently approve.
# Returns 1 on decline/fail-closed (never exits directly) — every caller MUST check this
# and abort/clean up itself; a bare unchecked call would let a decline silently pass through
# under a tested-context `set -e` suspension (see run_base_provisioning/container_provision_
# prepare, which route this through provision_fail / an explicit `|| exit 1`).
tofu_decide() {
    local hash_file="$1" cur="$2" label="$3" display_fn="$4"
    if [[ -z "$cur" ]]; then
        error "Could not fingerprint ${label} (no sha256sum/shasum?). Refusing to continue (fail closed)."
        return 1
    fi
    mkdir -p "$(dirname "$hash_file")"
    local recorded=""
    [[ -f "$hash_file" ]] && recorded="$(cat "$hash_file" 2>/dev/null || true)"
    [[ "$cur" == "$recorded" ]] && return 0

    warn "${label} changed and will run on the next build:"
    "$display_fn"

    if [[ "${AUGUR_ACCEPT_PROVISION_HOOK:-}" == "1" ]]; then
        echo "$cur" > "$hash_file"
        info "Accepted via AUGUR_ACCEPT_PROVISION_HOOK=1."
        return 0
    fi

    if [[ -t 0 && -t 1 ]]; then
        local yn=""
        read -rp "$(echo -e "${CYAN}[augur]${RESET} Approve ${label}? [y/N] ")" yn || true
        if [[ "$yn" == [yY] ]]; then
            echo "$cur" > "$hash_file"
            success "Approved — won't ask again until ${label} changes."
            return 0
        fi
        error "Declined. Edit it or approve it to continue."
        return 1
    fi

    error "${label} is unapproved and augur is non-interactive."
    error "Re-run in a terminal to review it, or set AUGUR_ACCEPT_PROVISION_HOOK=1 to accept."
    return 1
}

# Validate ONE bare package name (Homebrew formula/cask on macOS, apt package on Apple
# Container — same safe charset covers both). No shell metacharacters/paths/flags.
provision_package_name_valid() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9+._@-]*$ ]]
}

# Shared comment-strip/trim step for every provisioning conf file (manifest.conf,
# container-packages.conf, hook.allowlist.conf) — one definition instead of several
# hand-copied loops, so a future change to the cleaning rule (e.g. CRLF handling) can't
# silently drift between a file's validate-pass and its use-pass. Emits "LINENO<TAB>cleaned"
# for every non-comment, non-blank line in $1 (blank/comment-only lines are never emitted).
# Safe to consume via `< <(...)` — never exits, only echoes.
provision_clean_lines() {
    local file="$1" line lineno=0 clean
    [[ -f "$file" ]] || return 0
    while IFS= read -r line; do
        lineno=$((lineno + 1))
        clean="${line%%#*}"
        clean="${clean#"${clean%%[![:space:]]*}"}"
        clean="${clean%"${clean##*[![:space:]]}"}"
        [[ -n "$clean" ]] || continue
        printf '%s\t%s\n' "$lineno" "$clean"
    done < "$file"
}

# ── macOS base-VM custom provisioning ──────────────────────────────────────────
# hook.allowlist.conf alone (no manifest.conf, no hook.sh) is deliberately NOT enough to
# trigger provisioning — it only ever widens the network for something else to use, so with
# nothing to install/run it would just be a wasted VM network-mode switch. It's still merged
# into write_provision_allowlist and included in the approval hash whenever provisioning DOES
# run for another reason.
#
# Existence alone is not enough for manifest.conf/hook.sh either — both are checked for
# actual (non-comment, non-blank) content, not just presence. Without this, a freshly
# scaffolded-but-still-untouched template (e.g. right after 'augur init-conf', which only
# writes commented-out example lines) would trigger the full provisioning-proxy VM network
# switch on every build/update for zero actual installs/effect.
provision_manifest_has_entries() {
    [[ -f "$AUGUR_PROVISION_MANIFEST" ]] || return 1
    [[ -n "$(provision_clean_lines "$AUGUR_PROVISION_MANIFEST")" ]]
}

provision_hook_has_content() {
    [[ -f "$AUGUR_PROVISION_HOOK" ]] || return 1
    [[ -n "$(provision_clean_lines "$AUGUR_PROVISION_HOOK")" ]]
}

provision_files_present() {
    provision_manifest_has_entries || provision_hook_has_content
}

# Validate the WHOLE manifest before touching the VM (fail before boot, not mid-install).
# Returns 1 (not exit — this may run in a subshell/pipe, and an exit there wouldn't abort
# the direct caller; mirrors project_conf_hash's own note on this exact pitfall) on the
# first invalid line.
provision_manifest_validate() {
    local lineno clean
    while IFS=$'\t' read -r lineno clean; do
        if ! provision_package_name_valid "$clean"; then
            error "~/.augur/provision/manifest.conf:${lineno}: invalid entry '${clean}' (expected a bare package name)"
            return 1
        fi
    done < <(provision_clean_lines "$AUGUR_PROVISION_MANIFEST")
    return 0
}

# Parsed package names, one per line. Only meaningful after provision_manifest_validate has
# already succeeded.
provision_manifest_entries() {
    local lineno clean
    while IFS=$'\t' read -r lineno clean; do
        echo "$clean"
    done < <(provision_clean_lines "$AUGUR_PROVISION_MANIFEST")
}

provision_hash_file() { echo "$AUGUR_DIR/provision-hashes/macos.sha256"; }

provision_display_changes() {
    if [[ -f "$AUGUR_PROVISION_MANIFEST" ]]; then
        printf '    %b+ manifest: %s%b\n' "$YELLOW" "$AUGUR_PROVISION_MANIFEST" "$RESET"
        grep -vE '^[[:space:]]*(#|$)' "$AUGUR_PROVISION_MANIFEST" 2>/dev/null | while IFS= read -r _l; do printf '        %s\n' "$_l"; done
    fi
    if [[ -f "$AUGUR_PROVISION_HOOK" ]]; then
        printf '    %b+ hook script (runs as root): %s%b\n' "$YELLOW" "$AUGUR_PROVISION_HOOK" "$RESET"
        echo "        ---- hook.sh ----"
        cat "$AUGUR_PROVISION_HOOK" | while IFS= read -r _l; do printf '        %s\n' "$_l"; done
        echo "        -----------------"
    fi
    if [[ -f "$AUGUR_PROVISION_HOOK_ALLOWLIST" ]]; then
        printf '    %b+ hook allowlist domains: %s%b\n' "$YELLOW" "$AUGUR_PROVISION_HOOK_ALLOWLIST" "$RESET"
        # Show exactly what write_provision_allowlist will actually merge (validated
        # domains via provision_hook_allowlist_domains), not the raw file — otherwise an
        # operator could approve a line here that the proxy silently never applies.
        provision_hook_allowlist_domains | while IFS= read -r _l; do printf '        %s\n' "$_l"; done
        local _dropped; _dropped="$(provision_hook_allowlist_invalid_count)"
        [[ "${_dropped:-0}" -gt 0 ]] && \
            warn "Ignored ${_dropped} line(s) in hook.allowlist.conf that are not valid domain patterns (possible obfuscation)."
    fi
}

check_provision_approved() {
    provision_files_present || return 0
    local cur; cur="$(files_content_hash "$AUGUR_PROVISION_MANIFEST" "$AUGUR_PROVISION_HOOK" "$AUGUR_PROVISION_HOOK_ALLOWLIST")"
    tofu_decide "$(provision_hash_file)" "$cur" "macOS base-VM provisioning (~/.augur/provision/)" provision_display_changes
}

# Domains needed for Homebrew itself to install ANYTHING (formula or cask) from the base
# VM. Fixed and shipped with augur (not user-editable). Package-specific extra domains
# (e.g. a cask's own vendor CDN) are NOT auto-mapped here — that doesn't scale past a
# handful of hardcoded names, so hook.allowlist.conf is the one general escape hatch for
# any extra domain a manifest.conf package (or hook.sh) needs.
# Deliberately mirrors augur.conf's own already-vetted "Homebrew"/"GitHub" sections
# (installed as AUGUR_BASELINE_CONF, read by write_merged_allowlist for the per-project
# proxy) rather than an independently hand-picked list — same domains, same forms
# (*.ghcr.io / *.githubusercontent.com, not the broader apex-inclusive '.' form), so this
# never silently drifts from what's already reviewed for the exact same dependency (brew
# install fetching formulae/bottles). No docker.io: Homebrew's own infra doesn't use it,
# and it was never in augur.conf either — kept out to avoid an unreviewed addition.
provision_baseline_domains() {
    cat <<'EOF'
formulae.brew.sh
ghcr.io
*.ghcr.io
github.com
*.githubusercontent.com
EOF
}

provision_allowlist_path() { echo "$AUGUR_PROXY_DIR/_macos-build-provision.allowlist"; }

# Merge the fixed baseline with the TOFU-approved hook.allowlist.conf into a standalone
# allowlist for the ONE-TIME build-provisioning proxy session. Never touches
# proxy_allowlist()/write_merged_allowlist() (the per-project egress allowlist) — a
# separate file, a separate proxy instance, because there is no project/workspace yet at
# base-VM build time. hook.allowlist.conf is merged even when hook.sh doesn't exist (a
# manifest.conf package can need it too).
# Effective domain patterns hook.allowlist.conf contributes: comments stripped, whitespace
# trimmed, blanks dropped, and validated by conf_line_valid — mirrors project_conf_domains
# exactly (same sanitization contract). Shared by write_provision_allowlist (enforcement)
# and provision_display_changes (the TOFU approval prompt) so the two can never disagree
# about what a line means — an operator approving what's shown is guaranteed to be
# approving exactly what gets merged into the proxy's allowlist, not a superset of it.
provision_hook_allowlist_domains() {
    local lineno clean
    while IFS=$'\t' read -r lineno clean; do
        conf_line_valid "$clean" && printf '%s\n' "$clean"
    done < <(provision_clean_lines "$AUGUR_PROVISION_HOOK_ALLOWLIST")
}

# Count of hook.allowlist.conf non-comment, non-blank lines conf_line_valid REJECTED —
# mirrors project_conf_invalid_count, surfaced at approval so an obfuscated/malformed line
# is a visible warning instead of a silent, unexplained drop.
provision_hook_allowlist_invalid_count() {
    local lineno clean total=0 valid=0
    while IFS=$'\t' read -r lineno clean; do
        total=$((total + 1))
        conf_line_valid "$clean" && valid=$((valid + 1))
    done < <(provision_clean_lines "$AUGUR_PROVISION_HOOK_ALLOWLIST")
    echo $((total - valid))
}

write_provision_allowlist() {
    mkdir -p "$AUGUR_PROXY_DIR"
    local out; out="$(provision_allowlist_path)"
    {
        echo "# generated by augur at $(date) — do not edit"
        echo "# --- baseline (Homebrew)"
        provision_baseline_domains
        if [[ -f "$AUGUR_PROVISION_HOOK_ALLOWLIST" ]]; then
            echo "# --- hook.allowlist.conf (approved)"
            provision_hook_allowlist_domains
        fi
    } > "$out"
    echo "$out"
}

# Leading `_` is deliberate, not decorative: workspace_slug() (used to key every per-project
# file in this same $AUGUR_PROXY_DIR — proxy_allowlist, gvproxy_socket, etc.) only ever
# produces `[a-z0-9-]+` (tr -cs '[:alnum:]' '-' maps every other byte, including `_`, to
# `-`), so a leading underscore is a byte a project slug can structurally never contain —
# this namespace can never collide with a project whose directory happens to sanitize to
# "macos-build-provision" itself.
provision_proxy_pidfile()   { echo "$AUGUR_PROXY_DIR/_macos-build-provision.pid"; }
provision_proxy_logfile()   { echo "$AUGUR_PROXY_DIR/_macos-build-provision.log"; }
provision_gvproxy_socket()  { echo "$AUGUR_PROXY_DIR/_macos-build-provision.vfkit.sock"; }
provision_gvproxy_pidfile() { echo "$AUGUR_PROXY_DIR/_macos-build-provision.gvproxy.pid"; }
provision_gvproxy_log()     { echo "$AUGUR_PROXY_DIR/_macos-build-provision.gvproxy.log"; }
provision_vm_log()          { echo "$AUGUR_PROXY_DIR/_macos-build-provision.vm.log"; }

provision_proxy_running() {
    local pf; pf="$(provision_proxy_pidfile)"
    [[ -f "$pf" ]] || return 1
    local pid; pid="$(cat "$pf" 2>/dev/null)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

provision_gvproxy_running() {
    local pf; pf="$(provision_gvproxy_pidfile)"
    [[ -f "$pf" ]] || return 1
    local pid; pid="$(cat "$pf" 2>/dev/null)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# Mirrors start_proxy, but a standalone identity (fixed name + fixed ports, not
# workspace_slug-keyed) for the one-time build-provisioning session.
start_provision_proxy() {
    local bin allowlist pidfile logfile
    bin="$(require_proxy_bin)"
    allowlist="$(write_provision_allowlist)"
    pidfile="$(provision_proxy_pidfile)"
    logfile="$(provision_proxy_logfile)"

    # Same fresh-or-replace rule as start_proxy. No guest attaches to this proxy across
    # invocations — run_base_provisioning stops it on the way out — so replacing it cuts nobody off.
    if provision_proxy_running; then
        local why
        if why="$(egress_helper_staleness "$bin" "$pidfile")"; then
            info "Build-provisioning egress proxy already running (pid $(cat "$pidfile"))."
            return 0
        fi
        replace_stale_helper "$pidfile" "build-provisioning egress proxy" "$why" "$(command -v "$bin" 2>/dev/null || echo "$bin")"
    fi
    mkdir -p "$AUGUR_PROXY_DIR"
    info "Starting build-provisioning egress proxy (allowlist: ${BOLD}${allowlist}${RESET})..."
    record_launched_binsha "$bin" "$pidfile"
    "$bin" --allowlist "$allowlist" \
           --listen "127.0.0.1" \
           --http-port "$AUGUR_PROXY_HTTP_PORT_PROVISION" \
           --socks-port "$AUGUR_PROXY_SOCKS_PORT_PROVISION" \
           --log "$logfile" \
           --pidfile "$pidfile" &>/dev/null &
    disown
    local tries=20
    while ((tries-- > 0)); do
        provision_proxy_running && return 0
        sleep 0.1
    done
    error "Build-provisioning egress proxy failed to start. See ${logfile}."
    exit 1
}

stop_provision_proxy() {
    local pidfile; pidfile="$(provision_proxy_pidfile)"
    if provision_proxy_running; then
        info "Stopping build-provisioning egress proxy..."
        kill "$(cat "$pidfile")" 2>/dev/null || true
    fi
    rm -f "$pidfile" "$(binsha_file "$pidfile")" 2>/dev/null || true
}

# Mirrors start_gvproxy, but the standalone build-provisioning identity.
start_provision_gvproxy() {
    local gvp sock pidfile
    gvp="$(resolve_gvproxy)"
    if [[ -z "$gvp" ]]; then
        error "Base-VM provisioning needs the augur gvproxy fork (augur-gvproxy), which was not found."
        error "Build/install it (see gvproxy/README), or remove ~/.augur/provision/* to skip provisioning."
        stop_provision_proxy
        exit 1
    fi
    sock="$(provision_gvproxy_socket)"; pidfile="$(provision_gvproxy_pidfile)"
    # Deliberately warn-only on a live gvproxy that is not fresh: the provisioning identity is fixed
    # (not per-project), so a live one may be another build/update's VM NIC, and killing it would
    # cut that VM off. run_base_provisioning stops it on the way out.
    if provision_gvproxy_running; then
        local why pid; pid="$(cat "$pidfile" 2>/dev/null)" || pid=""
        if ! why="$(egress_helper_staleness "$gvp" "$pidfile")"; then
            warn "The running build-provisioning gvproxy (pid ${pid}) is reused although it is not verified"
            warn "as the installed binary: $(egress_helper_staleness_text "$why" "$gvp")."
            warn "To use the installed one: stop the other build/update, or ${BOLD}kill ${pid}${RESET}, then retry."
        fi
        return 0
    fi
    # Same ordering rule as start_gvproxy, for the same reason: the unlink clears a socket left
    # behind by a crashed gvproxy (or the -S wait below succeeds instantly against a dead file),
    # so it must stay BELOW the early return — above it, reusing a running gvproxy unlinked the
    # socket run_base_provisioning is about to hand `vm run --net-vfkit`.
    rm -f "$sock"
    info "Starting build-provisioning gvproxy..."
    local gvp_debug=()
    [[ "${AUGUR_DEBUG:-}" == "1" ]] && gvp_debug=(--debug)
    record_launched_binsha "$gvp" "$pidfile"
    "$gvp" --listen-vfkit "unixgram://${sock}" \
           --socks-upstream "127.0.0.1:${AUGUR_PROXY_SOCKS_PORT_PROVISION}" \
           --dns-allowlist "$(provision_allowlist_path)" \
           --ssh-port "$AUGUR_SSH_FWD_PORT_PROVISION" \
           ${gvp_debug[@]+"${gvp_debug[@]}"} \
           --deny-direct &>"$(provision_gvproxy_log)" &
    echo $! > "$pidfile"
    disown
    local tries=30
    while ((tries-- > 0)); do [[ -S "$sock" ]] && return 0; sleep 0.1; done
    error "Build-provisioning gvproxy did not create its socket in time."
    exit 1
}

stop_provision_gvproxy() {
    local pidfile; pidfile="$(provision_gvproxy_pidfile)"
    provision_gvproxy_running && kill "$(cat "$pidfile")" 2>/dev/null || true
    rm -f "$pidfile" "$(binsha_file "$pidfile")" "$(provision_gvproxy_socket)" 2>/dev/null || true
}

# ssh_macos routes through gvproxy only for the per-project VM (macos_via_gvproxy checks
# macos_project_vm) — the build/base VM is never that name, so during the ONE-TIME
# provisioning step (which deliberately puts it behind start_provision_gvproxy instead of
# NAT) we need a dedicated wrapper targeting the fixed provisioning forward instead of the
# direct DHCP IP ssh_macos would otherwise resolve. Mirrors ssh_macos's options exactly,
# plus `-n` (redirect stdin from /dev/null): this is called once per entry inside
# run_provision_manifest's `while read ... < <(provision_manifest_entries)` loop, and
# without `-n` ssh forwards its inherited stdin (the SAME process-substitution pipe the
# loop's own `read` is consuming) to the remote command — draining every remaining manifest
# line on the very first call and silently truncating the loop to one iteration.
#
# Also primes Homebrew's PATH/env before the caller's command: `ssh host "cmd"` always runs
# a non-interactive, NON-LOGIN remote shell, and zsh only reads ~/.zshenv in that mode — not
# ~/.zprofile, which is where cmd_build_macos's Homebrew install step put `brew shellenv`
# (login-shell only, matching an interactive Terminal session). Without this, a bare `brew`
# call here fails with "command not found: brew" even though it's fully installed
# (confirmed on real hardware). `2>/dev/null` on the eval is defensive only — the base VM
# build already guarantees brew exists at this path by the time provisioning ever runs; if
# that assumption were ever wrong, the actual command right after would fail anyway with the
# same diagnostic.
ssh_macos_provision() { _ssh_macos_provision -n "$@"; }
# The same, minus `-n`: forwards stdin to the remote command. Only for a caller that pipes
# something in on purpose (macos_admin_password_stdin), never from inside the manifest loop.
ssh_macos_provision_stdin() { _ssh_macos_provision "" "$@"; }
_ssh_macos_provision() {
    local stdin_opt="$1" vm="$2"; shift 2
    local key_opts=()
    if [[ -f "$MACOS_SSH_KEY" ]]; then
        key_opts=(-i "$MACOS_SSH_KEY" -o PasswordAuthentication=no -o BatchMode=yes)
    fi
    ssh ${stdin_opt:+"$stdin_opt"} -F /dev/null \
        -p "$AUGUR_SSH_FWD_PORT_PROVISION" \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="$(vm_known_hosts_file "$vm")" \
        -o LogLevel=ERROR \
        -o ConnectTimeout=10 \
        -o ServerAliveInterval=15 \
        -o ServerAliveCountMax=4 \
        ${key_opts[@]+"${key_opts[@]}"} \
        "${MACOS_SSH_USER}@127.0.0.1" \
        "eval \"\$(/opt/homebrew/bin/brew shellenv)\" 2>/dev/null; $*"
}

scp_to_macos_provision() {
    local vm="$1" src="$2" dst="$3"
    local key_opts=()
    if [[ -f "$MACOS_SSH_KEY" ]]; then
        key_opts=(-i "$MACOS_SSH_KEY" -o PasswordAuthentication=no -o BatchMode=yes)
    fi
    scp -F /dev/null \
        -P "$AUGUR_SSH_FWD_PORT_PROVISION" \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="$(vm_known_hosts_file "$vm")" \
        -o LogLevel=ERROR \
        ${key_opts[@]+"${key_opts[@]}"} \
        "$src" "${MACOS_SSH_USER}@127.0.0.1:${dst}"
}

# Mirrors wait_for_macos_ssh, hardcoded to the fixed provisioning host/port (macos_ssh_host/
# macos_ssh_port don't know about the build VM's temporary gvproxy session — see
# ssh_macos_provision above).
wait_for_provision_ssh() {
    local vm="$1" max_secs="${2:-120}"
    local key_opts=()
    [[ -f "$MACOS_SSH_KEY" ]] && key_opts=(-i "$MACOS_SSH_KEY" -o PasswordAuthentication=no -o BatchMode=yes)
    local deadline=$(( SECONDS + max_secs ))
    while (( SECONDS < deadline )); do
        ssh -F /dev/null \
            -p "$AUGUR_SSH_FWD_PORT_PROVISION" \
            -o StrictHostKeyChecking=accept-new \
            -o UserKnownHostsFile="$(vm_known_hosts_file "$vm")" \
            -o LogLevel=ERROR \
            -o ConnectTimeout=5 \
            -o ServerAliveInterval=4 \
            -o ServerAliveCountMax=2 \
            ${key_opts[@]+"${key_opts[@]}"} \
            "${MACOS_SSH_USER}@127.0.0.1" true 2>/dev/null && return 0
        sleep 3
    done
    return 1
}

# Install each manifest.conf package. Tries a formula install first, falls back to a cask
# install on failure (Homebrew doesn't auto-detect between the two, and this lets the
# manifest stay agnostic about which one a name is). No sudo — Homebrew refuses installs
# as root/via sudo. Explicit `|| return 1` at each step: this may run in a tested context
# (run_base_provisioning's `|| provision_fail`), which suspends `set -e` for everything
# inside it, so a failure must be checked explicitly rather than relied on to propagate.
run_provision_manifest() {
    local vm="$1" name out rc
    while read -r name; do
        info "Provisioning: brew install ${name}"
        out="$(ssh_macos_provision "$vm" "brew install $(printf '%q' "$name")" 2>&1)"; rc=$?
        echo "$out"
        if [[ $rc -ne 0 ]]; then
            # Only fall back to a cask install when brew's own output says this name isn't
            # a formula. Retrying on ANY failure would mask a real formula-install failure
            # (network/egress denial, a broken bottle, disk space, ...) behind a silently
            # different — and silently "successful" — cask install of the same name.
            if grep -qi "No available formula\|Found a cask" <<<"$out"; then
                info "Not a formula — retrying as a cask: brew install --cask ${name}"
                ssh_macos_provision "$vm" "brew install --cask $(printf '%q' "$name")" || return 1
            else
                error "brew install ${name} failed (see output above) — not a missing-formula issue, not retrying as a cask."
                return 1
            fi
        fi
    done < <(provision_manifest_entries)
}

# Copy hook.sh into the VM (never piped/eval'd from a string) and run it as root — mirrors
# the existing "download-to-file-then-execute" rule cmd_build_macos uses for the Homebrew/
# Claude installers. Its allowlist domains were already merged into the filtered session by
# write_provision_allowlist. Explicit `|| return 1` — see run_provision_manifest's note.
run_provision_hook() {
    local vm="$1"
    [[ -f "$AUGUR_PROVISION_HOOK" ]] || return 0
    info "Provisioning: running ~/.augur/provision/hook.sh"
    scp_to_macos_provision "$vm" "$AUGUR_PROVISION_HOOK" "/tmp/augur-provision-hook.sh" || return 1
    ssh_macos_provision "$vm" "sudo bash /tmp/augur-provision-hook.sh; rc=\$?; rm -f /tmp/augur-provision-hook.sh; exit \$rc" || return 1
}

# Shared failure path for run_base_provisioning: revoke any sudo grant this session may
# have made, then tear down whatever this feature started (VM, gvproxy, proxy) before
# exiting, so a failure never leaks a stray background process, a running VM, or a live
# NOPASSWD sudo grant (with AUGUR_KEEP_BUILD_VM=1, the EXIT trap of build/update keeps the
# scratch VM it ran in). The revoke attempt is harmless/no-op if sudo was never granted yet or
# the VM is unreachable.
# PROVISION_CLEANUP_VM/_PID are plain globals (not locals) set right before they can first
# be needed — a trap referencing function-local variables is fragile (and cmd_build_macos
# already owns the EXIT trap for the whole build, which a nested trap here must not
# clobber), so this uses explicit `cmd || provision_fail "..."` at each risky step instead
# of a nested trap.
provision_fail() {
    error "$1"
    if [[ -n "${PROVISION_CLEANUP_VM:-}" ]]; then
        ssh_macos_provision "$PROVISION_CLEANUP_VM" "sudo rm -f /etc/sudoers.d/augur" 2>/dev/null || true
        stop_and_reap_macos_vm "$PROVISION_CLEANUP_VM" "${PROVISION_CLEANUP_PID:-}" 2>/dev/null
    fi
    stop_provision_gvproxy 2>/dev/null || true
    stop_provision_proxy 2>/dev/null || true
    exit 1
}

# Run optional custom provisioning (~/.augur/provision/{manifest.conf,hook.sh,
# hook.allowlist.conf}) inside the base-VM build/update, once, before it is cloned/saved.
# No-op if none of those files exist — cmd_build_macos/cmd_update_macos are unaffected.
# TOFU-gated (check_provision_approved) and executed over the dedicated, egress-filtered
# provision proxy/gvproxy pair — not the open NAT the rest of the build uses. $1 = VM name
# (MACOS_BUILD_VM or MACOS_UPDATE_VM, the scratch VM build or update works in), running on NAT
# under the caller's backgrounded `run`, whose pid is MACOS_SCRATCH_VM_PID. When provisioning runs,
# that NAT session is stopped for it and a new one started afterwards, so on return the VM is
# running on NAT either way and MACOS_SCRATCH_VM_PID names its current `run`.
run_base_provisioning() {
    local vm="$1" outer_pid="${MACOS_SCRATCH_VM_PID:-}"
    provision_files_present || return 0
    # Set the cleanup globals BEFORE the two checks below (not after) — an invalid
    # manifest or a declined/unapproved TOFU prompt must still stop the caller's own NAT
    # session via provision_fail.
    PROVISION_CLEANUP_VM="$vm"
    PROVISION_CLEANUP_PID="$outer_pid"
    provision_manifest_validate || provision_fail "Invalid manifest.conf entry (see above)."
    check_provision_approved    || provision_fail "Provisioning declined or unapproved."

    info "Switching '${vm}' to the egress-filtered datapath for provisioning..."
    stop_and_reap_macos_vm "$vm" "$outer_pid"
    start_provision_proxy
    start_provision_gvproxy

    local sock; sock="$(provision_gvproxy_socket)"
    "$VM_CLI" run --no-graphics "--net-vfkit=${sock}" "$vm" &>"$(provision_vm_log)" &
    PROVISION_CLEANUP_PID=$!

    if ! wait_for_provision_ssh "$vm" 120; then
        error "VM did not become reachable over the filtered provisioning network."
        error "  gvproxy log: $(provision_gvproxy_log)"
        error "  VM log:      $(provision_vm_log)"
        provision_fail "Aborting: provisioning network did not come up."
    fi

    # Grant temporary passwordless sudo for this session (idempotent: cmd_build_macos's
    # mid-build VM already has this grant from its own Step 4; a standalone base-VM
    # 'augur update --macos' does not, since the original build already revoked it — this
    # establishes it fresh in that case). Same admin credential the rest of the build already
    # depends on — see macos_admin_password().
    macos_admin_password_stdin "$vm" | ssh_macos_provision_stdin "$vm" \
        "sudo -S -p '' bash -c \
            'echo \"${MACOS_SSH_USER} ALL=(ALL) NOPASSWD:ALL\" > /etc/sudoers.d/augur \
             && chmod 440 /etc/sudoers.d/augur'" \
        || provision_fail "Failed to grant temporary sudo for provisioning."

    run_provision_manifest "$vm" || provision_fail "Base-VM manifest provisioning failed."
    run_provision_hook "$vm"     || provision_fail "Base-VM provisioning hook failed."

    info "Revoking provisioning sudo grant..."
    ssh_macos_provision "$vm" "sudo rm -f /etc/sudoers.d/augur" || provision_fail "Failed to revoke the provisioning sudo grant."

    stop_and_reap_macos_vm "$vm" "$PROVISION_CLEANUP_PID"
    stop_provision_gvproxy
    stop_provision_proxy
    success "Base-VM provisioning complete."

    # Back on NAT, as on entry: the caller's remaining steps run over plain ssh_macos.
    # Accepted trade-off: the provisioned guest has open NAT for those few steps. It has the same on
    # every later update's first boot anyway, which runs the base VM on NAT before provisioning.
    info "Restarting '${vm}' on NAT for the remaining steps..."
    PROVISION_CLEANUP_PID=""
    if ! macos_boot_scratch_vm_nat "$vm" "$(macos_base_vm_log)"; then
        PROVISION_CLEANUP_PID="$MACOS_SCRATCH_VM_PID"
        provision_fail "VM '${vm}' did not come back up over SSH after provisioning (VM log: $(macos_base_vm_log))."
    fi
    unset PROVISION_CLEANUP_VM PROVISION_CLEANUP_PID
}

# ── Apple Container image custom provisioning ──────────────────────────────────
# Much simpler than the macOS side: the image build (cmd_build/cmd_update) already runs
# with zero egress filtering (pre-existing, unchanged) and is a one-shot `eng build`, not a
# live VM — so this just validates + TOFU-gates container-packages.conf and emits extra
# `eng build` argv, no dedicated proxy/SSH machinery needed.
# Checked for actual (non-comment, non-blank) content, not just presence — same rationale
# as provision_manifest_has_entries: a freshly scaffolded-but-still-untouched template must
# not add a --build-arg / TOFU prompt for zero actual packages.
provision_container_packages_present() {
    [[ -f "$AUGUR_PROVISION_CONTAINER_PACKAGES" ]] || return 1
    [[ -n "$(provision_clean_lines "$AUGUR_PROVISION_CONTAINER_PACKAGES")" ]]
}

provision_container_packages_validate() {
    local lineno clean
    while IFS=$'\t' read -r lineno clean; do
        if ! provision_package_name_valid "$clean"; then
            error "~/.augur/provision/container-packages.conf:${lineno}: invalid entry '${clean}' (expected a bare apt package name)"
            return 1
        fi
    done < <(provision_clean_lines "$AUGUR_PROVISION_CONTAINER_PACKAGES")
    return 0
}

provision_container_packages_list() {
    local lineno clean
    while IFS=$'\t' read -r lineno clean; do
        echo "$clean"
    done < <(provision_clean_lines "$AUGUR_PROVISION_CONTAINER_PACKAGES")
}

provision_container_hash_file() { echo "$AUGUR_DIR/provision-hashes/container.sha256"; }

provision_container_display_changes() {
    printf '    %b+ container-packages.conf: %s%b\n' "$YELLOW" "$AUGUR_PROVISION_CONTAINER_PACKAGES" "$RESET"
    grep -vE '^[[:space:]]*(#|$)' "$AUGUR_PROVISION_CONTAINER_PACKAGES" 2>/dev/null | while IFS= read -r _l; do printf '        %s\n' "$_l"; done
}

check_container_provision_approved() {
    provision_container_packages_present || return 0
    local cur; cur="$(files_content_hash "$AUGUR_PROVISION_CONTAINER_PACKAGES")"
    tofu_decide "$(provision_container_hash_file)" "$cur" "Apple Container image provisioning (~/.augur/provision/container-packages.conf)" provision_container_display_changes
}

# Validate + TOFU-gate container-packages.conf. MUST be called directly (never inside a
# `$(...)`/`<(...)` subshell) — this exits on failure/decline, and an `exit` inside a
# subshell only kills that subshell, silently leaving the parent build to proceed
# unprovisioned instead of aborting (the exact pitfall project_conf_hash's own comment
# warns about). check_container_provision_approved's own tofu_decide call only ever
# returns on failure (never exits) — check it explicitly here rather than relying on it
# to propagate implicitly, so this stays fail-closed even if a future caller wraps this
# function in a tested context.
container_provision_prepare() {
    provision_container_packages_present || return 0
    provision_container_packages_validate || exit 1
    check_container_provision_approved    || exit 1
}

# Extra `eng build` argv elements needed to bake container-packages.conf's apt packages
# into the image, one PER LINE (so callers can safely read them into an array with
# `while IFS= read -r arg; do build_args+=("$arg"); done < <(container_provision_build_args)`
# without word-splitting risk). Prints nothing (no-op) if the file doesn't exist. Safe to
# call inside a subshell/process substitution — unlike container_provision_prepare (which
# callers must run first, directly), this never exits, only echoes.
container_provision_build_args() {
    provision_container_packages_present || return 0
    local pkgs; pkgs="$(provision_container_packages_list | tr '\n' ' ')"
    pkgs="${pkgs% }"
    [[ -n "$pkgs" ]] || return 0
    echo "--build-arg"
    echo "EXTRA_APT_PACKAGES=${pkgs}"
}

# `version` reports the installed augur commit and nothing else. Side-effect-free —
# unlike before, it does NOT boot the base VM to read its toolchain. The base VM name
# and the running project VM's toolchain live in `augur status --macos`.
cmd_version_macos() {
    echo ""
    echo -e "  ${BOLD}augur${RESET}  ${CYAN}$(augur_version)${RESET}  (macOS VM mode)"
    echo ""
}

# ── Config scaffolding ────────────────────────────────────────────────────────

# Write starter ./.augur/allowlist.conf and ./.augur/resources.conf in the project root.
# Never overwrites an existing file (both are hand-maintained); we only report one was found.
cmd_init_conf() {
    local out="$AUGUR_PROJECT_CONF"
    if [[ -f "$out" ]]; then
        warn "A project config already exists: ${BOLD}${out}${RESET}"
        warn "Leaving it untouched. Edit it directly to change this project's egress allowlist."
    else
        mkdir -p "$(dirname "$out")"
        cat > "$out" <<'EOF'
# augur project egress allowlist
#
# Domains listed here (merged with the global ~/.augur/augur.conf) are reachable
# from this project's container/VM. Everything else is blocked by the host-side
# augur-proxy. Creating this file also turns egress filtering on for the project.
#
# Syntax (one pattern per line, '#' starts a comment):
#   example.com     exact host only (the apex). Does NOT match subdomains.
#   *.example.com   subdomains only (api.example.com yes; example.com no).
#   .example.com    the apex AND every subdomain.

# Add this project's endpoints below:
EOF
        success "Created ${BOLD}${out}${RESET}"
        info "Edit it to list this project's endpoints, then run ${BOLD}augur up${RESET}."
    fi

    local res="$AUGUR_PROJECT_RESOURCES_CONF"
    if [[ -f "$res" ]]; then
        warn "A project resources file already exists: ${BOLD}${res}${RESET}"
        warn "Leaving it untouched. Edit it directly to change this project's resource settings."
    else
        mkdir -p "$(dirname "$res")"
        cat > "$res" <<'EOF'
# augur project resource settings
#
# KEY=VALUE lines, '#' starts a comment. Unlike allowlist.conf, this file has no
# approval prompt — a guest requesting more/less resources for itself isn't a
# containment concern the way widening egress is.

# MEMORY sets the Apple Container memory limit (e.g. 4g, 8g). Default: 4g.
# An AUGUR_CONTAINER_MEMORY environment variable, if set, overrides this.
# MEMORY=4g

# MACOS_CPU / MACOS_MEMORY_MB set the macOS VM mode vCPU count / memory (in MB).
# Applied on every `augur up --macos`, so a change here takes effect on the VM's
# next boot without needing to destroy/re-clone it. Defaults: 4 / 8192.
# An AUGUR_MACOS_VM_CPU / AUGUR_MACOS_VM_MEMORY_MB environment variable, if set,
# overrides these.
# MACOS_CPU=4
# MACOS_MEMORY_MB=8192
EOF
        success "Created ${BOLD}${res}${RESET}"
    fi

    # Base-image provisioning templates are HOST-GLOBAL (~/.augur/provision/, not
    # project-scoped like the two files above) — there is exactly one macOS base VM and one
    # container image per Swift tag per host, shared by every project. Scaffolded here too
    # (same never-overwrite/report-if-exists idiom) since 'augur init-conf' is the natural
    # single place an operator looks for "how do I configure augur," even though these
    # particular files aren't specific to the project they ran it from. Comments-only by
    # default: provision_manifest_has_entries/provision_container_packages_present require
    # actual (non-comment, non-blank) content, so an untouched template never triggers
    # provisioning on its own.
    local manifest="$AUGUR_PROVISION_MANIFEST"
    if [[ -f "$manifest" ]]; then
        warn "A base-VM provisioning manifest already exists: ${BOLD}${manifest}${RESET}"
        warn "Leaving it untouched (host-global — shared by every project on this machine)."
    else
        mkdir -p "$(dirname "$manifest")"
        cat > "$manifest" <<'EOF'
# augur base-VM provisioning manifest (macOS mode)
#
# One Homebrew package name per line (formula or cask — augur tries 'brew install NAME'
# first, then 'brew install --cask NAME' only if brew itself says NAME isn't a formula).
# '#' starts a comment, blank lines are ignored.
#
# Host-global: shared by every project on this machine, not specific to the project you
# ran 'augur init-conf' from. Runs once, as root, during 'augur build --macos' / 'augur
# update --macos', over an egress-filtered proxy session — approved via a one-time prompt
# whenever this file's content changes (AUGUR_ACCEPT_PROVISION_HOOK=1 to accept
# non-interactively).

# Add packages below, e.g.:
# jq
# wget

# For anything beyond a simple package list (installers, license acceptance, env setup),
# see hook.sh (+ hook.allowlist.conf for any extra domains it needs) in this same directory.
EOF
        success "Created ${BOLD}${manifest}${RESET} (host-global — see it for syntax)"
    fi

    local cpkgs="$AUGUR_PROVISION_CONTAINER_PACKAGES"
    if [[ -f "$cpkgs" ]]; then
        warn "A container image provisioning file already exists: ${BOLD}${cpkgs}${RESET}"
        warn "Leaving it untouched (host-global — shared by every project on this machine)."
    else
        mkdir -p "$(dirname "$cpkgs")"
        cat > "$cpkgs" <<'EOF'
# augur container image provisioning (Apple Container)
#
# One apt package name per line. '#' starts a comment, blank lines are ignored.
#
# Host-global: shared by every project on this machine, not specific to the project you
# ran 'augur init-conf' from. Baked into the shared image via a --build-arg during
# 'augur build' / 'augur update' — approved via a one-time prompt whenever this file's
# content changes (AUGUR_ACCEPT_PROVISION_HOOK=1 to accept non-interactively).

# Add packages below, e.g.:
# ripgrep
# tmux
EOF
        success "Created ${BOLD}${cpkgs}${RESET} (host-global — see it for syntax)"
    fi
}

