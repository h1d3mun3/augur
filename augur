# ── Entry point ───────────────────────────────────────────────────────────────

# Test seam (mirrors the existing AUGUR_TEST_* seams used by tests/): allow a harness to
# `source` this script purely to REUSE its functions — e.g. ssh_macos for the local macOS-VM
# e2e gate (tests/e2e_macos_vm.sh) — without running a command. Never set in normal use, so
# production dispatch is unaffected. `return` succeeds only when sourced; when executed it
# errors, and `|| true` falls through to normal dispatch.
if [[ "${AUGUR_SOURCE_ONLY:-0}" == "1" ]]; then return 0 2>/dev/null || true; fi

# Refuse whatever the global flag loop below left unparsed for command $1 ($2… are those words).
# That loop reads --macos/--gui/--egress/--no-egress/--swift only directly after the command and
# stops at the first other word, so a flag placed later would otherwise be dropped without a word:
# `augur down extra --macos` would stop the container, `augur build --ipsw X --xcode-xip Y --macos`
# would build the container image. Every refusal exits 1 before anything runs.
# - `-h`/`--help` anywhere in the leftovers: print the usage and exit 0, ahead of every check below.
# - A global flag anywhere in the leftovers: say where it goes.
# - `build` without --macos: the macOS base-VM build options mean --macos was left out.
# - Any other leftover word, for a command that takes none.
# Deliberately NOT checked: `build --macos` (cmd_build_macos parses its own options and refuses an
# unknown one), the positional argument of `destroy` (cmd_destroy* refuse extras themselves; only a
# misplaced global flag is refused here; `install-cert` takes zero or one, and its own missing-argument
# check handles zero), `help` (extra words are harmless),
# and an unknown command (the dispatch reports it).
reject_extra_args() {
    local cmd="$1" a; shift
    case "$cmd" in
        help|--help|-h) return 0 ;;
        build|up|claude|shell|setup-token|install-cert|down|destroy|status|init-conf|list|__names|update|version) ;;
        *) return 0 ;;
    esac
    for a in "$@"; do
        case "$a" in -h|--help) cmd_help; exit 0 ;; esac
    done
    [[ "$cmd" == build ]] && $MACOS_MODE && return 0
    for a in "$@"; do
        case "$a" in
            --macos|--gui|--egress|--no-egress|--swift)
                error "Put ${a} right after the command: augur ${cmd} ${a}$([[ "$a" == --swift ]] && echo " <version>") …"
                exit 1 ;;
        esac
    done
    case "$cmd" in
        install-cert)
            (( $# <= 1 )) && return 0
            error "Usage: augur install-cert [--macos] <cert.crt>  (got extra: $*)"
            exit 1 ;;
        destroy) return 0 ;;
    esac
    if [[ "$cmd" == build ]]; then
        for a in "$@"; do
            case "$a" in
                --ipsw|--xcode-xip|--platforms|--manual-setup)
                    error "${a} is an option of the macOS base-VM build: augur build --macos --ipsw <path> --xcode-xip <path> …"
                    exit 1 ;;
            esac
        done
    fi
    (( $# == 0 )) && return 0
    error "augur ${cmd} takes no arguments (got: $*)"
    exit 1
}

COMMAND="${1:-help}"
shift || true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --macos) MACOS_MODE=true; shift ;;
        --gui)   MACOS_GUI=true; shift ;;
        --egress)    AUGUR_EGRESS=1; shift ;;
        --no-egress) AUGUR_EGRESS=0; shift ;;
        --swift)
            # A flag (or nothing) in the value slot means the version was left out; taking it would
            # swallow the flag and build a bogus image tag.
            if [[ -z "${2:-}" || "$2" == -* ]]; then
                error "--swift needs a version: augur ${COMMAND} --swift <version> (e.g. --swift 6.0)"
                exit 1
            fi
            SWIFT_VERSION="$2"
            shift 2
            ;;
        *) break ;;
    esac
done

SWIFT_IMAGE_TAG="${SWIFT_VERSION:-latest}"
IMAGE_NAME="augur:swift-${SWIFT_IMAGE_TAG}"
CONTAINER_NAME="$(make_container_name)"
WORKSPACE_MOUNT="$(make_workspace_mount)"
# Per-project virtiofs share name for macOS VM mode. The automount exposes it at
# "/Volumes/My Shared Files/<name>", which is the path Claude actually records as cwd (it resolves
# the ~/workspace-<slug> symlink), so a per-project name keeps each project's history under a distinct slug.
MACOS_SHARE="workspace-$(workspace_slug)"

# ONE containment gate for BOTH modes, deliberately here in the shared dispatch tail rather
# than inside cmd_up/cmd_up_macos. Two reasons:
#   • Structural: a single site makes it impossible to fix one mode and forget the other.
#   • Correctness: cmd_claude/cmd_shell only call cmd_up when the guest is NOT already
#     running (ensure_session_container, prepare_macos_session), so a
#     check inside `up` would be skipped entirely when attaching to a guest a pre-fix augur
#     had already created from $HOME — exactly the case that needs refusing.
# It also runs BEFORE require_vz (called from inside the macOS cmd_* functions), so the
# refusal names the workspace rather than the host OS.
# Deliberately NOT gated: down/destroy/list/status must keep working here so a
# container/VM a pre-fix augur made in $HOME can still be cleaned up; init-conf/build/update/
# install-cert/version/help never hand this directory to a guest (`build` uses $SCRIPT_DIR as
# its context), and neither does `setup-token --macos` (its throwaway VM gets no workspace share).
# The argument check comes first, so a misplaced flag is named even in a directory the gate refuses.
reject_extra_args "$COMMAND" "$@"
case "$COMMAND" in
    up|claude|shell) require_safe_workspace ;;
    setup-token)     $MACOS_MODE || require_safe_workspace ;;
esac

if $MACOS_MODE; then
    case "$COMMAND" in
        build)          cmd_build_macos "$@" ;;
        up)             cmd_up_macos ;;
        claude)         cmd_claude_macos ;;
        shell)          cmd_shell_macos ;;
        setup-token)    cmd_setup_token_macos ;;
        install-cert)   cmd_install_cert_macos "$@" ;;
        down)           cmd_down_macos ;;
        destroy)        cmd_destroy_macos "$@" ;;
        status)         cmd_status_macos ;;
        init-conf)      cmd_init_conf ;;
        list)           cmd_list_macos ;;
        __names)        cmd_names_macos ;;
        update)         cmd_update_macos ;;
        version)        cmd_version_macos ;;
        help|--help|-h) cmd_help ;;
        *) error "Unknown command: '$COMMAND'"; cmd_help; exit 1 ;;
    esac
else
    case "$COMMAND" in
        up)             cmd_up ;;
        claude)         cmd_claude ;;
        shell)          cmd_shell ;;
        setup-token)    cmd_setup_token ;;
        install-cert)   cmd_install_cert "$@" ;;
        down)           cmd_down ;;
        destroy)        cmd_destroy "$@" ;;
        status)         cmd_status ;;
        init-conf)      cmd_init_conf ;;
        list)           cmd_list ;;
        __names)        cmd_names ;;
        update)         cmd_update ;;
        version)        cmd_version ;;
        build)          cmd_build ;;
        help|--help|-h) cmd_help ;;
        *)
            error "Unknown command: '$COMMAND'"
            cmd_help
            exit 1
            ;;
    esac
fi
