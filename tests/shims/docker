#!/usr/bin/env bash
# Test shim for `docker`. Stands in for the real CLI so augur's command CONSTRUCTION
# (cmd_up / cmd_claude) can be captured WITHOUT a Docker daemon. It:
#   • records every invocation to $AUGUR_TEST_SHIMLOG.trace (human-readable), and
#   • dumps the exact argv of `run`/`exec` (one arg per line, spaces preserved) to
#     $AUGUR_TEST_SHIMLOG.run / .exec for the test to assert on, and
#   • fakes just enough preflight (info / image inspect / ps) for augur to reach the
#     real `docker run`/`docker exec` it builds from the agent seam.
# Container "running" state is controlled by $AUGUR_TEST_CONTAINER_RUNNING (0|1).
set -u
log="${AUGUR_TEST_SHIMLOG:-/tmp/augur-shim}"
printf 'docker %s\n' "$*" >> "$log.trace"

case "${1:-}" in
  run|exec)
    : > "$log.$1"
    for a in "$@"; do printf '%s\n' "$a" >> "$log.$1"; done
    exit 0 ;;
  info)
    exit 0 ;;
  image)
    # `image inspect IMAGE` -> exit 0 (image "exists", skip build)
    # `image inspect --format '{{.Created}}' IMAGE` -> emit a recent date
    if [[ "${2:-}" == inspect && ( "${3:-}" == --format || "${3:-}" == -f ) ]]; then
      printf '2026-06-28T00:00:00Z\n'
    fi
    exit 0 ;;
  inspect)
    printf 'sha-fake\n'; exit 0 ;;
  ps)
    # container_running:  ps --format '{{.Names}}'
    # container_exists:   ps -a --format '{{.Names}}'
    if [[ "${AUGUR_TEST_CONTAINER_RUNNING:-0}" == 1 ]]; then
      printf '%s\n' "${AUGUR_TEST_CONTAINER_NAME:-}"
    fi
    exit 0 ;;
  *)
    # start / rm / network / etc. — construction already captured; just succeed.
    exit 0 ;;
esac
