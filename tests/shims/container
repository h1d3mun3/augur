#!/usr/bin/env bash
# Test shim for Apple `container` (github.com/apple/container). Stands in for the real CLI
# so augur's command CONSTRUCTION (cmd_up / cmd_claude) can be captured with NO real
# runtime. It:
#   • records every invocation to $AUGUR_TEST_SHIMLOG.trace (human-readable), and
#   • dumps the exact argv of `run`/`exec` (one arg per line) to $AUGUR_TEST_SHIMLOG.run /
#     .exec for the test to assert on, and
#   • fakes just enough preflight (system status / image inspect / inspect) for augur to
#     reach the real `container run`/`container exec` it builds from the agent seam.
# Container "running" state is controlled by $AUGUR_TEST_CONTAINER_RUNNING (0|1); the
# running container's name is $AUGUR_TEST_CONTAINER_NAME.
set -u
log="${AUGUR_TEST_SHIMLOG:-/tmp/augur-shim}"
printf 'container %s\n' "$*" >> "$log.trace"

case "${1:-}" in
  run|exec)
    : > "$log.$1"
    for a in "$@"; do printf '%s\n' "$a" >> "$log.$1"; done
    # Injected failure for the exec path only (AUGUR_TEST_EXEC_FAIL=1): lets a test drive
    # seed_workspace_trust's best-effort branch — a failing seed must warn yet keep `up` exit 0.
    if [[ "$1" == exec && "${AUGUR_TEST_EXEC_FAIL:-0}" == 1 ]]; then exit 1; fi
    exit 0 ;;
  system)
    # `system status` → service up (exit 0); `system start` → succeed.
    exit 0 ;;
  image)
    # `image inspect IMAGE` → image "exists" (exit 0, skip build).
    exit 0 ;;
  inspect)
    # container_running greps this for the nested .status.state == "running"; container_exists
    # treats a non-zero exit as "absent". Mirrors Apple's real inspect shape (status is an
    # OBJECT carrying "state"). AUGUR_TEST_CONTAINER_STOPPED=1 models "exists but stopped"
    # (container_exists true, container_running false) — the persisted-container reuse path.
    if [[ "${AUGUR_TEST_CONTAINER_RUNNING:-0}" == 1 ]]; then
      printf '[{"id":"%s","status":{"state":"running"}}]\n' "${AUGUR_TEST_CONTAINER_NAME:-}"
      exit 0
    fi
    if [[ "${AUGUR_TEST_CONTAINER_STOPPED:-0}" == 1 ]]; then
      printf '[{"id":"%s","status":{"state":"stopped"}}]\n' "${AUGUR_TEST_CONTAINER_NAME:-}"
      exit 0
    fi
    exit 1 ;;
  network)
    # `network inspect NAME` → absent (exit 1 so ensure_egress_network would create it);
    # create/delete → succeed.
    case "${2:-}" in
      inspect) exit 1 ;;
      *)       exit 0 ;;
    esac ;;
  list)
    # Fake `container list [--all]` table for cmd_list, mirroring REAL Apple macOS 26 output:
    # `ID IMAGE OS ARCH STATE IP CPUS MEMORY STARTED` — note IP is NOT the trailing column, MEMORY
    # carries an internal space ("4096 MB"), and a STOPPED container has a BLANK IP with the
    # CPUS/MEMORY columns still populated after it. cmd_list locates columns BY LABEL and only
    # trusts IP for a running row, so this table exercises the exact field-shift a stopped row
    # would otherwise cause (blank IP → CPUS shifts into IP's slot). Two augur- rows (one running
    # with an IP, one stopped with a blank IP) plus a NON-augur row that must be filtered out.
    # AUGUR_TEST_LIST_EMPTY=1 drops the augur- rows so only the non-augur row remains — the augur-
    # filter then yields nothing, driving cmd_list's empty-state branch even though the host still
    # has (unrelated) containers.
    printf '%s\n' 'ID                                     IMAGE               OS     ARCH   STATE    IP                CPUS  MEMORY   STARTED'
    if [[ "${AUGUR_TEST_LIST_EMPTY:-0}" != 1 ]]; then
      printf '%s\n' 'augur-alpha-0011aabbccdd-swift-latest  augur:swift-latest  linux  arm64  running  172.31.38.210/28  4     4096 MB  2026-07-24T11:11:59Z'
      printf '%s\n' 'augur-beta-eeff22334455-swift-6-0      augur:swift-6-0     linux  arm64  stopped                    4     4096 MB'
    fi
    printf '%s\n' 'nginx-sidecar                          nginx:latest        linux  arm64  running  172.31.38.99/28   2     2048 MB  2026-07-24T09:00:00Z'
    exit 0 ;;
  *)
    # build / start / delete / etc. — construction already captured; just succeed. (`list` has
    # its own case above.)
    exit 0 ;;
esac
