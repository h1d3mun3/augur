diff --git a/pkg/services/dns/dns_allowlist.go b/pkg/services/dns/dns_allowlist.go
new file mode 100644
index 00000000..3b38ec12
--- /dev/null
+++ b/pkg/services/dns/dns_allowlist.go
@@ -0,0 +1,172 @@
+package dns
+
+// augur: gate DNS resolution on the same domain allowlist used for connections,
+// so a name is resolvable iff it is connection-allowed. This closes the DNS-exfil
+// residual (a guest encoding data in QNAMEs to an attacker nameserver).
+//
+// This matcher is a 1:1 port of augur-proxy's Swift Allowlist + Hostname
+// (augur-proxy/Sources/AugurProxyCore/{Allowlist,Hostname}.swift). It is the
+// security chokepoint and MUST stay byte-identical to the Swift semantics — see
+// dns_allowlist_test.go, which mirrors the Swift test suite.
+
+import (
+	"strconv"
+	"strings"
+)
+
+type dnsAllowlist struct {
+	exact    map[string]struct{}
+	suffixes []string // base domains whose *subdomains* are allowed
+}
+
+// PatternsFromConf mirrors Swift Allowlist.patterns(fromConf:): for each line,
+// cut at the first '#', trim ASCII whitespace, drop blanks. Exported so the CLI
+// can parse the same .augur/allowlist.conf grammar in one place.
+func PatternsFromConf(text string) []string {
+	out := []string{}
+	for _, rawLine := range strings.FieldsFunc(text, func(r rune) bool { return r == '\n' || r == '\r' }) {
+		line := rawLine
+		if i := strings.IndexByte(line, '#'); i >= 0 {
+			line = line[:i]
+		}
+		line = strings.TrimSpace(line)
+		if line != "" {
+			out = append(out, line)
+		}
+	}
+	return out
+}
+
+// newDNSAllowlist mirrors Swift Allowlist.init(patterns:).
+func newDNSAllowlist(patterns []string) *dnsAllowlist {
+	a := &dnsAllowlist{exact: map[string]struct{}{}}
+	for _, raw := range patterns {
+		p := normalizeHost(raw)
+		if p == "" {
+			continue
+		}
+		if rest, ok := strings.CutPrefix(p, "*."); ok { // subdomains only
+			if rest != "" {
+				a.suffixes = append(a.suffixes, rest)
+			}
+		} else if rest, ok := strings.CutPrefix(p, "."); ok { // apex + subdomains
+			if rest != "" {
+				a.exact[rest] = struct{}{}
+				a.suffixes = append(a.suffixes, rest)
+			}
+		} else {
+			a.exact[p] = struct{}{}
+		}
+	}
+	return a
+}
+
+// allows mirrors Swift Allowlist.allows(): normalize, reject empty / IP-literal /
+// invalid hostname, then exact-set or strict-label-boundary subdomain match.
+func (a *dnsAllowlist) allows(name string) bool {
+	h := normalizeHost(name)
+	if h == "" {
+		return false
+	}
+	if isIPLiteral(h) {
+		return false
+	}
+	if !isValidHostname(h) {
+		return false
+	}
+	if _, ok := a.exact[h]; ok {
+		return true
+	}
+	for _, base := range a.suffixes {
+		if isSubdomainOf(h, base) {
+			return true
+		}
+	}
+	return false
+}
+
+// normalizeHost: lowercase, trim whitespace, drop EXACTLY ONE trailing dot
+// (mirrors Swift normalize — do not loop-strip).
+func normalizeHost(s string) string {
+	t := strings.ToLower(strings.TrimSpace(s))
+	if strings.HasSuffix(t, ".") {
+		t = t[:len(t)-1]
+	}
+	return t
+}
+
+// isSubdomainOf: host is a strict subdomain of base on a label boundary
+// (api.github.com of github.com yes; evilgithub.com no; github.com of itself no).
+// Byte length is safe because only ASCII LDH names reach here.
+func isSubdomainOf(host, base string) bool {
+	if len(host) <= len(base)+1 {
+		return false
+	}
+	if !strings.HasSuffix(host, base) {
+		return false
+	}
+	return host[len(host)-len(base)-1] == '.'
+}
+
+// isValidHostname ports Hostname.swift isValidHostname: strict LDH, <=253 bytes,
+// labels 1..63, no empty labels, tolerate one trailing dot. Rejects NUL, spaces,
+// '_', backslash (so miekg/dns escaped presentation forms like `\000` fail).
+func isValidHostname(s string) bool {
+	host := s
+	if strings.HasSuffix(host, ".") {
+		host = host[:len(host)-1]
+	}
+	if len(host) == 0 || len(host) > 253 {
+		return false
+	}
+	labelLen := 0
+	for i := 0; i < len(host); i++ {
+		b := host[i]
+		if b == '.' {
+			if labelLen == 0 {
+				return false
+			}
+			labelLen = 0
+			continue
+		}
+		ldh := (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') || (b >= '0' && b <= '9') || b == '-'
+		if !ldh {
+			return false
+		}
+		labelLen++
+		if labelLen > 63 {
+			return false
+		}
+	}
+	return labelLen > 0
+}
+
+// isIPLiteral ports Allowlist.isIPLiteral: any colon => IPv6; four numeric <=255
+// dot-octets => IPv4.
+func isIPLiteral(s string) bool {
+	host := s
+	if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
+		host = host[1 : len(host)-1]
+	}
+	if strings.Contains(host, ":") {
+		return true
+	}
+	parts := strings.Split(host, ".")
+	if len(parts) != 4 {
+		return false
+	}
+	for _, p := range parts {
+		if p == "" {
+			return false
+		}
+		for i := 0; i < len(p); i++ {
+			if p[i] < '0' || p[i] > '9' {
+				return false
+			}
+		}
+		if n, err := strconv.Atoi(p); err != nil || n > 255 {
+			return false
+		}
+	}
+	return true
+}
diff --git a/pkg/services/dns/dns_allowlist_test.go b/pkg/services/dns/dns_allowlist_test.go
new file mode 100644
index 00000000..0e9194fd
--- /dev/null
+++ b/pkg/services/dns/dns_allowlist_test.go
@@ -0,0 +1,82 @@
+package dns
+
+import "testing"
+
+// Parity with augur-proxy's Swift AllowlistTests / SecurityTests. This matcher is
+// the DNS-side security chokepoint; it must match the connection-side allowlist.
+func TestDNSAllowlistMatches(t *testing.T) {
+	cases := []struct {
+		patterns []string
+		host     string
+		want     bool
+	}{
+		// bare host = exact apex only
+		{[]string{"github.com"}, "github.com", true},
+		{[]string{"github.com"}, "api.github.com", false},
+		{[]string{"github.com"}, "evilgithub.com", false},
+		// *.host = subdomains only, label-boundary anchored
+		{[]string{"*.github.com"}, "api.github.com", true},
+		{[]string{"*.github.com"}, "a.b.github.com", true},
+		{[]string{"*.github.com"}, "github.com", false},
+		{[]string{"*.github.com"}, "evilgithub.com", false},
+		{[]string{"*.github.com"}, "notgithub.com", false},
+		{[]string{"*.github.com"}, "github.com.evil.com", false},
+		// .host = apex + subdomains
+		{[]string{".github.com"}, "github.com", true},
+		{[]string{".github.com"}, "api.github.com", true},
+		{[]string{".github.com"}, "evilgithub.com", false},
+		// case + trailing dot (FQDN form as DNS presents q.Name)
+		{[]string{"github.com"}, "GitHub.COM.", true},
+		{[]string{"*.github.com"}, "API.GitHub.COM.", true},
+		{[]string{"github.com"}, "github.com..", false}, // doubled trailing dot
+		// NUL / illegal-byte injection must be rejected (parity with MF1 fix)
+		{[]string{"*.github.com"}, "evil.com\x00.github.com", false},
+		{[]string{"*.github.com"}, "github.com\x00.evil.com", false},
+		// miekg/dns escaped presentation form of a NUL ("\000") — backslash is non-LDH
+		{[]string{"*.github.com"}, "evil.com\\000.github.com", false},
+		// IP literals never match
+		{[]string{"*.com"}, "1.2.3.4", false},
+		{[]string{"*.com"}, "10.0.0.1", false},
+		{[]string{"*.com"}, "::1", false},
+		// non-LDH / malformed
+		{[]string{"*.com"}, "under_score.com", false},
+		{[]string{"*.com"}, "has space.com", false},
+		{[]string{"*.com"}, "a..b.com", false},
+		// empty allowlist (armed) => deny everything (fail closed)
+		{[]string{}, "github.com", false},
+	}
+	for _, c := range cases {
+		got := newDNSAllowlist(c.patterns).allows(c.host)
+		if got != c.want {
+			t.Errorf("allows(patterns=%v, host=%q) = %v, want %v", c.patterns, c.host, got, c.want)
+		}
+	}
+}
+
+func TestDNSAllowlistOversizedLabel(t *testing.T) {
+	long := ""
+	for i := 0; i < 64; i++ {
+		long += "a"
+	}
+	if newDNSAllowlist([]string{"*.com"}).allows(long + ".com") {
+		t.Error("label > 63 chars should be rejected")
+	}
+}
+
+func TestPatternsFromConf(t *testing.T) {
+	conf := "# comment\napi.anthropic.com   # trailing\n\n   github.com\n"
+	got := PatternsFromConf(conf)
+	want := []string{"api.anthropic.com", "github.com"}
+	if len(got) != len(want) {
+		t.Fatalf("PatternsFromConf = %v, want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("PatternsFromConf[%d] = %q, want %q", i, got[i], want[i])
+		}
+	}
+	// comments/blanks only => empty (non-nil) slice
+	if p := PatternsFromConf("# only\n\n"); len(p) != 0 {
+		t.Errorf("expected empty, got %v", p)
+	}
+}
