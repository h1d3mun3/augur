diff --git a/pkg/services/forwarder/socks_client.go b/pkg/services/forwarder/socks_client.go
new file mode 100644
index 0000000..139a641
--- /dev/null
+++ b/pkg/services/forwarder/socks_client.go
@@ -0,0 +1,93 @@
+package forwarder
+
+// Minimal SOCKS5 client (RFC 1928, no auth) used by augur's egress mode to hand
+// every guest TCP connection to the host-side augur-proxy, which makes the
+// allow/deny decision. Kept dependency-free (no golang.org/x/net/proxy) so the
+// augur fork of gvproxy adds no new module requirements.
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+)
+
+// socksDial connects to the SOCKS5 proxy at socksAddr and issues a CONNECT to the
+// guest's intended destination (dst:port). The destination is passed as an IP
+// literal (ATYP 1/4); augur-proxy peeks the TLS SNI / HTTP Host on the stream to
+// recover the domain and applies its allowlist.
+func socksDial(socksAddr string, dst tcpip.Address, port uint16) (net.Conn, error) {
+	c, err := net.Dial("tcp", socksAddr)
+	if err != nil {
+		return nil, err
+	}
+	ok := false
+	defer func() {
+		if !ok {
+			_ = c.Close()
+		}
+	}()
+
+	// Greeting: VER=5, NMETHODS=1, METHOD=0 (no auth).
+	if _, err := c.Write([]byte{0x05, 0x01, 0x00}); err != nil {
+		return nil, err
+	}
+	reply := make([]byte, 2)
+	if _, err := io.ReadFull(c, reply); err != nil {
+		return nil, err
+	}
+	if reply[0] != 0x05 || reply[1] != 0x00 {
+		return nil, fmt.Errorf("socks: no acceptable auth method (%v)", reply)
+	}
+
+	// Request: VER=5, CMD=1 (connect), RSV=0, ATYP, ADDR, PORT.
+	req := []byte{0x05, 0x01, 0x00}
+	raw := dst.AsSlice()
+	switch len(raw) {
+	case 4:
+		req = append(req, 0x01) // IPv4
+		req = append(req, raw...)
+	case 16:
+		req = append(req, 0x04) // IPv6
+		req = append(req, raw...)
+	default:
+		return nil, fmt.Errorf("socks: unsupported address length %d", len(raw))
+	}
+	req = binary.BigEndian.AppendUint16(req, port)
+	if _, err := c.Write(req); err != nil {
+		return nil, err
+	}
+
+	// Reply: VER, REP, RSV, ATYP, BND.ADDR, BND.PORT. Read the fixed head, then
+	// the variable bound address (which we discard).
+	head := make([]byte, 4)
+	if _, err := io.ReadFull(c, head); err != nil {
+		return nil, err
+	}
+	if head[1] != 0x00 {
+		return nil, fmt.Errorf("socks: connect refused (rep=%d)", head[1])
+	}
+	var addrLen int
+	switch head[3] {
+	case 0x01:
+		addrLen = 4
+	case 0x04:
+		addrLen = 16
+	case 0x03:
+		l := make([]byte, 1)
+		if _, err := io.ReadFull(c, l); err != nil {
+			return nil, err
+		}
+		addrLen = int(l[0])
+	default:
+		return nil, fmt.Errorf("socks: bad reply ATYP %d", head[3])
+	}
+	if _, err := io.ReadFull(c, make([]byte, addrLen+2)); err != nil { // addr + port
+		return nil, err
+	}
+
+	ok = true
+	return c, nil
+}
